<%- include("../partials/admin/header") %>

<div class="ml-52 flex-1 overflow-auto bg-gray-50">

    <div class="bg-white border-b px-6 py-4 flex justify-between items-center">
        <h1 class="text-xl font-semibold text-teal-700">
            Dashboard
        </h1>

        <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-teal-100 rounded-full flex items-center justify-center text-teal-700 font-semibold">
                <%= admin.name.charAt(0).toUpperCase() %>
            </div>
            <span class="text-gray-700"><%= admin.name.toUpperCase() %></span>
            <i class="fas fa-chevron-down text-gray-400 text-sm"></i>
        </div>
    </div>

    <!-- Dashboard Content -->
    <div class="p-6">

        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-800">Dashboard</h2>
            <p class="text-gray-500 text-sm">Overview of store performance.</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 text-sm mb-1">Total Orders</p>
                        <h3 class="text-3xl font-bold text-gray-800"><%= totalOrders.toLocaleString('en-IN') %></h3>
                        <div class="w-12 h-1 bg-yellow-400 mt-2"></div>
                    </div>
                    <div class="w-10 h-10 bg-teal-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-shopping-cart text-teal-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 text-sm mb-1">Total Users</p>
                        <h3 class="text-3xl font-bold text-gray-800"><%= totalUsers.toLocaleString('en-IN') %></h3>
                        <div class="w-12 h-1 bg-yellow-400 mt-2"></div>
                    </div>
                    <div class="w-10 h-10 bg-teal-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-users text-teal-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 text-sm mb-1">Total Sales</p>
                        <h3 class="text-3xl font-bold text-gray-800">₹<%= totalSales.toLocaleString('en-IN') %></h3>
                        <div class="w-12 h-1 bg-yellow-400 mt-2"></div>
                    </div>
                    <div class="w-10 h-10 bg-teal-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-dollar-sign text-teal-600"></i>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-gray-500 text-sm mb-1">Pending Returns</p>
                        <h3 class="text-3xl font-bold text-gray-800"><%= pendingReturns %></h3>
                        <div class="w-12 h-1 bg-yellow-400 mt-2"></div>
                    </div>
                    <div class="w-10 h-10 bg-teal-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-sync-alt text-teal-600"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Chart and Alerts -->
        <div class="grid grid-cols-3 gap-6 mb-6">
            <!-- Monthly Sales Chart -->
            <div class="col-span-2 bg-white rounded-lg shadow p-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Monthly Sales Overview</h3>
                <div class="w-full h-1 bg-yellow-400 mb-4" style="width: 60px;"></div>
                <canvas id="salesChart" height="80"></canvas>
            </div>

            <!-- Low Stock Alerts + Quick Actions -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center gap-2 mb-4">
                    <i class="fas fa-exclamation-triangle text-red-500"></i>
                    <h3 class="text-lg font-semibold text-gray-800">Low Stock Alerts</h3>
                </div>
                <div class="w-full h-1 bg-yellow-400 mb-4" style="width: 60px;"></div>
                
                <div class="space-y-4 mb-6">
                    <% if (lowStockProducts.length === 0) { %>
                        <p class="text-sm text-gray-400 text-center py-4">No low stock items</p>
                    <% } else { %>
                        <% lowStockProducts.forEach(product => { %>
                            <div class="flex items-center gap-3">
                                <img src="<%= product.productImage?.[0]?.url || 'https://via.placeholder.com/100' %>" 
                                     alt="<%= product.name %>" 
                                     class="w-12 h-12 rounded object-cover">
                                <div class="flex-1">
                                    <p class="text-sm font-medium text-gray-800 line-clamp-1"><%= product.name %></p>
                                    <p class="text-xs text-red-500">Stock: <%= product.totalStock %></p>
                                </div>
                                <a href="/admin/products" class="px-3 py-1 text-xs border border-teal-600 text-teal-600 rounded hover:bg-teal-50">Restock</a>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <div class="mt-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h3>
                    <div class="w-full h-1 bg-yellow-400 mb-4" style="width: 60px;"></div>
                    
                    <div class="grid grid-cols-2 gap-3">
                        <a href="/admin/products" class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
                            <i class="fas fa-plus text-teal-600 text-xl mb-2"></i>
                            <span class="text-sm text-gray-700">Add Product</span>
                        </a>
                        <a href="/admin/categories" class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
                            <i class="fas fa-tags text-teal-600 text-xl mb-2"></i>
                            <span class="text-sm text-gray-700">Add Category</span>
                        </a>
                        <a href="/admin/coupons" class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
                            <i class="fas fa-ticket-alt text-teal-600 text-xl mb-2"></i>
                            <span class="text-sm text-gray-700">Create Coupon</span>
                        </a>
                        <a href="/admin/orders" class="flex flex-col items-center justify-center p-4 border-2 border-dashed border-gray-300 rounded-lg hover:border-teal-500 hover:bg-teal-50 transition">
                            <i class="fas fa-shopping-cart text-teal-600 text-xl mb-2"></i>
                            <span class="text-sm text-gray-700">View Orders</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Orders -->
        <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">Recent Orders</h3>
            <div class="w-full h-1 bg-yellow-400 mb-4" style="width: 60px;"></div>
            
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr class="border-b">
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Order ID</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Customer</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Amount</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Status</th>
                            <th class="text-left py-3 px-4 text-sm font-medium text-gray-600">Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (recentOrders.length === 0) { %>
                            <tr>
                                <td colspan="5" class="py-8 text-center text-gray-400">
                                    <i class="fas fa-inbox text-3xl mb-2 block opacity-30"></i>
                                    <p class="text-sm">No orders yet</p>
                                </td>
                            </tr>
                        <% } else { %>
                            <% recentOrders.forEach(order => { 
                                let statusClass = 'bg-gray-100 text-gray-700';
                                if (order.status === 'delivered') statusClass = 'bg-green-100 text-green-700';
                                else if (order.status === 'shipped' || order.status === 'out-for-delivery') statusClass = 'bg-blue-100 text-blue-700';
                                else if (order.status === 'pending' || order.status === 'processing') statusClass = 'bg-yellow-100 text-yellow-700';
                                else if (order.status === 'cancelled') statusClass = 'bg-red-100 text-red-700';
                            %>
                                <tr class="border-b hover:bg-gray-50">
                                    <td class="py-3 px-4 text-sm text-gray-800"><%= order.orderId %></td>
                                    <td class="py-3 px-4 text-sm text-gray-800">
                                        <%= order.userId ? order.userId.name : 'Guest' %>
                                    </td>
                                    <td class="py-3 px-4 text-sm text-gray-800">₹<%= order.finalAmount.toLocaleString('en-IN') %></td>
                                    <td class="py-3 px-4">
                                        <span class="px-3 py-1 text-xs rounded-full <%= statusClass %>">
                                            <%= order.status.charAt(0).toUpperCase() + order.status.slice(1).replace(/-/g, ' ') %>
                                        </span>
                                    </td>
                                    <td class="py-3 px-4 text-sm text-gray-600">
                                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <% if (recentOrders.length > 0) { %>
                <div class="mt-4 text-center">
                    <a href="/admin/orders" class="text-sm text-teal-600 hover:text-teal-700 font-medium">
                        View All Orders →
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Chart.js Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const ctx = document.getElementById('salesChart').getContext('2d');
    
    const salesData = <%- JSON.stringify(salesByMonth) %>;
    
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
            datasets: [{
                label: 'Monthly Sales (₹)',
                data: salesData,
                borderColor: '#0d9488',
                backgroundColor: 'rgba(13, 148, 136, 0.1)',
                borderWidth: 2,
                tension: 0.4,
                fill: true,
                pointBackgroundColor: '#0d9488',
                pointBorderColor: '#fff',
                pointBorderWidth: 2,
                pointRadius: 4,
                pointHoverRadius: 6
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            return '₹' + context.parsed.y.toLocaleString('en-IN');
                        }
                    }
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        callback: function(value) {
                            return '₹' + (value / 1000).toFixed(0) + 'k';
                        }
                    },
                    grid: {
                        color: 'rgba(0, 0, 0, 0.05)'
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            }
        }
    });
</script>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

<%- include("../partials/admin/footer") %>
