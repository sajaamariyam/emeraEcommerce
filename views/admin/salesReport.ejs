<%- include("../partials/admin/header") %>

<style>#toast-container { transition: transform 0.3s cubic-bezier(0.16,1,0.3,1); }</style>

<div class="ml-52 h-screen overflow-y-auto bg-gray-50">
    <div class="bg-white border-b sticky top-0 z-10">
        <div class="px-8 py-4 max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-semibold text-teal-700">Sales Report</h1>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-teal-600 rounded-full flex items-center justify-center text-white text-sm font-medium"><%= admin.name.charAt(0) %></div>
                <span class="text-sm text-gray-700"><%= admin.name %></span>
            </div>
        </div>
    </div>

    <div class="p-8 max-w-7xl mx-auto">
        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Sales Overview</h2>
                <p class="text-gray-600 mt-1">View and analyse delivered order sales data.</p>
            </div>
            <div class="flex gap-3">
                <a href="/admin/sales-report/pdf?filter=<%= filter %>&from=<%= from %>&to=<%= to %>"
                   class="bg-white border border-gray-300 text-gray-700 px-5 py-2.5 rounded-lg hover:bg-gray-50 transition flex items-center gap-2 font-medium shadow-sm">
                    <i class="fas fa-file-pdf text-red-500"></i> PDF
                </a>
                <a href="/admin/sales-report/excel?filter=<%= filter %>&from=<%= from %>&to=<%= to %>"
                   class="bg-teal-700 text-white px-5 py-2.5 rounded-lg hover:bg-teal-800 transition flex items-center gap-2 font-medium shadow-md">
                    <i class="fas fa-file-excel"></i> Excel
                </a>
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 mb-8">
            <form method="GET" action="/admin/sales-report" id="filterForm" class="flex flex-wrap items-end gap-4">
                <div>
                    <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">Filter By</label>
                    <div class="flex gap-2">
                        <%
                          // FIX: use direct links instead of submit buttons so filter param is always clean
                          ['daily','weekly','monthly'].forEach(function(f) {
                            var isActive = filter === f;
                        %>
                            <a href="/admin/sales-report?filter=<%= f %>"
                                class="px-4 py-2 rounded-lg text-sm font-semibold border transition
                                    <%= isActive ? 'bg-teal-700 text-white border-teal-700' : 'bg-white text-gray-600 border-gray-300 hover:border-teal-500 hover:text-teal-700' %>">
                                <%= f.charAt(0).toUpperCase() + f.slice(1) %>
                            </a>
                        <% }) %>
                    </div>
                </div>
                <div class="h-10 w-px bg-gray-200 self-end mb-0.5"></div>
                <div class="flex items-end gap-3">
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">From</label>
                        <input type="date" name="from" id="fromDate" value="<%= from %>" class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 outline-none transition">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase tracking-wider mb-2">To</label>
                        <input type="date" name="to" id="toDate" value="<%= to %>" class="px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-teal-500 outline-none transition">
                    </div>
                    <input type="hidden" name="filter" value="custom">
                    <button type="button" onclick="applyCustomFilter()"
                        class="px-5 py-2 rounded-lg text-sm font-semibold border transition
                            <%= filter === 'custom' ? 'bg-teal-700 text-white border-teal-700' : 'bg-white text-gray-600 border-gray-300 hover:border-teal-500 hover:text-teal-700' %>">
                        Apply
                    </button>
                </div>
                <% if (filter) { %>
                    <a href="/admin/sales-report" class="self-end px-4 py-2 text-sm text-gray-500 hover:text-gray-800 font-medium transition flex items-center gap-1">
                        <i class="fas fa-times text-xs"></i> Clear
                    </a>
                <% } %>
            </form>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-teal-50 rounded-full flex items-center justify-center"><i class="fas fa-shopping-bag text-teal-600 text-lg"></i></div>
                <div><p class="text-sm text-gray-500 font-medium">Total Orders</p><p class="text-2xl font-bold text-gray-800"><%= summary.totalOrders %></p></div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center"><i class="fas fa-rupee-sign text-green-600 text-lg"></i></div>
                <div><p class="text-sm text-gray-500 font-medium">Total Revenue</p><p class="text-2xl font-bold text-gray-800">₹<%= summary.totalSales.toLocaleString('en-IN') %></p></div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-orange-50 rounded-full flex items-center justify-center"><i class="fas fa-tag text-orange-500 text-lg"></i></div>
                <div><p class="text-sm text-gray-500 font-medium">Total Discount Given</p><p class="text-2xl font-bold text-gray-800">₹<%= summary.totalDiscount.toLocaleString('en-IN') %></p></div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-gray-100">
            <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Order ID</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Customer</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Items</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Payment</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Discount</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Final Amount</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% if (orders.length === 0) { %>
                        <tr><td colspan="7" class="px-6 py-16 text-center text-gray-400"><i class="fas fa-chart-bar text-4xl mb-3 block opacity-30"></i><p class="font-medium">No delivered orders found for this period.</p></td></tr>
                    <% } %>

                    <% orders.forEach(function(order) { %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <p class="font-semibold text-gray-800 text-sm"><%= order.orderId %></p>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-700 font-medium">
                                <%= order.userId?.name || 'N/A' %>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">
                                <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-2.5 py-1 bg-teal-50 text-teal-700 text-xs font-bold rounded-full border border-teal-100">
                                    <%= order.orderedItems.length %> item<%= order.orderedItems.length !== 1 ? 's' : '' %>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <%
                                  var pm = (order.paymentMethod || '').toLowerCase();
                                  var pmClass = 'bg-gray-50 text-gray-600 border-gray-100';
                                  if (pm === 'cod')           pmClass = 'bg-yellow-50 text-yellow-700 border-yellow-100';
                                  else if (pm === 'upi')      pmClass = 'bg-blue-50 text-blue-700 border-blue-100';
                                  else if (pm === 'wallet')   pmClass = 'bg-purple-50 text-purple-700 border-purple-100';
                                  else if (pm === 'razorpay') pmClass = 'bg-indigo-50 text-indigo-700 border-indigo-100';
                                %>
                                <span class="px-3 py-1 text-xs font-bold rounded-full border <%= pmClass %>">
                                    <%= (order.paymentMethod || 'N/A').toUpperCase() %>
                                </span>
                            </td>
                            <td class="px-6 py-4">
                                <% if (order.discount > 0) { %>
                                    <span class="text-orange-600 font-semibold text-sm">-₹<%= order.discount.toLocaleString('en-IN') %></span>
                                <% } else { %>
                                    <span class="text-gray-400 text-sm">—</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-lg font-bold text-teal-700">₹<%= order.finalAmount.toLocaleString('en-IN') %></span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- FIX: pagination links now carry filter + from + to so filter is preserved on page change -->
            <% if (totalPages > 1) { %>
                <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between flex-wrap gap-3">
                    <p class="text-sm text-gray-500">
                        Page <span class="font-semibold text-gray-700"><%= currentPage %></span> of
                        <span class="font-semibold text-gray-700"><%= totalPages %></span>
                        &nbsp;·&nbsp; <span class="font-semibold text-gray-700"><%= totalOrders %></span> orders
                    </p>
                    <div class="flex items-center gap-1">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %>&filter=<%= filter %>&from=<%= from %>&to=<%= to %>" class="px-3 py-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-medium transition">← Prev</a>
                        <% } %>
                        <%
                          var maxPg = 5;
                          var startPg = Math.max(1, currentPage - Math.floor(maxPg / 2));
                          var endPg   = Math.min(totalPages, startPg + maxPg - 1);
                          if (endPg - startPg < maxPg - 1) startPg = Math.max(1, endPg - maxPg + 1);
                        %>
                        <% for (var i = startPg; i <= endPg; i++) { %>
                            <a href="?page=<%= i %>&filter=<%= filter %>&from=<%= from %>&to=<%= to %>"
                                class="px-3 py-1.5 rounded text-sm font-medium transition
                                <%= currentPage === i ? 'bg-teal-700 text-white border border-teal-700' : 'border border-gray-300 text-gray-600 hover:bg-gray-50' %>">
                                <%= i %>
                            </a>
                        <% } %>
                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>&filter=<%= filter %>&from=<%= from %>&to=<%= to %>" class="px-3 py-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-medium transition">Next →</a>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
function showToast(message, type) {
    type = type || 'error';
    var existing = document.getElementById('toast-container');
    if (existing) existing.remove();
    var colors = { success:'bg-green-600', error:'bg-red-600', warning:'bg-yellow-500' };
    var icons  = { success:'✓', error:'✕', warning:'⚠' };
    var el = document.createElement('div');
    el.id = 'toast-container';
    el.className = 'fixed top-6 right-6 z-[999] flex items-center gap-3 px-5 py-4 rounded-lg shadow-xl text-white text-sm font-medium max-w-sm ' + colors[type];
    el.style.transform = 'translateX(120%)';
    el.style.transition = 'transform 0.3s cubic-bezier(0.16,1,0.3,1)';
    el.innerHTML = '<span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold">' + icons[type] + '</span><span class="flex-1">' + message + '</span><button onclick="this.parentElement.remove()" class="ml-2 text-white/70 hover:text-white text-lg">&times;</button>';
    document.body.appendChild(el);
    requestAnimationFrame(function() { el.style.transform = 'translateX(0)'; });
    setTimeout(function() { el.style.transform = 'translateX(120%)'; setTimeout(function() { el.remove(); }, 300); }, 4000);
}

function getTodayStr() {
    var t = new Date();
    return t.getFullYear() + '-' + String(t.getMonth()+1).padStart(2,'0') + '-' + String(t.getDate()).padStart(2,'0');
}

var fromInput = document.getElementById('fromDate');
var toInput   = document.getElementById('toDate');
var today     = getTodayStr();

fromInput.setAttribute('max', today);
toInput.setAttribute('max', today);

fromInput.addEventListener('change', function () {
    toInput.setAttribute('min', this.value);
    if (toInput.value && toInput.value < this.value) toInput.value = this.value;
});
toInput.addEventListener('change', function () {
    fromInput.setAttribute('max', this.value || today);
});

function applyCustomFilter() {
    var from = fromInput.value;
    var to   = toInput.value;
    if (!from || !to) { showToast('Please select both From and To dates.', 'warning'); return; }
    if (from > to)    { showToast('From date cannot be after To date.', 'error'); return; }
    if (from > today || to > today) { showToast('Dates cannot be in the future.', 'error'); return; }
    window.location.href = '/admin/sales-report?' + new URLSearchParams({ filter: 'custom', from: from, to: to }).toString();
}
</script>

<%- include("../partials/admin/footer") %>
