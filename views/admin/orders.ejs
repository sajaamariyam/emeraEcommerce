<%- include("../partials/admin/header") %>

<div class="ml-52 h-screen overflow-y-auto bg-gray-50">

  <!-- Top bar -->
  <div class="bg-white border-b sticky top-0 z-10">
    <div class="px-8 py-4 max-w-7xl mx-auto flex justify-between items-center">
      <h1 class="text-xl font-semibold text-teal-700">Order Management</h1>
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-teal-600 rounded-full flex items-center justify-center text-white text-sm font-medium">
          <%= admin.name.charAt(0).toUpperCase() %>
        </div>
        <span class="text-sm text-gray-700"><%= admin.name %></span>
      </div>
    </div>
  </div>

  <div class="p-8 max-w-7xl mx-auto">
    <div class="mb-8">
      <h2 class="text-2xl font-bold text-gray-800">Manage Orders</h2>
      <p class="text-gray-600 mt-1">Track shipments, update statuses, and manage order details.</p>
    </div>

    <!-- Stats Cards -->
    <div class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-7 gap-4 mb-8">
      <!-- Total Orders -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Total Orders</p>
        <p class="text-3xl font-bold text-gray-800"><%= totalOrders %></p>
        <div class="h-1 w-10 bg-teal-500 mt-3"></div>
      </div>

      <!-- Pending Orders -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Pending</p>
        <p class="text-3xl font-bold text-yellow-600"><%= pendingOrders %></p>
        <div class="h-1 w-10 bg-yellow-500 mt-3"></div>
      </div>

      <!-- Shipped Orders -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Shipped</p>
        <p class="text-3xl font-bold text-blue-600"><%= shippedOrders %></p>
        <div class="h-1 w-10 bg-blue-500 mt-3"></div>
      </div>

      <!-- Out for Delivery -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Out for Delivery</p>
        <p class="text-3xl font-bold text-purple-600"><%= outForDelivery %></p>
        <div class="h-1 w-10 bg-purple-500 mt-3"></div>
      </div>

      <!-- Delivered Orders -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Delivered</p>
        <p class="text-3xl font-bold text-green-600"><%= deliveredOrders %></p>
        <div class="h-1 w-10 bg-green-500 mt-3"></div>
      </div>

      <!-- Cancelled Orders -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Cancelled</p>
        <p class="text-3xl font-bold text-red-600"><%= cancelledOrders %></p>
        <div class="h-1 w-10 bg-red-500 mt-3"></div>
      </div>

      <!-- Return Requested -->
      <div class="bg-white rounded-lg shadow-sm p-4 border border-gray-100">
        <p class="text-xs text-gray-500 uppercase font-bold mb-1">Return Requested</p>
        <p class="text-3xl font-bold text-orange-600"><%= returnRequestedOrders %></p>
        <div class="h-1 w-10 bg-orange-500 mt-3"></div>
      </div>
    </div>

    <!-- Filters and Search -->
    <div class="bg-white rounded-lg shadow-sm p-6 mb-6">
      <form id="filterForm" method="GET" action="/admin/orders" class="space-y-4">

        <!-- SEARCH ROW (FULL WIDTH) -->
        <div class="flex gap-2 w-full">
          <input
            type="text"
            name="search"
            value="<%= search %>"
            placeholder="Search by Order ID, Customer, Email..."
            class="w-full border px-4 py-2 rounded-lg outline-none focus:ring-2 focus:ring-black"
          />

          <button
            type="submit"
            class="bg-black text-white px-6 rounded-lg"
          >
            Search
          </button>

          <% if (search || status !== 'all' || sortBy !== 'date-desc') { %>
            <a
              href="/admin/orders"
              class="bg-gray-300 px-5 py-2 rounded-lg text-black flex items-center"
            >
              Clear
            </a>
          <% } %>
        </div>

        <!-- FILTER ROW -->
        <div class="flex flex-col md:flex-row gap-4">

          <!-- STATUS -->
          <select
            name="status"
            onchange="this.form.submit()"
            class="w-full md:w-1/3 px-4 py-2 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-black"
          >
            <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Status</option>
            <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="processing" <%= status === 'processing' ? 'selected' : '' %>>Processing</option>
            <option value="shipped" <%= status === 'shipped' ? 'selected' : '' %>>Shipped</option>
            <option value="out-for-delivery" <%= status === 'out-for-delivery' ? 'selected' : '' %>>Out for Delivery</option>
            <option value="delivered" <%= status === 'delivered' ? 'selected' : '' %>>Delivered</option>
            <option value="cancelled" <%= status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
            <option value="return-requested" <%= status === 'return-requested' ? 'selected' : '' %>>Return Requested</option>
            <option value="returned" <%= status === 'returned' ? 'selected' : '' %>>Returned</option>
          </select>

          <!-- SORT BY -->
          <select
            name="sortBy"
            onchange="this.form.submit()"
            class="w-full md:w-1/3 px-4 py-2 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-black"
          >
            <option value="date-desc" <%= (sortBy || 'date-desc') === 'date-desc' ? 'selected' : '' %>>Latest First</option>
            <option value="date-asc" <%= sortBy === 'date-asc' ? 'selected' : '' %>>Oldest First</option>
            <option value="amount-desc" <%= sortBy === 'amount-desc' ? 'selected' : '' %>>Amount: High to Low</option>
            <option value="amount-asc" <%= sortBy === 'amount-asc' ? 'selected' : '' %>>Amount: Low to High</option>
          </select>

        </div>

      </form>
    </div>

    <!-- Orders Table -->
    <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-gray-100">
      <% if (orders.length === 0) { %>
        <!-- Empty State -->
        <div class="text-center py-16">
          <svg class="mx-auto w-24 h-24 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <h3 class="text-xl font-semibold text-gray-800 mb-2">No Orders Found</h3>
          <p class="text-gray-500">Try adjusting your filters or search terms</p>
        </div>
      <% } else { %>
        <!-- Table -->
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-gray-50 border-b border-gray-200">
              <tr>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Order ID</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Customer</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Date</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Amount</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Payment</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-4 text-left text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% orders.forEach(order => { %>
                <tr class="hover:bg-gray-50 transition-colors">
                  <!-- Order ID -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex flex-col">
                      <span class="text-sm font-bold text-gray-900">#<%= order.orderId %></span>
                      <span class="text-xs text-gray-400"><%= order.orderedItems ? order.orderedItems.length : 0 %> item(s)</span>
                    </div>
                  </td>

                  <!-- Customer -->
                  <td class="px-6 py-4">
                    <div class="flex items-center">
                      <div class="flex-shrink-0 h-10 w-10 bg-teal-100 rounded-full flex items-center justify-center text-teal-600 font-semibold">
                        <%= (order.userId?.name || 'N')[0].toUpperCase() %>
                      </div>
                      <div class="ml-3">
                        <div class="text-sm font-medium text-gray-900"><%= order.userId?.name || 'N/A' %></div>
                        <div class="text-xs text-gray-400"><%= order.userId?.email || 'N/A' %></div>
                      </div>
                    </div>
                  </td>

                  <!-- Date -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-900">
                      <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </div>
                  </td>

                  <!-- Amount -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <span class="text-sm font-bold text-gray-900">₹<%= order.finalAmount.toLocaleString() %></span>
                  </td>

                  <!-- Payment -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex flex-col">
                      <span class="text-sm text-gray-900"><%= order.paymentMethod %></span>
                      <% 
                        let paymentStatusClass = '';
                        switch(order.paymentStatus) {
                          case 'Paid':
                            paymentStatusClass = 'text-green-600';
                            break;
                          case 'Pending':
                            paymentStatusClass = 'text-yellow-600';
                            break;
                          case 'Refunded':
                            paymentStatusClass = 'text-blue-600';
                            break;
                          default:
                            paymentStatusClass = 'text-gray-600';
                        }
                      %>
                      <span class="text-xs font-medium <%= paymentStatusClass %>"><%= order.paymentStatus || 'Pending' %></span>
                    </div>
                  </td>

                  <!-- Status -->
                  <td class="px-6 py-4 whitespace-nowrap">
                    <% 
                      let statusClass = '';
                      let statusText = order.status;
                      switch(order.status) {
                        case 'pending':
                          statusClass = 'bg-yellow-50 text-yellow-700 border border-yellow-100';
                          statusText = 'Pending';
                          break;
                        case 'processing':
                          statusClass = 'bg-indigo-50 text-indigo-700 border border-indigo-100';
                          statusText = 'Processing';
                          break;
                        case 'shipped':
                          statusClass = 'bg-blue-50 text-blue-700 border border-blue-100';
                          statusText = 'Shipped';
                          break;
                        case 'out-for-delivery':
                          statusClass = 'bg-purple-50 text-purple-700 border border-purple-100';
                          statusText = 'Out for Delivery';
                          break;
                        case 'delivered':
                          statusClass = 'bg-green-50 text-green-700 border border-green-100';
                          statusText = 'Delivered';
                          break;
                        case 'cancelled':
                          statusClass = 'bg-red-50 text-red-700 border border-red-100';
                          statusText = 'Cancelled';
                          break;
                        case 'return-requested':
                          statusClass = 'bg-orange-50 text-orange-700 border border-orange-100';
                          statusText = 'Return Requested';
                          break;
                        case 'returned':
                          statusClass = 'bg-gray-50 text-gray-700 border border-gray-100';
                          statusText = 'Returned';
                          break;
                        default:
                          statusClass = 'bg-gray-50 text-gray-700 border border-gray-100';
                      }
                    %>
                    <span class="px-3 py-1 <%= statusClass %> text-[10px] font-bold uppercase rounded-full">
                      <%= statusText %>
                    </span>
                  </td>

                  <!-- Actions -->
                  <td class="px-6 py-4 whitespace-nowrap text-right">
                    <div class="flex justify-end gap-3">
                      <button 
                        onclick="viewOrderDetails('<%= order._id %>')"
                        class="text-teal-600 hover:text-teal-800 text-sm font-bold"
                      >
                        View
                      </button>
                      <% if (order.status !== 'delivered' && order.status !== 'cancelled' && order.status !== 'returned') { %>
                        <button 
                          onclick="openUpdateModal('<%= order._id %>', '<%= order.status %>')"
                          class="text-gray-500 hover:text-gray-700 text-sm font-bold"
                        >
                          Update
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <% if (totalPages > 1) { %>
          <div class="px-6 py-6 bg-gray-50 border-t border-gray-200 flex justify-center gap-2">
            <% for(let i = 1; i <= totalPages; i++) { %>
              <a href="?page=<%= i %>&search=<%= search || '' %>&status=<%= status || 'all' %>&sortBy=<%= sortBy || 'date-desc' %>" 
                 class="w-10 h-10 flex items-center justify-center text-sm font-bold border rounded transition-all <%= currentPage === i ? 'bg-teal-600 text-white border-teal-600' : 'bg-white text-gray-400 hover:bg-gray-100' %>">
                <%= i %>
              </a>
            <% } %>
          </div>
        <% } %>
      <% } %>
    </div>
  </div>
</div>

<!-- Order Details Modal -->
<div id="orderDetailsModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-white w-full max-w-4xl max-h-[90vh] overflow-y-auto rounded-2xl shadow-2xl">
    <!-- Modal Header -->
    <div class="flex justify-between items-center px-6 py-4 border-b sticky top-0 bg-white z-10">
      <div>
        <h2 class="text-xl font-bold text-gray-900">Order Details</h2>
        <p class="text-sm text-gray-500 mt-1">Order ID: <span id="modalOrderId"></span></p>
      </div>
      <button onclick="closeOrderDetailsModal()" class="text-gray-400 hover:text-gray-900 text-2xl">
        &times;
      </button>
    </div>

    <!-- Modal Content -->
    <div id="orderDetailsContent" class="p-6">
      <div class="flex items-center justify-center py-12">
        <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-600"></div>
      </div>
    </div>
  </div>
</div>

<!-- Update Status Modal -->
<div id="updateStatusModal" class="fixed inset-0 z-[100] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-8">
    <div class="mb-6">
      <h2 class="text-xl font-bold text-gray-900">Update Order Status</h2>
      <p class="text-sm text-gray-500 mt-1">Select the new status for this order</p>
    </div>
    
    <div>
      <input type="hidden" id="updateOrderId">
      
      <label class="block text-sm font-medium text-gray-700 mb-2">New Status</label>
      <select id="newStatus" class="w-full px-4 py-3 border border-gray-300 rounded-lg outline-none focus:ring-2 focus:ring-teal-500">
        <option value="pending">Pending</option>
        <option value="processing">Processing</option>
        <option value="shipped">Shipped</option>
        <option value="out-for-delivery">Out for Delivery</option>
        <option value="delivered">Delivered</option>
        <option value="cancelled">Cancelled</option>
        <option value="return-requested">Return Requested</option>
        <option value="returned">Returned</option>
      </select>

      <div class="flex gap-3 mt-6">
        <button 
          onclick="updateOrderStatus()"
          class="flex-1 bg-teal-700 text-white px-6 py-3 rounded-xl font-bold uppercase text-xs tracking-widest hover:bg-teal-800 transition"
        >
          Update Status
        </button>
        <button 
          onclick="closeUpdateModal()"
          class="flex-1 border border-gray-300 px-6 py-3 rounded-xl font-bold uppercase text-xs tracking-widest hover:bg-gray-50 transition"
        >
          Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Notification Modal -->
<div id="notificationModal" class="fixed inset-0 z-[200] hidden flex items-center justify-center bg-black/50 backdrop-blur-sm p-4">
  <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl p-8">
    <div class="text-center mb-6">
      <div id="notificationIcon" class="w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
        <i id="notificationIconElement" class="text-2xl"></i>
      </div>
      <h3 id="notificationTitle" class="text-xl font-bold text-gray-900 mb-2"></h3>
      <p id="notificationMessage" class="text-sm text-gray-600"></p>
    </div>

    <button onclick="closeNotificationModal()" class="w-full bg-teal-700 text-white py-3 rounded-xl font-bold uppercase text-xs tracking-widest hover:bg-teal-800 transition">
      OK
    </button>
  </div>
</div>

<script>
// Notification Modal Functions
function showNotificationModal(title, message, isSuccess = true) {
  const modal = document.getElementById("notificationModal");
  const icon = document.getElementById("notificationIcon");
  const iconElement = document.getElementById("notificationIconElement");
  
  document.getElementById("notificationTitle").textContent = title;
  document.getElementById("notificationMessage").textContent = message;
  
  if (isSuccess) {
    icon.className = "w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4";
    iconElement.className = "fas fa-check-circle text-green-600 text-2xl";
  } else {
    icon.className = "w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4";
    iconElement.className = "fas fa-times-circle text-red-600 text-2xl";
  }
  
  modal.classList.remove("hidden");
  modal.classList.add("flex");
}

function closeNotificationModal() {
  const modal = document.getElementById("notificationModal");
  modal.classList.add("hidden");
  modal.classList.remove("flex");
}

// View Order Details
async function viewOrderDetails(orderId) {
  const modal = document.getElementById('orderDetailsModal');
  const content = document.getElementById('orderDetailsContent');
  const modalOrderId = document.getElementById('modalOrderId');
  
  modal.classList.remove('hidden');
  modal.classList.add('flex');
  content.innerHTML = `
    <div class="flex items-center justify-center py-12">
      <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-teal-600"></div>
    </div>
  `;

  try {
    const response = await fetch(`/admin/orders/${orderId}`);
    const order = await response.json();

    if (!response.ok) {
      throw new Error('Failed to load order details');
    }

    // Debug: Log the order data to see the structure
    console.log('Order data:', order);
    console.log('Address:', order.address);
    console.log('Sample item:', order.orderedItems?.[0]);

    modalOrderId.textContent = `#${order.orderId}`;
    
    content.innerHTML = `
      <!-- Customer Info -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <div class="bg-teal-50 rounded-lg p-4 border border-teal-100">
          <h3 class="text-sm font-bold text-gray-700 mb-3 uppercase tracking-widest">
            Customer Information
          </h3>
          <div class="space-y-2">
            <p class="text-sm"><span class="font-medium text-gray-700">Name:</span> <span class="text-gray-900">${order.userId?.name || 'N/A'}</span></p>
            <p class="text-sm"><span class="font-medium text-gray-700">Email:</span> <span class="text-gray-900">${order.userId?.email || 'N/A'}</span></p>
            <p class="text-sm"><span class="font-medium text-gray-700">Phone:</span> <span class="text-gray-900">${order.userId?.phone || 'N/A'}</span></p>
          </div>
        </div>

        <div class="bg-green-50 rounded-lg p-4 border border-green-100">
          <h3 class="text-sm font-bold text-gray-700 mb-3 uppercase tracking-widest">
            Shipping Address
          </h3>
          <div class="space-y-1 text-sm text-gray-900">
            ${order.address ? `
              ${order.address.name ? `<p class="font-medium">${order.address.name}</p>` : ''}
              ${order.address.address ? `<p>${order.address.address}</p>` : ''}
              ${order.address.city || order.address.state || order.address.pincode ? `
                <p>${order.address.city || ''}${order.address.city && order.address.state ? ', ' : ''}${order.address.state || ''}${(order.address.city || order.address.state) && order.address.pincode ? ' - ' : ''}${order.address.pincode || ''}</p>
              ` : ''}
              ${order.address.phone ? `<p><strong>Phone:</strong> ${order.address.phone}</p>` : ''}
              ${!order.address.name && !order.address.address && !order.address.city && !order.address.state ? '<p class="text-gray-500">Address details not available</p>' : ''}
            ` : '<p class="text-gray-500">Address not available</p>'}
          </div>
        </div>
      </div>

      <!-- Order Info -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
        <div class="bg-gray-50 rounded-lg p-4 text-center border border-gray-200">
          <p class="text-xs text-gray-500 uppercase font-bold mb-1">Order Date</p>
          <p class="text-sm font-bold text-gray-900">${new Date(order.createdAt).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' })}</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4 text-center border border-gray-200">
          <p class="text-xs text-gray-500 uppercase font-bold mb-1">Payment Method</p>
          <p class="text-sm font-bold text-gray-900">${order.paymentMethod || 'N/A'}</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4 text-center border border-gray-200">
          <p class="text-xs text-gray-500 uppercase font-bold mb-1">Payment Status</p>
          <p class="text-sm font-bold text-gray-900">${order.paymentStatus || 'Pending'}</p>
        </div>
        <div class="bg-gray-50 rounded-lg p-4 text-center border border-gray-200">
          <p class="text-xs text-gray-500 uppercase font-bold mb-1">Order Status</p>
          <p class="text-sm font-bold text-gray-900">${formatStatus(order.status)}</p>
        </div>
      </div>

      <!-- Order Items -->
      <div class="mb-6">
        <h3 class="text-sm font-bold text-gray-700 mb-4 uppercase tracking-widest">
          Order Items
        </h3>
        <div class="space-y-3">
          ${order.orderedItems?.map(item => {
            // Handle different image URL formats
            let imageUrl = '/images/placeholder.jpg';
            if (item.productId?.productImage) {
              if (Array.isArray(item.productId.productImage) && item.productId.productImage.length > 0) {
                // If it's an array of objects with url property
                if (typeof item.productId.productImage[0] === 'object' && item.productId.productImage[0].url) {
                  imageUrl = item.productId.productImage[0].url;
                } 
                // If it's an array of strings
                else if (typeof item.productId.productImage[0] === 'string') {
                  imageUrl = item.productId.productImage[0];
                }
              }
            }
            
            return `
            <div class="flex items-center space-x-4 bg-gray-50 rounded-lg p-4 border border-gray-200">
              <img 
                src="${imageUrl}" 
                alt="${item.productId?.productName || 'Product'}"
                class="w-20 h-20 object-cover rounded-lg"
              >
              <div class="flex-1">
                <h4 class="font-bold text-gray-900">${item.productId?.productName || 'Product Name'}</h4>
                <p class="text-sm text-gray-600">Color: ${item.color || 'N/A'} | Size: ${item.size || 'N/A'}</p>
                <p class="text-sm text-gray-600">Quantity: ${item.quantity || 0}</p>
              </div>
              <div class="text-right">
                <p class="text-sm text-gray-600">Unit Price</p>
                <p class="font-bold text-gray-900">₹${(item.price || 0).toLocaleString()}</p>
                <p class="text-sm font-bold text-teal-600 mt-1">Total: ₹${((item.price || 0) * (item.quantity || 0)).toLocaleString()}</p>
              </div>
            </div>
          `}).join('') || '<p class="text-gray-500 text-center py-4">No items found</p>'}
        </div>
      </div>

      <!-- Order Summary -->
      <div class="bg-gray-50 rounded-lg p-6 border border-gray-200">
        <h3 class="text-sm font-bold text-gray-700 mb-4 uppercase tracking-widest">Order Summary</h3>
        <div class="space-y-2">
          <div class="flex justify-between text-sm">
            <span class="text-gray-600">Subtotal:</span>
            <span class="text-gray-900 font-medium">₹${(order.totalPrice || 0).toLocaleString()}</span>
          </div>
          ${order.discount && order.discount > 0 ? `
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Discount:</span>
              <span class="text-green-600 font-medium">-₹${order.discount.toLocaleString()}</span>
            </div>
          ` : ''}
          ${order.couponApplied ? `
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Coupon (${order.couponApplied}):</span>
              <span class="text-green-600 font-medium">-₹${(order.couponDiscount || 0).toLocaleString()}</span>
            </div>
          ` : ''}
          ${order.shippingCost && order.shippingCost > 0 ? `
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Shipping:</span>
              <span class="text-gray-900 font-medium">₹${order.shippingCost.toLocaleString()}</span>
            </div>
          ` : `
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Shipping:</span>
              <span class="text-green-600 font-medium">Free</span>
            </div>
          `}
          <div class="border-t border-gray-300 pt-2 mt-2">
            <div class="flex justify-between">
              <span class="text-base font-bold text-gray-900">Total Amount:</span>
              <span class="text-lg font-bold text-teal-600">₹${(order.finalAmount || 0).toLocaleString()}</span>
            </div>
          </div>
        </div>
      </div>
    `;
  } catch (error) {
    console.error('Error loading order details:', error);
    content.innerHTML = `
      <div class="text-center py-12">
        <svg class="mx-auto w-16 h-16 text-red-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Failed to Load Order Details</h3>
        <p class="text-gray-600">Please try again later</p>
      </div>
    `;
  }
}

function closeOrderDetailsModal() {
  const modal = document.getElementById('orderDetailsModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

// Update Order Status
function openUpdateModal(orderId, currentStatus) {
  document.getElementById('updateOrderId').value = orderId;
  document.getElementById('newStatus').value = currentStatus;
  const modal = document.getElementById('updateStatusModal');
  modal.classList.remove('hidden');
  modal.classList.add('flex');
}

function closeUpdateModal() {
  const modal = document.getElementById('updateStatusModal');
  modal.classList.add('hidden');
  modal.classList.remove('flex');
}

async function updateOrderStatus() {
  const orderId = document.getElementById('updateOrderId').value;
  const status = document.getElementById('newStatus').value;

  try {
    const response = await fetch('/admin/orders/update-status', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ orderId, status })
    });

    const data = await response.json();

    if (data.success) {
      showNotificationModal('Success!', 'Order status updated successfully', true);
      closeUpdateModal();
      setTimeout(() => {
        closeNotificationModal();
        location.reload();
      }, 1500);
    } else {
      showNotificationModal('Error', 'Failed to update order status', false);
    }
  } catch (error) {
    console.error('Error updating status:', error);
    showNotificationModal('Error', 'An error occurred. Please try again.', false);
  }
}

// Helper function to format status
function formatStatus(status) {
  const statusMap = {
    'pending': 'Pending',
    'processing': 'Processing',
    'shipped': 'Shipped',
    'out-for-delivery': 'Out for Delivery',
    'delivered': 'Delivered',
    'cancelled': 'Cancelled',
    'return-requested': 'Return Requested',
    'returned': 'Returned'
  };
  return statusMap[status] || status;
}

// Close modals on escape key
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape') {
    closeOrderDetailsModal();
    closeUpdateModal();
    closeNotificationModal();
  }
});
</script>

