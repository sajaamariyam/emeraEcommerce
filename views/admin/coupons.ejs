<%- include("../partials/admin/header") %>

<!-- Flash data from server for toast on page load -->
<div id="flash-data"
    data-message="<%= typeof flash !== 'undefined' && flash.message ? flash.message : '' %>"
    data-type="<%= typeof flash !== 'undefined' && flash.type ? flash.type : 'success' %>"
    class="hidden"></div>

<style>
#toast-container { transition: transform 0.3s cubic-bezier(0.16,1,0.3,1); }
</style>

<div class="ml-52 h-screen overflow-y-auto bg-gray-50">

    <!-- Top Navigation Bar -->
    <div class="bg-white border-b sticky top-0 z-10">
        <div class="px-8 py-4 max-w-7xl mx-auto flex justify-between items-center">
            <h1 class="text-xl font-semibold text-teal-700">Coupon Management</h1>
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-teal-600 rounded-full flex items-center justify-center text-white text-sm font-medium">
                    <%= admin.name.charAt(0) %>
                </div>
                <span class="text-sm text-gray-700"><%= admin.name %></span>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="p-8 max-w-7xl mx-auto">

        <div class="flex items-center justify-between mb-8">
            <div>
                <h2 class="text-2xl font-bold text-gray-800">Coupons</h2>
                <p class="text-gray-600 mt-1">Create and manage discount coupons.</p>
            </div>
            <button onclick="openCreateModal()" class="bg-teal-700 text-white px-6 py-3 rounded-lg hover:bg-teal-800 transition flex items-center gap-2 font-medium shadow-md">
                <i class="fas fa-plus"></i> Create Coupon
            </button>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-5 mb-8">
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-teal-50 rounded-full flex items-center justify-center">
                    <i class="fas fa-ticket-alt text-teal-600 text-lg"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500 font-medium">Total Coupons</p>
                    <p class="text-2xl font-bold text-gray-800"><%= totalCoupons %></p>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-green-50 rounded-full flex items-center justify-center">
                    <i class="fas fa-check-circle text-green-600 text-lg"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500 font-medium">Active</p>
                    <p class="text-2xl font-bold text-gray-800"><%= activeCoupons %></p>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-blue-50 rounded-full flex items-center justify-center">
                    <i class="fas fa-check text-blue-600 text-lg"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500 font-medium">Used</p>
                    <p class="text-2xl font-bold text-gray-800"><%= usedCoupons %></p>
                </div>
            </div>
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-5 flex items-center gap-4">
                <div class="w-12 h-12 bg-red-50 rounded-full flex items-center justify-center">
                    <i class="fas fa-times-circle text-red-500 text-lg"></i>
                </div>
                <div>
                    <p class="text-sm text-gray-500 font-medium">Expired</p>
                    <p class="text-2xl font-bold text-gray-800"><%= expiredCoupons %></p>
                </div>
            </div>
        </div>

        <!-- Search -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 mb-6">
            <form method="GET" action="/admin/coupons" class="flex gap-3">
                <input type="text" name="search" value="<%= search %>" placeholder="Search coupon code..."
                    class="flex-1 border border-gray-300 rounded-lg px-4 py-2 text-sm focus:ring-2 focus:ring-teal-500 outline-none">
                <button type="submit" class="bg-teal-700 text-white px-5 py-2 rounded-lg font-medium hover:bg-teal-800 transition text-sm">Search</button>
                <% if (search) { %>
                    <a href="/admin/coupons" class="border border-gray-300 text-gray-600 px-5 py-2 rounded-lg font-medium hover:bg-gray-50 transition text-sm">Clear</a>
                <% } %>
            </form>
        </div>

        <!-- Coupons Table -->
        <div class="bg-white rounded-lg shadow-sm overflow-hidden border border-gray-100">
            <table class="w-full text-left">
                <thead class="bg-gray-50 border-b border-gray-200">
                    <tr>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Code</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Discount</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Min. Purchase</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Expiry</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-4 text-xs font-bold text-gray-500 uppercase tracking-wider text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    <% if (coupons.length === 0) { %>
                        <tr>
                            <td colspan="6" class="px-6 py-16 text-center text-gray-400">
                                <i class="fas fa-ticket-alt text-4xl mb-3 block opacity-30"></i>
                                <p class="font-medium"><%= search ? 'No coupons match your search.' : 'No coupons found. Create your first coupon!' %></p>
                            </td>
                        </tr>
                    <% } %>
                    <% coupons.forEach(coupon => { %>
                        <%
                            const now = new Date();
                            const isExpired = coupon.expiryDate < now;
                            let statusLabel = 'Active';
                            let statusClass = 'bg-green-50 text-green-700 border-green-100';
                            if (coupon.isUsed) {
                                statusLabel = 'Used';
                                statusClass = 'bg-blue-50 text-blue-700 border-blue-100';
                            } else if (isExpired) {
                                statusLabel = 'Expired';
                                statusClass = 'bg-red-50 text-red-700 border-red-100';
                            }
                        %>
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-6 py-4">
                                <span class="font-mono font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded text-sm tracking-widest"><%= coupon.code %></span>
                            </td>
                            <td class="px-6 py-4">
                                <span class="text-lg font-bold text-teal-700">&#8377;<%= coupon.discountAmount.toLocaleString('en-IN') %></span>
                                <p class="text-xs text-gray-400 font-medium">Flat Off</p>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">
                                <% if (coupon.minPurchaseAmount && coupon.minPurchaseAmount > 0) { %>
                                    &#8377;<%= coupon.minPurchaseAmount.toLocaleString('en-IN') %>
                                <% } else { %>
                                    <span class="text-gray-400 italic">No minimum</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 text-sm text-gray-600">
                                <%= new Date(coupon.expiryDate).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                            </td>
                            <td class="px-6 py-4">
                                <span class="px-3 py-1 text-xs font-bold rounded-full border <%= statusClass %>"><%= statusLabel %></span>
                            </td>
                            <td class="px-6 py-4 text-right">
                                <button onclick="confirmDeleteCoupon('<%= coupon._id %>', '<%= coupon.code %>')"
                                    class="text-red-600 hover:text-red-800 text-sm font-bold transition">Delete</button>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <!-- ── Pagination ── -->
            <% if (totalPages > 1) { %>
                <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between flex-wrap gap-3">
                    <p class="text-sm text-gray-500">
                        Showing page <span class="font-semibold text-gray-700"><%= currentPage %></span> of
                        <span class="font-semibold text-gray-700"><%= totalPages %></span>
                        &nbsp;·&nbsp; <span class="font-semibold text-gray-700"><%= totalCoupons %></span> total coupons
                    </p>
                    <div class="flex items-center gap-1">
                        <!-- Prev -->
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %>&search=<%= search %>"
                                class="px-3 py-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-medium transition">
                                ← Prev
                            </a>
                        <% } else { %>
                            <span class="px-3 py-1.5 rounded border border-gray-200 text-gray-300 text-sm font-medium cursor-not-allowed">← Prev</span>
                        <% } %>

                        <!-- Page numbers — show max 5 around current -->
                        <%
                        const maxPages   = 5;
                        let startPage    = Math.max(1, currentPage - Math.floor(maxPages / 2));
                        let endPage      = Math.min(totalPages, startPage + maxPages - 1);
                        if (endPage - startPage < maxPages - 1) startPage = Math.max(1, endPage - maxPages + 1);
                        %>

                        <% if (startPage > 1) { %>
                            <a href="?page=1&search=<%= search %>"
                                class="px-3 py-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-medium transition">1</a>
                            <% if (startPage > 2) { %><span class="px-2 text-gray-400 text-sm">…</span><% } %>
                        <% } %>

                        <% for (let i = startPage; i <= endPage; i++) { %>
                            <a href="?page=<%= i %>&search=<%= search %>"
                                class="px-3 py-1.5 rounded text-sm font-medium transition
                                <%= currentPage === i
                                    ? 'bg-teal-700 text-white border border-teal-700'
                                    : 'border border-gray-300 text-gray-600 hover:bg-gray-50' %>">
                                <%= i %>
                            </a>
                        <% } %>

                        <% if (endPage < totalPages) { %>
                            <% if (endPage < totalPages - 1) { %><span class="px-2 text-gray-400 text-sm">…</span><% } %>
                            <a href="?page=<%= totalPages %>&search=<%= search %>"
                                class="px-3 py-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-medium transition"><%= totalPages %></a>
                        <% } %>

                        <!-- Next -->
                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>&search=<%= search %>"
                                class="px-3 py-1.5 rounded border border-gray-300 text-gray-600 hover:bg-gray-50 text-sm font-medium transition">
                                Next →
                            </a>
                        <% } else { %>
                            <span class="px-3 py-1.5 rounded border border-gray-200 text-gray-300 text-sm font-medium cursor-not-allowed">Next →</span>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- ════════════════════════════
     CREATE COUPON MODAL
════════════════════════════ -->
<div id="createCouponModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/50" onclick="closeCreateModal()"></div>
    <div class="bg-white rounded-lg shadow-xl w-full max-w-md z-50 overflow-hidden">
        <div class="px-6 py-4 border-b flex justify-between items-center bg-gray-50">
            <h3 class="text-lg font-bold text-gray-800">Create New Coupon</h3>
            <button onclick="closeCreateModal()" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
        </div>
        <div class="p-6 space-y-5">

            <!-- Coupon Code -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Coupon Code *</label>
                <input type="text" id="couponCode" placeholder="e.g. SAVE200"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 outline-none uppercase transition"
                    oninput="this.value = this.value.toUpperCase(); clearFieldErr('couponCode')">
                <p class="text-xs text-gray-400 mt-1">4–20 alphanumeric characters, no spaces</p>
                <p id="couponCode-err" class="text-xs text-red-500 mt-1 hidden"></p>
            </div>

            <!-- Discount Amount -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Discount Amount (&#8377;) *</label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-bold">&#8377;</span>
                    <input type="number" id="discountAmount" min="1" placeholder="e.g. 200"
                        class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 outline-none transition"
                        oninput="clearFieldErr('discountAmount')">
                </div>
                <p id="discountAmount-err" class="text-xs text-red-500 mt-1 hidden"></p>
            </div>

            <!-- Minimum Purchase Amount -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Minimum Purchase Amount (&#8377;) <span class="text-gray-400 font-normal">optional</span></label>
                <div class="relative">
                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 font-bold">&#8377;</span>
                    <input type="number" id="minPurchaseAmount" min="0" placeholder="e.g. 500"
                        class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 outline-none transition"
                        oninput="clearFieldErr('minPurchaseAmount')">
                </div>
                <p class="text-xs text-gray-400 mt-1">Minimum order value to apply this coupon</p>
                <p id="minPurchaseAmount-err" class="text-xs text-red-500 mt-1 hidden"></p>
            </div>

            <!-- Expiry Date -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Expiry Date *</label>
                <input type="date" id="expiryDate"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-teal-500 outline-none transition"
                    oninput="clearFieldErr('expiryDate')">
                <p class="text-xs text-gray-400 mt-1">Must be a future date</p>
                <p id="expiryDate-err" class="text-xs text-red-500 mt-1 hidden"></p>
            </div>

            <div class="flex gap-3 pt-2">
                <button onclick="submitCreateCoupon()" id="createCouponBtn"
                    class="flex-1 bg-teal-700 text-white py-3 rounded-lg font-bold hover:bg-teal-800 transition shadow-md flex items-center justify-center gap-2">
                    <i class="fas fa-plus text-sm"></i> Create Coupon
                </button>
                <button onclick="closeCreateModal()"
                    class="flex-1 border border-gray-300 text-gray-600 py-3 rounded-lg font-bold hover:bg-gray-50 transition">
                    Cancel
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════
     DELETE CONFIRM MODAL
════════════════════════════ -->
<div id="deleteCouponModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-4">
    <div class="fixed inset-0 bg-black/40" onclick="closeDeleteModal()"></div>
    <div class="bg-white rounded-lg shadow-2xl max-w-sm w-full p-6 z-[70] text-center">
        <div class="w-14 h-14 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-trash-alt text-red-500 text-xl"></i>
        </div>
        <h4 class="text-lg font-bold text-gray-900 mb-2">Delete Coupon?</h4>
        <p class="text-sm text-gray-500 mb-1">You are about to delete coupon:</p>
        <p id="deleteTargetCode" class="font-mono font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded text-sm tracking-widest inline-block mb-4"></p>
        <p class="text-sm text-gray-500 mb-6">This action cannot be undone.</p>
        <div class="flex gap-3">
            <button id="confirmDeleteBtn"
                class="flex-1 bg-red-600 text-white py-2 rounded-lg font-bold hover:bg-red-700 transition">
                Yes, Delete
            </button>
            <button onclick="closeDeleteModal()"
                class="flex-1 border border-gray-300 py-2 rounded-lg font-bold hover:bg-gray-50 transition text-gray-600">
                Cancel
            </button>
        </div>
    </div>
</div>

<script>
// ══════════════════════════════════════
// TOAST SYSTEM
// ══════════════════════════════════════
function showToast(message, type = 'success') {
    const existing = document.getElementById('toast-container');
    if (existing) existing.remove();

    const colors = { success:'bg-green-600', error:'bg-red-600', warning:'bg-yellow-500', info:'bg-blue-600' };
    const icons  = { success:'✓', error:'✕', warning:'⚠', info:'ℹ' };

    const el = document.createElement('div');
    el.id = 'toast-container';
    el.className = `fixed top-6 right-6 z-[999] flex items-center gap-3 px-5 py-4 rounded-lg shadow-xl text-white text-sm font-medium max-w-sm ${colors[type]}`;
    el.style.transform = 'translateX(120%)';
    el.style.transition = 'transform 0.3s cubic-bezier(0.16,1,0.3,1)';
    el.innerHTML = `
        <span class="w-6 h-6 rounded-full bg-white/20 flex items-center justify-center text-xs font-bold flex-shrink-0">${icons[type]}</span>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="ml-2 text-white/70 hover:text-white text-lg leading-none">&times;</button>
    `;
    document.body.appendChild(el);
    requestAnimationFrame(() => { el.style.transform = 'translateX(0)'; });
    setTimeout(() => {
        el.style.transform = 'translateX(120%)';
        setTimeout(() => el.remove(), 300);
    }, 4000);
}

// Show server flash on load
window.addEventListener('DOMContentLoaded', () => {
    const flash = document.getElementById('flash-data');
    if (flash) {
        const msg  = flash.dataset.message;
        const type = flash.dataset.type;
        if (msg) showToast(msg, type || 'success');
    }

    // Set expiry date min to today (local time, not UTC)
    setExpiryMin();
});

// ══════════════════════════════════════
// DATE HELPER — local time YYYY-MM-DD
// ══════════════════════════════════════
function getTodayStr() {
    const t = new Date();
    return `${t.getFullYear()}-${String(t.getMonth()+1).padStart(2,'0')}-${String(t.getDate()).padStart(2,'0')}`;
}

function setExpiryMin() {
    const input = document.getElementById('expiryDate');
    if (input) input.min = getTodayStr();
}

// ══════════════════════════════════════
// FIELD-LEVEL ERROR HELPERS
// ══════════════════════════════════════
function showFieldErr(id, msg) {
    const input = document.getElementById(id);
    const err   = document.getElementById(id + '-err');
    if (input) input.classList.add('border-red-400', 'ring-1', 'ring-red-400');
    if (err)   { err.textContent = msg; err.classList.remove('hidden'); }
}

function clearFieldErr(id) {
    const input = document.getElementById(id);
    const err   = document.getElementById(id + '-err');
    if (input) input.classList.remove('border-red-400', 'ring-1', 'ring-red-400');
    if (err)   err.classList.add('hidden');
}

function clearAllFieldErrs() {
    ['couponCode','discountAmount','minPurchaseAmount','expiryDate'].forEach(clearFieldErr);
}

// ══════════════════════════════════════
// CREATE MODAL
// ══════════════════════════════════════
function openCreateModal() {
    document.getElementById('createCouponModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    clearAllFieldErrs();
    setExpiryMin();
}

function closeCreateModal() {
    document.getElementById('createCouponModal').classList.add('hidden');
    document.body.style.overflow = '';
    clearAllFieldErrs();
    document.getElementById('couponCode').value        = '';
    document.getElementById('discountAmount').value    = '';
    document.getElementById('minPurchaseAmount').value = '';
    document.getElementById('expiryDate').value        = '';
}

// ══════════════════════════════════════
// SUBMIT CREATE — with full validation
// ══════════════════════════════════════
async function submitCreateCoupon() {
    const code              = document.getElementById('couponCode').value.trim();
    const discountAmount    = document.getElementById('discountAmount').value.trim();
    const minPurchaseAmount = document.getElementById('minPurchaseAmount').value.trim();
    const expiryDate        = document.getElementById('expiryDate').value;
    const btn               = document.getElementById('createCouponBtn');

    clearAllFieldErrs();
    let valid = true;

    // Validate code
    if (!code) {
        showFieldErr('couponCode', 'Coupon code is required.'); valid = false;
    } else if (!/^[A-Z0-9]{4,20}$/.test(code)) {
        showFieldErr('couponCode', 'Must be 4–20 uppercase letters/numbers, no spaces.'); valid = false;
    }

    // Validate discount
    if (!discountAmount) {
        showFieldErr('discountAmount', 'Discount amount is required.'); valid = false;
    } else if (isNaN(discountAmount) || parseFloat(discountAmount) <= 0) {
        showFieldErr('discountAmount', 'Must be a positive number.'); valid = false;
    }

    // Validate min purchase
    if (minPurchaseAmount !== '' && (isNaN(minPurchaseAmount) || parseFloat(minPurchaseAmount) < 0)) {
        showFieldErr('minPurchaseAmount', 'Cannot be negative.'); valid = false;
    }

    // Discount must be less than min purchase (if set)
    if (minPurchaseAmount && parseFloat(discountAmount) >= parseFloat(minPurchaseAmount)) {
        showFieldErr('discountAmount', 'Discount must be less than the minimum purchase amount.'); valid = false;
    }

    // Validate expiry
    const today = getTodayStr();
    if (!expiryDate) {
        showFieldErr('expiryDate', 'Expiry date is required.'); valid = false;
    } else if (expiryDate <= today) {
        showFieldErr('expiryDate', 'Expiry date must be a future date.'); valid = false;
    }

    if (!valid) return;

    // Submit
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm"></i> Creating...';

    try {
        const res  = await fetch('/admin/coupons', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                code,
                discountAmount,
                minPurchaseAmount: minPurchaseAmount || 0,
                expiryDate
            }),
        });
        const data = await res.json();

        if (data.success) {
            closeCreateModal();
            showToast(data.message || 'Coupon created successfully!', 'success');
            setTimeout(() => location.reload(), 1200);
        } else {
            // Map backend field errors to the right field
            const msg = data.message || 'Failed to create coupon.';
            if (msg.toLowerCase().includes('code')) {
                showFieldErr('couponCode', msg);
            } else if (msg.toLowerCase().includes('discount')) {
                showFieldErr('discountAmount', msg);
            } else if (msg.toLowerCase().includes('minimum') || msg.toLowerCase().includes('purchase')) {
                showFieldErr('minPurchaseAmount', msg);
            } else if (msg.toLowerCase().includes('expiry') || msg.toLowerCase().includes('date')) {
                showFieldErr('expiryDate', msg);
            } else {
                showToast(msg, 'error');
            }
        }
    } catch (e) {
        showToast('Network error. Please check your connection.', 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus text-sm"></i> Create Coupon';
    }
}

// ══════════════════════════════════════
// DELETE COUPON
// ══════════════════════════════════════
function confirmDeleteCoupon(id, code) {
    document.getElementById('deleteTargetCode').textContent = code;
    document.getElementById('deleteCouponModal').classList.remove('hidden');
    document.body.style.overflow = 'hidden';

    document.getElementById('confirmDeleteBtn').onclick = async () => {
        const btn = document.getElementById('confirmDeleteBtn');
        btn.disabled = true;
        btn.textContent = 'Deleting...';
        try {
            const res  = await fetch('/admin/coupons/' + id, { method: 'DELETE' });
            const data = await res.json();
            closeDeleteModal();
            if (data.success) {
                showToast(data.message || 'Coupon deleted successfully.', 'success');
                setTimeout(() => location.reload(), 1200);
            } else {
                showToast(data.message || 'Failed to delete coupon.', 'error');
            }
        } catch {
            closeDeleteModal();
            showToast('Network error. Please check your connection.', 'error');
        } finally {
            btn.disabled = false;
            btn.textContent = 'Yes, Delete';
        }
    };
}

function closeDeleteModal() {
    document.getElementById('deleteCouponModal').classList.add('hidden');
    document.body.style.overflow = '';
}
</script>

