<!-- Error Modal -->
<div id="error-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50" style="display: none;">
    <div class="bg-white rounded-lg p-8 max-w-md w-full mx-4 transform transition-all">
        <div class="text-center">
            <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-red-100 mb-4">
                <svg class="h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </div>
            <h3 class="text-xl font-serif text-gray-900 mb-2">Oops!</h3>
            <p id="error-message" class="text-sm text-gray-600 mb-6">Something went wrong. Please try again.</p>
            <button onclick="closeErrorModal()" class="w-full bg-emera-950 text-white py-3 text-[10px] uppercase tracking-[0.3em] font-bold rounded-sm hover:bg-emera-700 transition-all duration-300">
                Close
            </button>
