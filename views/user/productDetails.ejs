<%- include('../partials/user/header') %>

<main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-12 lg:py-20">
    <!-- Breadcrumbs -->
    <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-500 mb-12 flex items-center space-x-3">
        <a href="/" class="hover:text-emera-950 transition-colors">Home</a>
        <span class="opacity-40">/</span>
        <a href="/products?category=<%= product.category?._id %>" class="hover:text-emera-950 transition-colors">
            <%= product.category?.name || 'Products' %>
        </a>
        <span class="opacity-40">/</span>
        <span class="text-emera-950 font-bold"><%= product.name %></span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">
        <!-- Left: Gallery -->
        <div class="lg:w-3/5 flex flex-col-reverse lg:flex-row gap-6 w-full">
            <!-- Thumbnails -->
            <div id="thumb-container" class="flex lg:flex-col gap-4 overflow-x-auto lg:overflow-visible no-scrollbar pb-4 lg:pb-0">
                <% if (product.productImage && product.productImage.length > 0) { %>
                    <% product.productImage.forEach((img, index) => { %>
                        <div class="thumbnail <%= index === 0 ? 'active' : '' %> w-20 h-24 lg:w-24 lg:h-28 flex-shrink-0" onclick="changeImage(<%= index %>)">
                            <img src="<%= img.url %>" class="w-full h-full object-cover" alt="View <%= index + 1 %>">
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- Main Display with Fixed Zoom -->
            <div class="flex-1 aspect-[4/5] relative overflow-hidden shadow-md cursor-zoom-in" id="main-zoom-area">
                <img
                    id="main-img"
                    src="<%= product.productImage && product.productImage.length > 0 ? product.productImage[0].url : 'https://via.placeholder.com/800x1000?text=No+Image' %>"
                    alt="<%= product.name %>"
                    class="w-full h-full object-cover transition-transform duration-100"
                    style="transform-origin: center center;"
                />

                <div class="absolute top-6 right-6 pointer-events-none">
                    <% if (product.quantity > 0 && product.quantity < 5) { %>
                    <span class="bg-white/95 text-emera-950 text-[9px] font-bold px-5 py-2.5 uppercase tracking-widest shadow-lg rounded-sm">
                        Limited Stock
                    </span>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right: Product Information -->
        <div class="lg:w-2/5 space-y-10 animate-reveal w-full">
            <div class="space-y-6">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
                    <h1 class="text-4xl lg:text-5xl font-serif text-gray-900 leading-tight">
                        <%= product.name.split(' ').slice(0, -1).join(' ') %> <br>
                        <span class="italic font-light"><%= product.name.split(' ').slice(-1) %></span>
                    </h1>
                    
                    <div id="stock-status-pill">
                        <% if (product.quantity === 0) { %>
                            <div class="stock-pill stock-out">Sold Out</div>
                        <% } else if (product.quantity < 5) { %>
                            <div class="stock-pill stock-low">Only <%= product.quantity %> Left</div>
                        <% } else { %>
                            <div class="stock-pill stock-in">In Stock</div>
                        <% } %>
                    </div>
                </div>
                
                <!-- ===== PRICE SECTION - UPDATED FOR OFFERS ===== -->
                <div class="flex items-center justify-between border-b border-gray-200 pb-6">
                    <div class="flex flex-col">
                        <div class="flex items-center space-x-4">
                            <% if (discount > 0) { %>
                                <p class="text-3xl font-semibold text-gray-900">₹<%= Math.round(finalPrice).toLocaleString() %></p>
                                <p class="text-lg text-gray-400 line-through font-light">₹<%= product.salePrice.toLocaleString() %></p>
                                <span class="text-[10px] bg-red-600 text-white px-3 py-1.5 uppercase font-bold tracking-tight rounded-sm">
                                    Save <%= discount %>%
                                </span>
                            <% } else { %>
                                <p class="text-3xl font-semibold text-gray-900">₹<%= product.salePrice.toLocaleString() %></p>
                                <% if (product.salePrice < product.regularPrice) { %>
                                    <p class="text-lg text-gray-400 line-through font-light">₹<%= product.regularPrice.toLocaleString() %></p>
                                    <span class="text-[10px] bg-red-600 text-white px-3 py-1.5 uppercase font-bold tracking-tight rounded-sm">
                                        Save <%= Math.round((1 - product.salePrice/product.regularPrice) * 100) %>%
                                    </span>
                                <% } %>
                            <% } %>
                        </div>
                        <span class="text-[10px] text-emera-700 font-bold uppercase tracking-[0.15em] mt-3">✓ Certified Premium Product</span>
                    </div>
                    
                    <div class="text-right">
                        <div class="flex gap-0.5 justify-end mb-2">
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                        </div>
                        <p class="text-[9px] text-gray-500 uppercase tracking-widest font-semibold">5.0 Rating</p>
                    </div>
                </div>
                <!-- ===== END PRICE SECTION ===== -->
            </div>

            <!-- Offers Card -->
            <div class="bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 p-6 rounded-lg space-y-3 shadow-sm">
                <div class="flex items-center space-x-3 text-emera-950">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>
                    <span class="text-[11px] uppercase tracking-[0.25em] font-bold">Special Offer</span>
                </div>
                <p class="text-xs text-gray-700 leading-relaxed">
                    Complimentary premium care kit <span class="font-semibold text-emera-950">included with purchases</span> over ₹50,000
                </p>
            </div>

            <!-- Description -->
            <div class="space-y-4">
                <h4 class="text-[11px] uppercase tracking-widest font-bold text-gray-500">Product Description</h4>
                <p class="text-sm text-gray-700 leading-relaxed font-light">
                    <%= product.description %>
                </p>
            </div>

            <!-- Variant Colors -->
            <div class="space-y-5">
                <label class="text-[11px] uppercase tracking-widest font-bold text-gray-500 block">
                    Available Colors
                </label>
                <div class="flex gap-4">
                    <% product.variants.forEach((variant, index) => { %>
                        <button type="button" onclick="selectVariant(<%= index %>)" 
                            class="variant-btn <%= index === 0 ? 'selected' : '' %> w-12 h-12 rounded-full border-4 border-white transition-all 
                            <%= variant.quantity === 0 ? 'opacity-40 cursor-not-allowed' : 'hover:scale-110' %>" 
                            style="background-color: <%= variant.color %>" 
                            title="<%= variant.color %>">
                        </button>
                    <% }) %>
                </div>
                <p id="stock-text" class="text-xs text-gray-600 font-medium"></p>
            </div>

            <!-- Actions -->
            <div class="flex flex-col gap-5 pt-4">
                <% if (!user) { %>
                    <a href="/login" 
                        class="block text-center bg-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-sm shadow-lg hover:bg-emera-700 transition-all duration-300">
                        Add to Cart
                    </a>
                <% } else { %>
                    <button id="add-btn" onclick="addToCart('<%= product._id %>')" 
                        class="bg-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-sm shadow-lg hover:bg-emera-700 transition-all duration-100">
                        Add to Cart
                    </button>
                <% } %>
                
                <button
                onclick="buyNow('<%= product._id %>')"
                class="flex-1 border-2 border-emera-950 text-emera-950 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 rounded-sm"
                >
                Buy Now
                </button>

                <div class="flex gap-4">
                    <button onclick="addToWishlist('<%= product._id %>')" class="flex-1 border-2 border-emera-950 text-emera-950 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 rounded-sm">
                        Add to Wishlist
                    </button>
                </div>
            </div>

            <!-- Trust Badges -->
            <div class="grid grid-cols-3 gap-4 pt-6 border-t border-gray-200">
                <div class="text-center space-y-2">
                    <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Authentic</p>
                </div>
                <div class="text-center space-y-2">
                    <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Secure Pay</p>
                </div>
                <div class="text-center space-y-2">
                    <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                    <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Free Ship</p>
                </div>
            </div>

            <!-- Specifications Accordion -->
            <div class="border-t border-gray-200 pt-8">
                <details class="group" open>
                    <summary class="flex justify-between items-center cursor-pointer list-none text-[11px] uppercase tracking-[0.3em] font-bold text-gray-900 py-4">
                        <span>Product Specifications</span>
                        <span class="group-open:rotate-45 transition-transform duration-300 text-2xl font-light text-gray-400">+</span>
                    </summary>
                    <div class="pt-8 grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-10 text-xs">
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Materials</p>
                            <p class="text-gray-600">100% Full-grain Calfskin</p>
                        </div>
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Hardware</p>
                            <p class="text-gray-600">24k Gold-Finished Palladium</p>
                        </div>
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Architecture</p>
                            <p class="text-gray-600">Structured with Suede Lining</p>
                        </div>
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Origin</p>
                            <p class="text-gray-600">Handcrafted in Florence</p>
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <section class="mt-32 border-t border-gray-200 pt-24">
        <div class="flex justify-between items-end mb-16">
            <div class="space-y-3">
                <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-gray-500 block">You May Also Like</span>
                <h2 class="text-4xl font-serif text-gray-900">Related Products</h2>
            </div>
            <a href="/products" class="text-[10px] uppercase tracking-widest border-b-2 border-gray-900 pb-1 font-bold hover:text-emera-700 hover:border-emera-700 transition-colors">Browse Collection</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
            <% relatedProducts.forEach(rp => { %>
                <a href="/products/<%= rp._id %>" class="block group space-y-5">
                    <div class="aspect-[4/5] bg-stone-50 overflow-hidden relative rounded-sm shadow-sm">
                        <img src="<%= rp.productImage?.[0]?.url || '/images/placeholder.png' %>" 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                            alt="<%= rp.name %>">
                    </div>
                    <div class="space-y-2">
                        <h3 class="text-sm font-serif group-hover:text-emera-950 transition-colors"><%= rp.name %></h3>
                        <div class="flex justify-between items-center">
                            <p class="text-xs font-bold tracking-wide">₹<%= rp.salePrice.toLocaleString() %></p>
                            <span class="text-[9px] uppercase tracking-widest text-gray-500 group-hover:text-emera-950 transition-colors">View Details →</span>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    </section>
    <% } %>
</main>

<!-- Success Modal -->
<div id="success-modal" class="fixed inset-0 bg-black bg-opacity-70 hidden items-center justify-center z-50 backdrop-blur-md" style="display: none;">
    <div class="bg-white rounded-lg shadow-2xl p-0 max-w-xl w-full mx-4 transform transition-all overflow-hidden relative">
        
        <!-- Confetti Animation -->
        <div class="confetti-container absolute inset-0 pointer-events-none overflow-hidden">
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
            <div class="confetti"></div>
        </div>

        <!-- Premium Header with Animated Background -->
        <div class="relative bg-gradient-to-br from-emera-950 via-emera-800 to-emera-950 p-10 overflow-hidden">
            <!-- Animated Background Elements -->
            <div class="absolute inset-0 overflow-hidden">
                <div class="absolute top-0 right-0 w-96 h-96 bg-white opacity-5 rounded-full blur-3xl animate-float-slow"></div>
                <div class="absolute bottom-0 left-0 w-80 h-80 bg-white opacity-5 rounded-full blur-3xl animate-float-slower"></div>
                <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-amber-300 opacity-10 rounded-full blur-2xl animate-pulse-slow"></div>
            </div>

            <!-- Shimmer Effect -->
            <div class="absolute inset-0 shimmer-effect"></div>
            
            <div class="relative z-10 text-center">
                <!-- Success Icon with Ripple Effect -->
                <div class="relative mx-auto w-24 h-24 mb-6">
                    <div class="absolute inset-0 rounded-full bg-white opacity-20 animate-ping-slow"></div>
                    <div class="absolute inset-2 rounded-full bg-white opacity-30 animate-ping-slower"></div>
                    <div class="relative flex items-center justify-center h-24 w-24 rounded-full bg-white bg-opacity-20 backdrop-blur-md animate-scale-in shadow-2xl">
                        <div class="h-20 w-20 rounded-full bg-white flex items-center justify-center shadow-lg">
                            <svg class="h-12 w-12 text-emera-950 animate-check-draw" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <h3 class="text-3xl font-serif text-white mb-3 tracking-wide animate-fade-in-up" style="animation-delay: 0.2s;">
                    Successfully Added!
                </h3>
                <p class="text-white text-opacity-90 text-xs uppercase tracking-[0.4em] font-light animate-fade-in-up" style="animation-delay: 0.3s;">
                    ✦ Item secured in your collection ✦
                </p>
            </div>
        </div>

        <!-- Product Preview Card -->
        <div class="p-8 border-b border-gray-100 animate-fade-in-up" style="animation-delay: 0.4s;">
            <div class="flex items-start gap-6 group">
                <div class="relative w-28 h-32 bg-stone-100 rounded-md overflow-hidden flex-shrink-0 shadow-lg transform transition-all duration-500 group-hover:scale-105 group-hover:shadow-xl">
                    <img id="modal-product-img" src="" alt="Product" class="w-full h-full object-cover">
                    <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                </div>
                <div class="flex-1 pt-1">
                    <h4 id="modal-product-name" class="font-serif text-gray-900 text-lg mb-3 leading-snug"></h4>
                    <div class="space-y-3">
                        <div class="flex items-center gap-3">
                            <p id="modal-product-price" class="text-base font-bold text-emera-950"></p>
                            <span class="text-xs text-gray-400">•</span>
                            <span class="text-xs text-gray-500 uppercase tracking-wide">Premium Quality</span>
                        </div>
                        <div class="flex items-center gap-3 p-3 bg-gray-50 rounded-md border border-gray-100">
                            <div id="modal-product-color" class="w-5 h-5 rounded-full border-2 border-white shadow-md transform transition-transform duration-300 hover:scale-125"></div>
                            <span class="text-xs text-gray-600 uppercase tracking-wider font-medium">Selected Color</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Cart Summary with Gradient -->
        <div class="px-8 py-6 bg-gradient-to-br from-amber-50 via-orange-50 to-amber-50 border-b border-amber-200 animate-fade-in-up" style="animation-delay: 0.5s;">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-full bg-white shadow-md flex items-center justify-center transform transition-all duration-300 hover:scale-110 hover:rotate-12">
                        <svg class="w-6 h-6 text-emera-950" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs uppercase tracking-widest font-bold text-gray-500 mb-1">Your Cart</p>
                        <p id="modal-cart-count" class="text-lg font-bold text-emera-950">0 items</p>
                    </div>
                </div>
                <div class="text-right">
                    <p class="text-xs uppercase tracking-wider text-gray-500 mb-1">Status</p>
                    <div class="flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                        <span class="text-xs font-semibold text-green-700">Ready to Checkout</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Action Buttons with Enhanced Styling -->
        <div class="p-8 space-y-4 animate-fade-in-up" style="animation-delay: 0.6s;">
            <a href="/cart" class="block relative overflow-hidden group text-center bg-gradient-to-r from-emera-950 via-emera-800 to-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-md transition-all duration-500 shadow-xl hover:shadow-2xl transform hover:-translate-y-1">
                <span class="relative z-10 flex items-center justify-center gap-3">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    View Cart & Checkout
                    <svg class="w-4 h-4 transform transition-transform duration-300 group-hover:translate-x-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </span>
                <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white to-transparent opacity-0 group-hover:opacity-20 transform -skew-x-12 group-hover:translate-x-full transition-all duration-1000"></div>
            </a>
            
            <button onclick="closeModal()" class="relative w-full overflow-hidden group border-2 border-gray-300 text-gray-700 py-4 text-[10px] uppercase tracking-[0.3em] font-bold rounded-md transition-all duration-300 hover:border-emera-950 hover:text-white hover:bg-emera-950 transform hover:scale-[1.02]">
                <span class="relative z-10">Continue Shopping</span>
            </button>

            <!-- Trust Badge -->
            <div class="flex items-center justify-center gap-2 pt-4 opacity-70">
                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
                <span class="text-xs text-gray-600">Secure checkout • Free shipping over ₹50,000</span>
            </div>
        </div>
    </div>
</div>

<!-- Wishlist Modal -->
<div id="wishlist-modal" class="fixed inset-0 bg-black bg-opacity-70 hidden items-center justify-center z-50 backdrop-blur-md" style="display: none;">
    <div class="bg-white rounded-lg shadow-2xl p-0 max-w-xl w-full mx-4 transform transition-all overflow-hidden relative">
        
        <!-- Heart Animation Container -->
        <div class="heart-container absolute inset-0 pointer-events-none overflow-hidden">
            <div class="floating-heart"></div>
            <div class="floating-heart"></div>
            <div class="floating-heart"></div>
            <div class="floating-heart"></div>
            <div class="floating-heart"></div>
        </div>

        <!-- Premium Header with Animated Background -->
        <div class="relative bg-gradient-to-br from-rose-900 via-pink-800 to-rose-900 p-10 overflow-hidden">
            <!-- Animated Background Elements -->
            <div class="absolute inset-0 overflow-hidden">
                <div class="absolute top-0 right-0 w-96 h-96 bg-white opacity-5 rounded-full blur-3xl animate-float-slow"></div>
                <div class="absolute bottom-0 left-0 w-80 h-80 bg-white opacity-5 rounded-full blur-3xl animate-float-slower"></div>
                <div class="absolute top-1/2 left-1/2 w-64 h-64 bg-rose-300 opacity-10 rounded-full blur-2xl animate-pulse-slow"></div>
            </div>

            <!-- Shimmer Effect -->
            <div class="absolute inset-0 shimmer-effect"></div>
            
            <div class="relative z-10 text-center">
                <!-- Heart Icon with Ripple Effect -->
                <div class="relative mx-auto w-24 h-24 mb-6">
                    <div class="absolute inset-0 rounded-full bg-white opacity-20 animate-ping-slow"></div>
                    <div class="absolute inset-2 rounded-full bg-white opacity-30 animate-ping-slower"></div>
                    <div class="relative flex items-center justify-center h-24 w-24 rounded-full bg-white bg-opacity-20 backdrop-blur-md animate-scale-in shadow-2xl">
