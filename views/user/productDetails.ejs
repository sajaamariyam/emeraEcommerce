<script>
if (<%= !!product.isBlocked %>) location.href = "/products";

const variants = <%- JSON.stringify(product.variants) %>;
const images   = <%- JSON.stringify(product.productImage || []) %>;
let activeVariant = 0;

function stockPillHTML(qty) {
  if (qty === 0) return `<div class="stock-pill stock-out">Sold Out</div>`;
  if (qty < 5)   return `<div class="stock-pill stock-low">Only ${qty} Left</div>`;
  return               `<div class="stock-pill stock-in">In Stock</div>`;
}


function selectVariant(i) {
  if (!variants[i] || variants[i].quantity === 0) return;
  activeVariant = i;
  document.querySelectorAll('.variant-btn').forEach((b, idx) => b.classList.toggle('selected', idx === i));
  
  const qty = variants[i].quantity;
  
  document.getElementById('stock-status-pill').innerHTML = stockPillHTML(qty);
  
  if (qty > 0) {
    document.getElementById('stock-text').textContent = qty + ' piece' + (qty !== 1 ? 's' : '') + ' available';
  } else {
    document.getElementById('stock-text').textContent = '';
  }

  const btn = document.getElementById('add-btn');
  const buyBtn = document.getElementById('buy-now-btn');
  if (btn) btn.disabled = qty <= 0;
  if (buyBtn) buyBtn.disabled = qty <= 0;
}

function changeImage(i) {
  if (!images[i]) return;
  const img = document.getElementById('main-img');
  img.src = images[i].url;
  img.style.transform = 'scale(1)';
  img.style.transformOrigin = 'center center';
  zoomed = false;
  document.getElementById('main-zoom-area').classList.remove('zoomed');
  document.querySelectorAll('.thumbnail').forEach((t, idx) => t.classList.toggle('active', idx === i));
}

const zoomArea = document.getElementById('main-zoom-area');
const zoomImg  = document.getElementById('main-img');
let zoomed = false;
zoomArea?.addEventListener('click', () => {
  if (window.innerWidth < 768) return;
  zoomed = !zoomed;
  zoomArea.classList.toggle('zoomed', zoomed);
  if (!zoomed) { zoomImg.style.transform='scale(1)'; zoomImg.style.transformOrigin='center center'; }
});
zoomArea?.addEventListener('mousemove', e => {
  if (!zoomed) return;
  const r = zoomArea.getBoundingClientRect();
  zoomImg.style.transformOrigin = `${((e.clientX-r.left)/r.width)*100}% ${((e.clientY-r.top)/r.height)*100}%`;
  zoomImg.style.transform = 'scale(1.8)';
});
zoomArea?.addEventListener('mouseleave', () => {
  if (!zoomed) return;
  zoomed = false;
  zoomImg.style.transform='scale(1)'; zoomImg.style.transformOrigin='center center';
  zoomArea.classList.remove('zoomed');
});

function openLuxModal(id)  { document.getElementById(id).classList.add('open'); }
function closeLuxModal(id) { document.getElementById(id).classList.remove('open'); }
['success-modal','wishlist-modal','error-modal','review-modal'].forEach(id => {
  document.getElementById(id)?.addEventListener('click', function(e) { if (e.target===this) this.classList.remove('open'); });
});

function showSuccessModal(cartCount) {
  document.getElementById('modal-product-name').textContent  = "<%= product.name %>";
  document.getElementById('modal-product-price').textContent = "₹<%= Math.round(finalPrice || product.salePrice).toLocaleString() %>";
  document.getElementById('modal-product-img').src           = images[0]?.url || '';
  document.getElementById('modal-product-color').style.backgroundColor = variants[activeVariant]?.color || '#000';
  document.getElementById('modal-cart-count').textContent    = cartCount + ' item' + (cartCount!==1?'s':'');
  openLuxModal('success-modal');
}
function closeModal()        { closeLuxModal('success-modal'); }
function showWishlistModal(c) {
  document.getElementById('wishlist-modal-product-name').textContent  = "<%= product.name %>";
  document.getElementById('wishlist-modal-product-price').textContent = "₹<%= Math.round(finalPrice || product.salePrice).toLocaleString() %>";
  document.getElementById('wishlist-modal-product-img').src           = images[0]?.url || '';
  document.getElementById('wishlist-modal-product-color').style.backgroundColor = variants[activeVariant]?.color || '#000';
  document.getElementById('wishlist-modal-count').textContent = c + ' item' + (c!==1?'s':'');
  openLuxModal('wishlist-modal');
}
function closeWishlistModal(){ closeLuxModal('wishlist-modal'); }
function showErrorModal(msg) { document.getElementById('error-message').textContent = msg||'Something went wrong.'; openLuxModal('error-modal'); }
function closeErrorModal()   { closeLuxModal('error-modal'); }

let selectedRating = 0;
function setRating(r) {
  selectedRating = r;
  document.getElementById('rating-input').value = r;
  document.querySelectorAll('.rating-star-btn').forEach((s,i) => s.classList.toggle('lit', i<r));
}
function openReviewModal()  {
  <% if (!user) { %> window.location.href='/login'; return; <% } %>
  openLuxModal('review-modal');
}
function closeReviewModal() {
  closeLuxModal('review-modal');
  document.getElementById('review-form').reset();
  selectedRating=0;
  document.querySelectorAll('.rating-star-btn').forEach(s=>s.classList.remove('lit'));
}
document.getElementById('review-form')?.addEventListener('submit', async e => {
  e.preventDefault();
  if (!selectedRating) { alert('Please select a rating'); return; }
  const data = Object.fromEntries(new FormData(e.target));
  try {
    const res = await fetch('/reviews/submit',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
    const result = await res.json();
    if (result.success) { closeReviewModal(); location.reload(); }
    else alert(result.message||'Failed to submit review');
  } catch { alert('Failed to submit review. Please try again.'); }
});
async function markHelpful(reviewId) {
  try { const r=await fetch(`/reviews/${reviewId}/helpful`,{method:'POST'}); if(r.ok) location.reload(); } catch {}
}

function addToCart(productId) {
  fetch('/cart/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId,color:variants[activeVariant]?.color})})
  .then(r=>{if(!r.headers.get('content-type')?.includes('application/json')){location.href='/login';return;}return r.json();})
  .then(d=>{
    if(!d)return;
    if(d.code==='AUTH_REQUIRED'){location.href='/login';return;}
    if(d.success){const b=document.getElementById('cart-count-badge');if(b)b.textContent=d.cartCount;showSuccessModal(d.cartCount||1);}
    else showErrorModal(d.message||'Failed to add item to cart');
  }).catch(()=>showErrorModal('An error occurred. Please try again.'));
}
function addToWishlist(productId) {
  fetch(`/wishlist/add/${productId}`,{method:'POST',headers:{'Content-Type':'application/json'}})
  .then(r=>{if(!r.headers.get('content-type')?.includes('application/json')){location.href='/login';return;}return r.json();})
  .then(d=>{
    if(!d)return;
    if(d.code==='AUTH_REQUIRED'){location.href='/login';return;}
    if(d.success){const b=document.getElementById('wishlist-count-badge');if(b)b.textContent=d.wishlistCount;showWishlistModal(d.wishlistCount||1);}
    else showErrorModal(d.message||'Failed to add to wishlist');
  }).catch(()=>showErrorModal('An error occurred. Please try again.'));
}
function buyNow(productId) {
  fetch('/cart/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({productId,color:variants[activeVariant]?.color,buyNow:true})})
  .then(r=>{if(!r.headers.get('content-type')?.includes('application/json')){location.href='/login';return;}return r.json();})
  .then(d=>{
    if(!d)return;
    if(d.code==='AUTH_REQUIRED'){location.href='/login';return;}
    if(d.redirect)location.href=d.redirect;
    else if(!d.success)showErrorModal(d.message||'Failed to process your request');
  }).catch(()=>showErrorModal('An error occurred. Please try again.'));
}

if (variants.length) {
  const firstAvailable = variants.findIndex(v => v.quantity > 0);
  if (firstAvailable !== -1) {
    selectVariant(firstAvailable);
  } else {
    const btn = document.getElementById('add-btn');
    const buyBtn = document.getElementById('buy-now-btn');
    if (btn) btn.disabled = true;
    if (buyBtn) buyBtn.disabled = true;
    document.getElementById('stock-text').textContent = 'This product is currently unavailable';
  }
}
</script>

