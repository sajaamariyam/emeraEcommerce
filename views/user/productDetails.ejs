<%- include('../partials/user/header') %>

<main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-12 lg:py-20">
    <!-- Breadcrumbs -->
    <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-500 mb-12 flex items-center space-x-3">
        <a href="/" class="hover:text-emera-950 transition-colors">Home</a>
        <span class="opacity-40">/</span>
        <a href="/products?category=<%= product.category?._id %>" class="hover:text-emera-950 transition-colors">
            <%= product.category?.name || 'Products' %>
        </a>
        <span class="opacity-40">/</span>
        <span class="text-emera-950 font-bold"><%= product.name %></span>
    </nav>

    <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">
        <!-- Left: Gallery -->
        <div class="lg:w-3/5 flex flex-col-reverse lg:flex-row gap-6 w-full">
            <!-- Thumbnails -->
            <div id="thumb-container" class="flex lg:flex-col gap-4 overflow-x-auto lg:overflow-visible no-scrollbar pb-4 lg:pb-0">
                <% if (product.productImage && product.productImage.length > 0) { %>
                    <% product.productImage.forEach((img, index) => { %>
                        <div class="thumbnail <%= index === 0 ? 'active' : '' %> w-20 h-24 lg:w-24 lg:h-28 flex-shrink-0" onclick="changeImage(<%= index %>)">
                            <img src="<%= img.url %>" class="w-full h-full object-cover" alt="View <%= index + 1 %>">
                        </div>
                    <% }) %>
                <% } %>
            </div>

            <!-- Main Display with Fixed Zoom -->
            <div class="flex-1 aspect-[4/5] relative overflow-hidden shadow-md cursor-zoom-in" id="main-zoom-area">
                <img
                    id="main-img"
                    src="<%= product.productImage && product.productImage.length > 0 ? product.productImage[0].url : 'https://via.placeholder.com/800x1000?text=No+Image' %>"
                    alt="<%= product.name %>"
                    class="w-full h-full object-cover transition-transform duration-100"
                    style="transform-origin: center center;"
                />

                <div class="absolute top-6 right-6 pointer-events-none">
                    <% if (product.quantity > 0 && product.quantity < 5) { %>
                    <span class="bg-white/95 text-emera-950 text-[9px] font-bold px-5 py-2.5 uppercase tracking-widest shadow-lg rounded-sm">
                        Limited Stock
                    </span>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Right: Product Information -->
        <div class="lg:w-2/5 space-y-10 animate-reveal w-full">
            <div class="space-y-6">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4">
                    <h1 class="text-4xl lg:text-5xl font-serif text-gray-900 leading-tight">
                        <%= product.name.split(' ').slice(0, -1).join(' ') %> <br>
                        <span class="italic font-light"><%= product.name.split(' ').slice(-1) %></span>
                    </h1>
                    
                    <div id="stock-status-pill">
                        <% if (product.quantity === 0) { %>
                            <div class="stock-pill stock-out">Sold Out</div>
                        <% } else if (product.quantity < 5) { %>
                            <div class="stock-pill stock-low">Only <%= product.quantity %> Left</div>
                        <% } else { %>
                            <div class="stock-pill stock-in">In Stock</div>
                        <% } %>
                    </div>
                </div>
                
                <div class="flex items-center justify-between border-b border-gray-200 pb-6">
                    <div class="flex flex-col">
                        <div class="flex items-center space-x-4">
                            <p class="text-3xl font-semibold text-gray-900">₹<%= product.salePrice.toLocaleString() %></p>
                            <% if (product.salePrice < product.regularPrice) { %>
                                <p class="text-lg text-gray-400 line-through font-light">₹<%= product.regularPrice.toLocaleString() %></p>
                                <span class="text-[10px] bg-red-600 text-white px-3 py-1.5 uppercase font-bold tracking-tight rounded-sm">
                                    Save <%= Math.round((1 - product.salePrice/product.regularPrice) * 100) %>%
                                </span>
                            <% } %>
                        </div>
                        <span class="text-[10px] text-emera-700 font-bold uppercase tracking-[0.15em] mt-3">✓ Certified Premium Product</span>
                    </div>
                    
                    <div class="text-right">
                        <div class="flex gap-0.5 justify-end mb-2">
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                            <span class="star filled">★</span>
                        </div>
                        <p class="text-[9px] text-gray-500 uppercase tracking-widest font-semibold">5.0 Rating</p>
                    </div>
                </div>
            </div>

            <!-- Offers Card -->
            <div class="bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200 p-6 rounded-lg space-y-3 shadow-sm">
                <div class="flex items-center space-x-3 text-emera-950">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>
                    <span class="text-[11px] uppercase tracking-[0.25em] font-bold">Special Offer</span>
                </div>
                <p class="text-xs text-gray-700 leading-relaxed">
                    Complimentary premium care kit <span class="font-semibold text-emera-950">included with purchases</span> over ₹50,000
                </p>
            </div>

            <!-- Description -->
            <div class="space-y-4">
                <h4 class="text-[11px] uppercase tracking-widest font-bold text-gray-500">Product Description</h4>
                <p class="text-sm text-gray-700 leading-relaxed font-light">
                    <%= product.description %>
                </p>
            </div>

            <!-- Variant Colors -->
            <div class="space-y-5">
                <label class="text-[11px] uppercase tracking-widest font-bold text-gray-500 block">
                    Available Colors
                </label>
                <div class="flex gap-4">
                    <% product.variants.forEach((variant, index) => { %>
                        <button type="button" onclick="selectVariant(<%= index %>)" 
                            class="variant-btn <%= index === 0 ? 'selected' : '' %> w-12 h-12 rounded-full border-4 border-white transition-all 
                            <%= variant.quantity === 0 ? 'opacity-40 cursor-not-allowed' : 'hover:scale-110' %>" 
                            style="background-color: <%= variant.color %>" 
                            title="<%= variant.color %>">
                        </button>
                    <% }) %>
                </div>
                <p id="stock-text" class="text-xs text-gray-600 font-medium"></p>
            </div>

            <!-- Actions -->
            <div class="flex flex-col gap-5 pt-4">
                <% if (!user) { %>
                    <a href="/login" 
                        class="block text-center bg-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-sm shadow-lg hover:bg-emera-700 transition-all duration-300">
                        Add to Cart
                    </a>
                <% } else { %>
                    <button id="add-btn" onclick="addToCart('<%= product._id %>')" 
                        class="bg-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-sm shadow-lg hover:bg-emera-700 transition-all duration-100">
                        Add to Cart
                    </button>
                <% } %>
                
                <button
                onclick="buyNow('<%= product._id %>')"
                class="flex-1 border-2 border-emera-950 text-emera-950 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 rounded-sm"
                >
                Buy Now
                </button>

                <div class="flex gap-4">
                    <button class="flex-1 border-2 border-emera-950 text-emera-950 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 rounded-sm">
                        Add to Wishlist
                    </button>
                </div>
            </div>

            <!-- Trust Badges -->
            <div class="grid grid-cols-3 gap-4 pt-6 border-t border-gray-200">
                <div class="text-center space-y-2">
                    <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                    <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Authentic</p>
                </div>
                <div class="text-center space-y-2">
                    <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
                    <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Secure Pay</p>
                </div>
                <div class="text-center space-y-2">
                    <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                    <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Free Ship</p>
                </div>
            </div>

            <!-- Specifications Accordion -->
            <div class="border-t border-gray-200 pt-8">
                <details class="group" open>
                    <summary class="flex justify-between items-center cursor-pointer list-none text-[11px] uppercase tracking-[0.3em] font-bold text-gray-900 py-4">
                        <span>Product Specifications</span>
                        <span class="group-open:rotate-45 transition-transform duration-300 text-2xl font-light text-gray-400">+</span>
                    </summary>
                    <div class="pt-8 grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-10 text-xs">
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Materials</p>
                            <p class="text-gray-600">100% Full-grain Calfskin</p>
                        </div>
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Hardware</p>
                            <p class="text-gray-600">24k Gold-Finished Palladium</p>
                        </div>
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Architecture</p>
                            <p class="text-gray-600">Structured with Suede Lining</p>
                        </div>
                        <div class="border-l-2 border-emera-700 pl-5 space-y-1">
                            <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Origin</p>
                            <p class="text-gray-600">Handcrafted in Florence</p>
                        </div>
                    </div>
                </details>
            </div>
        </div>
    </div>

    <!-- Related Products -->
    <% if (relatedProducts && relatedProducts.length > 0) { %>
    <section class="mt-32 border-t border-gray-200 pt-24">
        <div class="flex justify-between items-end mb-16">
            <div class="space-y-3">
                <span class="text-[10px] uppercase tracking-[0.4em] font-bold text-gray-500 block">You May Also Like</span>
                <h2 class="text-4xl font-serif text-gray-900">Related Products</h2>
            </div>
            <a href="/products" class="text-[10px] uppercase tracking-widest border-b-2 border-gray-900 pb-1 font-bold hover:text-emera-700 hover:border-emera-700 transition-colors">Browse Collection</a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">
            <% relatedProducts.forEach(rp => { %>
                <a href="/products/<%= rp._id %>" class="block group space-y-5">
                    <div class="aspect-[4/5] bg-stone-50 overflow-hidden relative rounded-sm shadow-sm">
                        <img src="<%= rp.productImage?.[0]?.url || '/images/placeholder.png' %>" 
                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                            alt="<%= rp.name %>">
                    </div>
                    <div class="space-y-2">
                        <h3 class="text-sm font-serif group-hover:text-emera-950 transition-colors"><%= rp.name %></h3>
                        <div class="flex justify-between items-center">
                            <p class="text-xs font-bold tracking-wide">₹<%= rp.salePrice.toLocaleString() %></p>
                            <span class="text-[9px] uppercase tracking-widest text-gray-500 group-hover:text-emera-950 transition-colors">View Details →</span>
                        </div>
                    </div>
                </a>
            <% }) %>
        </div>
    </section>
    <% } %>
</main>

<script>
if (<%= !!product.isBlocked %>) location.href = "/products";

const variants = <%- JSON.stringify(product.variants) %>;
const images = <%- JSON.stringify(product.productImage || []) %>;
let activeVariant = 0;



function changeImage(i) {
  if (!images[i]) return;
  const mainImg = document.getElementById("main-img");
  mainImg.src = images[i].url;
  
  let zoomed;
  // Reset zoom when changing images
  mainImg.style.transform = "scale(1)";
  mainImg.style.transformOrigin = "center center";
  const zoomArea = document.getElementById("main-zoom-area");
  if (zoomArea) {
    zoomArea.classList.remove("cursor-zoom-out");
    zoomArea.classList.add("cursor-zoom-in");
  }
  zoomed = false;

  document.querySelectorAll(".thumbnail").forEach((t, idx) =>
    t.classList.toggle("active", idx === i)
  );
}

function selectVariant(i) {
  if (!variants[i] || variants[i].quantity === 0) return;

  activeVariant = i;

  document.querySelectorAll(".variant-btn").forEach((b, idx) =>
    b.classList.toggle("selected", idx === i)
  );

  document.getElementById("stock-text").textContent =
    variants[i].quantity + " pieces available";

  const btn = document.getElementById("add-btn");
  if (btn) btn.disabled = false;
}

// Improved Zoom Functionality
const zoomArea = document.getElementById("main-zoom-area");
const zoomImg = document.getElementById("main-img");let zoomed = false;

if (zoomArea && zoomImg) {
  zoomArea.addEventListener("click", () => {
    if (window.innerWidth < 768) return;

    zoomed = !zoomed;
    zoomArea.style.cursor = zoomed ? "zoom-out" : "zoom-in";

    if (!zoomed) {
      zoomImg.style.transform = "scale(1)";
      zoomImg.style.transformOrigin = "center center";
    }
  });

  zoomArea.addEventListener("mousemove", (e) => {
    if (!zoomed) return;

    const rect = zoomArea.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    zoomImg.style.transformOrigin = `${x}% ${y}%`;
    zoomImg.style.transform = "scale(1.8)";
  });

  zoomArea.addEventListener("mouseleave", () => {
    if (!zoomed) return;

    zoomed = false;
    zoomImg.style.transform = "scale(1)";
    zoomImg.style.transformOrigin = "center center";
    zoomArea.style.cursor = "zoom-in";
  });
}

function addToCart(productId) {
  fetch("/cart/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      productId,
      color: variants[activeVariant]?.color
    })
  })
    .then(res => {
      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        window.location.href = "/login";
        return;
      }
      return res.json();
    })
    .then(data => {
      if (!data) return;

      if (data.code === "AUTH_REQUIRED") {
        window.location.href = "/login";
        return;
      }

      if (data.success) {
        document.getElementById("cart-count-badge").textContent = data.cartCount;
      }
    });
}


function buyNow(productId) {
  fetch("/cart/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      productId,
      color: variants[activeVariant]?.color,
      buyNow: true
    })
  })
    .then(res => {
      const contentType = res.headers.get("content-type");

      if (!contentType || !contentType.includes("application/json")) {
        // backend returned HTML → redirect happened
        window.location.href = "/login";
        return;
      }

      return res.json();
    })
    .then(data => {
      if (!data) return;

      if (data.code === "AUTH_REQUIRED") {
        window.location.href = `/login`;
        return;
      }

      if (data.redirect) {
        window.location.href = data.redirect;
      }
    })
    .catch(err => {
      console.error("BUY NOW ERROR", err);
    });
}




if (variants.length) selectVariant(0);
</script>

<%- include('../partials/user/footer') %>