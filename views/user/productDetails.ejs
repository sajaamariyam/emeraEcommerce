<%- include('../partials/user/header') %>

<%
// ── Derived stock (variants take precedence over product.quantity) ──
const totalVariantStock = product.variants && product.variants.length > 0
  ? product.variants.reduce((sum, v) => sum + (v.quantity || 0), 0)
  : product.quantity || 0;
const effectiveStock = (product.variants && product.variants.length > 0)
  ? totalVariantStock
  : (product.quantity || 0);
%>

<!-- Luxury font layer — Cormorant for display headings only -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet">

<style>
/* ── Luxury additions only — no color overrides ── */
.lux-serif { font-family: 'Cormorant Garamond', Georgia, serif; }

.gold-accent-line {
  width: 40px; height: 1px;
  background: linear-gradient(90deg, transparent, #c9a96e, transparent);
  display: inline-block;
}
.gold-rule-full {
  width: 100%; height: 1px;
  background: linear-gradient(90deg, transparent, rgba(201,169,110,.45) 40%, rgba(201,169,110,.45) 60%, transparent);
}

/* ── Brand badge ── */
.brand-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 9px;
  letter-spacing: .42em;
  text-transform: uppercase;
  font-weight: 700;
  color: #c9a96e;
}
.brand-badge::before,
.brand-badge::after {
  content: '';
  width: 16px; height: 1px;
  background: #c9a96e;
  opacity: .7;
}

/* ── Stock pills ── */
.stock-pill {
  font-size: 9px;
  letter-spacing: .3em;
  text-transform: uppercase;
  font-weight: 700;
  padding: 5px 14px;
  border-radius: 2px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  white-space: nowrap;
}
.stock-pill::before {
  content: '';
  width: 5px; height: 5px;
  border-radius: 50%;
  flex-shrink: 0;
}
.stock-in  { background:#f0faf4; color:#1a6b3a; border:1px solid #a8d5b8; }
.stock-in::before  { background:#2ecc71; animation:pulse-dot 2s infinite; box-shadow:0 0 0 2px rgba(46,204,113,.25); }
.stock-low { background:#fff8ee; color:#92510a; border:1px solid #f0c97a; }
.stock-low::before { background:#f59e0b; }
.stock-out { background:#fdf2f2; color:#991b1b; border:1px solid #fca5a5; }
.stock-out::before { background:#ef4444; }

@keyframes pulse-dot {
  0%,100% { box-shadow:0 0 0 2px rgba(46,204,113,.25); }
  50%      { box-shadow:0 0 0 5px rgba(46,204,113,.06); }
}

/* ── Thumbnail ── */
.thumbnail {
  border: 1.5px solid transparent;
  cursor: pointer;
  overflow: hidden;
  transition: border-color .22s, transform .2s;
  flex-shrink: 0;
}
.thumbnail.active { border-color: #c9a96e; }
.thumbnail:hover:not(.active) { border-color: rgba(201,169,110,.45); transform:translateY(-2px); }

/* ── Zoom ── */
#main-zoom-area { cursor: zoom-in; }
#main-zoom-area.zoomed { cursor: zoom-out; }

/* ── Certified tag ── */
.certified-lux {
  font-size: 9px;
  letter-spacing: .18em;
  text-transform: uppercase;
  font-weight: 700;
  color: #c9a96e;
}

/* ── Stars ── */
.star { font-size: 1.2em; }
.star.filled { color: #fbbf24; }
.star.half {
  background: linear-gradient(90deg,#fbbf24 50%,#d1d5db 50%);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.star.empty { color: #d1d5db; }

/* ── Spec bar ── */
.spec-lux-bar { border-left: 2px solid #c9a96e; padding-left: 20px; }

/* ── Section eyebrow ── */
.section-eyebrow-lux {
  font-size: 9px;
  letter-spacing: .42em;
  text-transform: uppercase;
  font-weight: 700;
  color: #c9a96e;
  display: block;
  margin-bottom: 10px;
}

/* ── Rating bar ── */
.rating-bar-bg  { background:#e5e7eb; height:3px; flex:1; overflow:hidden; }
.rating-bar-fill{ background:linear-gradient(90deg,#fbbf24,#f59e0b); height:100%; transition:width .6s ease; }

/* ── Review avatar ── */
.review-avatar-lux {
  width:44px; height:44px; border-radius:50%;
  background:#fdf8f0;
  border:1px solid rgba(201,169,110,.35);
  display:flex; align-items:center; justify-content:center;
  font-family:'Cormorant Garamond',serif;
  font-size:18px; font-weight:400;
  color:#c9a96e;
  flex-shrink:0;
}

/* ── Verified badge ── */
.verified-badge {
  font-size:9px; letter-spacing:.15em; text-transform:uppercase; font-weight:700;
  background:#f0fdf4; color:#166534;
  border:1px solid #bbf7d0;
  padding:3px 10px; border-radius:1px;
}

/* ── Rating big number ── */
.rating-big-lux {
  font-family:'Cormorant Garamond',Georgia,serif;
  font-size:4.5rem; font-weight:300; color:#111827; line-height:1;
}

/* ── Related card hover ── */
.related-img-wrap { overflow:hidden; }
.related-img-wrap img { transition:transform .7s cubic-bezier(.25,.46,.45,.94); }
.group:hover .related-img-wrap img { transform:scale(1.05); }

/* ── Offers card ── */
.offers-card-lux {
  background: linear-gradient(135deg,#fffbf2 0%,#fef3c7 100%);
  border:1px solid #fbbf24;
  border-left:3px solid #c9a96e;
  padding:20px 22px;
  border-radius:4px;
}

/* ── Modal overlay ── */
.lux-modal-overlay {
  position:fixed; inset:0;
  background:rgba(0,0,0,.72);
  backdrop-filter:blur(6px);
  display:none; align-items:center; justify-content:center;
  z-index:50;
}
.lux-modal-overlay.open { display:flex; animation:fadeOverlay .3s ease; }
@keyframes fadeOverlay { from{opacity:0}to{opacity:1} }

.lux-modal-box {
  background:#fff;
  width:100%; max-width:520px;
  margin:16px;
  animation:slideUp .45s cubic-bezier(.16,1,.3,1);
  overflow:hidden;
  position:relative;
  max-height:92vh;
  overflow-y:auto;
}
@keyframes slideUp {
  from{transform:translateY(40px) scale(.97);opacity:0}
  to{transform:none;opacity:1}
}

/* Modal headers — using emera dark tone like original */
.modal-header-cart {
  background:linear-gradient(135deg,#0f0f0f 0%,#1c1a16 100%);
  padding:36px 32px;
  position:relative; overflow:hidden;
  text-align:center;
}
.modal-header-cart::before {
  content:'';
  position:absolute;inset:0;
  background:repeating-linear-gradient(45deg,transparent,transparent 40px,rgba(201,169,110,.04) 40px,rgba(201,169,110,.04) 80px);
}
.modal-gold-line {
  position:absolute;bottom:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,transparent,#c9a96e,transparent);
}
.modal-header-wishlist {
  background:linear-gradient(135deg,#6b1a2a 0%,#3d0f19 100%);
  padding:36px 32px;
  position:relative; overflow:hidden;
  text-align:center;
}
.modal-header-wishlist::before {
  content:'';
  position:absolute;inset:0;
  background:repeating-linear-gradient(45deg,transparent,transparent 40px,rgba(255,255,255,.03) 40px,rgba(255,255,255,.03) 80px);
}

.modal-icon-ring {
  width:68px; height:68px; border-radius:50%;
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.2);
  display:flex; align-items:center; justify-content:center;
  margin:0 auto 16px;
  animation:scaleIn .5s cubic-bezier(.34,1.56,.64,1);
}
@keyframes scaleIn{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}

/* Confetti */
.confetti-wrap{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
.c-dot{position:absolute;width:6px;height:6px;border-radius:50%;opacity:0;animation:cFall 2.5s ease-out forwards;}
.c-dot:nth-child(1){left:10%;background:#c9a96e;animation-delay:.05s}
.c-dot:nth-child(2){left:22%;background:#10b981;animation-delay:.15s}
.c-dot:nth-child(3){left:35%;background:#3b82f6;animation-delay:.1s}
.c-dot:nth-child(4){left:50%;background:#f59e0b;animation-delay:.2s}
.c-dot:nth-child(5){left:65%;background:#ec4899;animation-delay:.08s}
.c-dot:nth-child(6){left:78%;background:#8b5cf6;animation-delay:.22s}
.c-dot:nth-child(7){left:90%;background:#c9a96e;animation-delay:.12s}
@keyframes cFall{0%{top:-5%;opacity:1;transform:rotate(0)}100%{top:105%;opacity:0;transform:rotate(720deg) translateX(30px)}}

/* Floating hearts */
.heart-wrap{position:absolute;inset:0;pointer-events:none;overflow:hidden;}
.h-dot{position:absolute;bottom:-10%;opacity:0;font-size:14px;color:#f472b6;animation:hFloat 3.5s ease-out forwards;}
.h-dot:nth-child(1){left:20%;animation-delay:.1s}
.h-dot:nth-child(2){left:40%;animation-delay:.3s}
.h-dot:nth-child(3){left:60%;animation-delay:.15s}
.h-dot:nth-child(4){left:80%;animation-delay:.4s}
@keyframes hFloat{0%{bottom:-10%;opacity:1;transform:scale(.5)}50%{opacity:.8;transform:scale(1) translateX(10px)}100%{bottom:105%;opacity:0;transform:scale(.3) translateX(-15px)}}

.modal-product-row{display:flex;gap:20px;align-items:flex-start;padding:24px 28px;border-bottom:1px solid #e5e7eb;}
.modal-product-img{width:88px;height:104px;object-fit:cover;flex-shrink:0;}
.modal-cart-strip{display:flex;justify-content:space-between;align-items:center;padding:16px 28px;background:linear-gradient(135deg,#fdfaf3,#fdf3dc);border-bottom:1px solid rgba(201,169,110,.25);}
.modal-actions{padding:24px 28px;display:flex;flex-direction:column;gap:12px;}

/* Review */
.rating-star-btn{font-size:32px;color:#d1d5db;cursor:pointer;transition:color .15s,transform .15s;background:none;border:none;padding:0;}
.rating-star-btn:hover,.rating-star-btn.lit{color:#fbbf24;transform:scale(1.15);}

/* Animate reveal */
@keyframes reveal{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}
.animate-reveal{animation:reveal .7s cubic-bezier(.16,1,.3,1) .1s both;}

.no-scrollbar::-webkit-scrollbar{display:none;}
.no-scrollbar{-ms-overflow-style:none;scrollbar-width:none;}
</style>

<main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-12 lg:py-20">

  <!-- Breadcrumbs — original -->
  <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-500 mb-12 flex items-center space-x-3">
    <a href="/" class="hover:text-emera-950 transition-colors">Home</a>
    <span class="opacity-40">/</span>
    <a href="/products?category=<%= product.category?._id %>" class="hover:text-emera-950 transition-colors">
      <%= product.category?.name || 'Products' %>
    </a>
    <span class="opacity-40">/</span>
    <span class="text-emera-950 font-bold"><%= product.name %></span>
  </nav>

  <div class="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start">

    <!-- LEFT: Gallery — original structure -->
    <div class="lg:w-3/5 flex flex-col-reverse lg:flex-row gap-6 w-full">
      <div id="thumb-container" class="flex lg:flex-col gap-4 overflow-x-auto lg:overflow-visible no-scrollbar pb-4 lg:pb-0">
        <% if (product.productImage && product.productImage.length > 0) { %>
          <% product.productImage.forEach((img, index) => { %>
            <div class="thumbnail <%= index === 0 ? 'active' : '' %> w-20 h-24 lg:w-24 lg:h-28 flex-shrink-0" onclick="changeImage(<%= index %>)">
              <img src="<%= img.url %>" class="w-full h-full object-cover" alt="View <%= index + 1 %>">
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="flex-1 aspect-[4/5] relative overflow-hidden shadow-md" id="main-zoom-area">
        <img
          id="main-img"
          src="<%= product.productImage && product.productImage.length > 0 ? product.productImage[0].url : 'https://via.placeholder.com/800x1000?text=No+Image' %>"
          alt="<%= product.name %>"
          class="w-full h-full object-cover transition-transform duration-100"
          style="transform-origin:center center;"
        />
        <div class="absolute top-6 right-6 pointer-events-none">
          <% if (effectiveStock > 0 && effectiveStock < 5) { %>
            <span class="bg-white/95 text-emera-950 text-[9px] font-bold px-5 py-2.5 uppercase tracking-widest shadow-lg rounded-sm">
              Limited Stock
            </span>
          <% } %>
        </div>
      </div>
    </div>

    <!-- RIGHT: Product Info -->
    <div class="lg:w-2/5 space-y-8 animate-reveal w-full">

      <!-- ✦ NEW: Brand + Stock pill row -->
      <div class="flex items-center justify-between">
        <% if (product.brand) { %>
          <span class="brand-badge"><%= product.brand %></span>
        <% } else { %>
          <span></span>
        <% } %>
        <div id="stock-status-pill">
          <% if (effectiveStock === 0) { %>
            <div class="stock-pill stock-out">Sold Out</div>
          <% } else if (effectiveStock < 5) { %>
            <div class="stock-pill stock-low">Only <%= effectiveStock %> Left</div>
          <% } else { %>
            <div class="stock-pill stock-in">In Stock</div>
          <% } %>
        </div>
      </div>

      <!-- Product name — lux serif applied, original size & color classes -->
      <h1 class="lux-serif text-4xl lg:text-5xl text-gray-900 leading-tight font-light">
        <%= product.name.split(' ').slice(0, -1).join(' ') %> <br>
        <em class="font-extralight"><%= product.name.split(' ').slice(-1) %></em>
      </h1>

      <!-- Gold rule divider -->
      <div class="gold-rule-full"></div>

      <!-- Price & Rating — original classes kept -->
      <div class="flex items-center justify-between border-b border-gray-200 pb-6">
        <div class="flex flex-col">
          <div class="flex items-center space-x-4 flex-wrap gap-y-2">
            <% if (discount > 0) { %>
              <p class="text-3xl font-semibold text-gray-900">₹<%= Math.round(finalPrice).toLocaleString() %></p>
              <p class="text-lg text-gray-400 line-through font-light">₹<%= product.salePrice.toLocaleString() %></p>
              <span class="text-[10px] bg-red-600 text-white px-3 py-1.5 uppercase font-bold tracking-tight rounded-sm">Save <%= discount %>%</span>
            <% } else { %>
              <p class="text-3xl font-semibold text-gray-900">₹<%= product.salePrice.toLocaleString() %></p>
              <% if (product.salePrice < product.regularPrice) { %>
                <p class="text-lg text-gray-400 line-through font-light">₹<%= product.regularPrice.toLocaleString() %></p>
                <span class="text-[10px] bg-red-600 text-white px-3 py-1.5 uppercase font-bold tracking-tight rounded-sm">Save <%= Math.round((1 - product.salePrice/product.regularPrice)*100) %>%</span>
              <% } %>
            <% } %>
          </div>
          <span class="certified-lux mt-2">✦ Certified Premium Product</span>
        </div>

        <div class="text-right">
          <div class="flex gap-0.5 justify-end mb-2">
            <%
            const avgRating   = product.averageRating || 0;
            const fullStars   = Math.floor(avgRating);
            const hasHalfStar = avgRating % 1 >= 0.5;
            const emptyStars  = 5 - fullStars - (hasHalfStar ? 1 : 0);
            %>
            <% for(let i=0;i<fullStars;i++) { %><span class="star filled">★</span><% } %>
            <% if(hasHalfStar) { %><span class="star half">★</span><% } %>
            <% for(let i=0;i<emptyStars;i++) { %><span class="star empty">★</span><% } %>
          </div>
          <p class="text-[9px] text-gray-500 uppercase tracking-widest font-semibold">
            <%= avgRating.toFixed(1) %> (<%= product.totalReviews||0 %> reviews)
          </p>
        </div>
      </div>

      <!-- Offers Card — original amber + gold-left border -->
      <div class="offers-card-lux">
        <div class="flex items-center space-x-3 text-emera-950 mb-2">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7"></path></svg>
          <span class="text-[11px] uppercase tracking-[0.25em] font-bold">Special Offer</span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed">
          Complimentary premium care kit <span class="font-semibold text-emera-950">included with purchases</span> over ₹50,000
        </p>
      </div>

      <!-- Description — original -->
      <div class="space-y-4">
        <h4 class="text-[11px] uppercase tracking-widest font-bold text-gray-500">Product Description</h4>
        <p class="text-sm text-gray-700 leading-relaxed font-light"><%= product.description %></p>
      </div>

      <!-- Variant Colors — original -->
      <div class="space-y-5">
        <label class="text-[11px] uppercase tracking-widest font-bold text-gray-500 block">Available Colors</label>
        <div class="flex gap-4 flex-wrap">
          <% product.variants.forEach((variant, index) => { %>
            <button type="button" onclick="selectVariant(<%= index %>)"
              class="variant-btn <%= index === 0 ? 'selected' : '' %> w-12 h-12 rounded-full border-4 border-white transition-all
              <%= variant.quantity === 0 ? 'opacity-40 cursor-not-allowed' : 'hover:scale-110' %>"
              style="background-color:<%= variant.color %>"
              title="<%= variant.color %>"
              <%= variant.quantity === 0 ? 'disabled' : '' %>>
            </button>
          <% }) %>
        </div>
        <p id="stock-text" class="text-xs text-gray-600 font-medium"></p>
      </div>

      <!-- Actions — original emera buttons -->
      <div class="flex flex-col gap-5 pt-4">
        <% if (!user) { %>
          <a href="/login" class="block text-center bg-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-sm shadow-lg hover:bg-emera-700 transition-all duration-300">
            Add to Cart
          </a>
        <% } else { %>
          <button id="add-btn" onclick="addToCart('<%= product._id %>')"
              class="bg-emera-950 text-white w-full py-5 text-[11px] uppercase tracking-[0.4em] font-bold rounded-sm shadow-lg hover:bg-emera-700 transition-all duration-100
              disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-emera-950">
              Add to Cart
          </button>
        <% } %>
        <button id="buy-now-btn" onclick="buyNow('<%= product._id %>')"
            class="flex-1 border-2 border-emera-950 text-emera-950 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 rounded-sm
            disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-emera-950">
            Buy Now
        </button>
        <div class="flex gap-4">
          <button onclick="addToWishlist('<%= product._id %>')"
            class="flex-1 border-2 border-emera-950 text-emera-950 py-4 text-[10px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 rounded-sm">
            Add to Wishlist
          </button>
        </div>
      </div>

      <!-- Trust Badges — original -->
      <div class="grid grid-cols-3 gap-4 pt-6 border-t border-gray-200">
        <div class="text-center space-y-2">
          <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
          <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Authentic</p>
        </div>
        <div class="text-center space-y-2">
          <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path></svg>
          <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Secure Pay</p>
        </div>
        <div class="text-center space-y-2">
          <svg class="w-6 h-6 mx-auto text-emera-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
          <p class="text-[9px] uppercase tracking-wider font-semibold text-gray-600">Free Ship</p>
        </div>
      </div>

      <!-- Specifications Accordion — original structure, gold bar instead of emera bar -->
      <div class="border-t border-gray-200 pt-8">
        <details class="group" open>
          <summary class="flex justify-between items-center cursor-pointer list-none text-[11px] uppercase tracking-[0.3em] font-bold text-gray-900 py-4">
            <span>Product Specifications</span>
            <span class="group-open:rotate-45 transition-transform duration-300 text-2xl font-light text-gray-400">+</span>
          </summary>
          <div class="pt-8 grid grid-cols-1 sm:grid-cols-2 gap-y-6 gap-x-10 text-xs">
            <%
            const specs = product.specifications || new Map();
            const specEntries = specs instanceof Map ? Array.from(specs.entries()) : Object.entries(specs);
            if (specEntries.length > 0) {
              specEntries.forEach(([key, value]) => {
            %>
              <div class="spec-lux-bar space-y-1">
                <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]"><%= key %></p>
                <p class="text-gray-600"><%= value %></p>
              </div>
            <% });
            } else { %>
              <div class="spec-lux-bar space-y-1">
                <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Brand</p>
                <p class="text-gray-600"><%= product.brand %></p>
              </div>
              <div class="spec-lux-bar space-y-1">
                <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Category</p>
                <p class="text-gray-600"><%= product.category.name %></p>
              </div>
              <div class="spec-lux-bar space-y-1">
                <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Materials</p>
                <p class="text-gray-600">Premium Quality Materials</p>
              </div>
              <div class="spec-lux-bar space-y-1">
                <p class="text-gray-900 font-semibold uppercase tracking-wide text-[10px]">Quality</p>
                <p class="text-gray-600">Handcrafted Excellence</p>
              </div>
            <% } %>
          </div>
        </details>
      </div>

    </div><!-- /right -->
  </div><!-- /hero -->


  <!-- REVIEWS — original layout, lux type + colors layered -->
  <section class="mt-32 border-t border-gray-200 pt-24">
    <div class="max-w-5xl mx-auto">
      <div class="flex justify-between items-end mb-16">
        <div class="space-y-2">
          <span class="section-eyebrow-lux">Customer Feedback</span>
          <h2 class="lux-serif text-4xl font-light text-gray-900">Reviews &amp; Ratings</h2>
          <div class="gold-accent-line"></div>
        </div>
        <% if (canReview) { %>
          <button onclick="openReviewModal()" class="text-[10px] uppercase tracking-widest border-b-2 border-gray-900 pb-1 font-bold hover:text-emera-700 hover:border-emera-700 transition-colors">
            Write a Review
          </button>
        <% } %>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 mb-16">
        <div class="bg-gray-50 rounded-lg p-8 text-center border border-gray-100">
          <div class="rating-big-lux mb-3"><%= (product.averageRating||0).toFixed(1) %></div>
          <div class="flex gap-1 justify-center mb-3">
            <% for(let i=0;i<5;i++) { %>
              <span class="star <%= i < Math.round(product.averageRating||0) ? 'filled' : 'empty' %>">★</span>
            <% } %>
          </div>
          <p class="text-sm text-gray-600 font-light">Based on <%= product.totalReviews||0 %> reviews</p>
        </div>

        <div class="lg:col-span-2 flex flex-col justify-center space-y-4">
          <%
          const totalReviewCount = product.totalReviews || 0;
          for(let rating=5; rating>=1; rating--) {
            const count = ratingDistribution[rating] || 0;
            const percentage = totalReviewCount > 0 ? (count / totalReviewCount * 100).toFixed(0) : 0;
          %>
            <div class="flex items-center gap-4">
              <span class="text-sm font-medium text-gray-700 w-12"><%= rating %> ★</span>
              <div class="rating-bar-bg">
                <div class="rating-bar-fill" style="width:<%= percentage %>%"></div>
              </div>
              <span class="text-sm text-gray-600 w-16 text-right font-light"><%= count %> (<%= percentage %>%)</span>
            </div>
          <% } %>
        </div>
      </div>

      <div class="space-y-8">
        <% if (reviews && reviews.length > 0) { %>
          <% reviews.forEach(review => { %>
            <div class="border-b border-gray-200 pb-8">
              <div class="flex items-start gap-6">
                <div class="review-avatar-lux"><%= review.userId.name.charAt(0).toUpperCase() %></div>
                <div class="flex-1">
                  <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
                    <div>
                      <h4 class="font-semibold text-gray-900"><%= review.userId.name %></h4>
                      <div class="flex gap-1 mt-1">
                        <% for(let i=0;i<5;i++) { %>
                          <span class="star <%= i < review.rating ? 'filled' : 'empty' %> text-sm">★</span>
                        <% } %>
                      </div>
                    </div>
                    <% if (review.isVerifiedPurchase) { %>
                      <span class="verified-badge">✓ Verified Purchase</span>
                    <% } %>
                  </div>
                  <h5 class="font-semibold text-gray-800 mb-2"><%= review.title %></h5>
                  <p class="text-sm text-gray-600 leading-relaxed font-light mb-3"><%= review.comment %></p>
                  <div class="flex items-center gap-4 text-xs text-gray-500">
                    <span><%= new Date(review.createdAt).toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'}) %></span>
                    <button onclick="markHelpful('<%= review._id %>')" class="hover:text-emera-700 transition-colors bg-transparent border-0">
                      👍 Helpful (<%= review.helpful||0 %>)
                    </button>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div class="text-center py-16">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
            </svg>
            <p class="text-gray-500 text-sm font-light">No reviews yet. Be the first to review this product!</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>


  <!-- RELATED PRODUCTS — original layout, lux type -->
  <% if (relatedProducts && relatedProducts.length > 0) { %>
  <section class="mt-32 border-t border-gray-200 pt-24">
