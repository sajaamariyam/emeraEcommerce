<script>
if (<%= !!product.isBlocked %>) location.href = "/products";

const variants = <%- JSON.stringify(product.variants) %>;
const images = <%- JSON.stringify(product.productImage || []) %>;
let activeVariant = 0;

// Modal Functions
function showSuccessModal(cartCount) {
    const modal = document.getElementById('success-modal');
    
    // Populate product details
    const productName = "<%= product.name %>";
    const productPrice = "₹<%= Math.round(finalPrice || product.salePrice).toLocaleString() %>";
    const productImage = images[0]?.url || "";
    const selectedColor = variants[activeVariant]?.color || "#000000";
    
    document.getElementById('modal-product-name').textContent = productName;
    document.getElementById('modal-product-price').textContent = productPrice;
    document.getElementById('modal-product-img').src = productImage;
    document.getElementById('modal-product-color').style.backgroundColor = selectedColor;
    document.getElementById('modal-cart-count').textContent = cartCount + ' item' + (cartCount !== 1 ? 's' : '');
    
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('show'), 10);
}

function closeModal() {
    const modal = document.getElementById('success-modal');
    modal.style.display = 'none';
    modal.classList.remove('show');
}

function showWishlistModal(wishlistCount) {
    const modal = document.getElementById('wishlist-modal');
    
    // Populate product details
    const productName = "<%= product.name %>";
    const productPrice = "₹<%= Math.round(finalPrice).toLocaleString() %>";
    const productImage = images[0]?.url || "";
    const selectedColor = variants[activeVariant]?.color || "#000000";
    
    document.getElementById('wishlist-modal-product-name').textContent = productName;
    document.getElementById('wishlist-modal-product-price').textContent = productPrice;
    document.getElementById('wishlist-modal-product-img').src = productImage;
    document.getElementById('wishlist-modal-product-color').style.backgroundColor = selectedColor;
    document.getElementById('wishlist-modal-count').textContent = wishlistCount + ' item' + (wishlistCount !== 1 ? 's' : '');
    
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('show'), 10);
}

function closeWishlistModal() {
    const modal = document.getElementById('wishlist-modal');
    modal.style.display = 'none';
    modal.classList.remove('show');
}

function showErrorModal(message) {
    const modal = document.getElementById('error-modal');
    const messageEl = document.getElementById('error-message');
    messageEl.textContent = message || 'Something went wrong. Please try again.';
    modal.style.display = 'flex';
    setTimeout(() => modal.classList.add('show'), 10);
}

function closeErrorModal() {
    const modal = document.getElementById('error-modal');
    modal.style.display = 'none';
    modal.classList.remove('show');
}

// Close modals when clicking outside
document.getElementById('success-modal')?.addEventListener('click', function(e) {
    if (e.target === this) closeModal();
});

document.getElementById('wishlist-modal')?.addEventListener('click', function(e) {
    if (e.target === this) closeWishlistModal();
});

document.getElementById('error-modal')?.addEventListener('click', function(e) {
    if (e.target === this) closeErrorModal();
});

function changeImage(i) {
  if (!images[i]) return;
  const mainImg = document.getElementById("main-img");
  mainImg.src = images[i].url;
  
  let zoomed;
  // Reset zoom when changing images
  mainImg.style.transform = "scale(1)";
  mainImg.style.transformOrigin = "center center";
  const zoomArea = document.getElementById("main-zoom-area");
  if (zoomArea) {
    zoomArea.classList.remove("cursor-zoom-out");
    zoomArea.classList.add("cursor-zoom-in");
  }
  zoomed = false;

  document.querySelectorAll(".thumbnail").forEach((t, idx) =>
    t.classList.toggle("active", idx === i)
  );
}

function selectVariant(i) {
  if (!variants[i] || variants[i].quantity === 0) return;

  activeVariant = i;

  document.querySelectorAll(".variant-btn").forEach((b, idx) =>
    b.classList.toggle("selected", idx === i)
  );

  document.getElementById("stock-text").textContent =
    variants[i].quantity + " pieces available";

  const btn = document.getElementById("add-btn");
  if (btn) btn.disabled = false;
}

// Improved Zoom Functionality
const zoomArea = document.getElementById("main-zoom-area");
const zoomImg = document.getElementById("main-img");
let zoomed = false;

if (zoomArea && zoomImg) {
  zoomArea.addEventListener("click", () => {
    if (window.innerWidth < 768) return;

    zoomed = !zoomed;
    zoomArea.style.cursor = zoomed ? "zoom-out" : "zoom-in";

    if (!zoomed) {
      zoomImg.style.transform = "scale(1)";
      zoomImg.style.transformOrigin = "center center";
    }
  });

  zoomArea.addEventListener("mousemove", (e) => {
    if (!zoomed) return;

    const rect = zoomArea.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 100;
    const y = ((e.clientY - rect.top) / rect.height) * 100;

    zoomImg.style.transformOrigin = `${x}% ${y}%`;
    zoomImg.style.transform = "scale(1.8)";
  });

  zoomArea.addEventListener("mouseleave", () => {
    if (!zoomed) return;

    zoomed = false;
    zoomImg.style.transform = "scale(1)";
    zoomImg.style.transformOrigin = "center center";
    zoomArea.style.cursor = "zoom-in";
  });
}

function addToCart(productId) {
  fetch("/cart/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      productId,
      color: variants[activeVariant]?.color
    })
  })
    .then(res => {
      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        window.location.href = "/login";
        return;
      }
      return res.json();
    })
    .then(data => {
      if (!data) return;

      if (data.code === "AUTH_REQUIRED") {
        window.location.href = "/login";
        return;
      }

      if (data.success) {
        const cartBadge = document.getElementById("cart-count-badge");
        if (cartBadge) {
          cartBadge.textContent = data.cartCount;
        }
        showSuccessModal(data.cartCount || 1);
      } else {
        showErrorModal(data.message || 'Failed to add item to cart');
      }
    })
    .catch(err => {
      console.error("ADD TO CART ERROR", err);
      showErrorModal('An error occurred. Please try again.');
    });
}

function addToWishlist(productId) {
  fetch(`/wishlist/add/${productId}`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
  })
    .then(res => {
      const contentType = res.headers.get("content-type");
      if (!contentType || !contentType.includes("application/json")) {
        window.location.href = "/login";
        return;
      }
      return res.json();
    })
    .then(data => {
      if (!data) return;

      if (data.code === "AUTH_REQUIRED") {
        window.location.href = "/login";
        return;
      }

      if (data.success) {
        const wishlistBadge = document.getElementById("wishlist-count-badge");
        if (wishlistBadge) {
          wishlistBadge.textContent = data.wishlistCount;
        }
        showWishlistModal(data.wishlistCount || 1);
      } else {
        showErrorModal(data.message || 'Failed to add item to wishlist');
      }
    })
    .catch(err => {
      console.error("ADD TO WISHLIST ERROR", err);
      showErrorModal('An error occurred. Please try again.');
    });
}

function buyNow(productId) {
  fetch("/cart/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      productId,
      color: variants[activeVariant]?.color,
      buyNow: true
    })
  })
    .then(res => {
      const contentType = res.headers.get("content-type");

      if (!contentType || !contentType.includes("application/json")) {
        window.location.href = "/login";
        return;
      }

      return res.json();
    })
    .then(data => {
      if (!data) return;

      if (data.code === "AUTH_REQUIRED") {
        window.location.href = `/login`;
        return;
      }

      if (data.redirect) {
        window.location.href = data.redirect;
      } else if (!data.success) {
        showErrorModal(data.message || 'Failed to process your request');
      }
    })
    .catch(err => {
      console.error("BUY NOW ERROR", err);
      showErrorModal('An error occurred. Please try again.');
    });
}

if (variants.length) selectVariant(0);
</script>

<style>
/* Modal Base Animations */
#success-modal, #wishlist-modal {
    transition: all 0.3s ease-in-out;
}

#success-modal.show, #wishlist-modal.show {
    animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

#success-modal.show > div, #wishlist-modal.show > div {
    animation: modalSlideUp 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

#error-modal.show {
    animation: fadeIn 0.3s ease-in-out;
}

/* Fade and Slide Animations */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes modalSlideUp {
    from { transform: translateY(50px) scale(0.95); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
}

@keyframes fade-in-up {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.animate-fade-in-up {
    animation: fade-in-up 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@keyframes scale-in {
    0% { transform: scale(0); opacity: 0; }
    50% { transform: scale(1.1); }
    100% { transform: scale(1); opacity: 1; }
}

.animate-scale-in { animation: scale-in 0.6s cubic-bezier(0.34, 1.56, 0.64, 1); }

@keyframes check-draw {
    0% { stroke-dasharray: 0, 100; opacity: 0; }
    50% { opacity: 1; }
    100% { stroke-dasharray: 100, 0; opacity: 1; }
}

.animate-check-draw {
    stroke-dasharray: 100;
    animation: check-draw 0.8s cubic-bezier(0.65, 0, 0.35, 1) 0.4s forwards;
}

@keyframes heart-beat {
    0%, 100% { transform: scale(1); }
    10%, 30% { transform: scale(0.9); }
    20%, 40%, 60%, 80% { transform: scale(1.1); }
    50%, 70% { transform: scale(1.05); }
}

.animate-heart-beat { animation: heart-beat 1.3s ease-in-out 0.4s forwards; }

@keyframes ping-slow {
    0% { transform: scale(1); opacity: 0.8; }
    50% { transform: scale(1.3); opacity: 0.4; }
    100% { transform: scale(1.5); opacity: 0; }
}

@keyframes ping-slower {
    0% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.5); opacity: 0.3; }
    100% { transform: scale(2); opacity: 0; }
}

.animate-ping-slow { animation: ping-slow 2s cubic-bezier(0, 0, 0.2, 1) infinite; }
.animate-ping-slower { animation: ping-slower 3s cubic-bezier(0, 0, 0.2, 1) infinite; }

@keyframes float-slow {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    25% { transform: translate(10px, -10px) rotate(5deg); }
    50% { transform: translate(-5px, -20px) rotate(-5deg); }
    75% { transform: translate(-10px, -10px) rotate(3deg); }
}

@keyframes float-slower {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(-15px, 10px) scale(1.05); }
    66% { transform: translate(15px, -15px) scale(0.95); }
}

.animate-float-slow { animation: float-slow 8s ease-in-out infinite; }
.animate-float-slower { animation: float-slower 12s ease-in-out infinite; }

@keyframes pulse-slow {
    0%, 100% { opacity: 0.1; transform: scale(1); }
    50% { opacity: 0.15; transform: scale(1.1); }
}

.animate-pulse-slow { animation: pulse-slow 4s ease-in-out infinite; }

@keyframes shimmer {
    0% { background-position: -1000px 0; }
    100% { background-position: 1000px 0; }
}

.shimmer-effect {
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.1) 50%, transparent 100%);
    background-size: 1000px 100%;
    animation: shimmer 3s infinite;
}

.confetti-container { perspective: 1000px; }

.confetti {
    position: absolute;
    width: 10px;
    height: 10px;
    background: linear-gradient(135deg, #fbbf24, #f59e0b);
    opacity: 0;
    animation: confetti-fall 3s ease-out forwards;
}

.confetti:nth-child(1) { left: 10%; animation-delay: 0.1s; background: linear-gradient(135deg, #10b981, #059669); }
.confetti:nth-child(2) { left: 20%; animation-delay: 0.2s; background: linear-gradient(135deg, #3b82f6, #2563eb); }
.confetti:nth-child(3) { left: 30%; animation-delay: 0.15s; background: linear-gradient(135deg, #f59e0b, #d97706); }
.confetti:nth-child(4) { left: 40%; animation-delay: 0.25s; background: linear-gradient(135deg, #ec4899, #db2777); }
.confetti:nth-child(5) { left: 50%; animation-delay: 0.1s; background: linear-gradient(135deg, #8b5cf6, #7c3aed); }
.confetti:nth-child(6) { left: 60%; animation-delay: 0.3s; background: linear-gradient(135deg, #fbbf24, #f59e0b); }
.confetti:nth-child(7) { left: 70%; animation-delay: 0.2s; background: linear-gradient(135deg, #10b981, #059669); }
.confetti:nth-child(8) { left: 80%; animation-delay: 0.15s; background: linear-gradient(135deg, #3b82f6, #2563eb); }
.confetti:nth-child(9) { left: 90%; animation-delay: 0.25s; background: linear-gradient(135deg, #ec4899, #db2777); }
.confetti:nth-child(10) { left: 95%; animation-delay: 0.1s; background: linear-gradient(135deg, #8b5cf6, #7c3aed); }

@keyframes confetti-fall {
    0% { top: -10%; opacity: 1; transform: translateX(0) rotateZ(0deg); }
    100% { top: 100%; opacity: 0; transform: translateX(calc(-50px + 100px * var(--random, 0))) rotateZ(calc(360deg * var(--random, 1))); }
}

.heart-container { perspective: 1000px; }

.floating-heart {
    position: absolute;
    width: 20px;
    height: 20px;
    opacity: 0;
    animation: heart-float 4s ease-out forwards;
}

.floating-heart::before { content: '♥'; font-size: 20px; color: #ec4899; }
.floating-heart:nth-child(1) { left: 20%; animation-delay: 0.2s; }
.floating-heart:nth-child(2) { left: 40%; animation-delay: 0.4s; }
.floating-heart:nth-child(3) { left: 60%; animation-delay: 0.1s; }
.floating-heart:nth-child(4) { left: 80%; animation-delay: 0.6s; }
.floating-heart:nth-child(5) { left: 50%; animation-delay: 0.3s; }

@keyframes heart-float {
    0% { bottom: -10%; opacity: 1; transform: translateX(0) scale(0.5) rotate(0deg); }
    50% { opacity: 0.8; transform: translateX(20px) scale(1) rotate(180deg); }
    100% { bottom: 100%; opacity: 0; transform: translateX(-20px) scale(0.3) rotate(360deg); }
}

button, a { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
button:active, a:active { transform: scale(0.98); }
</style>

