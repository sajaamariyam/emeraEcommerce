<%- include('../partials/user/header') %>
    
    <main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20 animate-reveal">
        
        <!-- Breadcrumb & Header -->
        <div class="mb-24 space-y-6">
            <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-400">
                <a href="/" class="hover:text-black transition-colors">Home</a> / 
                <span class="text-black">My Orders</span>
            </nav>
            <h1 class="text-6xl md:text-7xl font-serif text-gray-900 leading-none">My <span class="italic font-light">Orders</span></h1>
            <p class="text-[11px] uppercase tracking-[0.3em] text-gray-400 font-bold">Track & Manage Your Purchases</p>
        </div>
        
        <!-- Search & Filter Section -->
        <div class="mb-12 bg-stone-50 p-8 border border-stone-100">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="md:col-span-2">
                    <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Search Orders</label>
                    <div class="relative">
                        <input 
                            type="text" 
                            id="searchOrders" 
                            placeholder="Search by Order ID, Product Name..."
                            class="w-full border border-stone-300 px-6 py-4 pr-12 text-sm focus:border-emera-950 transition-colors bg-white"
                        >
                        <svg class="absolute right-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </div>
                </div>
                
                <div>
                    <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Filter by Status</label>
                    <select id="statusFilter" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        <option value="">All Orders</option>
                        <option value="pending">Pending</option>
                        <option value="processing">Processing</option>
                        <option value="shipped">Shipped</option>
                        <option value="delivered">Delivered</option>
                        <option value="cancelled">Cancelled</option>
                        <option value="return-requested">Return Requested</option>
                    </select>
                </div>
            </div>
        </div>
        
        <!-- Orders List -->
        <div class="space-y-8" id="ordersList">
            <% if (orders && orders.length > 0) { %>
                <% orders.forEach(order => { %>
                    <%
                      const status = (order.status || '').toLowerCase();
                    %>
                    <div class="bg-stone-50 border border-stone-100 order-card" 
                         data-order-id="<%= order.orderId %>" 
                         data-status="<%= status %>">
                        
                        <!-- Order Header -->
                        <div class="p-8 border-b border-stone-200">
                            <div class="flex flex-wrap justify-between items-start gap-4">
                                <div>
                                    <h3 class="text-2xl font-serif text-gray-900 mb-2">Order #<%= order.orderId %></h3>
                                    <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold">
                                        Placed on <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                    </p>
                                </div>
                                <div class="text-right">
                                    <div class="inline-block px-6 py-2 rounded-full text-[9px] uppercase tracking-[0.3em] font-bold
                                        <% if (status === 'delivered') { %>bg-green-100 text-green-700
                                        <% } else if (status === 'pending') { %>bg-yellow-100 text-yellow-700
                                        <% } else if (status === 'processing') { %>bg-blue-100 text-blue-700
                                        <% } else if (status === 'shipped') { %>bg-purple-100 text-purple-700
                                        <% } else if (status === 'cancelled') { %>bg-red-100 text-red-700
                                        <% } else if (status === 'return-requested') { %>bg-orange-100 text-orange-700
                                        <% } else { %>bg-gray-100 text-gray-700<% } %>">
                                        <%= order.status %>
                                    </div>
                                    <p class="text-xl font-serif text-gray-900 mt-3">₹<%= order.finalAmount.toLocaleString('en-IN') %></p>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Order Items -->
                        <div class="p-8">
                            <div class="space-y-6">
                                <% order.orderedItems.slice(0, 2).forEach(item => { %>
                                    <%
                                      const itemStatus = (item.itemStatus || 'active').toLowerCase();
                                      const isCancelled = itemStatus === 'cancelled';
                                      const isReturned = itemStatus === 'returned';
                                      const isReturnRequested = itemStatus === 'return-requested';
                                      const isActive = itemStatus === 'active';
                                    %>
                                    <div class="flex gap-6 items-start order-item <%= isCancelled || isReturned ? 'opacity-50' : '' %>"
                                         data-product-id="<%= item.productId?._id %>"
                                         data-color="<%= item.color || '' %>">

                                        <!-- FIX: image is now a link to product details -->
                                        <a href="/product/<%= item.productId?._id %>" 
                                           class="w-20 h-20 bg-stone-200 flex-shrink-0 overflow-hidden block hover:opacity-80 transition-opacity">
                                            <img src="<%= item.productId?.productImage?.[0]?.url || '/images/placeholder.png' %>" 
                                                 alt="<%= item.productId?.name || 'Product unavailable' %>" 
                                                 class="w-full h-full object-cover">
                                        </a>

                                        <div class="flex-1 min-w-0">
                                            <!-- FIX: product name is also a link -->
                                            <a href="/product/<%= item.productId?._id %>" 
                                               class="text-sm font-semibold text-gray-900 hover:underline">
                                                <%= item.productId ? item.productId.name : 'Product no longer available' %>
                                            </a>
                                            <p class="text-[9px] uppercase tracking-widest text-gray-400 mt-1">Qty: <%= item.quantity %></p>
                                            <% if (item.color) { %>
                                                <div class="flex items-center gap-2 mt-1">
                                                    <div class="w-3 h-3 rounded-full border border-gray-200" style="background-color: <%= item.color %>"></div>
                                                    <p class="text-[9px] uppercase tracking-widest text-gray-400"><%= item.color %></p>
                                                </div>
                                            <% } %>

                                            <!-- Per-item status badge -->
                                            <% if (isCancelled) { %>
                                                <span class="inline-block mt-2 px-3 py-1 bg-red-100 text-red-600 text-[8px] uppercase tracking-widest font-bold rounded-full">Cancelled</span>
                                            <% } else if (isReturned) { %>
                                                <span class="inline-block mt-2 px-3 py-1 bg-gray-100 text-gray-500 text-[8px] uppercase tracking-widest font-bold rounded-full">Returned</span>
                                            <% } else if (isReturnRequested) { %>
                                                <span class="inline-block mt-2 px-3 py-1 bg-orange-100 text-orange-600 text-[8px] uppercase tracking-widest font-bold rounded-full">Return Requested</span>
                                            <% } %>

                                            <!-- Per-item action buttons -->
                                            <div class="flex flex-wrap gap-2 mt-3">
                                                <!-- Cancel item button: only on active items, pending/processing orders -->
                                                <% if (isActive && (status === 'pending' || status === 'processing')) { %>
                                                    <button onclick="openCancelModal('<%= order.orderId %>', 'product', '<%= item.productId?._id %>', '<%= item.color || '' %>')"
                                                            class="px-4 py-1 border border-red-400 text-red-500 text-[8px] uppercase tracking-widest font-bold hover:bg-red-500 hover:text-white transition-all">
                                                        Cancel Item
                                                    </button>
                                                <% } %>

                                                <!-- Return item button: only on active items, delivered orders -->
                                                <% if (isActive && status === 'delivered') { %>
                                                    <button onclick="openReturnProductModal('<%= order.orderId %>', '<%= item.productId?._id %>', '<%= item.color || '' %>')"
                                                            class="px-4 py-1 border border-orange-400 text-orange-500 text-[8px] uppercase tracking-widest font-bold hover:bg-orange-500 hover:text-white transition-all">
                                                        Return Item
                                                    </button>
                                                <% } %>

                                                <!-- Write review: only on active delivered items -->
                                                <% if (status === 'delivered' && isActive && item.productId) { %>
                                                    <button onclick="openReviewModal('<%= item.productId._id %>', '<%= order.orderId %>')"
                                                            class="px-4 py-1 border border-emera-950 text-emera-950 text-[8px] uppercase tracking-widest font-bold hover:bg-emera-950 hover:text-white transition-all">
                                                        Write Review
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>

                                        <div class="text-right flex-shrink-0">
                                            <p class="text-sm font-bold <%= isCancelled || isReturned ? 'line-through text-gray-400' : 'text-gray-900' %>">
                                                ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>
                                            </p>
                                        </div>
                                    </div>
                                <% }) %>
                                
                                <% if (order.orderedItems.length > 2) { %>
                                    <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold">
                                        + <%= order.orderedItems.length - 2 %> more item(s)
                                    </p>
                                <% } %>
                            </div>
                        </div>
                        
                        <!-- Order Actions -->
                        <div class="p-8 border-t border-stone-200 bg-white">
                            <div class="flex flex-wrap gap-4">
                                <a href="/orders/<%= order.orderId %>" 
                                   class="px-8 py-3 bg-emera-950 text-white text-[9px] uppercase tracking-[0.3em] font-bold hover:bg-emera-700 transition-all">
                                    View Details
                                </a>
                                
                                <!-- FIX: invoice now opens in new tab so PDF streams correctly -->
                                <a href="/orders/<%= order.orderId %>/invoice" 
                                   target="_blank"
                                   class="px-8 py-3 border-2 border-emera-950 text-emera-950 text-[9px] uppercase tracking-[0.3em] font-bold hover:bg-emera-950 hover:text-white transition-all">
                                    Download Invoice
                                </a>
                                
                                <!-- Cancel whole order -->
                                <% if (status === 'pending' || status === 'processing') { %>
                                    <button onclick="openCancelModal('<%= order.orderId %>', 'order')"
                                            class="px-8 py-3 border-2 border-red-600 text-red-600 text-[9px] uppercase tracking-[0.3em] font-bold hover:bg-red-600 hover:text-white transition-all">
                                        Cancel Order
                                    </button>
                                <% } %>
                                
                                <!-- Return whole order -->
                                <% if (status === 'delivered') { %>
                                    <button onclick="openReturnModal('<%= order.orderId %>')"
                                        class="px-8 py-3 border-2 border-orange-600 text-orange-600 text-[9px] uppercase tracking-[0.3em] font-bold hover:bg-orange-600 hover:text-white transition-all">
                                        Return Order
                                    </button>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="bg-stone-50 p-20 border border-stone-100 text-center">
                    <svg class="w-24 h-24 mx-auto mb-6 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                    </svg>
                    <h3 class="text-2xl font-serif text-gray-900 mb-4">No Orders Yet</h3>
                    <p class="text-sm text-gray-600 mb-8">You haven't placed any orders yet. Start shopping to see your orders here.</p>
                    <a href="/" class="inline-block px-12 py-4 bg-emera-950 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all">
                        Start Shopping
                    </a>
                </div>
            <% } %>
        </div>
        
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="mt-16 flex justify-center items-center gap-4">
                <% if (currentPage > 1) { %>
                    <a href="/orders?page=<%= currentPage - 1 %>" 
                       class="px-6 py-3 border-2 border-stone-300 text-gray-900 text-[9px] uppercase tracking-[0.3em] font-bold hover:border-stone-900 transition-all">
                        Previous
                    </a>
                <% } %>
                
                <div class="flex gap-2">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/orders?page=<%= i %>" 
                           class="w-12 h-12 flex items-center justify-center border-2 text-[10px] font-bold transition-all
                                  <%= currentPage === i ? 'border-emera-950 bg-emera-950 text-white' : 'border-stone-300 text-gray-900 hover:border-stone-900' %>">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
                
                <% if (currentPage < totalPages) { %>
                    <a href="/orders?page=<%= currentPage + 1 %>" 
                       class="px-6 py-3 border-2 border-stone-300 text-gray-900 text-[9px] uppercase tracking-[0.3em] font-bold hover:border-stone-900 transition-all">
                        Next
                    </a>
                <% } %>
            </div>
        <% } %>
        
    </main>

    <!-- Cancel Modal (order or item) -->
    <div id="cancelModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white max-w-2xl w-full p-10 animate-modal">
            <h2 class="text-3xl font-serif text-gray-900 mb-6" id="cancelModalTitle">Cancel Order</h2>
            <p class="text-sm text-gray-600 mb-6" id="cancelModalDesc">Are you sure you want to cancel? This action cannot be undone.</p>
            <div class="mb-8">
                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Reason for Cancellation (Optional)</label>
                <textarea id="cancelReason" rows="4" placeholder="Tell us why you're cancelling..."
                    class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors resize-none"></textarea>
            </div>
            <div class="flex gap-4">
                <button onclick="confirmCancel()" 
                        class="flex-1 py-4 bg-red-600 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-red-700 transition-all">
                    Confirm Cancellation
                </button>
                <button onclick="closeCancelModal()" 
                        class="flex-1 py-4 border-2 border-stone-300 text-gray-900 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 transition-all">
                    Keep Order
                </button>
            </div>
        </div>
    </div>

    <!-- Return Whole Order Modal -->
    <div id="returnModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white max-w-2xl w-full p-10 animate-modal">
            <h2 class="text-3xl font-serif text-gray-900 mb-6">Return Order</h2>
            <p class="text-sm text-gray-600 mb-6">Please provide a reason for returning this order.</p>
            <div class="mb-8">
                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Reason for Return *</label>
                <textarea id="returnReason" rows="4" placeholder="Please describe the reason for return..."
                    class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors resize-none"></textarea>
            </div>
            <div class="flex gap-4">
                <button onclick="confirmReturn()" 
                        class="flex-1 py-4 bg-orange-600 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-orange-700 transition-all">
                    Submit Return Request
                </button>
                <button onclick="closeReturnModal()" 
                        class="flex-1 py-4 border-2 border-stone-300 text-gray-900 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 transition-all">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- Return Single Item Modal -->
    <div id="returnProductModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white max-w-2xl w-full p-10 animate-modal">
            <h2 class="text-3xl font-serif text-gray-900 mb-6">Return Item</h2>
            <p class="text-sm text-gray-600 mb-6">Please provide a reason for returning this item.</p>
            <div class="mb-8">
                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Reason for Return *</label>
                <textarea id="returnProductReason" rows="4" placeholder="Please describe the reason for return..."
                    class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors resize-none"></textarea>
            </div>
            <div class="flex gap-4">
                <button onclick="confirmReturnProduct()" 
                        class="flex-1 py-4 bg-orange-600 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-orange-700 transition-all">
                    Submit Return Request
                </button>
                <button onclick="closeReturnProductModal()" 
                        class="flex-1 py-4 border-2 border-stone-300 text-gray-900 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 transition-all">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="successModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white max-w-md w-full p-10 text-center animate-modal">
            <div class="w-20 h-20 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-serif text-gray-900 mb-4">Success!</h3>
            <p class="text-sm text-gray-600 mb-8" id="successMessage"></p>
            <button onclick="closeSuccessModal()" 
                    class="w-full py-4 bg-emera-950 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all">
                Continue
            </button>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white max-w-md w-full p-10 text-center animate-modal">
            <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-6">
                <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </div>
            <h3 class="text-2xl font-serif text-gray-900 mb-4">Error</h3>
            <p class="text-sm text-gray-600 mb-8" id="errorMessage"></p>
            <button onclick="closeErrorModal()" 
                    class="w-full py-4 bg-emera-950 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all">
                Close
            </button>
        </div>
    </div>

    <!-- Review Modal -->
    <div id="reviewModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center p-4">
        <div class="bg-white max-w-xl w-full p-8 animate-modal">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-serif text-gray-900">Write Review</h2>
                <button onclick="closeReviewModal()" class="text-2xl text-gray-400 hover:text-black">×</button>
            </div>
            <form id="reviewForm" class="space-y-6">
                <input type="hidden" id="reviewProductId">
                <input type="hidden" id="reviewOrderId">
                <div>
                    <label class="block text-sm font-semibold mb-2">Rating</label>
                    <div class="flex gap-2">
                        <span class="star cursor-pointer text-3xl" onclick="setRating(1)">★</span>
                        <span class="star cursor-pointer text-3xl" onclick="setRating(2)">★</span>
                        <span class="star cursor-pointer text-3xl" onclick="setRating(3)">★</span>
                        <span class="star cursor-pointer text-3xl" onclick="setRating(4)">★</span>
                        <span class="star cursor-pointer text-3xl" onclick="setRating(5)">★</span>
                    </div>
                    <input type="hidden" id="reviewRating">
                </div>
                <div>
                    <input id="reviewTitle" placeholder="Review title" class="w-full border px-4 py-3">
                </div>
                <div>
                    <textarea id="reviewComment" rows="4" placeholder="Write your review..." class="w-full border px-4 py-3"></textarea>
                </div>
                <button type="submit" class="w-full bg-emera-950 text-white py-3 uppercase text-xs tracking-widest">
                    Submit Review
                </button>
            </form>
        </div>
    </div>

    <script>
        let currentOrderId = '';
        let cancelType = 'order';
        let currentProductId = '';
        let currentProductColor = '';
        let returnProductId = '';
        let returnProductColor = '';

        // ── Search / filter ───────────────────────────────────────────────

        let searchTimeout;

        document.getElementById('searchOrders').addEventListener('input', function () {
            clearTimeout(searchTimeout);

            searchTimeout = setTimeout(() => {
                const search = this.value;
                const status = document.getElementById('statusFilter').value;

                const params = new URLSearchParams();

                if (search) params.append('search', search);
                if (status) params.append('status', status);

                window.location.href = `/orders?${params.toString()}`;
            }, 500);
        });

        document.getElementById('statusFilter').addEventListener('change', function () {
            const status = this.value;
            const search = document.getElementById('searchOrders').value;

            const params = new URLSearchParams();

            if (status) params.append('status', status);
            if (search) params.append('search', search);

            window.location.href = `/orders?${params.toString()}`;
        });

        // function filterOrders() {
        //     const searchTerm = document.getElementById('searchOrders').value.toLowerCase();
        //     const selectedStatus = document.getElementById('statusFilter').value.toLowerCase();
        //     document.querySelectorAll('.order-card').forEach(card => {
        //         const orderId = card.dataset.orderId.toLowerCase();
        //         const cardStatus = card.dataset.status.toLowerCase();
        //         const productNames = Array.from(card.querySelectorAll('.order-item a'))
        //             .map(a => a.textContent.toLowerCase()).join(' ');
        //         const matchesSearch = orderId.includes(searchTerm) || productNames.includes(searchTerm);
        //         const matchesStatus = !selectedStatus || cardStatus === selectedStatus;
        //         card.style.display = matchesSearch && matchesStatus ? 'block' : 'none';
        //     });
        // }

        // ── Modal helpers ─────────────────────────────────────────────────
        function showSuccessModal(message) {
            document.getElementById('successMessage').textContent = message;
            document.getElementById('successModal').classList.replace('hidden', 'flex') || 
            document.getElementById('successModal').classList.add('flex');
            document.getElementById('successModal').classList.remove('hidden');
        }
        function closeSuccessModal() {
            document.getElementById('successModal').classList.add('hidden');
            document.getElementById('successModal').classList.remove('flex');
            window.location.reload();
        }
        function showErrorModal(message) {
            document.getElementById('errorMessage').textContent = message;
            document.getElementById('errorModal').classList.remove('hidden');
            document.getElementById('errorModal').classList.add('flex');
        }
        function closeErrorModal() {
            document.getElementById('errorModal').classList.add('hidden');
            document.getElementById('errorModal').classList.remove('flex');
        }

        // ── Cancel modal ──────────────────────────────────────────────────
        function openCancelModal(orderId, type = 'order', productId = '', color = '') {
            currentOrderId = orderId;
            cancelType = type;
            currentProductId = productId;
            currentProductColor = color;
            document.getElementById('cancelModalTitle').textContent = type === 'product' ? 'Cancel Item' : 'Cancel Order';
            document.getElementById('cancelModalDesc').textContent = type === 'product' 
                ? 'Are you sure you want to cancel this item? It will remain visible in your order.'
                : 'Are you sure you want to cancel this order? This action cannot be undone.';
            document.getElementById('cancelModal').classList.remove('hidden');
            document.getElementById('cancelModal').classList.add('flex');
        }
        function closeCancelModal() {
            document.getElementById('cancelModal').classList.add('hidden');
            document.getElementById('cancelModal').classList.remove('flex');
            document.getElementById('cancelReason').value = '';
        }
        function confirmCancel() {
            const reason = document.getElementById('cancelReason').value;
            const url = cancelType === 'product'
                ? `/orders/${currentOrderId}/cancel-product`
                : `/orders/${currentOrderId}/cancel`;
            const body = cancelType === 'product'
                ? { reason, productId: currentProductId, color: currentProductColor }
                : { reason };

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(r => r.json())
            .then(data => {
                closeCancelModal();
                if (data.success) showSuccessModal(data.message || 'Cancellation successful');
                else showErrorModal(data.message || 'Cancellation failed');
            })
            .catch(() => { closeCancelModal(); showErrorModal('An error occurred. Please try again.'); });
        }

        // ── Return whole order modal ───────────────────────────────────────
        function openReturnModal(orderId) {
            currentOrderId = orderId;
            document.getElementById('returnModal').classList.remove('hidden');
            document.getElementById('returnModal').classList.add('flex');
        }
        function closeReturnModal() {
            document.getElementById('returnModal').classList.add('hidden');
            document.getElementById('returnModal').classList.remove('flex');
            document.getElementById('returnReason').value = '';
        }
        function confirmReturn() {
            const reason = document.getElementById('returnReason').value.trim();
            if (!reason) { showErrorModal('Please provide a reason for return'); return; }

            fetch(`/orders/${currentOrderId}/return`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            })
            .then(r => r.json())
            .then(data => {
                closeReturnModal();
                if (data.success) showSuccessModal(data.message || 'Return request submitted');
                else showErrorModal(data.message || 'Return request failed');
            })
            .catch(() => { closeReturnModal(); showErrorModal('An error occurred. Please try again.'); });
        }

        // ── Return single item modal ──────────────────────────────────────
        function openReturnProductModal(orderId, productId, color) {
            currentOrderId = orderId;
            returnProductId = productId;
            returnProductColor = color;
            document.getElementById('returnProductModal').classList.remove('hidden');
            document.getElementById('returnProductModal').classList.add('flex');
        }
        function closeReturnProductModal() {
            document.getElementById('returnProductModal').classList.add('hidden');
            document.getElementById('returnProductModal').classList.remove('flex');
            document.getElementById('returnProductReason').value = '';
        }
        function confirmReturnProduct() {
            const reason = document.getElementById('returnProductReason').value.trim();
            if (!reason) { showErrorModal('Please provide a reason for return'); return; }

            fetch(`/orders/${currentOrderId}/return-product`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ productId: returnProductId, color: returnProductColor, reason })
            })
            .then(r => r.json())
            .then(data => {
                closeReturnProductModal();
                if (data.success) showSuccessModal(data.message || 'Return request submitted');
                else showErrorModal(data.message || 'Return request failed');
            })
            .catch(() => { closeReturnProductModal(); showErrorModal('An error occurred. Please try again.'); });
        }

        // ── Backdrop click to close ───────────────────────────────────────
        ['cancelModal','returnModal','returnProductModal','successModal','errorModal'].forEach(id => {
            document.getElementById(id).addEventListener('click', function(e) {
                if (e.target === this) {
                    this.classList.add('hidden');
                    this.classList.remove('flex');
                    if (id === 'successModal') window.location.reload();
                }
            });
        });

        // ── Review modal ──────────────────────────────────────────────────
        let reviewRating = 0;

        function openReviewModal(productId, orderId) {
            document.getElementById('reviewProductId').value = productId;
            document.getElementById('reviewOrderId').value = orderId;
            document.getElementById('reviewModal').classList.remove('hidden');
            document.getElementById('reviewModal').classList.add('flex');
        }
        function closeReviewModal() {
            document.getElementById('reviewModal').classList.add('hidden');
            document.getElementById('reviewModal').classList.remove('flex');
        }
        function setRating(r) {
            reviewRating = r;
            document.getElementById('reviewRating').value = r;
            document.querySelectorAll('.star').forEach((s, i) => {
                s.style.color = i < r ? '#fbbf24' : '#ccc';
            });
        }
        document.getElementById('reviewForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const data = {
                productId: document.getElementById('reviewProductId').value,
                orderId: document.getElementById('reviewOrderId').value,
                rating: reviewRating,
                title: document.getElementById('reviewTitle').value,
                comment: document.getElementById('reviewComment').value
            };
            const res = await fetch('/reviews/submit', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            const result = await res.json();
            if (result.success) location.reload();
            else alert(result.message);
        });
    </script>

    <style>
        .animate-reveal { animation: fadeIn 0.6s ease-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-modal { animation: modalSlideIn 0.3s ease-out; }
        @keyframes modalSlideIn {
            from { opacity: 0; transform: translateY(-20px) scale(0.95); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }
    </style>

