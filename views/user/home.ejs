
<%- include('../partials/user/header') %>

    <!-- Cinematic Hero Slideshow -->
   <header id="hero-video" class="relative w-full h-[95vh] overflow-hidden bg-stone-100">

    <!-- Video Background -->
    <div class="absolute inset-0 z-0">
        <video
            class="w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
        >
            <source src="/videos/hero.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <!-- Dark overlay for readability -->
        <div class="absolute inset-0 bg-black/30"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 flex flex-col justify-center items-center text-center px-6 sm:px-12 lg:px-24 h-full max-w-[1440px] mx-auto">

        <span class="text-white text-[12px] tracking-[0.6em] uppercase font-bold mb-6 animate-reveal">
            Winter Collection 2025
        </span>

        <p class="text-white/90 max-w-xl mb-12 text-lg md:text-xl font-light leading-relaxed animate-reveal">
            Handcrafted in Florence. Made for women who love quality and timeless style.
        </p>

        <a
            href="/products"
            class="group px-14 py-6 bg-white text-emera-950 text-[11px] tracking-[0.4em] uppercase font-black hover:bg-emera-950 hover:text-white transition-all duration-700 shadow-2xl animate-reveal"
        >
            Shop The Collection
        </a>

    </div>

</header>


    <!-- Aesthetic Categories Grid -->
    <section class="py-32 bg-white">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-12">
            <div class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8">
                <div class="max-w-2xl">
                    <span class="text-emera-700 text-[11px] font-black tracking-[0.5em] uppercase mb-4 block"> </span>
                    <h2 class="text-5xl md:text-6xl font-serif leading-tight">Choose <span class="italic font-light text-gray-400">Your Style</span></h2>
                </div>
             </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <% categories.slice(0,3).forEach(cat => { %>
                <a href="/products?category=<%= cat._id %>" class="group block relative">
                <div class="aspect-[4/5] overflow-hidden bg-stone-50">
                    <img 
                    src="<%= cat.image?.url %>" 
                    alt="<%= cat.name %>" 
                    class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-105"
                    >
                </div>

                <div class="mt-8 flex justify-between items-center">
                    <h3 class="text-2xl font-serif"><%= cat.name %></h3>
                    <div class="w-12 h-px bg-emera-950 group-hover:w-20 transition-all duration-500"></div>
                </div>

                <p class="text-[10px] text-gray-400 uppercase tracking-widest mt-2 font-bold">
                    Explore Collection
                </p>
                </a>
            <% }) %>
            </div>

    </section>

<!-- Featured Products Showcase -->
<section class="py-40 bg-white relative overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12">

    <!-- SECTION HEADING -->
    <div class="text-center mb-28 relative z-10">
      <span class="block text-[10px] uppercase tracking-[0.6em] text-stone-400 mb-6 font-bold">
        Atelier Selection
      </span>

      <h2 class="text-5xl md:text-6xl font-serif text-gray-900 tracking-tight mb-8 leading-tight">
        Featured Creations
      </h2>

      <p class="text-sm text-stone-500 tracking-wide max-w-2xl mx-auto leading-relaxed">
        A carefully curated expression of form, function, and timeless craftsmanship —
        designed to transcend seasons.
      </p>
    </div>

    <!-- PRODUCTS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-16 gap-y-24">

      <% if (Array.isArray(products) && products.length > 0) { %>
        <% products.forEach(p => { %>

          <a
            href="/products/<%= p._id %>"
            class="group block relative"
          >

            <!-- CARD -->
            <div
              class="relative overflow-hidden bg-stone-50 aspect-[4/5]
                     transition-all duration-[1200ms] ease-[cubic-bezier(0.2,1,0.3,1)]
                     group-hover:-translate-y-2"
            >

              <!-- IMAGE -->
              <img
                src="<%= p.productImage?.[0]?.url || '/images/placeholder.png' %>"
                alt="<%= p.name %>"
                class="w-full h-full object-cover
                       transition-transform duration-[1600ms]
                       ease-[cubic-bezier(0.2,1,0.3,1)]
                       group-hover:scale-110"
              />

              <!-- LIGHT GRADIENT OVERLAY -->
              <div
                class="absolute inset-0
                       bg-gradient-to-t from-black/10 via-transparent to-transparent
                       opacity-0 group-hover:opacity-100
                       transition-opacity duration-[1000ms]"
              ></div>

              <!-- FLOATING VIEW LABEL -->
              <div
                class="absolute bottom-6 left-1/2 -translate-x-1/2
                       text-[9px] uppercase tracking-[0.4em] font-bold
                       text-white bg-black/60 px-5 py-2
                       opacity-0 translate-y-4
                       group-hover:opacity-100 group-hover:translate-y-0
                       transition-all duration-700"
              >
                View Piece
              </div>

            </div>

            <!-- TEXT -->
            <div class="pt-8 text-center space-y-3">

              <h3
                class="text-lg font-serif text-gray-900 tracking-wide
                       transition-colors duration-500
                       group-hover:text-emera-950"
              >
                <%= p.name %>
              </h3>

              <p class="text-[10px] uppercase tracking-[0.35em] text-stone-400 font-bold">
                <%= p.material || 'Premium Leather' %>
              </p>

              <p class="text-sm font-bold tracking-wide text-gray-900">
                ₹<%= p.salePrice ? p.salePrice.toLocaleString() : '0' %>
              </p>

            </div>

          </a>

        <% }) %>
      <% } else { %>

        <p class="col-span-full text-center text-stone-400 text-sm tracking-widest uppercase">
          No creations available
        </p>

      <% } %>

    </div>
  </div>

  <!-- SUBTLE BACKGROUND ACCENT -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[1200px] h-[1200px]
                bg-emera-950/5 rounded-full blur-[160px]"></div>
  </div>
</section>


    <!-- Brand Legacy -->
<section class="relative py-48 bg-emera-950 text-white overflow-hidden">

  <div class="absolute inset-0 bg-gradient-to-b from-emera-900/40 via-transparent to-black/30"></div>

  <div class="relative max-w-5xl mx-auto px-6 text-center">
    
    <section class="relative py-48 bg-emera-950 text-white overflow-hidden">

  <div class="max-w-5xl mx-auto px-6 text-center">
    <h2 class="text-5xl md:text-8xl font-serif mb-12 leading-tight">
      Our<br/>
      <span class="italic font-light">Craftsmanship</span>
    </h2>

    <p class="text-xl md:text-2xl text-gray-300 leading-relaxed mb-16 font-light max-w-2xl mx-auto italic">
      "We create high-quality bags using traditional craftsmanship and care."
    </p>

    <div class="h-16 w-px bg-white/20 mx-auto"></div>
  </div>

</section>


  </div>

</section>




    <style>
        @keyframes reveal {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .animate-reveal { animation: reveal 1s cubic-bezier(0.22, 1, 0.36, 1) forwards; }
        
        @keyframes kenBurns {
            0% { transform: scale(1); }
            100% { transform: scale(1.15); }
        }
        .animate-ken-burns { animation: kenBurns 10s linear infinite alternate; }

        .reveal-item { transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1); transform: translateY(50px); }
        .reveal-item.active { opacity: 1; transform: translateY(0); }
    </style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const items = document.querySelectorAll('.reveal-item');

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    },
    { threshold: 0.15 }
  );

  items.forEach(item => observer.observe(item));
});
</script>



<%- include('../partials/user/footer') %>