<%- include('../partials/user/header') %>

    <!-- Valentine's Cinematic Hero -->
   <header id="hero-video" class="relative w-full h-[95vh] overflow-hidden bg-rose-50">

    <!-- Video Background -->
    <div class="absolute inset-0 z-0">
        <video
            class="w-full h-full object-cover"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
        >
            <source src="/videos/hero.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <!-- Romantic Rose Overlay -->
        <div class="absolute inset-0 bg-gradient-to-br from-rose-900/40 via-pink-800/30 to-red-900/40"></div>
        
        <!-- Floating Hearts Animation -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="heart-float" style="left: 10%; animation-delay: 0s;"></div>
            <div class="heart-float" style="left: 25%; animation-delay: 2s;"></div>
            <div class="heart-float" style="left: 40%; animation-delay: 4s;"></div>
            <div class="heart-float" style="left: 60%; animation-delay: 1s;"></div>
            <div class="heart-float" style="left: 75%; animation-delay: 3s;"></div>
            <div class="heart-float" style="left: 90%; animation-delay: 5s;"></div>
        </div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 flex flex-col justify-center items-center text-center px-6 sm:px-12 lg:px-24 h-full max-w-[1440px] mx-auto">

        <!-- Valentine's Badge -->
        <div class="mb-8 animate-reveal">
            <div class="inline-flex items-center gap-3 px-8 py-4 bg-white/10 backdrop-blur-md border border-rose-200/30 rounded-full">
                <svg class="w-5 h-5 text-rose-300 animate-pulse-slow" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
                <span class="text-white text-[11px] tracking-[0.5em] uppercase font-bold">
                    Valentine's Collection 2026
                </span>
                <svg class="w-5 h-5 text-rose-300 animate-pulse-slow" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
            </div>
        </div>

        <h1 class="text-6xl md:text-8xl font-serif text-white mb-6 leading-tight animate-reveal" style="animation-delay: 0.2s;">
            Gifts of
            <span class="italic font-light text-rose-200">Love</span>
        </h1>

        <p class="text-white/90 max-w-2xl mb-12 text-lg md:text-xl font-light leading-relaxed animate-reveal" style="animation-delay: 0.4s;">
            Celebrate love with handcrafted elegance. Each piece tells a story of timeless romance and Italian artistry.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 animate-reveal" style="animation-delay: 0.6s;">
            <a
                href="/products"
                class="group px-14 py-6 bg-gradient-to-r from-rose-600 to-pink-600 text-white text-[11px] tracking-[0.4em] uppercase font-black hover:from-rose-700 hover:to-pink-700 transition-all duration-700 shadow-2xl hover:shadow-rose-500/50"
            >
                Shop Valentine's Gifts
            </a>
            
            <a
                href="/products"
                class="group px-14 py-6 bg-white/10 backdrop-blur-md border-2 border-white/30 text-white text-[11px] tracking-[0.4em] uppercase font-black hover:bg-white hover:text-rose-900 transition-all duration-700"
            >
                Luxury Sets
            </a>
        </div>

    </div>

</header>


    <!-- Valentine's Categories Grid -->
    <section class="py-32 bg-gradient-to-b from-white via-rose-50/30 to-white relative overflow-hidden">
        
        <!-- Decorative Elements -->
        <div class="absolute top-20 right-10 w-64 h-64 bg-rose-200/20 rounded-full blur-3xl"></div>
        <div class="absolute bottom-20 left-10 w-96 h-96 bg-pink-200/20 rounded-full blur-3xl"></div>
        
        <div class="max-w-[1440px] mx-auto px-6 lg:px-12 relative z-10">
            <div class="flex flex-col md:flex-row justify-between items-end mb-24 gap-8">
                <div class="max-w-2xl">
                    <span class="text-rose-600 text-[11px] font-black tracking-[0.5em] uppercase mb-4 block flex items-center gap-2">
                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                        </svg>
                        For Every Love Story
                    </span>
                    <h2 class="text-5xl md:text-6xl font-serif leading-tight">
                        Romance in 
                        <span class="italic font-light text-rose-400">Every Detail</span>
                    </h2>
                </div>
             </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-10">
            <% categories.slice(0,3).forEach((cat, index) => { %>
                <a href="/products?category=<%= cat._id %>" class="group block relative valentine-card" style="animation-delay: <%= index * 0.15 %>s;">
                    
                    <!-- Image Container with Heart Overlay -->
                    <div class="aspect-[4/5] overflow-hidden bg-gradient-to-br from-rose-50 to-pink-50 relative">
                        <img 
                        src="<%= cat.image?.url %>" 
                        alt="<%= cat.name %>" 
                        class="w-full h-full object-cover grayscale-[20%] group-hover:grayscale-0 transition-all duration-1000 group-hover:scale-105"
                        >
                        
                        <!-- Heart Icon Overlay -->
                        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-700">
                            <div class="w-20 h-20 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center transform scale-75 group-hover:scale-100 transition-transform duration-700">
                                <svg class="w-10 h-10 text-rose-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                                </svg>
                            </div>
                        </div>
                    </div>

                    <div class="mt-8 flex justify-between items-center">
                        <h3 class="text-2xl font-serif group-hover:text-rose-600 transition-colors duration-500"><%= cat.name %></h3>
                        <div class="w-12 h-px bg-gradient-to-r from-rose-500 to-pink-500 group-hover:w-20 transition-all duration-500"></div>
                    </div>

                    <p class="text-[10px] text-rose-400 uppercase tracking-widest mt-2 font-bold">
                        Perfect Gift Ideas
                    </p>
                </a>
            <% }) %>
            </div>

    </section>

<!-- Featured Valentine's Products -->
<section class="py-40 bg-white relative overflow-hidden">
  
  <!-- Rose Petal Decorations -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute top-10 left-20 w-32 h-32 bg-rose-300/10 rounded-full blur-2xl animate-float-slow"></div>
    <div class="absolute top-40 right-32 w-40 h-40 bg-pink-300/10 rounded-full blur-2xl animate-float-slower"></div>
    <div class="absolute bottom-32 left-1/3 w-48 h-48 bg-red-300/10 rounded-full blur-3xl animate-float-slow"></div>
  </div>

  <div class="max-w-[1440px] mx-auto px-6 lg:px-12 relative z-10">

    <!-- SECTION HEADING -->
    <div class="text-center mb-28">
      <div class="flex items-center justify-center gap-3 mb-6">
        <div class="w-8 h-px bg-gradient-to-r from-transparent via-rose-400 to-transparent"></div>
        <svg class="w-5 h-5 text-rose-500 animate-pulse-slow" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
        </svg>
        <span class="block text-[10px] uppercase tracking-[0.6em] text-rose-400 font-bold">
          Valentine's Selection
        </span>
        <svg class="w-5 h-5 text-rose-500 animate-pulse-slow" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
        </svg>
        <div class="w-8 h-px bg-gradient-to-r from-transparent via-rose-400 to-transparent"></div>
      </div>

      <h2 class="text-5xl md:text-7xl font-serif text-gray-900 tracking-tight mb-8 leading-tight">
        Tokens of
        <span class="italic font-light text-rose-400"> Affection</span>
      </h2>

      <p class="text-sm text-stone-500 tracking-wide max-w-2xl mx-auto leading-relaxed">
        Handpicked pieces that speak the language of love — crafted with passion,
        destined to create cherished memories.
      </p>
    </div>

    <!-- PRODUCTS GRID -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-16 gap-y-24">

      <% if (Array.isArray(products) && products.length > 0) { %>
        <% products.forEach((p, index) => { %>

          <a
            href="/products/<%= p._id %>"
            class="group block relative product-card-valentine"
            style="animation-delay: <%= index * 0.1 %>s;"
          >

            <!-- CARD -->
            <div
              class="relative overflow-hidden bg-gradient-to-br from-rose-50 to-pink-50 aspect-[4/5]
                     transition-all duration-[1200ms] ease-[cubic-bezier(0.2,1,0.3,1)]
                     group-hover:-translate-y-3 group-hover:shadow-2xl group-hover:shadow-rose-200/50"
            >

              <!-- IMAGE -->
              <img
                src="<%= p.productImage?.[0]?.url || '/images/placeholder.png' %>"
                alt="<%= p.name %>"
                class="w-full h-full object-cover
                       transition-transform duration-[1600ms]
                       ease-[cubic-bezier(0.2,1,0.3,1)]
                       group-hover:scale-110"
              />

              <!-- Rose Gradient Overlay -->
              <div
                class="absolute inset-0
                       bg-gradient-to-t from-rose-600/20 via-transparent to-transparent
                       opacity-0 group-hover:opacity-100
                       transition-opacity duration-[1000ms]"
              ></div>

              <!-- Heart Badge (Top Right) -->
              <div class="absolute top-4 right-4 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500 transform translate-x-2 group-hover:translate-x-0">
                <svg class="w-5 h-5 text-rose-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
                </svg>
              </div>

              <!-- FLOATING VIEW LABEL -->
              <div
                class="absolute bottom-6 left-1/2 -translate-x-1/2
                       text-[9px] uppercase tracking-[0.4em] font-bold
                       text-white bg-gradient-to-r from-rose-600 to-pink-600 px-6 py-3 rounded-full
                       opacity-0 translate-y-4
                       group-hover:opacity-100 group-hover:translate-y-0
                       transition-all duration-700"
              >
                A Perfect Gift
              </div>

            </div>

            <!-- TEXT -->
            <div class="pt-8 text-center space-y-3">

              <h3
                class="text-lg font-serif text-gray-900 tracking-wide
                       transition-colors duration-500
                       group-hover:text-rose-600"
              >
                <%= p.name %>
              </h3>

              <p class="text-[10px] uppercase tracking-[0.35em] text-rose-300 font-bold">
                <%= p.material || 'Premium Leather' %>
              </p>

              <p class="text-sm font-bold tracking-wide text-gray-900">
                ₹<%= p.salePrice ? p.salePrice.toLocaleString() : '0' %>
              </p>

            </div>

          </a>

        <% }) %>
      <% } else { %>

        <p class="col-span-full text-center text-rose-300 text-sm tracking-widest uppercase">
          No creations available
        </p>

      <% } %>

    </div>
  </div>

</section>


    <!-- Valentine's Brand Message -->
<section class="relative py-48 bg-gradient-to-br from-rose-900 via-pink-900 to-red-900 text-white overflow-hidden">

  <!-- Animated Background Hearts -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none opacity-10">
    <div class="heart-large" style="top: 10%; left: 10%;"></div>
    <div class="heart-large" style="top: 60%; right: 15%;"></div>
    <div class="heart-large" style="bottom: 20%; left: 30%;"></div>
  </div>

  <div class="absolute inset-0 bg-gradient-to-b from-black/20 via-transparent to-black/30"></div>

  <div class="relative max-w-5xl mx-auto px-6 text-center z-10">
    
    <div class="mb-12">
        <svg class="w-16 h-16 mx-auto text-rose-300 animate-pulse-slow" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
        </svg>
    </div>

    <h2 class="text-5xl md:text-8xl font-serif mb-12 leading-tight">
      Crafted with
      <span class="italic font-light text-rose-200">Love</span>
    </h2>

    <p class="text-xl md:text-2xl text-rose-100 leading-relaxed mb-16 font-light max-w-3xl mx-auto italic">
