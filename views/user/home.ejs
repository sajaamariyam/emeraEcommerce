<%- include('../partials/user/header') %>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&family=Tenor+Sans&family=Jost:wght@200;300;400&display=swap');

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}

:root{
  --ink:#0e0c0a;
  --ink-soft:#1e1b17;
  --gold:#b8956a;
  --gold-light:#d4b896;
  --gold-dim:rgba(184,149,106,.18);
  --cream:#f7f4ef;
  --cream2:#ede9e2;
  --warm:#faf8f5;
  --border:#ddd8d0;
  --border-gold:rgba(184,149,106,.28);
  --muted:#7a7570;
  --dim:#a09b94;
  --serif:'Cormorant Garamond',Georgia,serif;
  --tenor:'Tenor Sans',Georgia,serif;
  --sans:'Jost',system-ui,sans-serif;
  --transition-luxury: cubic-bezier(.19,1,.22,1);
}

html{scroll-behavior:smooth}
body{
  font-family:var(--sans);
  background:var(--warm);
  color:var(--ink);
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
}

/* ── GRAIN OVERLAY ── */
body::before{
  content:'';
  position:fixed;
  inset:0;
  z-index:9998;
  pointer-events:none;
  opacity:.028;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
  background-size:200px;
}

/* ── CURSOR ── */
.c-dot{
  position:fixed;width:4px;height:4px;
  background:var(--gold);border-radius:50%;
  pointer-events:none;z-index:8000;
  transform:translate(-50%,-50%);
  mix-blend-mode:multiply;
}
.c-ring{
  position:fixed;width:30px;height:30px;
  border:1px solid rgba(184,149,106,.4);
  border-radius:50%;pointer-events:none;z-index:7999;
  transform:translate(-50%,-50%);
  transition:width .4s var(--transition-luxury),height .4s var(--transition-luxury),border-color .4s;
}
.c-ring.big{width:58px;height:58px;border-color:rgba(184,149,106,.22)}
.c-ring.click{width:20px;height:20px;border-color:var(--gold)}

/* ── LOADER ── */
#loader{
  position:fixed;inset:0;
  background:var(--ink);z-index:9999;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:0;
  transition:opacity 1s .2s,visibility 1s .2s;
}
#loader.gone{opacity:0;visibility:hidden}
.lb-wrap{display:flex;flex-direction:column;align-items:center;gap:2.2rem}
.lb{
  font-family:var(--serif);font-size:42px;
  font-weight:300;font-style:italic;
  color:rgba(247,244,239,.75);
  letter-spacing:.18em;
  animation:fadeUp 1.2s .4s both;
}
.lb-ornament{
  display:flex;align-items:center;gap:18px;
  animation:fadeUp .9s .7s both;
}
.lb-line{width:36px;height:1px;background:rgba(184,149,106,.25)}
.lb-diamond{width:4px;height:4px;background:rgba(184,149,106,.45);transform:rotate(45deg)}
.ls{
  font-size:8.5px;letter-spacing:.7em;text-transform:uppercase;
  color:rgba(247,244,239,.2);font-weight:300;
  animation:fadeUp .8s 1.1s both;
}
.loader-bar{
  position:absolute;bottom:0;left:0;height:1px;
  background:linear-gradient(to right,transparent,var(--gold),transparent);
  animation:loaderBar 1.6s .3s var(--transition-luxury) forwards;
  width:0;
}
@keyframes loaderBar{to{width:100%}}
@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}

/* ── HERO ── */
.hero{position:relative;height:100vh;min-height:620px;overflow:hidden;background:#0e0c0a}
.hero-bg{
  position:absolute;inset:0;
  background-size:cover;background-position:center;
  opacity:.5;
  animation:hzoom 22s ease-in-out infinite alternate;
}
@keyframes hzoom{from{transform:scale(1.04)}to{transform:scale(1.1)}}
.hero video{
  position:absolute;inset:0;width:100%;height:100%;
  object-fit:cover;opacity:.5;
  animation:hzoom 22s ease-in-out infinite alternate;
}
.hero-veil{
  position:absolute;inset:0;
  background:
    linear-gradient(to bottom,rgba(14,12,10,.35) 0%,rgba(14,12,10,.1) 25%,rgba(14,12,10,.1) 70%,rgba(14,12,10,.55) 100%),
    linear-gradient(to right,rgba(14,12,10,.55) 0%,rgba(14,12,10,.15) 55%,transparent 100%);
}

/* Gold top border on hero */
.hero::after{
  content:'';position:absolute;top:0;left:0;right:0;height:1px;
  background:linear-gradient(to right,transparent 0%,var(--gold) 30%,var(--gold-light) 50%,var(--gold) 70%,transparent 100%);
  z-index:4;opacity:.55;
}

.hero-body{
  position:relative;z-index:2;height:100%;
  display:flex;flex-direction:column;
  justify-content:center;
  padding:0 72px;
  padding-top:80px; /* offset for navbar height */
}
.hero-tag{
  font-family:var(--tenor);
  font-size:9px;font-weight:400;letter-spacing:.75em;
  text-transform:uppercase;color:var(--gold-light);
  margin-bottom:1.6rem;
  animation:fadeUp 1.4s .4s both;
  display:flex;align-items:center;gap:16px;
}
.hero-tag::before{
  content:'';display:inline-block;
  width:28px;height:1px;background:var(--gold);opacity:.55;
}
.hero-title{
  font-family:var(--serif);
  font-size:clamp(44px,5.8vw,80px);
  font-weight:300;line-height:1.02;
  color:#f7f4ef;letter-spacing:-.01em;
  animation:fadeUp 1.4s .58s both;
  max-width:640px;
}
.hero-title em{
  font-style:italic;
  color:rgba(247,244,239,.42);
}
.hero-divider{
  display:flex;align-items:center;gap:16px;
  margin:1.8rem 0;
  animation:fadeUp 1.4s .7s both;
  width:fit-content;
}
.hero-divider-line{width:52px;height:1px;background:rgba(184,149,106,.35)}
.hero-divider-gem{width:5px;height:5px;border:1px solid rgba(184,149,106,.5);transform:rotate(45deg)}
.hero-sub{
  font-size:13px;font-weight:300;
  color:rgba(247,244,239,.46);
  letter-spacing:.04em;line-height:1.75;
  max-width:380px;
  animation:fadeUp 1.4s .75s both;
  font-family:var(--serif);font-style:italic;font-size:17px;
}
.hero-actions{
  display:flex;align-items:center;gap:2rem;
  margin-top:2.4rem;
  animation:fadeUp 1.4s .9s both;
}
.hero-cta{
  display:inline-block;
  padding:15px 52px;
  background:transparent;
  border:1px solid rgba(184,149,106,.55);
  color:rgba(247,244,239,.88);
  text-decoration:none;
  font-size:9px;font-weight:300;
  letter-spacing:.6em;text-transform:uppercase;
  font-family:var(--tenor);
  position:relative;overflow:hidden;
  transition:color .6s var(--transition-luxury);
}
.hero-cta::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,var(--gold-light),var(--gold));
  transform:translateX(-101%);
  transition:transform .7s var(--transition-luxury);
}
.hero-cta:hover::before{transform:translateX(0)}
.hero-cta:hover{color:var(--ink)}
.hero-cta span{position:relative;z-index:1}
.hero-cta-ghost{
  font-family:var(--serif);font-style:italic;
  font-size:15px;font-weight:300;
  color:rgba(247,244,239,.35);
  text-decoration:none;
  border-bottom:1px solid rgba(247,244,239,.12);
  padding-bottom:2px;
  transition:color .4s,border-color .4s;
  letter-spacing:.04em;
}
.hero-cta-ghost:hover{color:rgba(247,244,239,.65);border-color:rgba(247,244,239,.28)}

.hero-scroll{
  position:absolute;right:72px;bottom:80px;z-index:3;
  display:flex;flex-direction:column;align-items:center;gap:10px;
  animation:fadeUp 1.4s 1.1s both;
}
.hero-scroll span{
  font-size:7.5px;letter-spacing:.65em;text-transform:uppercase;
  color:rgba(247,244,239,.22);font-weight:300;
  writing-mode:vertical-rl;text-orientation:mixed;
}
.hero-scroll-line{
  width:1px;height:52px;
  background:rgba(247,244,239,.1);
  position:relative;overflow:hidden;
}
.hero-scroll-line::after{
  content:'';position:absolute;
  top:-100%;left:0;width:100%;height:100%;
  background:linear-gradient(to bottom,transparent,var(--gold),transparent);
  animation:lineSlide 2.4s 1.5s ease-in-out infinite;
}
@keyframes lineSlide{0%{top:-100%}100%{top:200%}}

/* ── TICKER ── */
.ticker{
  background:var(--ink-soft);padding:15px 0;overflow:hidden;
  border-top:1px solid rgba(184,149,106,.12);
  border-bottom:1px solid rgba(184,149,106,.12);
}
.ticker-track{display:flex;width:max-content;animation:ttick 32s linear infinite}
@keyframes ttick{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.t-item{
  display:flex;align-items:center;gap:2.8rem;
  padding:0 2.8rem;white-space:nowrap;
}
.t-word{
  font-family:var(--serif);font-size:12px;font-style:italic;
  color:rgba(247,244,239,.25);letter-spacing:.1em;
}
.t-dot{
  width:3px;height:3px;border-radius:50%;
  background:rgba(184,149,106,.28);flex-shrink:0;
  transform:rotate(45deg);border-radius:0;
}

/* ── SECTION HEAD ── */
.sec-head{
  padding:80px 72px 40px;
  display:flex;align-items:flex-end;justify-content:space-between;
}
.sec-title-wrap{display:flex;flex-direction:column;gap:10px}
.sec-eyebrow{
  font-family:var(--tenor);
  font-size:8.5px;letter-spacing:.7em;
  text-transform:uppercase;color:var(--gold);
  font-weight:400;
  display:flex;align-items:center;gap:12px;
}
.sec-eyebrow::before{
  content:'';display:inline-block;
  width:20px;height:1px;background:var(--gold);opacity:.7;
}
.sec-title{
  font-family:var(--serif);
  font-size:clamp(30px,3.4vw,46px);
  font-weight:300;line-height:1;
  letter-spacing:-.01em;color:var(--ink);
}
.sec-title em{font-style:italic;color:var(--dim)}
.sec-link{
  font-family:var(--tenor);
  font-size:8.5px;font-weight:400;letter-spacing:.55em;
  text-transform:uppercase;color:var(--muted);
  text-decoration:none;
  display:flex;align-items:center;gap:10px;
  transition:color .4s;
  padding-bottom:16px;/* align with title baseline */
}
.sec-link::after{
  content:'';display:inline-block;
  width:24px;height:1px;background:currentColor;
  transition:width .4s var(--transition-luxury);
}
.sec-link:hover{color:var(--gold)}
.sec-link:hover::after{width:40px}

/* ── CATEGORY BANNER ── */
.cat-banner{
  display:block;position:relative;height:420px;overflow:hidden;
  background:var(--ink);text-decoration:none;cursor:pointer;
  margin:0 72px;
}
.cat-banner::before{
  content:'';position:absolute;
  inset:-1px;border:1px solid rgba(184,149,106,.12);
  z-index:3;pointer-events:none;
}
.cat-banner-img{
  width:100%;height:100%;object-fit:cover;
  object-position:center 30%;opacity:.55;
  transition:transform 2s var(--transition-luxury),opacity .8s;display:block;
}
.cat-banner:hover .cat-banner-img{transform:scale(1.05);opacity:.65}
.cat-banner-overlay{
  position:absolute;inset:0;
  background:
    linear-gradient(to right,rgba(14,12,10,.72) 0%,rgba(14,12,10,.12) 55%,transparent 100%),
    linear-gradient(to bottom,transparent 50%,rgba(14,12,10,.35) 100%);
}
.cat-banner-body{
  position:absolute;left:60px;top:50%;transform:translateY(-50%);
}
.cat-num{
  font-family:var(--serif);font-size:11px;font-style:italic;
  color:var(--gold-light);opacity:.55;
  display:block;margin-bottom:14px;letter-spacing:.12em;
}
.cat-title{
  font-family:var(--serif);
  font-size:clamp(34px,4vw,56px);
  font-weight:300;color:#f7f4ef;
  line-height:1.0;margin-bottom:22px;
  letter-spacing:-.015em;
}
.cat-title em{font-style:italic;color:rgba(247,244,239,.38)}
.cat-explore{
  display:inline-flex;align-items:center;gap:12px;
  font-family:var(--tenor);
  font-size:9px;font-weight:400;letter-spacing:.55em;
  text-transform:uppercase;color:rgba(247,244,239,.55);
  transition:color .4s,gap .4s;
}
.cat-explore::after{
  content:'';width:20px;height:1px;background:currentColor;
  transition:width .5s var(--transition-luxury);
}
.cat-banner:hover .cat-explore{color:var(--gold-light);gap:16px}
.cat-banner:hover .cat-explore::after{width:38px}

/* ── PRODUCTS GRID ── */
.cat-products{
  padding:32px 72px 0;
  display:grid;grid-template-columns:repeat(4,1fr);gap:24px;
}
.prod{display:block;text-decoration:none;color:inherit;cursor:pointer}
.prod-img-wrap{
  aspect-ratio:3/4;overflow:hidden;
  background:var(--cream);position:relative;
}
/* Subtle gold corner accent */
.prod-img-wrap::before,
.prod-img-wrap::after{
  content:'';position:absolute;
  width:16px;height:16px;
  border-color:rgba(184,149,106,.35);
  border-style:solid;
  z-index:2;
  opacity:0;
  transition:opacity .5s;
}
.prod-img-wrap::before{top:12px;left:12px;border-width:1px 0 0 1px}
.prod-img-wrap::after{bottom:12px;right:12px;border-width:0 1px 1px 0}
.prod:hover .prod-img-wrap::before,
.prod:hover .prod-img-wrap::after{opacity:1}

.prod-img{
  width:100%;height:100%;object-fit:cover;display:block;
  transition:transform 2s var(--transition-luxury);
  filter:brightness(.97);
}
.prod:hover .prod-img{transform:scale(1.07);filter:brightness(1)}

.prod-qv{
  position:absolute;bottom:0;left:0;right:0;
  background:rgba(14,12,10,.82);
  backdrop-filter:blur(4px);
  padding:14px 18px;
  transform:translateY(100%);
  transition:transform .55s var(--transition-luxury);
  display:flex;align-items:center;justify-content:space-between;
}
.prod:hover .prod-qv{transform:translateY(0)}
.prod-qv-text{
  font-family:var(--tenor);
  font-size:8.5px;letter-spacing:.5em;
  text-transform:uppercase;color:rgba(247,244,239,.7);font-weight:400;
}
.prod-qv-icon{
  width:18px;height:18px;border:1px solid rgba(247,244,239,.2);
  border-radius:50%;display:flex;align-items:center;justify-content:center;
}
.prod-qv-icon svg{width:7px;height:7px;fill:rgba(247,244,239,.5)}

.prod-info{padding:16px 2px 0}
.prod-name{
  font-family:var(--serif);font-size:18px;
  font-weight:400;color:var(--ink);margin-bottom:5px;line-height:1.2;
}
.prod-mat{
  font-family:var(--tenor);
  font-size:9px;font-weight:400;letter-spacing:.4em;
  text-transform:uppercase;color:var(--dim);
  display:block;margin-bottom:8px;
}
.prod-price{
  font-family:var(--serif);font-size:16px;font-weight:400;
  color:var(--ink-soft);
  display:flex;align-items:center;gap:6px;
}
.prod-price-currency{
  font-size:11px;font-style:italic;
  color:var(--gold);opacity:.75;font-family:var(--serif);
}

/* ── DIVIDER ── */
.divider{
  margin:88px 72px 0;border:none;
  border-top:1px solid var(--border);
  position:relative;
}
.divider::before{
  content:'◆';
  position:absolute;left:50%;top:50%;
  transform:translate(-50%,-50%);
  font-size:8px;color:var(--gold);opacity:.4;
  background:var(--warm);padding:0 12px;
  letter-spacing:2px;
}

/* ── NO PRODUCTS ── */
.no-prods{
  grid-column:1/-1;text-align:center;
  color:var(--dim);font-size:10px;
  letter-spacing:.5em;text-transform:uppercase;
  font-weight:300;padding:4rem 0;
  font-family:var(--tenor);
}

/* ── CRAFT ── */
.craft{display:grid;grid-template-columns:1fr 1fr;margin-top:88px}
.craft-img-side{
  position:relative;overflow:hidden;
  background:var(--ink);min-height:520px;
}
.craft-photo{
  width:100%;height:100%;object-fit:cover;display:block;
  opacity:.52;
  filter:sepia(18%) brightness(.82) contrast(1.05);
  transition:transform 2.4s var(--transition-luxury),opacity .8s;
}
.craft:hover .craft-photo{transform:scale(1.04);opacity:.6}
.craft-caption{
  position:absolute;bottom:2.4rem;left:2.4rem;
  font-family:var(--serif);font-size:12px;font-style:italic;
  color:rgba(247,244,239,.25);letter-spacing:.06em;
}
/* Gold strip on craft image side */
.craft-img-side::after{
  content:'';
  position:absolute;top:0;right:0;width:1px;height:100%;
  background:linear-gradient(to bottom,transparent,rgba(184,149,106,.25),transparent);
}

.craft-body{
  background:var(--ink);padding:80px 72px;
  display:flex;flex-direction:column;justify-content:center;
  position:relative;
}
/* Very subtle pattern */
.craft-body::before{
  content:'';position:absolute;inset:0;
  background-image:radial-gradient(circle at 80% 20%,rgba(184,149,106,.04) 0%,transparent 55%);
  pointer-events:none;
}
.craft-ey{
  font-family:var(--tenor);
  font-size:8.5px;letter-spacing:.65em;text-transform:uppercase;
  color:var(--gold);opacity:.7;font-weight:400;
  margin-bottom:2rem;display:block;
  display:flex;align-items:center;gap:14px;
}
.craft-ey::before{
  content:'';display:inline-block;
  width:20px;height:1px;background:var(--gold);opacity:.7;
}
.craft-h{
  font-family:var(--serif);
  font-size:clamp(34px,4vw,54px);
  font-weight:300;color:#f7f4ef;
  line-height:1.02;margin-bottom:1.8rem;
  letter-spacing:-.015em;
}
.craft-h em{font-style:italic;color:rgba(184,149,106,.45)}
.craft-rule{
  width:44px;height:1px;
  background:linear-gradient(to right,rgba(184,149,106,.4),transparent);
  margin-bottom:2rem;
}
.craft-p{
  font-family:var(--serif);font-size:18px;
  font-style:italic;font-weight:300;
  color:rgba(247,244,239,.4);
  line-height:1.85;margin-bottom:3.5rem;max-width:340px;
}
.craft-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:1.8rem}
.craft-stat{
  border-top:1px solid rgba(184,149,106,.12);
  padding-top:1.4rem;position:relative;
}
.craft-stat::before{
  content:'';position:absolute;top:-1px;left:0;
  width:20px;height:1px;background:var(--gold);opacity:.45;
}
.craft-n{
  font-family:var(--serif);font-size:36px;
  font-weight:300;color:#f7f4ef;
  line-height:1;display:block;margin-bottom:5px;
}
.craft-n em{font-size:20px;font-style:italic;color:var(--gold);opacity:.5}
.craft-l{
  font-family:var(--tenor);
  font-size:8px;letter-spacing:.45em;text-transform:uppercase;
  color:rgba(247,244,239,.2);font-weight:400;
}

/* ── QUOTE ── */
.quote-band{
  padding:88px 72px;
  background:var(--cream2);
  display:flex;align-items:center;gap:5rem;
  position:relative;overflow:hidden;
}
.quote-band::before{
  content:'❝';
  position:absolute;right:72px;top:50%;transform:translateY(-50%);
  font-family:var(--serif);font-size:220px;font-weight:300;
  color:rgba(184,149,106,.07);line-height:1;
  pointer-events:none;
}
.q-line{
  width:1px;height:100px;
  background:linear-gradient(to bottom,transparent,var(--gold),transparent);
  flex-shrink:0;opacity:.4;
}
.q-text{
  font-family:var(--serif);
  font-size:clamp(20px,2.5vw,30px);
  font-weight:300;font-style:italic;
  color:var(--ink);line-height:1.6;max-width:580px;
}
.q-text strong{font-style:normal;font-weight:500;color:var(--ink)}
.q-attr{
  font-family:var(--tenor);
  font-size:9px;letter-spacing:.55em;text-transform:uppercase;
  color:var(--gold);margin-top:1.6rem;font-weight:400;
  display:flex;align-items:center;gap:14px;
  opacity:.7;
}
.q-attr::before{
  content:'';width:18px;height:1px mayo;
  background:var(--gold);opacity:.7;
  display:inline-block;width:18px;height:1px;
}

/* ── FOOTER BAND ── */
.footer-band{
  background:var(--ink);
  padding:60px 72px;
  display:flex;align-items:center;justify-content:space-between;
  position:relative;
}
.footer-band::before{
  content:'';position:absolute;
  top:0;left:72px;right:72px;height:1px;
  background:linear-gradient(to right,transparent,rgba(184,149,106,.25),transparent);
}
.footer-brand{
  font-family:var(--serif);font-size:22px;
  font-weight:300;font-style:italic;
  color:rgba(247,244,239,.35);letter-spacing:.12em;
}
.footer-mid{
  font-family:var(--tenor);
  font-size:8px;letter-spacing:.55em;text-transform:uppercase;
  color:rgba(247,244,239,.12);font-weight:400;
}
.footer-cta{
  display:inline-block;
  padding:14px 44px;
  border:1px solid rgba(184,149,106,.28);
  color:rgba(247,244,239,.42);
  text-decoration:none;
  font-family:var(--tenor);
  font-size:9px;letter-spacing:.55em;text-transform:uppercase;font-weight:400;
  position:relative;overflow:hidden;
  transition:color .7s var(--transition-luxury);
}
.footer-cta::before{
  content:'';position:absolute;inset:0;
  background:linear-gradient(135deg,rgba(184,149,106,.22),rgba(184,149,106,.08));
  transform:translateX(-101%);
  transition:transform .7s var(--transition-luxury);
}
.footer-cta:hover::before{transform:translateX(0)}
.footer-cta:hover{color:var(--gold-light)}
.footer-cta span{position:relative;z-index:1}

/* ── REVEAL ── */
.rv{opacity:0;transform:translateY(28px);transition:opacity 1.4s var(--transition-luxury),transform 1.4s var(--transition-luxury)}
.rv.on{opacity:1;transform:translateY(0)}
.d1{transition-delay:.05s}.d2{transition-delay:.14s}.d3{transition-delay:.23s}.d4{transition-delay:.32s}

/* ── RESPONSIVE ── */
@media(max-width:1024px){
  .hero-body,.sec-head,.cat-products,.quote-band,.footer-band,.divider{padding-left:36px;padding-right:36px}
  .hero-body{padding-top:70px}
  .cat-banner{margin:0 36px}
  .cat-products{grid-template-columns:repeat(2,1fr);padding-left:36px;padding-right:36px}
  .craft{grid-template-columns:1fr}
  .craft-img-side{min-height:56vw}
  .craft-body{padding:64px 36px}
}
@media(max-width:640px){
  .hero-body,.sec-head,.cat-products,.quote-band,.footer-band,.divider{padding-left:20px;padding-right:20px}
  .cat-banner{margin:0 20px;height:280px}
  .cat-products{padding-left:20px;padding-right:20px;gap:14px}
  .cat-banner-body{left:28px}
  .footer-band{flex-direction:column;gap:2rem;text-align:center}
  .footer-band::before{left:20px;right:20px}
  .hero-scroll{display:none}
}
</style>

<div id="loader">
  <div class="lb-wrap">
    <div class="lb">Emera</div>
    <div class="lb-ornament">
      <div class="lb-line"></div>
      <div class="lb-diamond"></div>
      <div class="lb-line"></div>
    </div>
    <div class="ls">Crafted in Florence</div>
  </div>
  <div class="loader-bar"></div>
</div>

<div class="c-dot" id="cdot"></div>
<div class="c-ring" id="cring"></div>

<!-- ══ HERO ══ -->
<section class="hero">
  <div class="hero-bg" style="background-image:url('/videos/hero-poster.jpg')"></div>
  <video autoplay muted loop playsinline preload="metadata">
    <source src="/videos/hero.mp4" type="video/mp4">
  </video>
  <div class="hero-veil"></div>
  <div class="hero-body">
    <span class="hero-tag">Winter Collection &middot; 2026</span>
    <h1 class="hero-title">Crafted in Florence,<br><em>worn with intention</em></h1>
    <div class="hero-divider">
      <div class="hero-divider-line"></div>
      <div class="hero-divider-gem"></div>
      <div class="hero-divider-line"></div>
    </div>
    <p class="hero-sub">Each bag handmade using traditional Florentine techniques. Leather chosen for life, not for seasons.</p>
    <div class="hero-actions">
      <a href="/products" class="hero-cta"><span>Shop the Collection</span></a>
      <a href="#collections" class="hero-cta-ghost">Discover more</a>
    </div>
  </div>
  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="hero-scroll-line"></div>
  </div>
</section>

<!-- ══ TICKER ══ -->
<div class="ticker" aria-hidden="true"><div class="ticker-track" id="ticker"></div></div>

<%
  const tickerWords = ['Handcrafted Leather','Timeless Luxury','Florence, Italy','Premium Quality','Made by Hand','Slow Fashion','The Atelier','Winter 2026'];
%>

<!-- ══ CATEGORIES WITH PRODUCTS ══ -->
<div id="collections">
<% if(Array.isArray(categories) && categories.length > 0) { %>
  <% categories.forEach((cat, ci) => { %>

  <div class="rv">
    <% if(ci > 0) { %><hr class="divider"><% } %>

    <div class="sec-head">
      <div class="sec-title-wrap">
        <span class="sec-eyebrow">Collection 0<%= ci+1 %></span>
        <h2 class="sec-title"><%= cat.name.split(' ')[0] %> <em><%= cat.name.split(' ').slice(1).join(' ') || 'Collection' %></em></h2>
      </div>
      <a href="/products?category=<%= cat._id %>" class="sec-link">View All</a>
    </div>

    <a href="/products?category=<%= cat._id %>" class="cat-banner">
      <% if(cat.image && cat.image.url) { %>
        <img src="<%= cat.image.url %>" alt="<%= cat.name %>" class="cat-banner-img" loading="lazy">
      <% } %>
      <div class="cat-banner-overlay"></div>
      <div class="cat-banner-body">
        <span class="cat-num">0<%= ci+1 %> &mdash; Collection</span>
        <h3 class="cat-title">The <%= cat.name.split(' ')[0] %><br><em>Edit</em></h3>
        <span class="cat-explore">Explore Collection</span>
      </div>
    </a>

    <% if(cat.products && cat.products.length > 0) { %>
    <div class="cat-products">
      <% cat.products.slice(0,4).forEach((p, pi) => { %>
      <a href="/products/<%= p._id %>" class="prod rv d<%= pi+1 %>">
        <div class="prod-img-wrap">
          <img
            src="<%= (p.productImage && p.productImage[0] && p.productImage[0].url) ? p.productImage[0].url : '/images/placeholder.png' %>"
            alt="<%= p.name %>"
            class="prod-img"
            loading="lazy"
          >
          <div class="prod-qv">
            <span class="prod-qv-text">Quick View</span>
            <div class="prod-qv-icon">
              <svg viewBox="0 0 8 8"><path d="M4 0L5 3H8L5.5 5L6.5 8L4 6L1.5 8L2.5 5L0 3H3Z"/></svg>
            </div>
          </div>
        </div>
        <div class="prod-info">
          <h3 class="prod-name"><%= p.name %></h3>
          <span class="prod-mat"><%= p.material || 'Premium Leather' %></span>
          <span class="prod-price">
            <span class="prod-price-currency">₹</span>
            <%= p.salePrice ? p.salePrice.toLocaleString('en-IN') : '0' %>
          </span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } else if(Array.isArray(products) && products.length > 0) { %>
    <div class="cat-products">
      <% products.slice(ci*4, ci*4+4).forEach((p, pi) => { %>
      <a href="/products/<%= p._id %>" class="prod rv d<%= pi+1 %>">
        <div class="prod-img-wrap">
          <img
            src="<%= (p.productImage && p.productImage[0] && p.productImage[0].url) ? p.productImage[0].url : '/images/placeholder.png' %>"
            alt="<%= p.name %>"
            class="prod-img"
            loading="lazy"
          >
          <div class="prod-qv">
            <span class="prod-qv-text">Quick View</span>
            <div class="prod-qv-icon">
              <svg viewBox="0 0 8 8"><path d="M4 0L5 3H8L5.5 5L6.5 8L4 6L1.5 8L2.5 5L0 3Z"/></svg>
            </div>
          </div>
        </div>
        <div class="prod-info">
          <h3 class="prod-name"><%= p.name %></h3>
          <span class="prod-mat"><%= p.material || 'Premium Leather' %></span>
          <span class="prod-price">
            <span class="prod-price-currency">₹</span>
            <%= p.salePrice ? p.salePrice.toLocaleString('en-IN') : '0' %>
          </span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="cat-products"><p class="no-prods">No products yet</p></div>
    <% } %>
  </div>

  <% }) %>
<% } else { %>
  <div class="rv">
    <div class="sec-head">
      <div class="sec-title-wrap">
        <span class="sec-eyebrow">All Pieces</span>
        <h2 class="sec-title">Our <em>Collections</em></h2>
      </div>
      <a href="/products" class="sec-link">View All</a>
    </div>
    <% if(Array.isArray(products) && products.length > 0) { %>
    <div class="cat-products">
      <% products.slice(0,4).forEach((p, pi) => { %>
      <a href="/products/<%= p._id %>" class="prod rv d<%= pi+1 %>">
        <div class="prod-img-wrap">
          <img
            src="<%= (p.productImage && p.productImage[0] && p.productImage[0].url) ? p.productImage[0].url : '/images/placeholder.png' %>"
            alt="<%= p.name %>"
            class="prod-img"
            loading="lazy"
          >
          <div class="prod-qv">
            <span class="prod-qv-text">Quick View</span>
            <div class="prod-qv-icon">
              <svg viewBox="0 0 8 8"><path d="M4 0L5 3H8L5.5 5L6.5 8L4 6L1.5 8L2.5 5L0 3Z"/></svg>
            </div>
          </div>
        </div>
        <div class="prod-info">
          <h3 class="prod-name"><%= p.name %></h3>
          <span class="prod-mat"><%= p.material || 'Premium Leather' %></span>
          <span class="prod-price">
            <span class="prod-price-currency">₹</span>
            <%= p.salePrice ? p.salePrice.toLocaleString('en-IN') : '0' %>
          </span>
        </div>
      </a>
      <% }) %>
    </div>
    <% } else { %>
    <div class="cat-products"><p class="no-prods">No products available</p></div>
    <% } %>
  </div>
<% } %>
</div>

<!-- ══ CRAFT ══ -->
<section class="craft rv">
  <div class="craft-img-side">
    <img
      src="https://miraggiolife.com/cdn/shop/files/1_32208365-9287-4630-bf93-4d3e935c9966.jpg?v=1771590729&width=900"
      alt="Artisan crafting leather in Florence"
      class="craft-photo"
    >
    <span class="craft-caption">Florence, Italy &mdash; 2026</span>
  </div>
  <div class="craft-body">
    <span class="craft-ey">Our Heritage</span>
    <h2 class="craft-h">Crafted<br><em>by hand</em></h2>
    <div class="craft-rule"></div>
    <p class="craft-p">"Each piece takes 48 hours of artisan work. We use traditional Florentine techniques passed through generations."</p>
    <div class="craft-stats">
      <div class="craft-stat">
        <span class="craft-n">100<em>%</em></span>
        <span class="craft-l">Genuine Leather</span>
      </div>
      <div class="craft-stat">
        <span class="craft-n">48<em>h</em></span>
        <span class="craft-l">Per Bag</span>
      </div>
      <div class="craft-stat">
        <span class="craft-n">1<em>st</em></span>
        <span class="craft-l">Atelier</span>
      </div>
    </div>
  </div>
</section>

<!-- ══ QUOTE ══ -->
<div class="quote-band rv">
  <div class="q-line"></div>
  <div>
    <p class="q-text">"Luxury is not about price. It is about the <strong>time someone took</strong> to make something <strong>worthy of you</strong>."</p>
    <p class="q-attr">The Emera Atelier</p>
  </div>
</div>

<!-- ══ FOOTER BAND ══ -->
<div class="footer-band">
  <span class="footer-brand">Emera</span>
  <span class="footer-mid">Handcrafted in Florence &nbsp;&middot;&nbsp; Est. 2020</span>
  <a href="/products" class="footer-cta"><span>Shop All Pieces</span></a>
</div>

<script>
(function(){
  /* Loader */
  window.addEventListener('load', () => {
    setTimeout(() => document.getElementById('loader').classList.add('gone'), 1600);
  });

  /* Custom cursor — desktop only */
  if(window.matchMedia('(hover:hover)').matches){
    const dot = document.getElementById('cdot');
    const ring = document.getElementById('cring');
    let mx = 0, my = 0, rx = 0, ry = 0;
    document.addEventListener('mousemove', e => {
      mx = e.clientX; my = e.clientY;
      dot.style.left = mx + 'px';
      dot.style.top  = my + 'px';
    });
    document.addEventListener('mousedown', () => ring.classList.add('click'));
    document.addEventListener('mouseup',   () => ring.classList.remove('click'));
    (function loop(){
      rx += (mx - rx) * .12;
      ry += (my - ry) * .12;
      ring.style.left = rx + 'px';
      ring.style.top  = ry + 'px';
      requestAnimationFrame(loop);
    })();
    document.querySelectorAll('a, .prod, .cat-banner').forEach(el => {
      el.addEventListener('mouseenter', () => ring.classList.add('big'));
      el.addEventListener('mouseleave', () => ring.classList.remove('big'));
    });
  } else {
    /* Hide cursor elements on touch devices */
    document.getElementById('cdot').style.display = 'none';
    document.getElementById('cring').style.display = 'none';
  }

  /* Ticker */
  const words = <%- JSON.stringify(tickerWords) %>;
  const t = document.getElementById('ticker');
  if(t){
    let h = '';
    for(let i = 0; i < 2; i++){
      words.forEach(w => {
        h += `<span class="t-item"><span class="t-word">${w}</span><span class="t-dot"></span></span>`;
      });
    }
    t.innerHTML = h;
  }

  /* Scroll reveal */
  const io = new IntersectionObserver(entries => {
    entries.forEach(x => {
      if(x.isIntersecting){
        x.target.classList.add('on');
        io.unobserve(x.target);
      }
    });
  }, { threshold: 0.07 });
  document.querySelectorAll('.rv').forEach(el => io.observe(el));
})();
</script>

<%- include('../partials/user/footer') %>
