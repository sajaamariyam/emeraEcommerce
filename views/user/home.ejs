    </p>

    <div class="flex items-center justify-center gap-4 mb-8">
        <div class="w-16 h-px bg-rose-300/40"></div>
        <svg class="w-6 h-6 text-rose-300" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd"/>
        </svg>
        <div class="w-16 h-px bg-rose-300/40"></div>
    </div>

    <p class="text-sm text-rose-200 tracking-[0.3em] uppercase font-bold">
        Made in Florence, Italy
    </p>

  </div>

</section>




    <style>
        /* Base Animations */
        @keyframes reveal {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .animate-reveal { 
            animation: reveal 1s cubic-bezier(0.22, 1, 0.36, 1) forwards; 
            opacity: 0;
        }
        
        /* Heart Float Animation */
        @keyframes heartFloat {
            0% {
                transform: translateY(100vh) scale(0) rotate(0deg);
                opacity: 0;
            }
            10% {
                opacity: 0.8;
            }
            90% {
                opacity: 0.8;
            }
            100% {
                transform: translateY(-100vh) scale(1) rotate(15deg);
                opacity: 0;
            }
        }
        
        .heart-float {
            position: absolute;
            bottom: -50px;
            width: 20px;
            height: 20px;
            animation: heartFloat 15s infinite ease-in-out;
        }
        
        .heart-float::before,
        .heart-float::after {
            content: '';
            position: absolute;
            width: 20px;
            height: 30px;
            background: rgba(255, 182, 193, 0.4);
            border-radius: 50% 50% 0 0;
        }
        
        .heart-float::before {
            left: -10px;
            transform: rotate(-45deg);
            transform-origin: 100% 100%;
        }
        
        .heart-float::after {
            left: 10px;
            transform: rotate(45deg);
            transform-origin: 0 100%;
        }

        /* Large Decorative Hearts */
        @keyframes heartPulse {
            0%, 100% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.1); opacity: 0.5; }
        }

        .heart-large {
            position: absolute;
            width: 100px;
            height: 100px;
            animation: heartPulse 4s infinite ease-in-out;
        }
        
        .heart-large::before,
        .heart-large::after {
            content: '';
            position: absolute;
            width: 100px;
            height: 150px;
            background: rgba(255, 255, 255, 0.3);
            border-radius: 50% 50% 0 0;
        }
        
        .heart-large::before {
            left: -50px;
            transform: rotate(-45deg);
            transform-origin: 100% 100%;
        }
        
        .heart-large::after {
            left: 50px;
            transform: rotate(45deg);
            transform-origin: 0 100%;
        }

        /* Pulse Slow */
        @keyframes pulseSlow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.6; transform: scale(1.05); }
        }
        .animate-pulse-slow {
            animation: pulseSlow 3s infinite ease-in-out;
        }

        /* Float Animations */
        @keyframes floatSlow {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }
        .animate-float-slow {
            animation: floatSlow 6s infinite ease-in-out;
        }

        @keyframes floatSlower {
            0%, 100% { transform: translateY(0px) translateX(0px); }
            50% { transform: translateY(-30px) translateX(10px); }
        }
        .animate-float-slower {
            animation: floatSlower 8s infinite ease-in-out;
        }

        /* Valentine Card Animation */
        .valentine-card {
            opacity: 0;
            transform: translateY(30px);
            animation: reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Product Card Valentine */
        .product-card-valentine {
            opacity: 0;
            transform: translateY(30px);
            animation: reveal 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        /* Scroll Reveal */
        .reveal-item { 
            transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1); 
            transform: translateY(50px); 
            opacity: 0;
        }
        .reveal-item.active { 
            opacity: 1; 
            transform: translateY(0); 
        }
    </style>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const items = document.querySelectorAll('.reveal-item');

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    },
    { threshold: 0.15 }
  );

  items.forEach(item => observer.observe(item));
});
</script>



