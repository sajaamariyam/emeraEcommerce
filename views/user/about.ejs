<%- include('../partials/user/header') %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,600&family=Jost:wght@200;300;400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --emera:     #062c26;
    --emera-mid: #0d4a3a;
    --gold:      #c9a96e;
    --gold-lt:   #e8d5a3;
    --cream:     #faf7f2;
    --ink:       #1a1208;
  }

  /* ── Base ── */
  .about-wrap { background: var(--cream); font-family: 'Jost', sans-serif; color: var(--ink); overflow-x: hidden; }
  .lux { font-family: 'Cormorant Garamond', Georgia, serif; }

  /* ── Gold rule ── */
  .gold-rule {
    width: 100%; height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold) 30%, var(--gold) 70%, transparent);
  }
  .gold-rule-short {
    width: 60px; height: 1px;
    background: var(--gold);
    display: inline-block;
  }

  /* ── Eyebrow ── */
  .eyebrow {
    font-size: 9px; letter-spacing: .55em;
    text-transform: uppercase; font-weight: 500;
    color: var(--gold);
  }

  /* ── Hero ── */
  .hero-about {
    position: relative;
    background: var(--emera);
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .hero-about::before {
    content: '';
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 80% 60% at 20% 50%, rgba(201,169,110,.08) 0%, transparent 60%),
      radial-gradient(ellipse 60% 80% at 80% 30%, rgba(201,169,110,.05) 0%, transparent 55%);
  }
  .hero-grid {
    position: absolute; inset: 0;
    background-image:
      linear-gradient(rgba(201,169,110,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(201,169,110,.04) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .hero-big-text {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: clamp(80px, 18vw, 220px);
    font-weight: 300;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201,169,110,.18);
    position: absolute;
    bottom: -40px; right: -20px;
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .hero-content { position: relative; z-index: 2; text-align: center; padding: 0 24px; }
  .hero-tag {
    display: inline-flex; align-items: center; gap: 16px;
    margin-bottom: 40px;
  }
  .hero-tag-line { width: 40px; height: 1px; background: var(--gold); opacity: .7; }
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(48px, 8vw, 96px);
    font-weight: 300;
    color: #fff;
    line-height: 1.05;
    margin-bottom: 32px;
  }
  .hero-title em { color: var(--gold); font-style: italic; }
  .hero-sub {
    font-size: 12px; letter-spacing: .35em;
    text-transform: uppercase; font-weight: 300;
    color: rgba(255,255,255,.45);
    max-width: 400px; margin: 0 auto 56px;
    line-height: 2;
  }
  .hero-scroll {
    display: flex; flex-direction: column; align-items: center; gap: 8px;
    color: rgba(255,255,255,.3); font-size: 9px;
    letter-spacing: .4em; text-transform: uppercase;
  }
  .scroll-line {
    width: 1px; height: 60px;
    background: linear-gradient(var(--gold), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%,100% { opacity: .4; transform: scaleY(1); }
    50%      { opacity: 1;  transform: scaleY(1.1); }
  }

  /* ── Founding Story ── */
  .story-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 100vh;
  }
  @media (max-width: 900px) {
    .story-section { grid-template-columns: 1fr; }
  }
  .story-img-side {
    position: relative;
    background: var(--emera);
    overflow: hidden;
  }
  .story-img-side img {
    width: 100%; height: 100%;
    object-fit: cover;
    opacity: .75;
    mix-blend-mode: luminosity;
    transition: transform 1.2s cubic-bezier(.25,.46,.45,.94);
  }
  .story-img-side:hover img { transform: scale(1.04); }
  .story-img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, rgba(6,44,38,.6) 0%, transparent 60%);
  }
  .founder-badge {
    position: absolute; bottom: 40px; left: 40px;
    border: 1px solid rgba(201,169,110,.4);
    padding: 20px 28px;
    background: rgba(6,44,38,.7);
    backdrop-filter: blur(12px);
  }
  .story-text-side {
    display: flex; flex-direction: column;
    justify-content: center;
    padding: clamp(48px, 8vw, 96px) clamp(40px, 6vw, 80px);
    background: var(--cream);
  }
  .story-text-side h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 300;
    line-height: 1.1;
    color: var(--emera);
    margin: 24px 0 32px;
  }
  .story-text-side h2 em { color: var(--gold); font-style: italic; }
  .story-body {
    font-size: 15px; line-height: 1.95;
    color: #4a4033; font-weight: 300;
    margin-bottom: 20px;
  }
  .story-signature {
    font-family: 'Cormorant Garamond', serif;
    font-size: 32px; font-weight: 400;
    font-style: italic;
    color: var(--emera);
    margin-top: 40px;
  }
  .story-sig-title {
    font-size: 9px; letter-spacing: .4em;
    text-transform: uppercase; color: var(--gold);
    margin-top: 6px;
  }

  /* ── Numbers ── */
  .numbers-section {
    background: var(--emera);
    padding: 80px 40px;
    position: relative; overflow: hidden;
  }
  .numbers-section::before {
    content: '';
    position: absolute; inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      transparent, transparent 60px,
      rgba(201,169,110,.025) 60px, rgba(201,169,110,.025) 61px
    );
  }
  .numbers-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    max-width: 1000px;
    margin: 0 auto;
    position: relative;
  }
  @media (max-width: 700px) {
    .numbers-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .number-card {
    text-align: center; padding: 48px 24px;
    border: 1px solid rgba(201,169,110,.12);
  }
  .number-big {
    font-family: 'Cormorant Garamond', serif;
    font-size: 64px; font-weight: 300;
    color: var(--gold); line-height: 1;
    margin-bottom: 12px;
  }
  .number-label {
    font-size: 9px; letter-spacing: .4em;
    text-transform: uppercase;
    color: rgba(255,255,255,.4); font-weight: 400;
  }

  /* ── Mission / Values ── */
  .mission-section {
    padding: clamp(80px, 12vw, 160px) clamp(24px, 6vw, 80px);
    max-width: 1200px; margin: 0 auto;
  }
  .mission-header { text-align: center; margin-bottom: 80px; }
  .mission-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300; color: var(--emera);
    margin: 20px 0 24px;
  }
  .mission-header h2 em { font-style: italic; color: var(--gold); }
  .mission-header p {
    font-size: 15px; line-height: 1.9;
    color: #5a4f3f; font-weight: 300;
    max-width: 560px; margin: 0 auto;
  }
  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: rgba(201,169,110,.1);
  }
  @media (max-width: 768px) {
    .values-grid { grid-template-columns: 1fr; }
  }
  .value-card {
    background: var(--cream);
    padding: 56px 40px;
    position: relative;
    transition: background .4s;
  }
  .value-card:hover { background: #fff; }
  .value-card::before {
    content: '';
    position: absolute; top: 0; left: 0;
    width: 3px; height: 0;
    background: var(--gold);
    transition: height .5s cubic-bezier(.16,1,.3,1);
  }
  .value-card:hover::before { height: 100%; }
  .value-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 80px; font-weight: 300;
    color: rgba(201,169,110,.15);
    line-height: 1;
    margin-bottom: -20px;
  }
  .value-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px; font-weight: 400;
    color: var(--emera); margin-bottom: 16px;
  }
  .value-body {
    font-size: 13px; line-height: 1.9;
    color: #6b5f4f; font-weight: 300;
  }

  /* ── Process / Timeline ── */
  .process-section {
    background: var(--emera);
    padding: clamp(80px, 12vw, 160px) clamp(24px, 6vw, 80px);
    position: relative; overflow: hidden;
  }
  .process-section::after {
    content: 'CRAFT';
    position: absolute; right: -60px; top: 50%;
    transform: translateY(-50%) rotate(90deg);
    font-family: 'Cormorant Garamond', serif;
    font-size: 200px; font-weight: 300;
    color: transparent;
    -webkit-text-stroke: 1px rgba(201,169,110,.06);
    pointer-events: none;
  }
  .process-header { text-align: center; margin-bottom: 80px; }
  .process-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 5vw, 72px);
    font-weight: 300; color: #fff;
    margin: 20px 0;
  }
  .process-header h2 em { color: var(--gold); font-style: italic; }
  .process-header p {
    font-size: 13px; letter-spacing: .15em;
    color: rgba(255,255,255,.4); max-width: 400px;
    margin: 0 auto; line-height: 2;
  }
  .timeline {
    max-width: 800px; margin: 0 auto;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute; left: 50%; top: 0; bottom: 0;
    width: 1px;
    background: linear-gradient(var(--gold), rgba(201,169,110,.1));
    transform: translateX(-50%);
  }
  @media (max-width: 640px) {
    .timeline::before { left: 20px; }
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 1fr 40px 1fr;
    gap: 0; margin-bottom: 64px;
    align-items: start;
  }
  @media (max-width: 640px) {
    .timeline-item { grid-template-columns: 40px 1fr; }
    .timeline-left { display: none; }
  }
  .timeline-left { text-align: right; padding-right: 32px; padding-top: 4px; }
  .timeline-right { padding-left: 32px; padding-top: 4px; }
  .timeline-right:only-child { padding-left: 48px; }
  .timeline-dot {
    width: 12px; height: 12px;
    border: 2px solid var(--gold);
    border-radius: 50%;
    background: var(--emera);
    margin: 6px auto 0;
    position: relative;
    flex-shrink: 0;
  }
  .timeline-dot::before {
    content: '';
    position: absolute; inset: 3px;
    background: var(--gold);
    border-radius: 50%;
  }
  .timeline-year {
    font-family: 'Cormorant Garamond', serif;
    font-size: 13px; letter-spacing: .3em;
    color: var(--gold); text-transform: uppercase;
    margin-bottom: 8px;
  }
  .timeline-event-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px; font-weight: 400;
    color: #fff; margin-bottom: 8px;
  }
  .timeline-event-body {
    font-size: 13px; line-height: 1.8;
    color: rgba(255,255,255,.45); font-weight: 300;
  }

  /* ── Craftsmanship ── */
  .craft-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 900px) {
    .craft-section { grid-template-columns: 1fr; }
  }
  .craft-text {
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(60px, 8vw, 120px) clamp(40px, 6vw, 80px);
    background: #fff;
  }
  .craft-text h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(36px, 4vw, 56px);
    font-weight: 300; color: var(--emera);
    line-height: 1.15; margin: 20px 0 28px;
  }
  .craft-text h2 em { color: var(--gold); font-style: italic; }
  .craft-text p {
    font-size: 14px; line-height: 2;
    color: #5a4f3f; font-weight: 300;
    margin-bottom: 20px;
  }
  .craft-pills {
    display: flex; flex-wrap: wrap; gap: 10px;
    margin-top: 32px;
  }
  .craft-pill {
    font-size: 9px; letter-spacing: .35em;
    text-transform: uppercase; font-weight: 500;
    padding: 10px 20px;
    border: 1px solid rgba(201,169,110,.4);
    color: var(--emera);
    background: rgba(201,169,110,.06);
  }
  .craft-img {
    position: relative;
    background: var(--emera-mid);
    overflow: hidden;
    min-height: 500px;
  }
  .craft-img img {
    width: 100%; height: 100%;
    object-fit: cover; opacity: .6;
    transition: transform 1.2s cubic-bezier(.25,.46,.45,.94);
  }
  .craft-img:hover img { transform: scale(1.05); }
  .craft-img-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(6,44,38,.5), transparent 60%);
  }
  .craft-quote {
    position: absolute; bottom: 40px; left: 40px; right: 40px;
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px; font-weight: 300;
    font-style: italic; color: rgba(255,255,255,.8);
    border-left: 2px solid var(--gold);
    padding-left: 20px; line-height: 1.5;
  }

  /* ── Promise ── */
  .promise-section {
    padding: clamp(80px, 12vw, 140px) 24px;
    text-align: center;
    position: relative; overflow: hidden;
    background: var(--cream);
  }
  .promise-section::before {
    content: '✦';
    position: absolute; top: 40%; left: 50%;
    transform: translate(-50%, -50%);
    font-size: 600px; color: rgba(201,169,110,.04);
    pointer-events: none; line-height: 1;
  }
  .promise-inner { position: relative; max-width: 700px; margin: 0 auto; }
  .promise-inner h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(40px, 6vw, 80px);
    font-weight: 300; color: var(--emera);
    line-height: 1.1; margin: 24px 0 36px;
  }
  .promise-inner h2 em { font-style: italic; color: var(--gold); }
  .promise-inner p {
    font-size: 15px; line-height: 2;
    color: #5a4f3f; font-weight: 300;
    margin-bottom: 48px;
  }
  .promise-cta {
    display: inline-block;
    padding: 18px 48px;
    background: var(--emera);
    color: #fff;
    font-size: 10px; letter-spacing: .5em;
    text-transform: uppercase; font-weight: 500;
    text-decoration: none;
    position: relative; overflow: hidden;
    transition: background .4s;
  }
  .promise-cta::after {
    content: '';
    position: absolute; inset: 0;
    background: var(--gold);
    transform: translateX(-101%);
    transition: transform .4s cubic-bezier(.16,1,.3,1);
  }
  .promise-cta:hover::after { transform: translateX(0); }
  .promise-cta span { position: relative; z-index: 1; }

  /* ── Reveal animations ── */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity .9s cubic-bezier(.16,1,.3,1), transform .9s cubic-bezier(.16,1,.3,1);
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .reveal-delay-1 { transition-delay: .1s; }
  .reveal-delay-2 { transition-delay: .2s; }
  .reveal-delay-3 { transition-delay: .3s; }
  .reveal-delay-4 { transition-delay: .4s; }
</style>

<div class="about-wrap">

  <!-- ═══════════════════════════════════
       HERO
  ════════════════════════════════════ -->
  <section class="hero-about">
    <div class="hero-grid"></div>
    <div class="hero-big-text">EMERA</div>

    <div class="hero-content">
      <div class="hero-tag">
        <span class="hero-tag-line"></span>
        <span class="eyebrow">Est. 2025 · Kerala, India</span>
        <span class="hero-tag-line"></span>
      </div>

      <h1 class="hero-title lux">
        The Art of<br>
        <em>Conscious Luxury</em>
      </h1>

      <p class="hero-sub">
        Where heritage craftsmanship meets<br>
        modern sensibility
      </p>

      <div class="hero-scroll">
        <div class="scroll-line"></div>
        <span>Scroll</span>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════
       FOUNDING STORY
  ════════════════════════════════════ -->
  <section class="story-section">

    <!-- Image Side -->
    <div class="story-img-side">
      <!-- Replace src with actual founder image path -->
<img src="/images/founder.jpg" alt="Founder of Emera">
      <div class="story-img-overlay"></div>

      <div class="founder-badge">
        <p class="eyebrow" style="margin-bottom:8px;">Founder & Creative Director</p>
        <p class="lux" style="font-size:26px;color:#fff;font-weight:300;">Saja Mariyam</p>
        <div class="gold-rule" style="margin-top:14px;opacity:.4;"></div>
        <p style="font-size:11px;color:rgba(255,255,255,.5);margin-top:12px;letter-spacing:.1em;">
          "Luxury is not a price tag —<br>it is intention made visible."
        </p>
      </div>
    </div>

    <!-- Text Side -->
    <div class="story-text-side">

      <span class="eyebrow reveal">Our Founding Story</span>
      <h2 class="reveal reveal-delay-1">
        Born from a <em>love</em><br>for the extraordinary
      </h2>

      <p class="story-body reveal reveal-delay-2">
        Emera was born in 2025, in the verdant hills of Kerala, from a single
        conviction: that true luxury is not excess — it is the quiet certainty
        of something made exactly right. Founder Saja Mariyam spent a decade
        studying the atelier traditions of Europe and the master weavers of
        South Asia before returning home with a vision.
      </p>

      <p class="story-body reveal reveal-delay-3">
        Every Emera piece begins as a conversation between material and maker.
        We source only the finest full-grain leathers, hand-selected from
        tanneries that share our commitment to responsible practices. Each
        stitch, each edge, each finish is considered not as a step in
        production, but as an act of care.
      </p>

      <p class="story-body reveal reveal-delay-4">
        We believe the things we carry should feel like an extension of
        ourselves — quietly confident, enduring, and worthy of the life lived
        alongside them.
      </p>

      <div class="gold-rule" style="margin: 40px 0 32px; opacity: .4;"></div>

      <div class="reveal">
        <p class="story-signature">Saja Mariyam</p>
        <p class="story-sig-title">Founder · Emera Luxury</p>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════
       NUMBERS
  ════════════════════════════════════ -->
  <section class="numbers-section">
    <div class="numbers-grid">
      <div class="number-card reveal">
        <div class="number-big lux">04</div>
        <div class="number-label">Years of Excellence</div>
      </div>
      <div class="number-card reveal reveal-delay-1">
        <div class="number-big lux">12K+</div>
        <div class="number-label">Pieces Crafted</div>
      </div>
      <div class="number-card reveal reveal-delay-2">
        <div class="number-big lux">28</div>
        <div class="number-label">Artisan Partners</div>
      </div>
      <div class="number-card reveal reveal-delay-3">
        <div class="number-big lux">100%</div>
        <div class="number-label">Responsibly Sourced</div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════
       MISSION & VALUES
  ════════════════════════════════════ -->
  <section class="mission-section">

    <div class="mission-header">
      <span class="eyebrow reveal">What We Stand For</span>
      <h2 class="reveal reveal-delay-1">
        Three pillars of<br><em>everything we do</em>
      </h2>
      <p class="reveal reveal-delay-2">
        Our values are not aspirations — they are the architecture of every
        decision we make, from the sourcing room to your doorstep.
      </p>
    </div>

    <div class="values-grid">

      <div class="value-card reveal">
        <div class="value-num lux">01</div>
        <h3 class="value-title lux">Radical Honesty</h3>
        <p class="value-body">
          We tell the truth about what goes into our products — every material,
          every maker, every mile. No greenwashing. No vague promises.
          Only transparent practice.
        </p>
      </div>

      <div class="value-card reveal reveal-delay-1">
        <div class="value-num lux">02</div>
        <h3 class="value-title lux">Enduring Craft</h3>
        <p class="value-body">
          We design for decades, not seasons. Each Emera piece is built to
          outlast trend cycles, developing character as it ages alongside the
          person who carries it.
        </p>
      </div>

      <div class="value-card reveal reveal-delay-2">
        <div class="value-num lux">03</div>
        <h3 class="value-title lux">Human First</h3>
        <p class="value-body">
          Every artisan who touches an Emera piece is paid fairly and works
          with dignity. Luxury built on exploitation is not luxury — it is
          merely expensive.
        </p>
      </div>

    </div>
  </section>


  <!-- ═══════════════════════════════════
       TIMELINE
  ════════════════════════════════════ -->
  <section class="process-section">

    <div class="process-header">
      <span class="eyebrow reveal">Our Journey</span>
      <h2 class="lux reveal reveal-delay-1">The Story <em>So Far</em></h2>
      <p class="reveal reveal-delay-2">
        From a small studio in Calicut to homes across India
      </p>
    </div>

    <div class="timeline">

      <div class="timeline-item reveal">
        <div class="timeline-left">
          <div class="timeline-year">2020</div>
          <div class="timeline-event-title lux">The First Stitch</div>
          <div class="timeline-event-body">
            Emera opens its first atelier in Calicut, Kerala, with a team of
            six master craftspeople and a single collection of twelve bags.
          </div>
        </div>
        <div><div class="timeline-dot"></div></div>
        <div class="timeline-right"></div>
      </div>

      <div class="timeline-item reveal">
