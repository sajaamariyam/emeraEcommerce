                </button>
                <button onclick="ProfileApp.closeModal('delete-address-modal')" class="flex-1 px-6 py-3 border-2 border-stone-300 text-stone-700 text-[10px] tracking-[0.3em] uppercase font-black hover:bg-stone-100 transition-all">
