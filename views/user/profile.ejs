<style>
/* Tab Styles */
.tab-active {
    background-color: #f5f5f4;
    color: #000;
}

/* Modal Base Styles */
.modal {
    display: none;
}

.modal.active {
    display: flex !important;
}

.emera-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10,14,13,0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    opacity: 0;
    pointer-events: none;
    transition: opacity .4s ease;
}

.emera-overlay.active {
    opacity: 1;
    pointer-events: all;
}

.emera-modal {
    background: linear-gradient(145deg,#fdfbf7,#fff);
    border-radius: 28px;
    padding: 48px;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(16,66,47,.3), 0 0 80px rgba(16,66,47,.15);
    transform: scale(.92) translateY(20px);
    opacity: 0;
    transition: all .45s cubic-bezier(.34,1.56,.64,1);
}

.emera-overlay.active .emera-modal {
    transform: scale(1) translateY(0);
    opacity: 1;
}

/* Loading Spinner */
.spinner {
    border: 3px solid #f3f3f3;
    border-top: 3px solid #292524;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
    margin: 20px auto;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

/* Emerald Colors */
:root {
    --emerald-deep: #10422f;
    --emerald-rich: #1a5c42;
    --emerald-mid: #2d7a5f;
    --emerald-light: #87b5a3;
    --gold-accent: #c9a960;
    --charcoal: #2b2b2b;
    --ivory: #fdfbf7;
}

/* Success Icon Animation */
.success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    position: relative;
    animation: iconFloat 0.8s ease-out;
}

.success-checkmark {
    width: 80px;
    height: 80px;
    border-radius: 50%;
