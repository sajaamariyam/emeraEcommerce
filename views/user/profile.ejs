<!-- ============================================================ -->
<!-- JAVASCRIPT                                                    -->
<!-- ============================================================ -->
<script>
const ProfileApp = (function () {
    'use strict';

    let originalEmailAtEdit = null;
    let allTransactions     = [];
    let otpInterval         = null;
    let otpTimeLeft         = 300;

    const state = {
        currentUser: {
            name:         "<%= user.name %>",
            email:        "<%= user.email %>",
            phone:        "<%= user.phone || '' %>",
            profileImage: "<%= user.profileImage || '/images/default-avatar.svg' %>",
            googleId:     "<%= user.googleId || '' %>"
        },
        pendingEmailChange: null,
        addressToDelete:    null
    };

    // ─── Helpers ─────────────────────────────────────────────────
    function showFieldError(fieldId, errorId, show) {
        const f = document.getElementById(fieldId), e = document.getElementById(errorId);
        if (f) f.classList.toggle('input-error', show);
        if (e) e.classList.toggle('hidden', !show);
    }
    function clearFormErrors(formId) {
        const form = document.getElementById(formId); if (!form) return;
        form.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        form.querySelectorAll('[id$="-error"]').forEach(el => el.classList.add('hidden'));
    }
    const isValidPhone   = p => /^[6-9]\d{9}$/.test(p.replace(/\s/g, ''));
    const isValidPincode = p => /^\d{6}$/.test(p.trim());
    const isValidEmail   = e => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);

    async function safeFetch(url, options) {
        options = options || {};
        const res = await fetch(url, options);
        const ct  = res.headers.get('content-type') || '';
        if (!ct.includes('application/json')) {
            const text = await res.text();
            console.warn('[safeFetch] Non-JSON from ' + url + ' (' + res.status + '):', text.slice(0, 200));
            return { ok: false, status: res.status, data: { message: res.status === 401 ? 'Session expired. Please log in again.' : 'Server error (' + res.status + ')' } };
        }
        const data = await res.json();
        return { ok: res.ok, status: res.status, data: data };
    }

    function validateAddressForm(prefix) {
        let valid = true;
        var fields = [
            [prefix + 'firstName', prefix + 'firstName-error', function(v){ return !!v; }],
            [prefix + 'lastName',  prefix + 'lastName-error',  function(v){ return !!v; }],
            [prefix + 'phone',     prefix + 'phone-error',     function(v){ return !!v && isValidPhone(v); }],
            [prefix + 'address1',  prefix + 'address1-error',  function(v){ return !!v; }],
            [prefix + 'city',      prefix + 'city-error',      function(v){ return !!v; }],
            [prefix + 'state',     prefix + 'state-error',     function(v){ return !!v; }],
            [prefix + 'pincode',   prefix + 'pincode-error',   function(v){ return !!v && isValidPincode(v); }]
        ];
        fields.forEach(function(item) {
            var id = item[0], errId = item[1], fn = item[2];
            var val = (document.getElementById(id) ? document.getElementById(id).value : '').trim();
            var bad = !fn(val);
            showFieldError(id, errId, bad);
            if (bad) valid = false;
        });
        return valid;
    }

    // ─── Modal helpers ────────────────────────────────────────────
    function openModal(id)  { var m = document.getElementById(id); if (m) { m.classList.add('active'); document.body.style.overflow = 'hidden'; } }
    function closeModal(id) { var m = document.getElementById(id); if (m) { m.classList.remove('active'); document.body.style.overflow = ''; } if (id === 'email-verification-modal') clearInterval(otpInterval); }
    function openEmera(id)  { var m = document.getElementById(id); if (m) { m.classList.add('active'); document.body.style.overflow = 'hidden'; } }
    function closeEmera(id) { var m = document.getElementById(id); if (m) { m.classList.remove('active'); document.body.style.overflow = ''; } }
    function showError(msg) { var el = document.getElementById('error-message'); if (el) el.textContent = msg || 'Something went wrong.'; openEmera('error'); }

    function showWalletError(msg) {
        var banner = document.getElementById('wallet-error-banner');
        var text   = document.getElementById('wallet-error-text');
        if (text)   text.textContent = msg || 'Failed to load wallet data. Please try again.';
        if (banner) banner.classList.remove('hidden');
        document.getElementById('wallet-transactions').innerHTML = '';
    }
    function hideWalletError() {
        var banner = document.getElementById('wallet-error-banner');
        if (banner) banner.classList.add('hidden');
    }

    // ─── Tab management ───────────────────────────────────────────
    function showTab(name) {
        document.querySelectorAll('.tab-content').forEach(function(t) { t.style.display = 'none'; });
        document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('tab-active'); });
        var tab = document.getElementById(name + '-tab');
        if (tab) tab.style.display = 'block';
        var btn = document.querySelector('[data-tab="' + name + '"]');
        if (btn) btn.classList.add('tab-active');
        if (name === 'addresses') loadAddresses();
        if (name === 'wallet')    loadWallet();
    }

    // ─── Profile ──────────────────────────────────────────────────
    function openEditProfileModal() {
        clearFormErrors('edit-profile-form');
        var parts = state.currentUser.name.split(' ');
        document.getElementById('edit-firstname').value = parts[0];
        document.getElementById('edit-lastname').value  = parts.slice(1).join(' ') || '';
        document.getElementById('edit-email').value     = state.currentUser.email;
        document.getElementById('edit-phone').value     = state.currentUser.phone;
        if (state.currentUser.profileImage) document.getElementById('edit-profile-img-preview').src = state.currentUser.profileImage || '/images/default-avatar.svg';
        originalEmailAtEdit = state.currentUser.email;
        openModal('edit-profile-modal');
    }

    function previewProfileImage(file) {
        var errEl = document.getElementById('profile-image-error');
        errEl.classList.add('hidden');
        errEl.textContent = '';
        if (!file) return;
        if (!file.type.startsWith('image/')) {
            errEl.textContent = 'Only image files are allowed (JPG, PNG, WEBP)';
            errEl.classList.remove('hidden');
            document.getElementById('profile-image-input').value = '';
            return;
        }
        if (file.size > 2 * 1024 * 1024) {
            errEl.textContent = 'Image must be smaller than 2MB';
            errEl.classList.remove('hidden');
            document.getElementById('profile-image-input').value = '';
            return;
        }
        var reader = new FileReader();
        reader.onload = function(e) {
            document.getElementById('edit-profile-img-preview').src = e.target.result;
        };
        reader.readAsDataURL(file);
    }

    async function handleEditProfileSubmit(e) {
        e.preventDefault();
        var firstName  = document.getElementById('edit-firstname').value.trim();
        var lastName   = document.getElementById('edit-lastname').value.trim();
        var emailInput = document.getElementById('edit-email');
        var email      = emailInput.value.trim();
        var phone      = document.getElementById('edit-phone').value.trim();
        var imgFile    = document.getElementById('profile-image-input').files[0];

        var valid = true;
        var firstNameBad = !firstName || !/^[a-zA-Z\s]+$/.test(firstName);
        showFieldError('edit-firstname', 'edit-firstname-error', firstNameBad);
        if (firstNameBad) valid = false;
        if (!emailInput.disabled) { var bad = !email || !isValidEmail(email); showFieldError('edit-email', 'edit-email-error', bad); if (bad) valid = false; }
        var phoneBad = !phone || !isValidPhone(phone); showFieldError('edit-phone', 'edit-phone-error', phoneBad); if (phoneBad) valid = false;
        if (!valid) return;

        try {
            if (email !== originalEmailAtEdit && !emailInput.disabled) {
                var r = await safeFetch('/profile/request-email-otp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ newEmail: email }) });
                if (r.ok) {
                    var fd = new FormData();
                    fd.append('name', (firstName + ' ' + lastName).trim());
                    fd.append('phone', phone);
                    if (imgFile) fd.append('profileImage', imgFile);
                    state.pendingEmailChange = { formData: fd, newEmail: email };
                    document.getElementById('new-email-display').textContent = email;
                    closeModal('edit-profile-modal');
                    openModal('email-verification-modal');
                    startOtpTimer();
                    setTimeout(function() { document.getElementById('otp-code').focus(); }, 300);
                } else { showError(r.data.message || 'Failed to send verification code'); }
            } else {
                var fd2 = new FormData();
                fd2.append('name', (firstName + ' ' + lastName).trim());
                fd2.append('phone', phone);
                if (imgFile) fd2.append('profileImage', imgFile);
                var res = await fetch('/profile/edit', { method: 'POST', body: fd2 });
                if (res.ok) { closeModal('edit-profile-modal'); openEmera('profileUpdated'); setTimeout(function() { location.reload(); }, 1500); }
                else { var d = await res.json().catch(function() { return {}; }); showError(d.message || 'Failed to update profile'); }
            }
        } catch (err) { console.error(err); showError('Network error. Please try again.'); }
    }

    // ─── OTP ──────────────────────────────────────────────────────
    async function handleOTPVerification(e) {
        e.preventDefault();
        if (!state.pendingEmailChange) { showError('No pending email change found'); return; }
        var otp    = document.getElementById('otp-code').value.trim();
        var otpErr = document.getElementById('otp-error');
        if (otp.length !== 6) { otpErr.classList.remove('hidden'); return; }
        otpErr.classList.add('hidden');
        try {
            var vr = await safeFetch('/profile/verify-email-otp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ otp: otp }) });
            if (vr.ok) {
                if (state.pendingEmailChange.formData) await fetch('/profile/edit', { method: 'POST', body: state.pendingEmailChange.formData });
                var ur = await safeFetch('/profile/update-after-otp', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
                if (ur.ok) {
                    state.pendingEmailChange = null;
                    document.getElementById('otp-code').value = '';
                    closeModal('email-verification-modal');
                    openEmera('emailVerified');
                    setTimeout(function() { location.reload(); }, 1500);
                } else { showError(ur.data.message || 'Failed to update email'); }
            } else {
                document.getElementById('otp-code').value = '';
                document.getElementById('otp-code').focus();
                showError(vr.data.message || 'Invalid verification code');
            }
        } catch (err) { console.error(err); document.getElementById('otp-code').value = ''; showError('Network error. Please try again.'); }
    }

    function startOtpTimer() {
        clearInterval(otpInterval); otpTimeLeft = 300;
        var btn = document.getElementById('resend-otp-btn');
        btn.disabled = true;
        btn.classList.add('cursor-not-allowed', 'text-stone-400');
        btn.classList.remove('text-stone-600');
        updateOtpTimerUI();
        otpInterval = setInterval(function() {
            otpTimeLeft--; updateOtpTimerUI();
            if (otpTimeLeft <= 0) {
                clearInterval(otpInterval);
                document.getElementById('otp-timer').innerHTML = "Didn't receive the code?";
                btn.disabled = false;
                btn.classList.remove('cursor-not-allowed', 'text-stone-400');
                btn.classList.add('text-stone-600');
            }
        }, 1000);
    }
    function updateOtpTimerUI() {
        var m = Math.floor(otpTimeLeft / 60), s = otpTimeLeft % 60;
        document.getElementById('otp-timer').innerHTML = 'Resend code in <span class="font-semibold">' + String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0') + '</span>';
    }
    async function resendOTP() {
        if (!state.pendingEmailChange) { showError('No pending email change found'); return; }
        try {
            var r = await safeFetch('/profile/request-email-otp', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ newEmail: state.pendingEmailChange.newEmail }) });
            if (r.ok) startOtpTimer(); else showError('Failed to resend code');
        } catch (err) { showError('Network error. Please try again.'); }
    }

    // ─── Addresses ────────────────────────────────────────────────
    function openAddAddressModal() {
        document.getElementById('add-address-form').reset();
        clearFormErrors('add-address-form');
        openModal('add-address-modal');
    }

    async function loadAddresses() {
        var c = document.getElementById('addresses-container');
        c.innerHTML = '<div class="spinner"></div>';
        try {
            var r = await safeFetch('/profile/addresses');
            if (!r.ok) { c.innerHTML = '<p class="text-red-600 text-center">Failed to load addresses</p>'; return; }
            var addresses = Array.isArray(r.data) ? r.data : [];
            if (!addresses.length) {
                c.innerHTML = '<div class="col-span-2 text-center py-12"><p class="text-stone-400 mb-6">No saved addresses yet</p><button onclick="ProfileApp.openAddAddressModal()" class="px-8 py-3 bg-stone-950 text-white text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-stone-700 transition-all">Add Your First Address</button></div>';
            } else {
                c.innerHTML = addresses.map(function(a) {
                    return '<div class="border border-stone-200 p-8 relative">' +
                        (a.isDefault ? '<span class="absolute top-4 right-4 px-3 py-1 bg-stone-950 text-white text-[8px] tracking-wider uppercase">Default</span>' : '') +
                        '<h4 class="font-serif text-lg mb-4">' + a.fullName + '</h4>' +
                        '<p class="text-sm text-stone-600">' + a.street + '</p>' +
                        '<p class="text-sm text-stone-600">' + a.city + ', ' + a.state + ' ' + a.zipCode + '</p>' +
                        '<p class="text-sm text-stone-600 mb-2">India</p>' +
                        '<p class="text-sm text-stone-600 mb-6">Phone: ' + a.phone + '</p>' +
                        '<div class="flex gap-4">' +
                            '<button onclick=\'ProfileApp.openEditAddress(' + JSON.stringify(a).replace(/'/g,"&#39;") + ')\' class="text-[10px] uppercase tracking-wider text-stone-700 hover:underline font-bold">Edit</button>' +
                            '<button onclick="ProfileApp.deleteAddress(\'' + a._id + '\')" class="text-[10px] uppercase tracking-wider text-red-600 hover:underline font-bold">Delete</button>' +
                            (!a.isDefault ? '<button onclick="ProfileApp.setDefaultAddress(\'' + a._id + '\')" class="text-[10px] uppercase tracking-wider text-stone-600 hover:underline font-bold">Set as Default</button>' : '') +
                        '</div></div>';
                }).join('');
            }
        } catch (err) { console.error(err); c.innerHTML = '<p class="text-red-600 text-center">Failed to load addresses</p>'; }
    }

    async function handleAddAddressSubmit(e) {
        e.preventDefault();
        if (!validateAddressForm('add-')) return;
        var data = {
            firstName: document.getElementById('add-firstName').value.trim(),
            lastName:  document.getElementById('add-lastName').value.trim(),
            phone:     document.getElementById('add-phone').value.trim(),
            address1:  document.getElementById('add-address1').value.trim(),
            address2:  document.getElementById('add-address2').value.trim(),
            city:      document.getElementById('add-city').value.trim(),
            state:     document.getElementById('add-state').value.trim(),
            pincode:   document.getElementById('add-pincode').value.trim(),
            isDefault: document.getElementById('add-isDefault').checked
        };
        try {
            var r = await safeFetch('/profile/addresses', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            if (r.ok) { closeModal('add-address-modal'); openEmera('profileUpdated'); setTimeout(function() { closeEmera('profileUpdated'); loadAddresses(); }, 1500); }
            else showError((r.data || {}).message || 'Failed to add address');
        } catch (err) { showError('Network error. Please try again.'); }
    }

    function openEditAddress(a) {
        clearFormErrors('edit-address-form');
        document.getElementById('edit-address-id').value       = a._id;
        var parts = (a.fullName || '').split(' ');
        document.getElementById('edit-addr-firstName').value   = parts[0] || '';
        document.getElementById('edit-addr-lastName').value    = parts.slice(1).join(' ') || '';
        document.getElementById('edit-addr-phone').value       = a.phone || '';
        var street = (a.street || '').split(', ');
        document.getElementById('edit-addr-address1').value    = street[0] || '';
        document.getElementById('edit-addr-address2').value    = street.slice(1).join(', ') || '';
        document.getElementById('edit-addr-city').value        = a.city || '';
        document.getElementById('edit-addr-state').value       = a.state || '';
        document.getElementById('edit-addr-pincode').value     = a.zipCode || '';
        document.getElementById('edit-addr-isDefault').checked = a.isDefault || false;
        openModal('edit-address-modal');
    }

    async function handleEditAddressSubmit(e) {
        e.preventDefault();
        if (!validateAddressForm('edit-addr-')) return;
        var id   = document.getElementById('edit-address-id').value;
        var data = {
            firstName: document.getElementById('edit-addr-firstName').value.trim(),
            lastName:  document.getElementById('edit-addr-lastName').value.trim(),
            phone:     document.getElementById('edit-addr-phone').value.trim(),
            address1:  document.getElementById('edit-addr-address1').value.trim(),
            address2:  document.getElementById('edit-addr-address2').value.trim(),
            city:      document.getElementById('edit-addr-city').value.trim(),
            state:     document.getElementById('edit-addr-state').value.trim(),
            pincode:   document.getElementById('edit-addr-pincode').value.trim(),
            isDefault: document.getElementById('edit-addr-isDefault').checked
        };
        try {
            var r = await safeFetch('/profile/addresses/' + id, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
            if (r.ok) { closeModal('edit-address-modal'); openEmera('profileUpdated'); setTimeout(function() { closeEmera('profileUpdated'); loadAddresses(); }, 1500); }
            else showError((r.data || {}).message || 'Failed to update address');
        } catch (err) { showError('Network error. Please try again.'); }
    }

    function deleteAddress(id) { state.addressToDelete = id; openModal('delete-address-modal'); }

    async function confirmDeleteAddress() {
        try {
            var r = await safeFetch('/profile/addresses/' + state.addressToDelete, { method: 'DELETE' });
            if (r.ok) { closeModal('delete-address-modal'); openEmera('profileUpdated'); setTimeout(function() { closeEmera('profileUpdated'); loadAddresses(); }, 1500); }
            else showError('Failed to delete address');
        } catch (err) { showError('Network error. Please try again.'); }
    }

    async function setDefaultAddress(id) {
        try {
            var r = await safeFetch('/profile/addresses/' + id + '/set-default', { method: 'PUT' });
            if (r.ok) { openEmera('profileUpdated'); setTimeout(function() { closeEmera('profileUpdated'); loadAddresses(); }, 1500); }
            else showError('Failed to set default address');
        } catch (err) { showError('Network error. Please try again.'); }
    }

    // ─── Wallet ───────────────────────────────────────────────────
    async function loadWallet() {
        hideWalletError();
        document.getElementById('wallet-transactions').innerHTML = '<div class="spinner"></div>';
        document.getElementById('wallet-balance').textContent      = '\u2014';
        document.getElementById('wallet-total-credit').textContent = '\u2014';
        document.getElementById('wallet-total-debit').textContent  = '\u2014';
        try {
            var r = await safeFetch('/payment/wallet');
            if (!r.ok) {
                showWalletError(r.status === 401 ? 'Your session has expired. Please refresh and log in again.' : r.data.message || 'Failed to load wallet data.');
                return;
            }
            var balance = typeof r.data.balance === 'number' ? r.data.balance : parseFloat(r.data.balance) || 0;
            allTransactions = Array.isArray(r.data.transactions) ? r.data.transactions : [];
            document.getElementById('wallet-balance').textContent      = '\u20B9' + balance.toFixed(2);
            var credit = allTransactions.filter(function(t){ return t.type === 'credit'; }).reduce(function(s,t){ return s + (t.amount||0); }, 0);
            var debit  = allTransactions.filter(function(t){ return t.type === 'debit';  }).reduce(function(s,t){ return s + (t.amount||0); }, 0);
            document.getElementById('wallet-total-credit').textContent = '\u20B9' + credit.toFixed(2);
            document.getElementById('wallet-total-debit').textContent  = '\u20B9' + debit.toFixed(2);
            filterTransactions('all');
        } catch (err) { console.error(err); showWalletError('Network error. Please check your connection and try again.'); }
    }

    function retryLoadWallet() { loadWallet(); }

    function renderTransactions(txs) {
        var c = document.getElementById('wallet-transactions');
        // FIX 2: removed .reverse() — server already returns newest-first
        var list = txs;
        if (!list.length) {
            c.innerHTML = '<div class="text-center py-16 border border-stone-100"><p class="text-stone-400 text-sm">No transactions yet</p></div>';
            return;
        }
        c.innerHTML = '<div class="border border-stone-200 divide-y divide-stone-100">' + list.map(function(tx) {
            var isC  = tx.type === 'credit';
            var date = new Date(tx.date).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
            return '<div class="tx-row flex items-center justify-between px-8 py-5 transition-colors">' +
                '<div class="flex items-center gap-5">' +
                    '<div class="w-10 h-10 flex-shrink-0 flex items-center justify-center border-2 ' + (isC ? 'border-green-500 text-green-600' : 'border-red-400 text-red-500') + ' text-base font-bold select-none">' + (isC ? '+' : '\u2212') + '</div>' +
                    '<div><p class="text-sm text-gray-900 font-medium leading-snug">' + (tx.description || '\u2014') + '</p><p class="text-[11px] text-stone-400 mt-1 uppercase tracking-wider">' + date + '</p></div>' +
                '</div>' +
                '<p class="text-base font-serif font-bold ' + (isC ? 'text-green-700' : 'text-red-600') + ' ml-4 whitespace-nowrap">' + (isC ? '+' : '\u2212') + '\u20B9' + (tx.amount||0).toFixed(2) + '</p>' +
            '</div>';
        }).join('') + '</div>';
    }

    function filterTransactions(type) {
        document.querySelectorAll('.tx-filter-btn').forEach(function(b) {
            b.classList.remove('bg-stone-950','text-white','border-stone-950');
            b.classList.add('border-stone-300','text-stone-600');
        });
        var active = document.getElementById('filter-' + type);
        if (active) { active.classList.add('bg-stone-950','text-white','border-stone-950'); active.classList.remove('border-stone-300','text-stone-600'); }
        renderTransactions(type === 'all' ? allTransactions : allTransactions.filter(function(t){ return t.type === type; }));
    }

    function openAddMoneyModal() {
        document.getElementById('add-money-form').reset();
        document.getElementById('wallet-amount-error').classList.add('hidden');
        document.getElementById('wallet-add-amount').classList.remove('input-error');
        document.querySelectorAll('.quick-amount-btn').forEach(function(b){ b.classList.remove('bg-stone-950','text-white','border-stone-950'); });
        openModal('add-money-modal');
    }

    function setWalletAmount(amount) {
        document.getElementById('wallet-add-amount').value = amount;
        document.getElementById('wallet-amount-error').classList.add('hidden');
        document.getElementById('wallet-add-amount').classList.remove('input-error');
        document.querySelectorAll('.quick-amount-btn').forEach(function(b) {
            var match = b.textContent.trim() === '\u20B9' + amount;
            b.classList.toggle('bg-stone-950', match);
            b.classList.toggle('text-white', match);
            b.classList.toggle('border-stone-950', match);
        });
    }

    async function handleAddMoneySubmit(e) {
        e.preventDefault();
        var inp    = document.getElementById('wallet-add-amount');
        var errEl  = document.getElementById('wallet-amount-error');
        var amount = parseFloat(inp.value);
        if (!amount || amount < 1 || amount > 50000) { inp.classList.add('input-error'); errEl.classList.remove('hidden'); return; }
        inp.classList.remove('input-error'); errEl.classList.add('hidden');
        try {
            var r = await safeFetch('/payment/wallet/add', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ amount: amount }) });
            if (!r.ok) { showError(r.data.message || 'Failed to initiate payment'); return; }
            if (r.data.razorpayOrder) {
                closeModal('add-money-modal');
                launchWalletRazorpay(r.data.razorpayOrder, amount);
            } else if (r.data.success) {
                closeModal('add-money-modal');
                document.getElementById('wallet-success-msg').textContent = '\u20B9' + amount.toFixed(2) + ' has been added to your wallet.';
                openEmera('walletSuccess');
                setTimeout(function() { closeEmera('walletSuccess'); loadWallet(); }, 2000);
            }
        } catch (err) { console.error(err); showError('Network error. Please try again.'); }
    }

    function launchWalletRazorpay(rzpOrder, amount) {
        if (typeof Razorpay === 'undefined') { showError('Payment gateway not loaded. Please refresh the page.'); return; }
        var rzp = new Razorpay({
            key:         rzpOrder.key || '',
            amount:      rzpOrder.amount,
            currency:    rzpOrder.currency || 'INR',
            order_id:    rzpOrder.id,
            name:        'Emera',
            description: 'Adding \u20B9' + amount + ' to your wallet',
            handler: async function(response) {
                try {
                    var vr = await safeFetch('/payment/wallet/verify', {
                        method:  'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body:    JSON.stringify({
                            razorpay_order_id:   response.razorpay_order_id,
                            razorpay_payment_id: response.razorpay_payment_id,
                            razorpay_signature:  response.razorpay_signature
                        })
                    });
                    if (vr.ok && vr.data.success) {
                        document.getElementById('wallet-success-msg').textContent = '\u20B9' + amount.toFixed(2) + ' has been added to your wallet.';
                        openEmera('walletSuccess');
                        setTimeout(function() { closeEmera('walletSuccess'); loadWallet(); }, 2000);
                    } else {
                        showError(vr.data.message || 'Payment verification failed');
                    }
                } catch (err) {
                    console.error(err);
                    showError('Verification failed. Please contact support.');
                }
            },
            modal: {
                ondismiss: function() {
                    showError('Payment was cancelled. No amount was deducted from your account.');
                }
            },
            theme: { color: '#0c0a09' }
        });
        rzp.on('payment.failed', function(response) {
            console.error('Wallet payment failed:', response.error);
            showError('Payment failed: ' + (response.error.description || 'Please try again.'));
        });
        rzp.open();
    }

    // ─── Security ─────────────────────────────────────────────────
    async function handleChangePassword(e) {
        e.preventDefault();
        var curPw  = document.getElementById('current-password').value;
        var newPw  = document.getElementById('new-password').value;
        var conPw  = document.getElementById('confirm-password').value;
        var curEl  = document.getElementById('current-password');
        var newEl  = document.getElementById('new-password');
        var conEl  = document.getElementById('confirm-password');
        var curErr = document.getElementById('current-password-error');
        var newErr = document.getElementById('new-password-error');
        var conErr = document.getElementById('confirm-password-error');
        [curEl,newEl,conEl].forEach(function(el){ el.classList.remove('input-error'); });
        [curErr,newErr,conErr].forEach(function(el){ el.classList.add('hidden'); });
        var valid = true;
        if (!curPw) { curEl.classList.add('input-error'); curErr.classList.remove('hidden'); valid = false; }
        var pwBad = !newPw || newPw.length < 8 || !/[A-Z]/.test(newPw) || !/[a-z]/.test(newPw) || !/[0-9]/.test(newPw);
        if (pwBad) { newEl.classList.add('input-error'); newErr.classList.remove('hidden'); valid = false; }
        if (!conPw || newPw !== conPw) { conEl.classList.add('input-error'); conErr.textContent = !conPw ? 'Please confirm your new password' : 'Passwords do not match'; conErr.classList.remove('hidden'); valid = false; }
        if (!valid) return;
        try {
            var r = await safeFetch('/profile/change-password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ currentPassword: curPw, newPassword: newPw }) });
            if (!r.ok) { showError(r.data.message || 'Failed to change password'); return; }
            var tEl = document.querySelector('#profileUpdated .modal-title');
            var sEl = document.querySelector('#profileUpdated .modal-subtitle');
            var oT  = tEl.textContent, oS = sEl.textContent;
            tEl.textContent = 'Password Changed';
            sEl.textContent = 'Your password has been updated successfully.';
            openEmera('profileUpdated');
            e.target.reset();
            setTimeout(function() { closeEmera('profileUpdated'); tEl.textContent = oT; sEl.textContent = oS; }, 1500);
        } catch (err) { showError('Network error. Please try again.'); }
    }

    function handleForgotPassword() { window.location.href = '/forgot-password'; }

    // ─── Referral ─────────────────────────────────────────────────
    function copyReferralLink() {
        var input = document.getElementById('referral-link-input');
        var msg   = document.getElementById('referral-copied-msg');
        var btn   = document.getElementById('copy-referral-btn');
        navigator.clipboard.writeText(input.value).then(function() {
            msg.classList.remove('hidden');
            btn.textContent = 'Copied!';
            setTimeout(function() { msg.classList.add('hidden'); btn.textContent = 'Copy Link'; }, 2500);
        }).catch(function() {
            input.select();
            document.execCommand('copy');
            msg.classList.remove('hidden');
            setTimeout(function() { msg.classList.add('hidden'); }, 2500);
        });
    }

    function copyReferralCode() {
        var code = document.getElementById('referral-code-display').textContent.trim();
        var msg  = document.getElementById('referral-code-copied-msg');
        var btn  = document.getElementById('copy-code-btn');
        navigator.clipboard.writeText(code).then(function() {
            msg.classList.remove('hidden');
            btn.textContent = 'Copied!';
            setTimeout(function() { msg.classList.add('hidden'); btn.textContent = 'Copy Code'; }, 2500);
        }).catch(function() {
            var el = document.getElementById('referral-code-display');
            var range = document.createRange();
            range.selectNode(el);
            window.getSelection().removeAllRanges();
            window.getSelection().addRange(range);
            document.execCommand('copy');
            msg.classList.remove('hidden');
            setTimeout(function() { msg.classList.add('hidden'); }, 2500);
        });
    }

    // ─── Init ─────────────────────────────────────────────────────
    function init() {
        showTab('profile');
        var imgInput = document.getElementById('profile-image-input');
        if (imgInput) imgInput.addEventListener('change', function(e) { if (e.target.files[0]) previewProfileImage(e.target.files[0]); });
        var epf = document.getElementById('edit-profile-form');      if (epf) epf.addEventListener('submit', handleEditProfileSubmit);
        var vef = document.getElementById('verify-email-form');      if (vef) vef.addEventListener('submit', handleOTPVerification);
        var aaf = document.getElementById('add-address-form');       if (aaf) aaf.addEventListener('submit', handleAddAddressSubmit);
        var eaf = document.getElementById('edit-address-form');      if (eaf) eaf.addEventListener('submit', handleEditAddressSubmit);
        var cpf = document.getElementById('change-password-form');   if (cpf) cpf.addEventListener('submit', handleChangePassword);
        var amf = document.getElementById('add-money-form');         if (amf) amf.addEventListener('submit', handleAddMoneySubmit);

        document.querySelectorAll('.modal').forEach(function(m) { m.addEventListener('click', function(e) { if (e.target === m) closeModal(m.id); }); });
        document.querySelectorAll('.emera-overlay').forEach(function(o) { o.addEventListener('click', function(e) { if (e.target === o) closeEmera(o.id); }); });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.active').forEach(function(m) { closeModal(m.id); });
                document.querySelectorAll('.emera-overlay.active').forEach(function(o) { closeEmera(o.id); });
            }
        });
    }

    return {
        init, showTab, openModal, closeModal, openEmera, closeEmera,
        openEditProfileModal, openAddAddressModal, openEditAddress,
        deleteAddress, confirmDeleteAddress, setDefaultAddress,
        resendOTP, handleForgotPassword,
        copyReferralLink, copyReferralCode,
        openAddMoneyModal, setWalletAmount, filterTransactions,
        retryLoadWallet
    };
})();

document.addEventListener('DOMContentLoaded', ProfileApp.init);
</script>

