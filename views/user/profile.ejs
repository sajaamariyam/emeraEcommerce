<style>
.tab-active { background-color: #f5f5f4; color: #000; }
.modal { display: none; }
.modal.active { display: flex !important; }
.input-error { border-color: #ef4444 !important; }

.emera-overlay {
    position: fixed; inset: 0; background: rgba(10,14,13,0.85);
    backdrop-filter: blur(8px); display: flex;
    align-items: center; justify-content: center;
    z-index: 3000; opacity: 0; pointer-events: none; transition: opacity .4s ease;
}
.emera-overlay.active { opacity: 1; pointer-events: all; }
.emera-modal {
    background: linear-gradient(145deg,#fdfbf7,#fff); border-radius: 28px; padding: 48px;
    max-width: 480px; width: 100%;
    box-shadow: 0 20px 60px rgba(16,66,47,.3), 0 0 80px rgba(16,66,47,.15);
    transform: scale(.92) translateY(20px); opacity: 0;
    transition: all .45s cubic-bezier(.34,1.56,.64,1);
}
.emera-overlay.active .emera-modal { transform: scale(1) translateY(0); opacity: 1; }

.spinner { border: 3px solid #f3f3f3; border-top: 3px solid #292524; border-radius: 50%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 20px auto; }
@keyframes spin { 0%{transform:rotate(0deg)} 100%{transform:rotate(360deg)} }

:root { --emerald-deep:#10422f; --emerald-rich:#1a5c42; --emerald-mid:#2d7a5f; --charcoal:#2b2b2b; --ivory:#fdfbf7; }

.success-icon { width:80px; height:80px; margin:0 auto 24px; position:relative; animation:iconFloat .8s ease-out; }
.success-checkmark {
    width:80px; height:80px; border-radius:50%;
    background:linear-gradient(135deg,var(--emerald-rich),var(--emerald-mid));
    display:flex; align-items:center; justify-content:center; position:relative;
    animation:emeraldGlow 2s ease-in-out infinite;
}
.success-checkmark::before { content:'✓'; color:white; font-size:42px; font-weight:300; animation:checkPop .6s cubic-bezier(.34,1.56,.64,1) .3s backwards; }
@keyframes iconFloat { 0%{transform:translateY(20px) scale(.8);opacity:0} 100%{transform:translateY(0) scale(1);opacity:1} }
@keyframes checkPop  { 0%{transform:scale(0);opacity:0} 100%{transform:scale(1);opacity:1} }
@keyframes emeraldGlow {
    0%,100%{box-shadow:0 0 20px rgba(29,122,95,.3),0 0 40px rgba(29,122,95,.15),inset 0 0 20px rgba(255,255,255,.1)}
    50%{box-shadow:0 0 30px rgba(29,122,95,.5),0 0 60px rgba(29,122,95,.25),inset 0 0 30px rgba(255,255,255,.15)}
}
.error-icon { width:80px; height:80px; margin:0 auto 24px; border-radius:50%; background:linear-gradient(135deg,#8b7355,#a68968); display:flex; align-items:center; justify-content:center; animation:shakeError .5s ease-out; }
.error-icon::before { content:'!'; color:white; font-size:42px; font-weight:500; }
@keyframes shakeError { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-8px)} 75%{transform:translateX(8px)} }

.emera-btn { width:100%; padding:16px 32px; background:linear-gradient(135deg,var(--emerald-rich),var(--emerald-mid)); color:white; border:none; border-radius:12px; font-size:16px; font-weight:500; cursor:pointer; transition:all .3s ease; margin-top:32px; font-family:'Inter',sans-serif; letter-spacing:.3px; }
.emera-btn:hover { transform:translateY(-2px); box-shadow:0 8px 24px rgba(29,122,95,.3),0 0 40px rgba(29,122,95,.2); }
.emera-btn:active { transform:translateY(0); }

.modal-title { font-size:32px; font-weight:500; color:var(--charcoal); margin-bottom:12px; letter-spacing:-.5px; }
.modal-subtitle { font-size:16px; color:#6b6b6b; line-height:1.6; font-weight:300; }

@keyframes sparkle { 0%,100%{opacity:0} 50%{opacity:1} }
.sparkle { position:absolute; width:4px; height:4px; background:white; border-radius:50%; animation:sparkle 2s ease-in-out infinite; }
.sparkle:nth-child(1){top:15%;right:25%;animation-delay:0s}
.sparkle:nth-child(2){top:30%;right:15%;animation-delay:.6s}
.sparkle:nth-child(3){top:45%;right:30%;animation-delay:1.2s}

.tx-row:hover { background-color: #fafaf9; }
</style>


<!-- ============================================================ -->
<!-- JAVASCRIPT                                                    -->
<!-- ============================================================ -->
<script>
const ProfileApp = (function() {
    'use strict';

    let originalEmailAtEdit = null;
    let allTransactions     = [];
    let otpInterval         = null;
    let otpTimeLeft         = 300;

    const state = {
        currentUser: {
            name:         "<%= user.name %>",
            email:        "<%= user.email %>",
            phone:        "<%= user.phone || '' %>",
            profileImage: "<%= user.profileImage || '' %>",
            googleId:     "<%= user.googleId || '' %>"
        },
        pendingEmailChange: null,
        addressToDelete:    null
    };

    // ---- Validation helpers ----
    function showFieldError(fieldId, errorId, show) {
        const f = document.getElementById(fieldId), e = document.getElementById(errorId);
        if (!f || !e) return;
        f.classList.toggle('input-error', show);
        e.classList.toggle('hidden', !show);
    }
    function clearFormErrors(formId) {
        const form = document.getElementById(formId);
        if (!form) return;
        form.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        form.querySelectorAll('[id$="-error"]').forEach(el => el.classList.add('hidden'));
    }
    const isValidPhone   = p => /^[6-9]\d{9}$/.test(p.replace(/\s/g,''));
    const isValidPincode = p => /^\d{6}$/.test(p.trim());
    const isValidEmail   = e => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);

    function validateAddressForm(prefix) {
        let valid = true;
        [
            [prefix+'firstName', prefix+'firstName-error', v => !!v],
            [prefix+'lastName',  prefix+'lastName-error',  v => !!v],
            [prefix+'phone',     prefix+'phone-error',     v => !!v && isValidPhone(v)],
            [prefix+'address1',  prefix+'address1-error',  v => !!v],
            [prefix+'city',      prefix+'city-error',      v => !!v],
            [prefix+'state',     prefix+'state-error',     v => !!v],
            [prefix+'pincode',   prefix+'pincode-error',   v => !!v && isValidPincode(v)],
        ].forEach(([id, errId, fn]) => {
            const val = (document.getElementById(id)?.value || '').trim();
            const bad = !fn(val);
            showFieldError(id, errId, bad);
            if (bad) valid = false;
        });
        return valid;
    }

    // ---- Modal helpers ----
    function openModal(id)  { const m = document.getElementById(id); if (m) { m.classList.add('active'); document.body.style.overflow='hidden'; } }
    function closeModal(id) { const m = document.getElementById(id); if (m) { m.classList.remove('active'); document.body.style.overflow=''; } if (id==='email-verification-modal') clearInterval(otpInterval); }
    function openEmera(id)  { const m = document.getElementById(id); if (m) { m.classList.add('active'); document.body.style.overflow='hidden'; } }
    function closeEmera(id) { const m = document.getElementById(id); if (m) { m.classList.remove('active'); document.body.style.overflow=''; } }
    function showError(msg) { const el = document.getElementById('error-message'); if (el) el.textContent = msg; openEmera('error'); }

    // ---- Tab management ----
    function showTab(name) {
        document.querySelectorAll('.tab-content').forEach(t => t.style.display='none');
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('tab-active'));
        const tab = document.getElementById(name+'-tab');
        if (tab) tab.style.display = 'block';
        const btn = document.querySelector(`[data-tab="${name}"]`);
        if (btn) btn.classList.add('tab-active');
        if (name === 'addresses') loadAddresses();
        if (name === 'wallet')    loadWallet();
    }

    // ---- Profile ----
    function openEditProfileModal() {
        clearFormErrors('edit-profile-form');
        const parts = state.currentUser.name.split(' ');
        document.getElementById('edit-firstname').value = parts[0];
        document.getElementById('edit-lastname').value  = parts.slice(1).join(' ') || '';
        document.getElementById('edit-email').value     = state.currentUser.email;
        document.getElementById('edit-phone').value     = state.currentUser.phone;
        if (state.currentUser.profileImage) document.getElementById('edit-profile-img-preview').src = state.currentUser.profileImage;
        originalEmailAtEdit = state.currentUser.email;
        openModal('edit-profile-modal');
    }

    function previewProfileImage(file) {
        if (!file || !file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = e => { document.getElementById('edit-profile-img-preview').src = e.target.result; };
        reader.readAsDataURL(file);
    }

    async function handleEditProfileSubmit(e) {
        e.preventDefault();
        const firstName  = document.getElementById('edit-firstname').value.trim();
        const lastName   = document.getElementById('edit-lastname').value.trim();
        const emailInput = document.getElementById('edit-email');
        const email      = emailInput.value.trim();
        const phone      = document.getElementById('edit-phone').value.trim();
        const imgFile    = document.getElementById('profile-image-input').files[0];

        let valid = true;
        showFieldError('edit-firstname','edit-firstname-error', !firstName); if(!firstName) valid=false;
        if (!emailInput.disabled) { const bad=!email||!isValidEmail(email); showFieldError('edit-email','edit-email-error',bad); if(bad) valid=false; }
        const phoneBad=!phone||!isValidPhone(phone); showFieldError('edit-phone','edit-phone-error',phoneBad); if(phoneBad) valid=false;
        if (!valid) return;

        try {
            if (email !== originalEmailAtEdit && !emailInput.disabled) {
                const res = await fetch('/profile/request-email-otp',{ method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({newEmail:email}) });
                if (res.ok) {
                    const fd=new FormData(); fd.append('name',`${firstName} ${lastName}`.trim()); fd.append('phone',phone); if(imgFile) fd.append('profileImage',imgFile);
                    state.pendingEmailChange = { formData:fd, newEmail:email };
                    document.getElementById('new-email-display').textContent = email;
                    closeModal('edit-profile-modal'); openModal('email-verification-modal'); startOtpTimer();
                    setTimeout(()=>document.getElementById('otp-code').focus(),300);
                } else { showError((await res.json()).message||'Failed to send verification code'); }
            } else {
                const fd=new FormData(); fd.append('name',`${firstName} ${lastName}`.trim()); fd.append('phone',phone); if(imgFile) fd.append('profileImage',imgFile);
                const res=await fetch('/profile/edit',{method:'POST',body:fd});
                if(res.ok){ closeModal('edit-profile-modal'); openEmera('profileUpdated'); setTimeout(()=>location.reload(),1500); }
                else { showError((await res.json()).message||'Failed to update profile'); }
            }
        } catch(err){ showError('Network error. Please try again.'); }
    }

    // ---- OTP ----
    async function handleOTPVerification(e) {
        e.preventDefault();
        if (!state.pendingEmailChange) { showError('No pending email change found'); return; }
        const otp=document.getElementById('otp-code').value.trim();
        const otpErr=document.getElementById('otp-error');
        if (otp.length!==6) { otpErr.classList.remove('hidden'); return; }
        otpErr.classList.add('hidden');
        try {
            const verRes=await fetch('/profile/verify-email-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({otp})});
            if (verRes.ok) {
                if(state.pendingEmailChange.formData) await fetch('/profile/edit',{method:'POST',body:state.pendingEmailChange.formData});
                const upRes=await fetch('/profile/update-after-otp',{method:'POST',headers:{'Content-Type':'application/json'}});
                if(upRes.ok){ state.pendingEmailChange=null; document.getElementById('otp-code').value=''; closeModal('email-verification-modal'); openEmera('emailVerified'); setTimeout(()=>location.reload(),1500); }
                else { showError((await upRes.json()).message||'Failed to update email'); }
            } else {
                document.getElementById('otp-code').value=''; document.getElementById('otp-code').focus();
                showError((await verRes.json()).message||'Invalid verification code');
            }
        } catch(err){ document.getElementById('otp-code').value=''; showError('Network error. Please try again.'); }
    }

    function startOtpTimer() {
        clearInterval(otpInterval); otpTimeLeft=300;
        const btn=document.getElementById('resend-otp-btn');
        btn.disabled=true; btn.classList.add('cursor-not-allowed','text-stone-400'); btn.classList.remove('text-stone-600');
        updateOtpTimerUI();
        otpInterval=setInterval(()=>{
            otpTimeLeft--; updateOtpTimerUI();
            if(otpTimeLeft<=0){ clearInterval(otpInterval); document.getElementById('otp-timer').innerHTML="Didn't receive the code?"; btn.disabled=false; btn.classList.remove('cursor-not-allowed','text-stone-400'); btn.classList.add('text-stone-600'); }
        },1000);
    }
    function updateOtpTimerUI(){
        const m=Math.floor(otpTimeLeft/60), s=otpTimeLeft%60;
        document.getElementById('otp-timer').innerHTML=`Resend code in <span class="font-semibold">${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}</span>`;
    }
    async function resendOTP(){
        if(!state.pendingEmailChange){ showError('No pending email change found'); return; }
        try {
            const res=await fetch('/profile/request-email-otp',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({newEmail:state.pendingEmailChange.newEmail})});
            if(res.ok) startOtpTimer(); else showError('Failed to resend code');
        } catch(err){ showError('Network error. Please try again.'); }
    }

    // ---- Addresses ----
    function openAddAddressModal(){ document.getElementById('add-address-form').reset(); clearFormErrors('add-address-form'); openModal('add-address-modal'); }

    async function loadAddresses(){
        const c=document.getElementById('addresses-container'); c.innerHTML='<div class="spinner"></div>';
        try {
            const addresses=await (await fetch('/profile/addresses')).json();
            if(!addresses.length){
                c.innerHTML=`<div class="col-span-2 text-center py-12"><p class="text-stone-400 mb-6">No saved addresses yet</p><button onclick="ProfileApp.openAddAddressModal()" class="px-8 py-3 bg-stone-950 text-white text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-stone-700 transition-all">Add Your First Address</button></div>`;
            } else {
                c.innerHTML=addresses.map(a=>`
                    <div class="border border-stone-200 p-8 relative">
                        ${a.isDefault?`<span class="absolute top-4 right-4 px-3 py-1 bg-stone-950 text-white text-[8px] tracking-wider uppercase">Default</span>`:''}
                        <h4 class="font-serif text-lg mb-4">${a.fullName}</h4>
                        <p class="text-sm text-stone-600">${a.street}</p>
                        <p class="text-sm text-stone-600">${a.city}, ${a.state} ${a.zipCode}</p>
                        <p class="text-sm text-stone-600 mb-2">India</p>
                        <p class="text-sm text-stone-600 mb-6">Phone: ${a.phone}</p>
                        <div class="flex gap-4">
                            <button onclick='ProfileApp.openEditAddress(${JSON.stringify(a).replace(/'/g,"&#39;")})' class="text-[10px] uppercase tracking-wider text-stone-700 hover:underline font-bold">Edit</button>
                            <button onclick="ProfileApp.deleteAddress('${a._id}')" class="text-[10px] uppercase tracking-wider text-red-600 hover:underline font-bold">Delete</button>
                            ${!a.isDefault?`<button onclick="ProfileApp.setDefaultAddress('${a._id}')" class="text-[10px] uppercase tracking-wider text-stone-600 hover:underline font-bold">Set as Default</button>`:''}
                        </div>
                    </div>`).join('');
            }
        } catch(err){ c.innerHTML='<p class="text-red-600 text-center">Failed to load addresses</p>'; }
    }

    async function handleAddAddressSubmit(e){
        e.preventDefault(); if(!validateAddressForm('add-')) return;
        const data={ firstName:document.getElementById('add-firstName').value.trim(), lastName:document.getElementById('add-lastName').value.trim(), phone:document.getElementById('add-phone').value.trim(), address1:document.getElementById('add-address1').value.trim(), address2:document.getElementById('add-address2').value.trim(), city:document.getElementById('add-city').value.trim(), state:document.getElementById('add-state').value.trim(), pincode:document.getElementById('add-pincode').value.trim(), isDefault:document.getElementById('add-isDefault').checked };
        try {
            const res=await fetch('/profile/addresses',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
            if(res.ok){ closeModal('add-address-modal'); openEmera('profileUpdated'); setTimeout(()=>{ closeEmera('profileUpdated'); loadAddresses(); },1500); }
            else showError((await res.json()).message||'Failed to add address');
        } catch(err){ showError('Network error. Please try again.'); }
    }

    function openEditAddress(a){
        clearFormErrors('edit-address-form');
        document.getElementById('edit-address-id').value=a._id;
        const parts=(a.fullName||'').split(' ');
        document.getElementById('edit-addr-firstName').value=parts[0]||'';
        document.getElementById('edit-addr-lastName').value=parts.slice(1).join(' ')||'';
        document.getElementById('edit-addr-phone').value=a.phone||'';
        const street=(a.street||'').split(', ');
        document.getElementById('edit-addr-address1').value=street[0]||'';
        document.getElementById('edit-addr-address2').value=street.slice(1).join(', ')||'';
        document.getElementById('edit-addr-city').value=a.city||'';
        document.getElementById('edit-addr-state').value=a.state||'';
        document.getElementById('edit-addr-pincode').value=a.zipCode||'';
        document.getElementById('edit-addr-isDefault').checked=a.isDefault||false;
        openModal('edit-address-modal');
    }

    async function handleEditAddressSubmit(e){
        e.preventDefault(); if(!validateAddressForm('edit-addr-')) return;
        const id=document.getElementById('edit-address-id').value;
        const data={ firstName:document.getElementById('edit-addr-firstName').value.trim(), lastName:document.getElementById('edit-addr-lastName').value.trim(), phone:document.getElementById('edit-addr-phone').value.trim(), address1:document.getElementById('edit-addr-address1').value.trim(), address2:document.getElementById('edit-addr-address2').value.trim(), city:document.getElementById('edit-addr-city').value.trim(), state:document.getElementById('edit-addr-state').value.trim(), pincode:document.getElementById('edit-addr-pincode').value.trim(), isDefault:document.getElementById('edit-addr-isDefault').checked };
        try {
            const res=await fetch(`/profile/addresses/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
            if(res.ok){ closeModal('edit-address-modal'); openEmera('profileUpdated'); setTimeout(()=>{ closeEmera('profileUpdated'); loadAddresses(); },1500); }
            else showError((await res.json()).message||'Failed to update address');
        } catch(err){ showError('Network error. Please try again.'); }
    }

    function deleteAddress(id){ state.addressToDelete=id; openModal('delete-address-modal'); }
    async function confirmDeleteAddress(){
        try {
            const res=await fetch(`/profile/addresses/${state.addressToDelete}`,{method:'DELETE'});
            if(res.ok){ closeModal('delete-address-modal'); openEmera('profileUpdated'); setTimeout(()=>{ closeEmera('profileUpdated'); loadAddresses(); },1500); }
            else showError('Failed to delete address');
        } catch(err){ showError('Network error. Please try again.'); }
    }
    async function setDefaultAddress(id){
        try {
            const res=await fetch(`/profile/addresses/${id}/set-default`,{method:'PUT'});
            if(res.ok){ openEmera('profileUpdated'); setTimeout(()=>{ closeEmera('profileUpdated'); loadAddresses(); },1500); }
            else showError('Failed to set default address');
        } catch(err){ showError('Network error. Please try again.'); }
    }

    // ---- Wallet ----
    async function loadWallet(){
        document.getElementById('wallet-transactions').innerHTML='<div class="spinner"></div>';
        try {
            const data=await (await fetch('/profile/wallet')).json();
            document.getElementById('wallet-balance').textContent='₹'+(data.balance||0).toFixed(2);
            allTransactions=data.transactions||[];
            const credit=allTransactions.filter(t=>t.type==='credit').reduce((s,t)=>s+t.amount,0);
            const debit =allTransactions.filter(t=>t.type==='debit').reduce((s,t)=>s+t.amount,0);
            document.getElementById('wallet-total-credit').textContent='₹'+credit.toFixed(2);
            document.getElementById('wallet-total-debit').textContent ='₹'+debit.toFixed(2);
            renderTransactions(allTransactions);
        } catch(err){ document.getElementById('wallet-transactions').innerHTML='<p class="text-red-600 text-center py-8">Failed to load wallet data</p>'; }
    }

    function renderTransactions(txs){
        const c=document.getElementById('wallet-transactions');
        const list=[...txs].reverse();
        if(!list.length){ c.innerHTML='<div class="text-center py-16 border border-stone-100"><p class="text-stone-400 text-sm">No transactions yet</p></div>'; return; }
        c.innerHTML=`<div class="border border-stone-200 divide-y divide-stone-100">${list.map(tx=>{
            const isC=tx.type==='credit';
            const date=new Date(tx.date).toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
            return `<div class="tx-row flex items-center justify-between px-8 py-5 transition-colors">
                <div class="flex items-center gap-5">
                    <div class="w-10 h-10 flex-shrink-0 flex items-center justify-center border-2 ${isC?'border-green-500 text-green-600':'border-red-400 text-red-500'} text-base font-bold select-none">${isC?'+':'−'}</div>
                    <div>
                        <p class="text-sm text-gray-900 font-medium leading-snug">${tx.description}</p>
                        <p class="text-[11px] text-stone-400 mt-1 uppercase tracking-wider">${date}</p>
                    </div>
                </div>
                <p class="text-base font-serif font-bold ${isC?'text-green-700':'text-red-600'} ml-4 whitespace-nowrap">${isC?'+':'−'}₹${(tx.amount||0).toFixed(2)}</p>
            </div>`;
        }).join('')}</div>`;
    }

    function filterTransactions(type){
        document.querySelectorAll('.tx-filter-btn').forEach(b=>{ b.classList.remove('bg-stone-950','text-white','border-stone-950'); b.classList.add('border-stone-300','text-stone-600'); });
        const active=document.getElementById('filter-'+type);
        if(active){ active.classList.add('bg-stone-950','text-white','border-stone-950'); active.classList.remove('border-stone-300','text-stone-600'); }
        renderTransactions(type==='all'?allTransactions:allTransactions.filter(t=>t.type===type));
    }

    function openAddMoneyModal(){
        document.getElementById('add-money-form').reset();
        document.getElementById('wallet-amount-error').classList.add('hidden');
        document.getElementById('wallet-add-amount').classList.remove('input-error');
        document.querySelectorAll('.quick-amount-btn').forEach(b=>b.classList.remove('bg-stone-950','text-white','border-stone-950'));
        openModal('add-money-modal');
    }

    function setWalletAmount(amount){
        document.getElementById('wallet-add-amount').value=amount;
        document.getElementById('wallet-amount-error').classList.add('hidden');
        document.getElementById('wallet-add-amount').classList.remove('input-error');
        document.querySelectorAll('.quick-amount-btn').forEach(b=>{
            const match=b.textContent.trim()==='₹'+amount;
            b.classList.toggle('bg-stone-950',match); b.classList.toggle('text-white',match); b.classList.toggle('border-stone-950',match);
        });
    }

    async function handleAddMoneySubmit(e){
        e.preventDefault();
        const inp=document.getElementById('wallet-add-amount'), errEl=document.getElementById('wallet-amount-error');
        const amount=parseFloat(inp.value);
        if(!amount||amount<1||amount>50000){ inp.classList.add('input-error'); errEl.classList.remove('hidden'); return; }
        inp.classList.remove('input-error'); errEl.classList.add('hidden');
        try {
            const res=await fetch('/profile/wallet/add',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({amount})});
            const data=await res.json();
            if(!res.ok){ showError(data.message||'Failed to initiate payment'); return; }
            if(data.razorpayOrder){ closeModal('add-money-modal'); launchWalletRazorpay(data.razorpayOrder,amount); }
            else if(data.success){ closeModal('add-money-modal'); document.getElementById('wallet-success-msg').textContent=`₹${amount.toFixed(2)} has been added to your wallet.`; openEmera('walletSuccess'); setTimeout(()=>{ closeEmera('walletSuccess'); loadWallet(); },2000); }
        } catch(err){ showError('Network error. Please try again.'); }
    }

    function launchWalletRazorpay(rzpOrder,amount){
        if(typeof Razorpay==='undefined'){ showError('Payment gateway not loaded. Please refresh the page.'); return; }
        new Razorpay({
            key:rzpOrder.key||'', amount:rzpOrder.amount, currency:rzpOrder.currency||'INR', order_id:rzpOrder.id,
            name:'Wallet Top-up', description:`Adding ₹${amount} to your wallet`,
            handler:async function(response){
                try {
                    const vRes=await fetch('/profile/wallet/verify',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({razorpay_order_id:response.razorpay_order_id,razorpay_payment_id:response.razorpay_payment_id,razorpay_signature:response.razorpay_signature})});
                    const vData=await vRes.json();
                    if(vData.success){ document.getElementById('wallet-success-msg').textContent=`₹${amount.toFixed(2)} has been added to your wallet.`; openEmera('walletSuccess'); setTimeout(()=>{ closeEmera('walletSuccess'); loadWallet(); },2000); }
                    else showError(vData.message||'Payment verification failed');
                } catch(err){ showError('Verification failed. Please contact support.'); }
            },
            modal:{ ondismiss:function(){} }, theme:{ color:'#0c0a09' }
        }).open();
    }

    // ---- Security ----
    async function handleChangePassword(e){
        e.preventDefault();
        const curPw=document.getElementById('current-password').value;
        const newPw=document.getElementById('new-password').value;
        const conPw=document.getElementById('confirm-password').value;
        const curEl=document.getElementById('current-password'), newEl=document.getElementById('new-password'), conEl=document.getElementById('confirm-password');
        const curErr=document.getElementById('current-password-error'), newErr=document.getElementById('new-password-error'), conErr=document.getElementById('confirm-password-error');
        [curEl,newEl,conEl].forEach(el=>el.classList.remove('input-error'));
        [curErr,newErr,conErr].forEach(el=>el.classList.add('hidden'));
        let valid=true;
        if(!curPw){ curEl.classList.add('input-error'); curErr.classList.remove('hidden'); valid=false; }
        const pwBad=!newPw||newPw.length<8||!/[A-Z]/.test(newPw)||!/[a-z]/.test(newPw)||!/[0-9]/.test(newPw);
        if(pwBad){ newEl.classList.add('input-error'); newErr.classList.remove('hidden'); valid=false; }
        if(!conPw||newPw!==conPw){ conEl.classList.add('input-error'); conErr.textContent=!conPw?'Please confirm your new password':'Passwords do not match'; conErr.classList.remove('hidden'); valid=false; }
        if(!valid) return;
        try {
            const res=await fetch('/profile/change-password',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({currentPassword:curPw,newPassword:newPw})});
            const data=await res.json();
            if(!res.ok){ showError(data.message||'Failed to change password'); return; }
            const tEl=document.querySelector('#profileUpdated .modal-title'), sEl=document.querySelector('#profileUpdated .modal-subtitle');
            const oT=tEl.textContent, oS=sEl.textContent;
            tEl.textContent='Password Changed'; sEl.textContent='Your password has been updated successfully.';
            openEmera('profileUpdated'); e.target.reset();
            setTimeout(()=>{ closeEmera('profileUpdated'); tEl.textContent=oT; sEl.textContent=oS; },1500);
        } catch(err){ showError('Network error. Please try again.'); }
    }

    function handleForgotPassword(){ window.location.href='/forgot-password'; }

    function copyReferralLink(){
        const input=document.getElementById('referral-link-input'), msg=document.getElementById('referral-copied-msg'), btn=document.getElementById('copy-referral-btn');
        navigator.clipboard.writeText(input.value).then(()=>{ msg.classList.remove('hidden'); btn.textContent='Copied!'; setTimeout(()=>{ msg.classList.add('hidden'); btn.textContent='Copy Link'; },2500); }).catch(()=>{ input.select(); document.execCommand('copy'); msg.classList.remove('hidden'); setTimeout(()=>msg.classList.add('hidden'),2500); });
    }

    // ---- Init ----
    function init(){
        showTab('profile');
        document.getElementById('profile-image-input')?.addEventListener('change',e=>{ if(e.target.files[0]) previewProfileImage(e.target.files[0]); });
        document.getElementById('edit-profile-form')?.addEventListener('submit',handleEditProfileSubmit);
        document.getElementById('verify-email-form')?.addEventListener('submit',handleOTPVerification);
        document.getElementById('add-address-form')?.addEventListener('submit',handleAddAddressSubmit);
        document.getElementById('edit-address-form')?.addEventListener('submit',handleEditAddressSubmit);
        document.getElementById('change-password-form')?.addEventListener('submit',handleChangePassword);
        document.getElementById('add-money-form')?.addEventListener('submit',handleAddMoneySubmit);

        document.getElementById('new-password')?.addEventListener('input',function(){
            const bad=this.value&&(this.value.length<8||!/[A-Z]/.test(this.value)||!/[a-z]/.test(this.value)||!/[0-9]/.test(this.value));
            this.classList.toggle('input-error',!!bad); document.getElementById('new-password-error')?.classList.toggle('hidden',!bad);
            const cv=document.getElementById('confirm-password')?.value;
            if(cv){ const mm=this.value!==cv; document.getElementById('confirm-password')?.classList.toggle('input-error',mm); const ce=document.getElementById('confirm-password-error'); if(ce){ce.textContent='Passwords do not match';ce.classList.toggle('hidden',!mm);} }
        });
        document.getElementById('confirm-password')?.addEventListener('input',function(){
            const mm=this.value&&this.value!==document.getElementById('new-password').value;
            this.classList.toggle('input-error',!!mm); const ce=document.getElementById('confirm-password-error'); if(ce){ce.textContent='Passwords do not match';ce.classList.toggle('hidden',!mm);}
        });
        document.getElementById('current-password')?.addEventListener('input',function(){ this.classList.toggle('input-error',!this.value); document.getElementById('current-password-error')?.classList.toggle('hidden',!!this.value); });

        document.querySelectorAll('.modal').forEach(m=>m.addEventListener('click',e=>{ if(e.target===m) closeModal(m.id); }));
        document.querySelectorAll('.emera-overlay').forEach(o=>o.addEventListener('click',e=>{ if(e.target===o) closeEmera(o.id); }));
        document.addEventListener('keydown',e=>{ if(e.key==='Escape'){ document.querySelectorAll('.modal.active').forEach(m=>closeModal(m.id)); document.querySelectorAll('.emera-overlay.active').forEach(o=>closeEmera(o.id)); } });
    }

    return { init, showTab, openModal, closeModal, openEmera, closeEmera, openEditProfileModal, openAddAddressModal, openEditAddress, deleteAddress, confirmDeleteAddress, setDefaultAddress, resendOTP, handleForgotPassword, copyReferralLink, openAddMoneyModal, setWalletAmount, filterTransactions };
})();

document.addEventListener('DOMContentLoaded', ProfileApp.init);
</script>

