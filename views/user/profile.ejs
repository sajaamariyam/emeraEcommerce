<style>
.tab-active {
    background-color: #f5f5f4;
    color: #000;
}

.modal {
    display: none;
}

.modal.active {
    display: flex !important;
}

/* Input error state */
.input-error {
    border-color: #ef4444 !important;
}

.emera-overlay {
    position: fixed;
    inset: 0;
    background: rgba(10,14,13,0.85);
    backdrop-filter: blur(8px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    opacity: 0;
    pointer-events: none;
    transition: opacity .4s ease;
}

.emera-overlay.active {
    opacity: 1;
    pointer-events: all;
}

.emera-modal {
    background: linear-gradient(145deg,#fdfbf7,#fff);
    border-radius: 28px;
    padding: 48px;
    max-width: 480px;
    width: 100%;
    box-shadow: 0 20px 60px rgba(16,66,47,.3), 0 0 80px rgba(16,66,47,.15);
    transform: scale(.92) translateY(20px);
    opacity: 0;
    transition: all .45s cubic-bezier(.34,1.56,.64,1);
}

.emera-overlay.active .emera-modal {
    transform: scale(1) translateY(0);
    opacity: 1;
}

.spinner {
    border: 3px solid #f3f3f3;
    border-top: 3px solid #292524;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    animation: spin 1s linear infinite;
    margin: 20px auto;
}

@keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
}

:root {
    --emerald-deep: #10422f;
    --emerald-rich: #1a5c42;
    --emerald-mid: #2d7a5f;
    --emerald-light: #87b5a3;
    --gold-accent: #c9a960;
    --charcoal: #2b2b2b;
    --ivory: #fdfbf7;
}

.success-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    position: relative;
    animation: iconFloat 0.8s ease-out;
}

.success-checkmark {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--emerald-rich), var(--emerald-mid));
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    animation: emeraldGlow 2s ease-in-out infinite;
}

.success-checkmark::before {
    content: '✓';
    color: white;
    font-size: 42px;
    font-weight: 300;
    animation: checkPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 0.3s backwards;
}

@keyframes iconFloat {
    0% { transform: translateY(20px) scale(0.8); opacity: 0; }
    100% { transform: translateY(0) scale(1); opacity: 1; }
}

@keyframes checkPop {
    0% { transform: scale(0); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
}

@keyframes emeraldGlow {
    0%, 100% {
        box-shadow: 0 0 20px rgba(29,122,95,0.3), 0 0 40px rgba(29,122,95,0.15), inset 0 0 20px rgba(255,255,255,0.1);
    }
    50% {
        box-shadow: 0 0 30px rgba(29,122,95,0.5), 0 0 60px rgba(29,122,95,0.25), inset 0 0 30px rgba(255,255,255,0.15);
    }
}

.error-icon {
    width: 80px;
    height: 80px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #8b7355, #a68968);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: shakeError 0.5s ease-out;
}

.error-icon::before {
    content: '!';
    color: white;
    font-size: 42px;
    font-weight: 500;
}

@keyframes shakeError {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-8px); }
    75% { transform: translateX(8px); }
}

.emera-btn {
    width: 100%;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--emerald-rich), var(--emerald-mid));
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    margin-top: 32px;
    font-family: 'Inter', sans-serif;
    letter-spacing: 0.3px;
}

.emera-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(29,122,95,0.3), 0 0 40px rgba(29,122,95,0.2);
}

.emera-btn:active {
    transform: translateY(0);
}

.modal-title {
    font-size: 32px;
    font-weight: 500;
    color: var(--charcoal);
    margin-bottom: 12px;
    letter-spacing: -0.5px;
}

.modal-subtitle {
    font-size: 16px;
    color: #6b6b6b;
    line-height: 1.6;
    font-weight: 300;
}

@keyframes sparkle {
    0%, 100% { opacity: 0; }
    50% { opacity: 1; }
}

.sparkle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: white;
    border-radius: 50%;
    animation: sparkle 2s ease-in-out infinite;
}

.sparkle:nth-child(1) { top: 15%; right: 25%; animation-delay: 0s; }
.sparkle:nth-child(2) { top: 30%; right: 15%; animation-delay: 0.6s; }
.sparkle:nth-child(3) { top: 45%; right: 30%; animation-delay: 1.2s; }
</style>

<script>
const ProfileApp = (function() {
    'use strict';

    let originalEmailAtEdit = null;

    let state = {
        currentUser: {
            name: "<%= user.name %>",
            email: "<%= user.email %>",
            phone: "<%= user.phone || '' %>",
            profileImage: "<%= user.profileImage || '' %>",
            googleId: "<%= user.googleId || '' %>"
        },
        pendingEmailChange: null,
        currentOrderToCancel: null,
        addressToDelete: null
    };

    // ============================================
    // VALIDATION HELPERS
    // ============================================

    function showFieldError(fieldId, errorId, show) {
        const field = document.getElementById(fieldId);
        const error = document.getElementById(errorId);
        if (!field || !error) return;
        if (show) {
            field.classList.add('input-error');
            error.classList.remove('hidden');
        } else {
            field.classList.remove('input-error');
            error.classList.add('hidden');
        }
    }

    function clearFormErrors(formId) {
        const form = document.getElementById(formId);
        if (!form) return;
        form.querySelectorAll('.input-error').forEach(el => el.classList.remove('input-error'));
        form.querySelectorAll('[id$="-error"]').forEach(el => el.classList.add('hidden'));
    }

    function isValidPhone(phone) {
        return /^[6-9]\d{9}$/.test(phone.replace(/\s/g, ''));
    }

    function isValidPincode(pin) {
        return /^\d{6}$/.test(pin.trim());
    }

    function isValidEmail(email) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    function validateAddAddressForm() {
        let valid = true;

        const firstName = document.getElementById('add-firstName').value.trim();
        const lastName = document.getElementById('add-lastName').value.trim();
        const phone = document.getElementById('add-phone').value.trim();
        const address1 = document.getElementById('add-address1').value.trim();
        const city = document.getElementById('add-city').value.trim();
        const state = document.getElementById('add-state').value.trim();
        const pincode = document.getElementById('add-pincode').value.trim();

        showFieldError('add-firstName', 'add-firstName-error', !firstName);
        if (!firstName) valid = false;

        showFieldError('add-lastName', 'add-lastName-error', !lastName);
        if (!lastName) valid = false;

        const phoneInvalid = !phone || !isValidPhone(phone);
        showFieldError('add-phone', 'add-phone-error', phoneInvalid);
        if (phoneInvalid) valid = false;

        showFieldError('add-address1', 'add-address1-error', !address1);
        if (!address1) valid = false;

        showFieldError('add-city', 'add-city-error', !city);
        if (!city) valid = false;

        showFieldError('add-state', 'add-state-error', !state);
        if (!state) valid = false;

        const pincodeInvalid = !pincode || !isValidPincode(pincode);
        showFieldError('add-pincode', 'add-pincode-error', pincodeInvalid);
        if (pincodeInvalid) valid = false;

        return valid;
    }

    function validateEditAddressForm() {
        let valid = true;

        const firstName = document.getElementById('edit-addr-firstName').value.trim();
        const lastName = document.getElementById('edit-addr-lastName').value.trim();
        const phone = document.getElementById('edit-addr-phone').value.trim();
        const address1 = document.getElementById('edit-addr-address1').value.trim();
        const city = document.getElementById('edit-addr-city').value.trim();
        const state = document.getElementById('edit-addr-state').value.trim();
        const pincode = document.getElementById('edit-addr-pincode').value.trim();

        showFieldError('edit-addr-firstName', 'edit-addr-firstName-error', !firstName);
        if (!firstName) valid = false;

        showFieldError('edit-addr-lastName', 'edit-addr-lastName-error', !lastName);
        if (!lastName) valid = false;

        const phoneInvalid = !phone || !isValidPhone(phone);
        showFieldError('edit-addr-phone', 'edit-addr-phone-error', phoneInvalid);
        if (phoneInvalid) valid = false;

        showFieldError('edit-addr-address1', 'edit-addr-address1-error', !address1);
        if (!address1) valid = false;

        showFieldError('edit-addr-city', 'edit-addr-city-error', !city);
        if (!city) valid = false;

        showFieldError('edit-addr-state', 'edit-addr-state-error', !state);
        if (!state) valid = false;

        const pincodeInvalid = !pincode || !isValidPincode(pincode);
        showFieldError('edit-addr-pincode', 'edit-addr-pincode-error', pincodeInvalid);
        if (pincodeInvalid) valid = false;

        return valid;
    }

    function validateEditProfileForm() {
        let valid = true;

        const firstName = document.getElementById('edit-firstname').value.trim();
        const phone = document.getElementById('edit-phone').value.trim();
        const emailInput = document.getElementById('edit-email');
        const email = emailInput.value.trim();

        showFieldError('edit-firstname', 'edit-firstname-error', !firstName);
        if (!firstName) valid = false;

        if (!emailInput.disabled) {
            const emailInvalid = !email || !isValidEmail(email);
            showFieldError('edit-email', 'edit-email-error', emailInvalid);
            if (emailInvalid) valid = false;
        }

        const phoneInvalid = !phone || !isValidPhone(phone);
        showFieldError('edit-phone', 'edit-phone-error', phoneInvalid);
        if (phoneInvalid) valid = false;

        return valid;
    }

    // ============================================
    // MODAL MANAGEMENT
    // ============================================

    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
        if (modalId === 'email-verification-modal') {
            clearInterval(otpInterval);
        }
    }

    function openEmera(id) {
        const modal = document.getElementById(id);
        if (modal) {
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';
        }
    }

    function closeEmera(id) {
        const modal = document.getElementById(id);
        if (modal) {
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }
    }

    function showError(message) {
        const errorEl = document.getElementById('error-message');
        if (errorEl) errorEl.textContent = message;
        openEmera('error');
    }

    // ============================================
    // TAB MANAGEMENT
    // ============================================

    function showTab(tabName) {
        document.querySelectorAll('.tab-content').forEach(tab => {
            tab.style.display = 'none';
        });
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.classList.remove('tab-active');
        });

        const selectedTab = document.getElementById(tabName + '-tab');
        if (selectedTab) selectedTab.style.display = 'block';

        const selectedBtn = document.querySelector(`[data-tab="${tabName}"]`);
        if (selectedBtn) selectedBtn.classList.add('tab-active');

        if (tabName === 'addresses') loadAddresses();
        else if (tabName === 'orders') loadOrders();
    }

    // ============================================
    // PROFILE MANAGEMENT
    // ============================================

    function openEditProfileModal() {
        clearFormErrors('edit-profile-form');
        const nameParts = state.currentUser.name.split(' ');
        document.getElementById('edit-firstname').value = nameParts[0];
        document.getElementById('edit-lastname').value = nameParts.slice(1).join(' ') || '';
        document.getElementById('edit-email').value = state.currentUser.email;
        document.getElementById('edit-phone').value = state.currentUser.phone;
        if (state.currentUser.profileImage) {
            document.getElementById('edit-profile-img-preview').src = state.currentUser.profileImage;
        }
        originalEmailAtEdit = state.currentUser.email;
        openModal('edit-profile-modal');
    }

    function previewProfileImage(file) {
        if (file && file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('edit-profile-img-preview').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    }

    async function handleEditProfileSubmit(e) {
        e.preventDefault();
        if (!validateEditProfileForm()) return;

        const firstName = document.getElementById('edit-firstname').value.trim();
        const lastName = document.getElementById('edit-lastname').value.trim();
        const email = document.getElementById('edit-email').value.trim();
        const phone = document.getElementById('edit-phone').value.trim();
        const profileImageFile = document.getElementById('profile-image-input').files[0];

        const emailChanged = email !== originalEmailAtEdit;
        const emailInput = document.getElementById('edit-email');
        const isGoogleAccount = emailInput.disabled;

        try {
            if (emailChanged && !isGoogleAccount) {
                const otpResponse = await fetch('/profile/request-email-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newEmail: email })
                });

                if (otpResponse.ok) {
                    const formData = new FormData();
                    formData.append('name', `${firstName} ${lastName}`.trim());
                    formData.append('phone', phone);
                    if (profileImageFile) formData.append('profileImage', profileImageFile);

                    state.pendingEmailChange = { formData, newEmail: email };
                    document.getElementById('new-email-display').textContent = email;
                    closeModal('edit-profile-modal');
                    openModal('email-verification-modal');
                    startOtpTimer();
                    setTimeout(() => document.getElementById('otp-code').focus(), 300);
                } else {
                    const error = await otpResponse.json();
                    showError(error.message || 'Failed to send verification code');
                }
            } else {
                const formData = new FormData();
                formData.append('name', `${firstName} ${lastName}`.trim());
                formData.append('phone', phone);
                if (profileImageFile) formData.append('profileImage', profileImageFile);

                const response = await fetch('/profile/edit', {
                    method: 'POST',
                    body: formData
                });

                if (response.ok) {
                    closeModal('edit-profile-modal');
                    openEmera('profileUpdated');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    const error = await response.json();
                    showError(error.message || 'Failed to update profile');
                }
            }
        } catch (error) {
            console.error('Error updating profile:', error);
            showError('Network error. Please try again.');
        }
    }

    // ============================================
    // OTP MANAGEMENT
    // ============================================

    async function handleOTPVerification(e) {
        e.preventDefault();

        const otpError = document.getElementById('otp-error');
        if (!state.pendingEmailChange) {
            showError('No pending email change found');
            return;
        }

        const otp = document.getElementById('otp-code').value.trim();
        if (otp.length !== 6) {
            otpError.classList.remove('hidden');
            return;
        }
        otpError.classList.add('hidden');

        try {
            const verifyResponse = await fetch('/profile/verify-email-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ otp })
            });

            if (verifyResponse.ok) {
                if (state.pendingEmailChange.formData) {
                    await fetch('/profile/edit', {
                        method: 'POST',
                        body: state.pendingEmailChange.formData
                    });
                }

                const updateResponse = await fetch('/profile/update-after-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });

                if (updateResponse.ok) {
                    state.pendingEmailChange = null;
                    document.getElementById('otp-code').value = '';
                    closeModal('email-verification-modal');
                    openEmera('emailVerified');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    const error = await updateResponse.json();
                    showError(error.message || 'Failed to update email');
                }
            } else {
                const error = await verifyResponse.json();
                document.getElementById('otp-code').value = '';
                document.getElementById('otp-code').focus();
                showError(error.message || 'Invalid verification code');
            }
        } catch (error) {
            console.error('Error verifying OTP:', error);
            document.getElementById('otp-code').value = '';
            showError('Network error. Please try again.');
        }
    }

    let otpInterval = null;
    let otpTimeLeft = 300;

    function startOtpTimer() {
        clearInterval(otpInterval);
        otpTimeLeft = 300;

        const resendBtn = document.getElementById('resend-otp-btn');
        resendBtn.disabled = true;
        resendBtn.classList.add('cursor-not-allowed', 'text-stone-400');
        resendBtn.classList.remove('text-stone-600');

        updateOtpTimerUI();

        otpInterval = setInterval(() => {
            otpTimeLeft--;
            updateOtpTimerUI();
            if (otpTimeLeft <= 0) {
                clearInterval(otpInterval);
                document.getElementById('otp-timer').innerHTML = "Didn't receive the code?";
                resendBtn.disabled = false;
                resendBtn.classList.remove('cursor-not-allowed', 'text-stone-400');
                resendBtn.classList.add('text-stone-600');
            }
        }, 1000);
    }

    function updateOtpTimerUI() {
        const timerEl = document.getElementById('otp-timer');
        const minutes = Math.floor(otpTimeLeft / 60);
        const seconds = otpTimeLeft % 60;
        timerEl.innerHTML = `Resend code in <span class="font-semibold">${String(minutes).padStart(2,'0')}:${String(seconds).padStart(2,'0')}</span>`;
    }

    async function resendOTP() {
        if (!state.pendingEmailChange) {
            showError('No pending email change found');
            return;
        }
        try {
            const response = await fetch('/profile/request-email-otp', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ newEmail: state.pendingEmailChange.newEmail })
            });

            if (response.ok) {
                startOtpTimer();
                const titleEl = document.querySelector('#profileUpdated .modal-title');
                const subtitleEl = document.querySelector('#profileUpdated .modal-subtitle');
                const originalTitle = titleEl.textContent;
                const originalSubtitle = subtitleEl.textContent;
                titleEl.textContent = 'Code Resent';
                subtitleEl.textContent = 'A new verification code has been sent to your email.';
                openEmera('profileUpdated');
                setTimeout(() => {
                    closeEmera('profileUpdated');
                    titleEl.textContent = originalTitle;
                    subtitleEl.textContent = originalSubtitle;
                }, 1500);
            } else {
                showError('Failed to resend code');
            }
        } catch (error) {
            console.error('Error resending OTP:', error);
            showError('Network error. Please try again.');
        }
    }

    // ============================================
    // ADDRESS MANAGEMENT
    // ============================================

    function openAddAddressModal() {
        document.getElementById('add-address-form').reset();
        clearFormErrors('add-address-form');
        openModal('add-address-modal');
    }

    async function loadAddresses() {
        const container = document.getElementById('addresses-container');
        container.innerHTML = '<div class="spinner"></div>';

        try {
            const response = await fetch('/profile/addresses');
            const addresses = await response.json();

            if (addresses.length === 0) {
                container.innerHTML = `
                    <div class="col-span-2 text-center py-12">
                        <p class="text-stone-400 mb-6">No saved addresses yet</p>
                        <button onclick="ProfileApp.openAddAddressModal()" class="px-8 py-3 bg-stone-950 text-white text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-stone-700 transition-all">
                            Add Your First Address
                        </button>
                    </div>
                `;
            } else {
                container.innerHTML = addresses.map(addr => `
                    <div class="border border-stone-200 p-8 relative">
                        ${addr.isDefault ? `
                            <span class="absolute top-4 right-4 px-3 py-1 bg-stone-950 text-white text-[8px] tracking-wider uppercase">Default</span>
                        ` : ''}
                        <h4 class="font-serif text-lg mb-4">${addr.fullName}</h4>
                        <p class="text-sm text-stone-600">${addr.street}</p>
                        <p class="text-sm text-stone-600">${addr.city}, ${addr.state} ${addr.zipCode}</p>
                        <p class="text-sm text-stone-600 mb-2">India</p>
                        <p class="text-sm text-stone-600 mb-6">Phone: ${addr.phone}</p>
                        <div class="flex gap-4">
                            <button
                                onclick='ProfileApp.openEditAddress(${JSON.stringify(addr).replace(/'/g, "&#39;")})'
                                class="text-[10px] uppercase tracking-wider text-stone-700 hover:underline font-bold"
                            >Edit</button>
                            <button
                                onclick="ProfileApp.deleteAddress('${addr._id}')"
                                class="text-[10px] uppercase tracking-wider text-red-600 hover:underline font-bold"
                            >Delete</button>
                            ${!addr.isDefault ? `
                                <button
                                    onclick="ProfileApp.setDefaultAddress('${addr._id}')"
                                    class="text-[10px] uppercase tracking-wider text-stone-600 hover:underline font-bold"
                                >Set as Default</button>
                            ` : ''}
                        </div>
                    </div>
                `).join('');
            }
        } catch (error) {
            console.error('Error loading addresses:', error);
            container.innerHTML = '<p class="text-red-600 text-center">Failed to load addresses</p>';
        }
    }

    // FIX: Send field names that match the controller (firstName, lastName, address1, address2, city, state, pincode, phone, isDefault)
    async function handleAddAddressSubmit(e) {
        e.preventDefault();
        if (!validateAddAddressForm()) return;

        const addressData = {
            firstName: document.getElementById('add-firstName').value.trim(),
            lastName: document.getElementById('add-lastName').value.trim(),
            phone: document.getElementById('add-phone').value.trim(),
            address1: document.getElementById('add-address1').value.trim(),
            address2: document.getElementById('add-address2').value.trim(),
            city: document.getElementById('add-city').value.trim(),
            state: document.getElementById('add-state').value.trim(),
            pincode: document.getElementById('add-pincode').value.trim(),
            isDefault: document.getElementById('add-isDefault').checked
        };

        try {
            const response = await fetch('/profile/addresses', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(addressData)
            });

            if (response.ok) {
                closeModal('add-address-modal');
                openEmera('profileUpdated');
                setTimeout(() => {
                    closeEmera('profileUpdated');
                    loadAddresses();
                }, 1500);
            } else {
                const error = await response.json();
                showError(error.message || 'Failed to add address');
            }
        } catch (error) {
            console.error('Error adding address:', error);
            showError('Network error. Please try again.');
        }
    }

    // FIX: Parse fullName back into firstName/lastName when opening edit modal
    // FIX: Parse street back into address1/address2
    // FIX: Parse zipCode back into pincode
    function openEditAddress(address) {
        clearFormErrors('edit-address-form');

        document.getElementById('edit-address-id').value = address._id;

        // Split fullName into first/last name
        const nameParts = (address.fullName || '').split(' ');
        document.getElementById('edit-addr-firstName').value = nameParts[0] || '';
        document.getElementById('edit-addr-lastName').value = nameParts.slice(1).join(' ') || '';

        document.getElementById('edit-addr-phone').value = address.phone || '';

        // Split street into address1/address2
        const streetParts = (address.street || '').split(', ');
        document.getElementById('edit-addr-address1').value = streetParts[0] || '';
        document.getElementById('edit-addr-address2').value = streetParts.slice(1).join(', ') || '';

        document.getElementById('edit-addr-city').value = address.city || '';
        document.getElementById('edit-addr-state').value = address.state || '';

        // zipCode from DB maps to pincode for controller
        document.getElementById('edit-addr-pincode').value = address.zipCode || '';
        document.getElementById('edit-addr-isDefault').checked = address.isDefault || false;

        openModal('edit-address-modal');
    }

    // FIX: Send correct field names to match controller
    async function handleEditAddressSubmit(e) {
        e.preventDefault();
        if (!validateEditAddressForm()) return;

        const id = document.getElementById('edit-address-id').value;

        const data = {
            firstName: document.getElementById('edit-addr-firstName').value.trim(),
            lastName: document.getElementById('edit-addr-lastName').value.trim(),
            phone: document.getElementById('edit-addr-phone').value.trim(),
            address1: document.getElementById('edit-addr-address1').value.trim(),
            address2: document.getElementById('edit-addr-address2').value.trim(),
            city: document.getElementById('edit-addr-city').value.trim(),
            state: document.getElementById('edit-addr-state').value.trim(),
            pincode: document.getElementById('edit-addr-pincode').value.trim(),
            isDefault: document.getElementById('edit-addr-isDefault').checked
        };

        try {
            const res = await fetch(`/profile/addresses/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (res.ok) {
                closeModal('edit-address-modal');
                openEmera('profileUpdated');
                setTimeout(() => {
                    closeEmera('profileUpdated');
                    loadAddresses();
                }, 1500);
            } else {
                const error = await res.json();
                showError(error.message || 'Failed to update address');
            }
        } catch (error) {
            console.error('Error updating address:', error);
            showError('Network error. Please try again.');
        }
    }

    function deleteAddress(id) {
        state.addressToDelete = id;
        openModal('delete-address-modal');
    }

    async function confirmDeleteAddress() {
        try {
            const res = await fetch(`/profile/addresses/${state.addressToDelete}`, {
                method: 'DELETE'
            });

            if (res.ok) {
                closeModal('delete-address-modal');
                openEmera('profileUpdated');
                setTimeout(() => {
                    closeEmera('profileUpdated');
                    loadAddresses();
                }, 1500);
            } else {
                showError('Failed to delete address');
            }
        } catch (error) {
            console.error('Error deleting address:', error);
            showError('Network error. Please try again.');
        }
    }

    async function setDefaultAddress(addressId) {
        try {
            const response = await fetch(`/profile/addresses/${addressId}/set-default`, {
                method: 'PUT'
            });

            if (response.ok) {
                openEmera('profileUpdated');
                setTimeout(() => {
                    closeEmera('profileUpdated');
                    loadAddresses();
                }, 1500);
            } else {
                showError('Failed to set default address');
            }
        } catch (error) {
            console.error('Error setting default address:', error);
            showError('Network error. Please try again.');
        }
    }

    // ============================================
    // ORDER MANAGEMENT
    // ============================================

    async function loadOrders() {
        const container = document.getElementById('orders-container');
        container.innerHTML = '<div class="spinner"></div>';

        try {
            const response = await fetch('/api/profile/orders');
            const orders = await response.json();

            if (orders.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-12">
                        <p class="text-stone-400 mb-6">No orders yet</p>
                        <a href="/shop" class="px-8 py-3 bg-stone-950 text-white text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-stone-700 transition-all inline-block">
                            Start Shopping
                        </a>
                    </div>
                `;
            } else {
                const statusColors = {
                    'pending': 'bg-yellow-100 text-yellow-800',
                    'processing': 'bg-blue-100 text-blue-800',
                    'shipped': 'bg-purple-100 text-purple-800',
                    'delivered': 'bg-green-100 text-green-800',
                    'cancelled': 'bg-red-100 text-red-800'
                };

                container.innerHTML = orders.map(order => {
                    const canCancel = ['pending', 'processing'].includes(order.status);
                    return `
                        <div class="border border-stone-200 p-8">
                            <div class="flex justify-between items-start mb-6">
                                <div>
                                    <h4 class="font-serif text-xl mb-2">Order #${order.orderNumber}</h4>
                                    <p class="text-xs text-stone-500">Placed on ${new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</p>
                                </div>
                                <span class="px-4 py-2 ${statusColors[order.status] || 'bg-stone-100 text-stone-800'} text-[10px] tracking-wider uppercase font-bold rounded">
                                    ${order.status}
                                </span>
                            </div>
                            <div class="space-y-4 mb-6">
                                ${order.items.map(item => `
                                    <div class="flex gap-6">
                                        <img src="${item.product.image}" alt="${item.product.name}" class="w-20 h-20 object-cover border border-stone-200">
                                        <div class="flex-1">
                                            <h5 class="font-serif text-base mb-1">${item.product.name}</h5>
                                            <p class="text-sm text-stone-600">Quantity: ${item.quantity}</p>
                                            <p class="text-sm font-bold text-stone-900">₹${item.price.toFixed(2)}</p>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            <div class="pt-6 border-t border-stone-200 flex justify-between items-center">
                                <div>
                                    <span class="text-[10px] uppercase tracking-wider text-stone-400 font-bold">Total Amount</span>
                                    <p class="text-2xl font-serif text-gray-900">₹${order.totalAmount.toFixed(2)}</p>
                                </div>
                                <div class="flex gap-4">
                                    <a href="/orders/${order._id}" class="px-8 py-3 bg-white border-2 border-stone-300 text-stone-700 text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-stone-100 transition-all">
                                        View Details
                                    </a>
                                    ${canCancel ? `
                                        <button onclick="ProfileApp.openCancelOrderModal('${order._id}', '${order.orderNumber}')" class="px-8 py-3 bg-red-600 text-white text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-red-700 transition-all">
                                            Cancel Order
                                        </button>
                                    ` : ''}
                                </div>
                            </div>
                        </div>
                    `;
                }).join('');
            }
        } catch (error) {
            console.error('Error loading orders:', error);
            container.innerHTML = '<p class="text-red-600 text-center">Failed to load orders</p>';
        }
    }

    function openCancelOrderModal(orderId, orderNumber) {
        state.currentOrderToCancel = orderId;
        document.getElementById('cancel-order-id').textContent = `#${orderNumber}`;
        document.getElementById('cancel-reason').value = '';
        document.getElementById('cancel-reason-error').classList.add('hidden');
        openModal('cancel-order-modal');
    }

    async function confirmCancelOrder() {
        const reason = document.getElementById('cancel-reason').value;
        const reasonError = document.getElementById('cancel-reason-error');

        if (!reason) {
            reasonError.classList.remove('hidden');
            return;
        }
        reasonError.classList.add('hidden');

        try {
            const response = await fetch(`/orders/${state.currentOrderToCancel}/cancel`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            });

            if (response.ok) {
                closeModal('cancel-order-modal');
                openEmera('profileUpdated');
                setTimeout(() => {
                    closeEmera('profileUpdated');
                    loadOrders();
                }, 1500);
            } else {
                const error = await response.json();
                showError(error.message || 'Failed to cancel order');
            }
        } catch (error) {
            console.error('Error cancelling order:', error);
            showError('Network error. Please try again.');
        }
    }

    // ============================================
    // SECURITY MANAGEMENT
    // ============================================

    async function handleChangePassword(e) {
        e.preventDefault();

        const currentPassword = document.getElementById('current-password').value;
        const newPassword = document.getElementById('new-password').value;
        const confirmPassword = document.getElementById('confirm-password').value;

        const currentEl = document.getElementById('current-password');
        const newEl = document.getElementById('new-password');
        const confirmEl = document.getElementById('confirm-password');
        const currentError = document.getElementById('current-password-error');
        const newError = document.getElementById('new-password-error');
        const confirmError = document.getElementById('confirm-password-error');

        // Clear all errors first
        [currentEl, newEl, confirmEl].forEach(el => el.classList.remove('input-error'));
        [currentError, newError, confirmError].forEach(el => el.classList.add('hidden'));

        let valid = true;

        if (!currentPassword) {
            currentEl.classList.add('input-error');
            currentError.classList.remove('hidden');
            valid = false;
        }

        const pwInvalid = !newPassword || newPassword.length < 8 ||
            !/[A-Z]/.test(newPassword) || !/[a-z]/.test(newPassword) || !/[0-9]/.test(newPassword);

        if (pwInvalid) {
            newEl.classList.add('input-error');
            newError.classList.remove('hidden');
            valid = false;
        }

        if (!confirmPassword || newPassword !== confirmPassword) {
            confirmEl.classList.add('input-error');
            confirmError.textContent = !confirmPassword ? 'Please confirm your new password' : 'Passwords do not match';
            confirmError.classList.remove('hidden');
            valid = false;
        }

        if (!valid) return;

        try {
            const response = await fetch('/profile/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ currentPassword, newPassword })
            });

            const data = await response.json();

            if (!response.ok) {
                showError(data.message || 'Failed to change password');
                return;
            }

            const titleEl = document.querySelector('#profileUpdated .modal-title');
            const subtitleEl = document.querySelector('#profileUpdated .modal-subtitle');
            const originalTitle = titleEl.textContent;
            const originalSubtitle = subtitleEl.textContent;
            titleEl.textContent = 'Password Changed';
            subtitleEl.textContent = 'Your password has been updated successfully.';
            openEmera('profileUpdated');
            e.target.reset();
            setTimeout(() => {
                closeEmera('profileUpdated');
                titleEl.textContent = originalTitle;
                subtitleEl.textContent = originalSubtitle;
            }, 1500);
        } catch (error) {
            console.error('Error changing password:', error);
            showError('Network error. Please try again.');
        }
    }

    function handleForgotPassword() {
        window.location.href = '/forgot-password';
    }

    // ============================================
    // INIT
    // ============================================

    function init() {
        showTab('profile');

        document.getElementById('profile-image-input')?.addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) previewProfileImage(file);
        });

        document.getElementById('edit-profile-form')?.addEventListener('submit', handleEditProfileSubmit);
        document.getElementById('verify-email-form')?.addEventListener('submit', handleOTPVerification);
        document.getElementById('add-address-form')?.addEventListener('submit', handleAddAddressSubmit);
        document.getElementById('edit-address-form')?.addEventListener('submit', handleEditAddressSubmit);
        document.getElementById('change-password-form')?.addEventListener('submit', handleChangePassword);

        // Password live validation listeners
        document.getElementById('new-password')?.addEventListener('input', function() {
            const val = this.value;
            const newError = document.getElementById('new-password-error');
            const invalid = val && (val.length < 8 || !/[A-Z]/.test(val) || !/[a-z]/.test(val) || !/[0-9]/.test(val));
            this.classList.toggle('input-error', !!invalid);
            newError?.classList.toggle('hidden', !invalid);

            // Also re-check confirm match live
            const confirmVal = document.getElementById('confirm-password')?.value;
            const confirmEl = document.getElementById('confirm-password');
            const confirmError = document.getElementById('confirm-password-error');
            if (confirmVal) {
                const mismatch = val !== confirmVal;
                confirmEl?.classList.toggle('input-error', mismatch);
                if (confirmError) {
                    confirmError.textContent = 'Passwords do not match';
                    confirmError.classList.toggle('hidden', !mismatch);
                }
            }
        });

        document.getElementById('confirm-password')?.addEventListener('input', function() {
            const newPw = document.getElementById('new-password').value;
            const confirmError = document.getElementById('confirm-password-error');
            const mismatch = this.value && this.value !== newPw;
            this.classList.toggle('input-error', !!mismatch);
            if (confirmError) {
                confirmError.textContent = 'Passwords do not match';
                confirmError.classList.toggle('hidden', !mismatch);
            }
        });

        document.getElementById('current-password')?.addEventListener('input', function() {
            const err = document.getElementById('current-password-error');
            this.classList.toggle('input-error', !this.value);
            err?.classList.toggle('hidden', !!this.value);
        });

        // Close modals on background click
        document.querySelectorAll('.modal').forEach(modal => {
            modal.addEventListener('click', function(e) {
                if (e.target === modal) closeModal(modal.id);
            });
        });

        document.querySelectorAll('.emera-overlay').forEach(overlay => {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeEmera(overlay.id);
            });
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.modal.active').forEach(m => closeModal(m.id));
                document.querySelectorAll('.emera-overlay.active').forEach(m => closeEmera(m.id));
            }
        });
    }

    return {
        init,
        showTab,
        openModal,
        closeModal,
        openEmera,
        closeEmera,
        openEditProfileModal,
        openAddAddressModal,
        openEditAddress,
        openCancelOrderModal,
        confirmCancelOrder,
        deleteAddress,
        confirmDeleteAddress,
        setDefaultAddress,
        resendOTP,
        handleForgotPassword
    };
})();

document.addEventListener('DOMContentLoaded', ProfileApp.init);
</script>

