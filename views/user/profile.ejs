<%- include('../partials/user/header', { user: user }) %>

<!-- Profile Container -->
<div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20">
    
    <!-- Page Header -->
    <div class="mb-20 text-center">
        <span class="block text-[10px] uppercase tracking-[0.6em] text-stone-400 mb-6 font-bold">Account Dashboard</span>
        <h1 class="text-5xl md:text-6xl font-serif text-gray-900 tracking-tight">My Profile</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-16">
        
        <!-- Sidebar Navigation -->
        <div class="lg:col-span-1">
            <div class="bg-white border border-stone-200 sticky top-28">
                <div class="text-center p-8 border-b border-stone-200">
                    <div class="w-24 h-24 mx-auto mb-4 rounded-full overflow-hidden bg-stone-100">
                        <img id="sidebar-profile-img" src="<%= user.profileImage || 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200' %>" alt="Profile" class="w-full h-full object-cover">
                    </div>
                    <h3 class="font-serif text-xl mb-1 text-gray-900">
                        <%= user.name %>
                    </h3>
                    <p class="text-[10px] text-stone-400 uppercase tracking-[0.3em]">
                        <%= user.email %>
                    </p>
                </div>
                
                <nav class="p-2">
                    <button onclick="ProfileApp.showTab('profile')" class="tab-btn w-full text-left px-6 py-4 text-[11px] uppercase tracking-[0.3em] font-bold transition-all hover:bg-stone-50" data-tab="profile">Profile Details</button>
                    <button onclick="ProfileApp.showTab('addresses')" class="tab-btn w-full text-left px-6 py-4 text-[11px] uppercase tracking-[0.3em] font-bold transition-all hover:bg-stone-50" data-tab="addresses">Addresses</button>
                    <a href="/orders" class="tab-btn block w-full text-left px-6 py-4 text-[11px] uppercase tracking-[0.3em] font-bold transition-all hover:bg-stone-50">
                        My Orders
                    </a>
                    <button onclick="ProfileApp.showTab('security')" class="tab-btn w-full text-left px-6 py-4 text-[11px] uppercase tracking-[0.3em] font-bold transition-all hover:bg-stone-50" data-tab="security">Security</button>
                </nav>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="lg:col-span-3">
            
            <!-- PROFILE DETAILS TAB -->
            <div id="profile-tab" class="tab-content">
                <div class="bg-white border border-stone-200 p-12">
                    <div class="flex justify-between items-center mb-10 pb-8 border-b border-stone-100">
                        <h2 class="text-3xl font-serif text-gray-900">Profile Information</h2>
                        <button onclick="ProfileApp.openEditProfileModal()" class="px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                            Edit Profile
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
                        <div class="md:col-span-1 text-center">
                            <div class="w-48 h-48 mx-auto mb-6 rounded-full overflow-hidden bg-stone-100 border-4 border-stone-50">
                                <img src="<%= user.profileImage || 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400' %>" alt="Profile" class="w-full h-full object-cover">
                            </div>
                            <span class="text-[10px] text-stone-400 uppercase tracking-[0.3em] font-bold">Member Since <%= new Date(user.createdAt || Date.now()).getFullYear() %></span>
                        </div>
                        
                        <div class="md:col-span-2 space-y-8">
                            <div class="grid grid-cols-2 gap-8">
                                <div>
                                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">First Name</label>
                                    <p class="text-lg text-gray-900"><%= user.name.split(' ')[0] %></p>
                                </div>
                                <div>
                                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Last Name</label>
                                    <p class="text-lg text-gray-900"><%= user.name.split(' ').slice(1).join(' ') || 'N/A' %></p>
                                </div>
                            </div>
                            
                            <div>
                                <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Email Address</label>
                                <p class="text-lg text-gray-900"><%= user.email %></p>
                            </div>
                            
                            <div>
                                <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Phone Number</label>
                                <p class="text-lg text-gray-900"><%= user.phone || 'Not provided' %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ADDRESSES TAB -->
            <div id="addresses-tab" class="tab-content" style="display:none;">
                <div class="bg-white border border-stone-200 p-12">
                    <div class="flex justify-between items-center mb-10 pb-8 border-b border-stone-100">
                        <h2 class="text-3xl font-serif text-gray-900">Saved Addresses</h2>
                        <button onclick="ProfileApp.openAddAddressModal()" class="px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                            Add New Address
                        </button>
                    </div>
                    <div id="addresses-container" class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Addresses will be loaded here -->
                    </div>
                </div>
            </div>

            <!-- SECURITY TAB -->
            <!-- FIX: Corrected the broken EJS structure — "Forgot Password" was outside the else block -->
            <div id="security-tab" class="tab-content" style="display:none;">
                <div class="bg-white border border-stone-200 p-12">
                    <div class="mb-10 pb-8 border-b border-stone-100">
                        <h2 class="text-3xl font-serif text-gray-900">Security Settings</h2>
                    </div>

                    <div class="space-y-10">
                        <% if (user.googleId) { %>
                            <!-- GOOGLE ACCOUNT MESSAGE -->
                            <div class="border border-stone-200 p-10">
                                <p class="text-sm text-stone-500 italic">
                                    This account is connected with Google.
                                    Password and security settings are managed by Google.
                                </p>
                            </div>
                        <% } else { %>
                            <!-- CHANGE PASSWORD -->
                            <div class="border border-stone-200 p-10">
                                <h3 class="text-xl font-serif mb-8 text-gray-900">Change Password</h3>
                                <form id="change-password-form" class="space-y-6 max-w-md" novalidate>
                                    <div>
                                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Current Password</label>
                                        <input type="password" id="current-password"
                                            class="w-full px-5 py-4 border border-stone-300 focus:border-stone-950 transition-all text-sm">
                                        <p id="current-password-error" class="text-xs text-red-500 mt-1 hidden">Current password is required</p>
                                    </div>
                                    <div>
                                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">New Password</label>
                                        <input type="password" id="new-password"
                                            class="w-full px-5 py-4 border border-stone-300 focus:border-stone-950 transition-all text-sm">
                                        <p class="text-xs text-stone-500 mt-2">Min. 8 characters with uppercase, lowercase, and number</p>
                                        <p id="new-password-error" class="text-xs text-red-500 mt-1 hidden">Password must be at least 8 characters with uppercase, lowercase, and a number</p>
                                    </div>
                                    <div>
                                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Confirm New Password</label>
                                        <input type="password" id="confirm-password"
                                            class="w-full px-5 py-4 border border-stone-300 focus:border-stone-950 transition-all text-sm">
                                        <p id="confirm-password-error" class="text-xs text-red-500 mt-2 hidden">Passwords do not match</p>
                                    </div>
                                    <button type="submit"
                                        class="px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                                        Update Password
                                    </button>
                                </form>
                            </div>

                            <!-- FORGOT PASSWORD — FIX: Now correctly inside the else block -->
                            <div class="border border-stone-200 p-10">
                                <h3 class="text-xl font-serif mb-4 text-gray-900">Forgot Password?</h3>
                                <p class="text-sm text-stone-600 mb-6 leading-relaxed">
                                    If you've forgotten your password, we'll send you a reset link via email.
                                </p>
                                <button onclick="ProfileApp.handleForgotPassword()"
                                    class="px-10 py-4 bg-white border-2 border-stone-950 text-stone-950 text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-950 hover:text-white transition-all duration-500">
                                    Send Reset Link
                                </button>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>


<!-- ============================================ -->
<!-- MODALS -->
<!-- ============================================ -->

<!-- EDIT PROFILE MODAL -->
<div id="edit-profile-modal" class="modal fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
    <div class="modal-content bg-white max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="p-12">
            <div class="flex justify-between items-center mb-10 pb-8 border-b border-stone-100">
                <h2 class="text-3xl font-serif text-gray-900">Edit Profile</h2>
                <button onclick="ProfileApp.closeModal('edit-profile-modal')" class="text-4xl text-stone-400 hover:text-stone-900 leading-none">&times;</button>
            </div>
            
            <form id="edit-profile-form" class="space-y-6" novalidate>
                <div class="text-center mb-10">
                    <img id="edit-profile-img-preview" src="<%= user.profileImage || 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=400' %>" alt="Profile Preview" class="w-32 h-32 rounded-full mx-auto mb-6 border-4 border-stone-50 object-cover">
                    <label class="cursor-pointer px-8 py-3 bg-stone-100 text-stone-700 text-[10px] tracking-[0.3em] uppercase font-bold hover:bg-stone-200 transition-all inline-block">
                        Change Photo
                        <input type="file" name="profileImage" id="profile-image-input" accept="image/*" class="hidden">
                    </label>
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">First Name</label>
                        <input type="text" name="firstName" id="edit-firstname" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="edit-firstname-error" class="text-xs text-red-500 mt-1 hidden">First name is required</p>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Last Name</label>
                        <input type="text" name="lastName" id="edit-lastname" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    </div>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Email Address</label>
                    <input
                        type="text"
                        name="email"
                        id="edit-email"
                        value="<%= user.email %>"
                        <%= user.googleId ? "disabled" : "" %>
                        class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all"
                    />
                    <% if (user.googleId) { %>
                        <p class="text-xs text-stone-500 mt-2 italic">Email is managed by Google and cannot be changed</p>
                    <% } else { %>
                        <p class="text-xs text-stone-500 mt-2 italic">Changing email will require OTP verification</p>
                    <% } %>
                    <p id="edit-email-error" class="text-xs text-red-500 mt-1 hidden">Please enter a valid email</p>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Phone Number</label>
                    <input type="text" name="phone" id="edit-phone" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="edit-phone-error" class="text-xs text-red-500 mt-1 hidden">Please enter a valid 10-digit phone number</p>
                </div>

                <div class="flex gap-4 pt-6">
                    <button type="submit" class="flex-1 px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                        Save Changes
                    </button>
                    <button type="button" onclick="ProfileApp.closeModal('edit-profile-modal')" class="flex-1 px-10 py-4 bg-white border-2 border-stone-300 text-stone-700 text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-100 transition-all duration-500">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EMAIL VERIFICATION MODAL (OTP) -->
<div id="email-verification-modal" class="modal fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
    <div class="modal-content bg-white max-w-md w-full mx-4">
        <div class="p-12">
            <div class="text-center mb-10">
                <h2 class="text-3xl font-serif text-gray-900 mb-4">Verify Your Email</h2>
                <p class="text-sm text-stone-600">We've sent a 6-digit code to <span id="new-email-display" class="font-bold"></span></p>
            </div>
            
            <form id="verify-email-form" class="space-y-6">
                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3 text-center">Enter OTP Code</label>
                    <input type="text" id="otp-code" maxlength="6" class="w-full px-5 py-4 border border-stone-300 text-center text-2xl tracking-widest focus:border-stone-950 transition-all" placeholder="000000" required>
                    <p id="otp-error" class="text-xs text-red-500 mt-2 hidden text-center">Please enter a valid 6-digit code</p>
                </div>

                <button type="submit" class="w-full px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                    Verify Email
                </button>

                <div class="text-center space-y-3">
                    <p id="otp-timer" class="text-xs text-stone-500">
                        Resend code in <span class="font-semibold">05:00</span>
                    </p>
                    <button
                        type="button"
                        id="resend-otp-btn"
                        onclick="ProfileApp.resendOTP()"
                        class="text-xs text-stone-400 underline cursor-not-allowed"
                        disabled
                    >
                        Resend Code
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ADD ADDRESS MODAL -->
<!-- FIX: Field names now match controller (firstName, lastName, address1, address2, city, state, pincode, phone) -->
<div id="add-address-modal" class="modal fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
    <div class="modal-content bg-white max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="p-12">
            <div class="flex justify-between items-center mb-10 pb-8 border-b border-stone-100">
                <h2 class="text-3xl font-serif text-gray-900">Add New Address</h2>
                <button onclick="ProfileApp.closeModal('add-address-modal')" class="text-4xl text-stone-400 hover:text-stone-900 leading-none">&times;</button>
            </div>
            
            <form id="add-address-form" class="space-y-6" novalidate>
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">First Name</label>
                        <input type="text" name="firstName" id="add-firstName" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="add-firstName-error" class="text-xs text-red-500 mt-1 hidden">First name is required</p>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Last Name</label>
                        <input type="text" name="lastName" id="add-lastName" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="add-lastName-error" class="text-xs text-red-500 mt-1 hidden">Last name is required</p>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Phone Number</label>
                    <input type="tel" name="phone" id="add-phone" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="add-phone-error" class="text-xs text-red-500 mt-1 hidden">Please enter a valid 10-digit phone number</p>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Address Line 1</label>
                    <input type="text" name="address1" id="add-address1" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="add-address1-error" class="text-xs text-red-500 mt-1 hidden">Address is required</p>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Address Line 2 <span class="text-stone-300">(Optional)</span></label>
                    <input type="text" name="address2" id="add-address2" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">City</label>
                        <input type="text" name="city" id="add-city" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="add-city-error" class="text-xs text-red-500 mt-1 hidden">City is required</p>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">State</label>
                        <input type="text" name="state" id="add-state" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="add-state-error" class="text-xs text-red-500 mt-1 hidden">State is required</p>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">PIN Code</label>
                    <input type="text" name="pincode" id="add-pincode" maxlength="6" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="add-pincode-error" class="text-xs text-red-500 mt-1 hidden">Please enter a valid 6-digit PIN code</p>
                </div>

                <div class="flex items-center gap-3">
                    <input type="checkbox" name="isDefault" id="add-isDefault" class="w-5 h-5 cursor-pointer">
                    <label for="add-isDefault" class="text-sm text-stone-700 cursor-pointer">Set as default address</label>
                </div>

                <div class="flex gap-4 pt-6">
                    <button type="submit" class="flex-1 px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                        Save Address
                    </button>
                    <button type="button" onclick="ProfileApp.closeModal('add-address-modal')" class="flex-1 px-10 py-4 bg-white border-2 border-stone-300 text-stone-700 text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-100 transition-all duration-500">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- EDIT ADDRESS MODAL -->
<!-- FIX: Field names now match controller (firstName, lastName, address1, address2, city, state, pincode, phone, isDefault) -->
<!-- FIX: All IDs renamed to edit-* to avoid conflicts with add-address form -->
<div id="edit-address-modal" class="modal fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
    <div class="modal-content bg-white max-w-2xl w-full mx-4 max-h-[90vh] overflow-y-auto">
        <div class="p-12">
            <div class="flex justify-between items-center mb-10 pb-8 border-b border-stone-100">
                <h2 class="text-3xl font-serif text-gray-900">Edit Address</h2>
                <button onclick="ProfileApp.closeModal('edit-address-modal')" class="text-4xl text-stone-400 hover:text-stone-900 leading-none">&times;</button>
            </div>
            
            <form id="edit-address-form" class="space-y-6" novalidate>
                <input type="hidden" id="edit-address-id">
                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">First Name</label>
                        <input type="text" id="edit-addr-firstName" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="edit-addr-firstName-error" class="text-xs text-red-500 mt-1 hidden">First name is required</p>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Last Name</label>
                        <input type="text" id="edit-addr-lastName" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="edit-addr-lastName-error" class="text-xs text-red-500 mt-1 hidden">Last name is required</p>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Phone Number</label>
                    <input type="tel" id="edit-addr-phone" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="edit-addr-phone-error" class="text-xs text-red-500 mt-1 hidden">Please enter a valid 10-digit phone number</p>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Address Line 1</label>
                    <input type="text" id="edit-addr-address1" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="edit-addr-address1-error" class="text-xs text-red-500 mt-1 hidden">Address is required</p>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">Address Line 2 <span class="text-stone-300">(Optional)</span></label>
                    <input type="text" id="edit-addr-address2" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">City</label>
                        <input type="text" id="edit-addr-city" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="edit-addr-city-error" class="text-xs text-red-500 mt-1 hidden">City is required</p>
                    </div>
                    <div>
                        <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">State</label>
                        <input type="text" id="edit-addr-state" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                        <p id="edit-addr-state-error" class="text-xs text-red-500 mt-1 hidden">State is required</p>
                    </div>
                </div>

                <div>
                    <label class="text-[10px] uppercase tracking-[0.3em] text-stone-400 font-bold block mb-3">PIN Code</label>
                    <input type="text" id="edit-addr-pincode" maxlength="6" class="w-full px-5 py-4 border border-stone-300 text-sm focus:border-stone-950 transition-all">
                    <p id="edit-addr-pincode-error" class="text-xs text-red-500 mt-1 hidden">Please enter a valid 6-digit PIN code</p>
                </div>

                <div class="flex items-center gap-3">
                    <input type="checkbox" id="edit-addr-isDefault" class="w-5 h-5 cursor-pointer">
                    <label for="edit-addr-isDefault" class="text-sm text-stone-700 cursor-pointer">Set as default address</label>
                </div>

                <div class="flex gap-4 pt-6">
                    <button type="submit" class="flex-1 px-10 py-4 bg-stone-950 text-white text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-700 transition-all duration-500">
                        Update Address
                    </button>
                    <button type="button" onclick="ProfileApp.closeModal('edit-address-modal')" class="flex-1 px-10 py-4 bg-white border-2 border-stone-300 text-stone-700 text-[10px] tracking-[0.4em] uppercase font-black hover:bg-stone-100 transition-all duration-500">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- DELETE ADDRESS CONFIRMATION -->
