    75% { transform: translateX(8px); }
}

/* Button Styling */
.emera-btn {
    width: 100%;
    padding: 16px 32px;
    background: linear-gradient(135deg, var(--emerald-rich), var(--emerald-mid));
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
