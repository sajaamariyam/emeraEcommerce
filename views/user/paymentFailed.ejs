<%- include('../partials/user/header') %>

<main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20 animate-reveal">

    <!-- Breadcrumb -->
    <div class="mb-16 space-y-6">
        <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-400">
            <a href="/" class="hover:text-black transition-colors">Home</a> /
            <a href="/orders" class="hover:text-black transition-colors">Orders</a> /
            <span class="text-black">Payment Failed</span>
        </nav>
    </div>

    <!-- Centered Content -->
    <div class="max-w-2xl mx-auto text-center">

        <!-- Failure Illustration -->
        <div class="flex justify-center mb-10">
            <div class="w-32 h-32 rounded-full bg-red-50 flex items-center justify-center">
                <svg class="w-16 h-16 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                        d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
            </div>
        </div>

        <!-- Heading -->
        <h1 class="text-5xl md:text-6xl font-serif text-gray-900 leading-none mb-4">
            Payment <span class="italic font-light">Failed</span>
        </h1>

        <p class="text-[11px] uppercase tracking-[0.3em] text-red-500 font-bold mb-6">
            Transaction Unsuccessful
        </p>

        <!-- Message -->
        <p class="text-sm text-gray-600 mb-4 leading-relaxed">
            We were unable to process your payment for order
            <strong class="text-gray-900">#<%= order.orderId %></strong>.
            Your cart items are still saved and your order is pending payment.
        </p>

        <p class="text-sm text-gray-500 mb-12">
            No money has been deducted from your account. You can retry the payment or choose a different payment method.
        </p>

        <!-- Order Info Box -->
        <div class="bg-stone-50 border border-stone-100 p-8 mb-10 text-left">
            <div class="grid grid-cols-2 gap-6">
                <div>
                    <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Order ID</p>
                    <p class="text-sm font-semibold text-gray-900">#<%= order.orderId %></p>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Amount</p>
                    <p class="text-sm font-semibold text-gray-900">₹<%= order.finalAmount.toLocaleString('en-IN') %></p>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Status</p>
                    <span class="inline-block px-3 py-1 bg-red-50 text-red-600 text-[9px] uppercase tracking-widest font-bold border border-red-100">
                        Payment Failed
                    </span>
                </div>
                <div>
                    <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-1">Date</p>
                    <p class="text-sm font-semibold text-gray-900">
                        <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                    </p>
                </div>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="space-y-4">
            <!-- Retry Payment -->
            <a href="/payment/<%= order.orderId %>"
                class="block w-full bg-emera-950 text-white py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all duration-300 text-center">
                Retry Payment
            </a>

            <!-- View Order Details -->
            <a href="/orders/<%= order.orderId %>"
                class="block w-full border-2 border-emera-950 text-emera-950 py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-300 text-center">
                View Order Details
            </a>

            <!-- Continue Shopping -->
            <a href="/products"
                class="block w-full border-2 border-stone-300 text-gray-600 py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 hover:text-gray-900 transition-all duration-300 text-center">
                Continue Shopping
            </a>
        </div>

        <!-- Support -->
        <div class="mt-12 pt-8 border-t border-stone-200 text-center space-y-2">
            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-900 font-bold">Need Help?</p>
            <p class="text-[9px] text-gray-400 uppercase tracking-widest">Email: support@emera.com</p>
            <p class="text-[9px] text-gray-400 uppercase tracking-widest">Phone: +91 1800 123 4567</p>
        </div>

    </div>

</main>

<style>
    .animate-reveal {
        animation: fadeIn 0.6s ease-out;
    }
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<%- include('../partials/user/footer') %>
