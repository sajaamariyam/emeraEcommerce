<%- include('../partials/user/header') %>
    
    <main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20 animate-reveal">
        
        <!-- Breadcrumb & Header -->
        <div class="mb-24 space-y-6">
            <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-400">
                <a href="/" class="hover:text-black transition-colors">Home</a> / 
                <% if (!isBuyNow) { %><a href="/cart" class="hover:text-black transition-colors">Cart</a> / <% } %>
                <span class="text-black">Checkout</span>
            </nav>
            <h1 class="text-6xl md:text-7xl font-serif text-gray-900 leading-none">Secure <span class="italic font-light">Checkout</span></h1>
            <p class="text-[11px] uppercase tracking-[0.3em] text-gray-400 font-bold">
                <%= isBuyNow ? 'Quick Purchase' : 'Complete Your Order' %>
            </p>
        </div>
        
        <!-- Main Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-24">
            
            <!-- Checkout Form -->
            <div class="lg:col-span-2 space-y-12">
                
                <!-- Contact Information -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-3xl font-serif text-gray-900">Contact Information</h2>
                        <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">Step 1 of 3</span>
                    </div>
                    <div class="space-y-6">
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Email Address *</label>
                            <input type="email" id="email" required value="<%= user?.email || '' %>" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Phone Number *</label>
                            <input type="tel" id="phone" required value="<%= user?.phone || '' %>" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                    </div>
                </div>
                
                <!-- Shipping Address -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-3xl font-serif text-gray-900">Shipping Address</h2>
                        <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">Step 2 of 3</span>
                    </div>
                    
                    <% if (addresses && addresses.length > 0) { %>
                        <div class="mb-8">
                            <h3 class="text-sm font-semibold text-gray-900 mb-4 uppercase tracking-widest">Select Saved Address</h3>
                            <div class="space-y-4" id="savedAddresses">
                                <% addresses.forEach((address, index) => { %>
                                    <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white address-card" data-address-id="<%= address._id %>">
                                        <input type="radio" name="selectedAddress" value="<%= address._id %>" class="radio-custom mt-1" <%= address.isDefault ? 'checked' : '' %>>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-sm font-semibold"><%= address.firstName %> <%= address.lastName %></span>
                                                <% if (address.isDefault) { %>
                                                    <span class="text-[8px] uppercase tracking-widest text-emera-700 font-bold bg-emera-50 px-3 py-1">Default</span>
                                                <% } %>
                                            </div>
                                            <p class="text-xs text-gray-600 mb-1"><%= address.address1 %><% if (address.address2) { %>, <%= address.address2 %><% } %></p>
                                            <p class="text-xs text-gray-600 mb-1"><%= address.city %>, <%= address.state %> - <%= address.pincode %></p>
                                            <p class="text-xs text-gray-600 mb-3">India</p>
                                            <p class="text-xs text-gray-600">Phone: <%= address.phone || user.phone %></p>
                                            <div class="flex gap-4 mt-4">
                                                <button class="text-[9px] uppercase tracking-widest text-emera-700 font-bold hover:text-emera-950 transition-colors edit-address-btn" data-address-id="<%= address._id %>">Edit</button>
                                                <% if (!address.isDefault) { %>
                                                    <button class="text-[9px] uppercase tracking-widest text-gray-500 font-bold hover:text-gray-900 transition-colors set-default-btn" data-address-id="<%= address._id %>">Set as Default</button>
                                                    <button class="text-[9px] uppercase tracking-widest text-red-500 font-bold hover:text-red-700 transition-colors delete-address-btn" data-address-id="<%= address._id %>">Delete</button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </label>
                                <% }) %>
                            </div>
                            <button id="addNewAddressBtn" class="mt-6 w-full border-2 border-dashed border-stone-300 text-gray-600 py-6 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-emera-950 hover:text-emera-950 transition-all duration-300">
                                + Add New Address
                            </button>
                        </div>
                    <% } else { %>
                        <p class="text-sm text-gray-500 mb-6 text-center py-4">No saved addresses. Please add a new address below.</p>
                    <% } %>
                    
                    <!-- Add/Edit Address Form -->
                    <div id="addressForm" class="<%= addresses && addresses.length > 0 ? 'hidden' : '' %> space-y-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-widest" id="formTitle">
                                <%= addresses && addresses.length > 0 ? 'Add New Address' : 'Enter Shipping Address' %>
                            </h3>
                            <% if (addresses && addresses.length > 0) { %>
                                <button id="cancelAddressBtn" class="text-[9px] uppercase tracking-widest text-gray-500 font-bold hover:text-gray-900 transition-colors">Cancel</button>
                            <% } %>
                        </div>
                        <input type="hidden" id="editingAddressId" value="">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">First Name *</label>
                                <input type="text" id="firstName" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Last Name *</label>
                                <input type="text" id="lastName" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Street Address *</label>
                            <input type="text" id="address1" required placeholder="House number and street name" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white mb-4">
                            <input type="text" id="address2" placeholder="Apartment, suite, unit etc. (optional)" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">City *</label>
                                <input type="text" id="city" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">State / Province *</label>
                                <select id="state" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                                    <option value="">Select State</option>
                                    <option value="AN">Andaman and Nicobar Islands</option>
                                    <option value="AP">Andhra Pradesh</option>
                                    <option value="AR">Arunachal Pradesh</option>
                                    <option value="AS">Assam</option>
                                    <option value="BR">Bihar</option>
                                    <option value="CH">Chandigarh</option>
                                    <option value="CT">Chhattisgarh</option>
                                    <option value="DH">Dadra and Nagar Haveli and Daman and Diu</option>
                                    <option value="DL">Delhi</option>
                                    <option value="GA">Goa</option>
                                    <option value="GJ">Gujarat</option>
                                    <option value="HR">Haryana</option>
                                    <option value="HP">Himachal Pradesh</option>
                                    <option value="JK">Jammu and Kashmir</option>
                                    <option value="JH">Jharkhand</option>
                                    <option value="KA">Karnataka</option>
                                    <option value="KL">Kerala</option>
                                    <option value="LA">Ladakh</option>
                                    <option value="LD">Lakshadweep</option>
                                    <option value="MP">Madhya Pradesh</option>
                                    <option value="MH">Maharashtra</option>
                                    <option value="MN">Manipur</option>
                                    <option value="ML">Meghalaya</option>
                                    <option value="MZ">Mizoram</option>
                                    <option value="NL">Nagaland</option>
                                    <option value="OR">Odisha</option>
                                    <option value="PY">Puducherry</option>
                                    <option value="PB">Punjab</option>
                                    <option value="RJ">Rajasthan</option>
                                    <option value="SK">Sikkim</option>
                                    <option value="TN">Tamil Nadu</option>
                                    <option value="TG">Telangana</option>
                                    <option value="TR">Tripura</option>
                                    <option value="UP">Uttar Pradesh</option>
                                    <option value="UT">Uttarakhand</option>
                                    <option value="WB">West Bengal</option>
                                </select>
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">PIN Code *</label>
                                <input type="text" id="pincode" required maxlength="6" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Country *</label>
                                <input type="text" id="country" value="India" readonly class="w-full border border-stone-300 px-6 py-4 text-sm bg-stone-100 text-gray-500">
                            </div>
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Phone (Optional)</label>
                            <input type="tel" id="addressPhone" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            <p class="text-[9px] text-gray-400 mt-2">Leave blank to use contact phone number</p>
                        </div>
                        <div>
                            <label class="flex items-start gap-3 cursor-pointer">
                                <input type="checkbox" id="setAsDefault" class="mt-1">
                                <span class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold">Set as default address</span>
                            </label>
                        </div>
                        <button id="saveAddressBtn" class="w-full bg-emera-950 text-white py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all duration-300">
                            Save Address
                        </button>
                    </div>
                </div>
                
                <!-- Payment Method -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-3xl font-serif text-gray-900">Payment Method</h2>
                        <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">Step 3 of 3</span>
                    </div>
                    <div class="space-y-4">
                        <!-- Online Payment -->
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white group">
                            <input type="radio" name="payment" value="razorpay" class="radio-custom mt-1" checked>
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-semibold">Online Payment</span>
                                    <div class="flex items-center gap-2">
                                        <span class="h-6 px-2 bg-white border border-stone-200 text-[8px] uppercase tracking-widest font-bold text-gray-500 flex items-center">Visa</span>
                                        <span class="h-6 px-2 bg-white border border-stone-200 text-[8px] uppercase tracking-widest font-bold text-gray-500 flex items-center">UPI</span>
                                        <span class="h-6 px-2 bg-white border border-stone-200 text-[8px] uppercase tracking-widest font-bold text-gray-500 flex items-center">NB</span>
                                    </div>
                                </div>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Card · UPI · Net Banking — powered by Razorpay</p>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-emera-700 font-bold mt-3 online-hint hidden">You'll choose your preferred method on the next step</p>
                            </div>
                        </label>

                        <!-- Cash on Delivery -->
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white">
                            <input type="radio" name="payment" value="cod" class="radio-custom mt-1">
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-semibold">Cash on Delivery</span>
                                    <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">No extra charge</span>
                                </div>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Pay in cash when your order arrives</p>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-amber-600 font-bold mt-2 cod-limit-warning hidden">
                                    Not available for orders above ₹<%= COD_MAX_AMOUNT.toLocaleString('en-IN') %>
                                </p>
                            </div>
                        </label>

                        <%
                            // FIX: Wallet balance guard — cast to Number to avoid NaN/undefined issues.
                            // Previously this check was inside an HTML comment which EJS was still parsing,
                            // causing "Unexpected token catch" compilation errors.
                            var safeWalletBalance = Number(walletBalance) || 0;
                        %>
                        <% if (safeWalletBalance > 0) { %>
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white">
                            <input type="radio" name="payment" value="wallet" class="radio-custom mt-1">
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-semibold">Wallet</span>
                                    <span class="text-[9px] uppercase tracking-[0.3em] text-emera-700 font-bold">Balance: ₹<%= safeWalletBalance.toLocaleString('en-IN') %></span>
                                </div>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Pay using your stored wallet balance</p>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-red-500 font-bold mt-2 wallet-insufficient hidden">Insufficient balance for this order</p>
                            </div>
                        </label>
                        <% } %>
                    </div>
                </div>
                
            </div>
            
            <!-- Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-stone-50 p-10 border border-stone-100 sticky top-32">
                    <h2 class="text-3xl font-serif text-gray-900 mb-8">Order Summary</h2>
                    
                    <!-- Order Items -->
                    <div class="space-y-6 mb-8 pb-8 border-b border-stone-200">
                        <% if (cartItems && cartItems.length > 0) { %>
                            <% cartItems.forEach(item => { %>
                                <% const isOutOfStock = item.product.stock < item.quantity; %>
                                <% const isBlocked = item.product.isBlocked || item.product.category?.isBlocked; %>
                                <div class="flex gap-4 <%= (isOutOfStock || isBlocked) ? 'opacity-50' : '' %>">
                                    <div class="w-20 h-20 bg-stone-200 flex-shrink-0 overflow-hidden">
                                        <img src="<%= item.product.productImage?.[0]?.url || '/images/placeholder.png' %>" alt="<%= item.product.name %>" class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="text-sm font-semibold text-gray-900 mb-1"><%= item.product.name %></h4>
                                        <p class="text-[9px] uppercase tracking-widest text-gray-400">Qty: <%= item.quantity %></p>
                                        <% if (item.color) { %>
                                            <div class="flex items-center gap-2 mt-1">
                                                <div class="w-3 h-3 rounded-full border border-gray-200" style="background-color: <%= item.color %>"></div>
                                                <p class="text-[9px] uppercase tracking-widest text-gray-400"><%= item.color %></p>
                                            </div>
                                        <% } %>
                                        <% if (isOutOfStock) { %>
                                            <p class="text-[8px] uppercase tracking-widest text-red-600 font-bold mt-1">Out of Stock</p>
                                        <% } else if (isBlocked) { %>
                                            <p class="text-[8px] uppercase tracking-widest text-red-600 font-bold mt-1">Unavailable</p>
                                        <% } %>
                                        <p class="text-sm font-bold text-gray-900 mt-2">₹<%= item.price.toLocaleString('en-IN') %></p>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-8">
                                <p class="text-sm text-gray-500">No items in cart</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- Coupon Section -->
                    <div class="mb-8 pb-8 border-b border-stone-200">
                        <h3 class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-4">Apply Coupon</h3>

                        <% if (coupons && coupons.length > 0) { %>
                        <div class="space-y-3 mb-4">
                            <% coupons.forEach(coupon => { %>
                                <button type="button"
                                    class="coupon-chip w-full flex items-center justify-between px-5 py-3 border-2 border-dashed border-stone-300 hover:border-emera-950 transition-all text-left group"
                                    data-code="<%= coupon.code %>"
                                    data-discount="<%= coupon.discountAmount %>">
                                    <div>
                                        <span class="text-[10px] uppercase tracking-[0.2em] font-bold text-gray-800 group-hover:text-emera-950"><%= coupon.code %></span>
                                        <% if (coupon.isPercentage) { %>
                                            <p class="text-[9px] text-gray-400 mt-0.5">
                                                <%= coupon.discountAmount %>% off
                                                <% if (coupon.maxDiscount) { %>· up to ₹<%= coupon.maxDiscount.toLocaleString('en-IN') %><% } %>
                                            </p>
                                        <% } else { %>
                                            <p class="text-[9px] text-gray-400 mt-0.5">Save ₹<%= coupon.discountAmount.toLocaleString('en-IN') %></p>
                                        <% } %>
                                    </div>
                                    <span class="text-[9px] uppercase tracking-widest font-bold text-emera-700 group-hover:text-emera-950">Apply</span>
                                </button>
                            <% }) %>
                        </div>
                        <% } %>

                        <!-- Manual coupon input -->
                        <div class="flex gap-3">
                            <input type="text" id="couponInput" placeholder="Enter coupon code"
                                class="flex-1 border border-stone-300 px-4 py-3 text-sm focus:border-emera-950 transition-colors bg-white uppercase"
                                autocomplete="off" spellcheck="false">
                            <button type="button" onclick="applyManualCoupon()"
                                class="px-5 py-3 bg-emera-950 text-white text-[9px] uppercase tracking-[0.3em] font-bold hover:bg-emera-700 transition-all whitespace-nowrap">
                                Apply
                            </button>
                        </div>

                        <!-- Applied coupon tag -->
                        <div id="appliedCouponTag" class="hidden mt-4 flex items-center justify-between bg-green-50 border border-green-200 px-5 py-3">
                            <div class="flex items-center gap-3">
                                <svg class="w-4 h-4 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                <span id="appliedCouponCode" class="text-[10px] uppercase tracking-widest font-bold text-green-700"></span>
                            </div>
                            <button type="button" onclick="removeCoupon()" class="text-[9px] uppercase tracking-widest text-red-500 font-bold hover:text-red-700">Remove</button>
                        </div>

                        <!-- Coupon error -->
                        <p id="couponError" class="hidden mt-2 text-[9px] uppercase tracking-widest text-red-500 font-bold"></p>
                    </div>
                    
                    <!-- Price Breakdown -->
                    <div class="space-y-6 mb-8 pb-8 border-b border-stone-200">
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Subtotal</span>
                            <span class="font-bold text-gray-900">₹<%= subtotal.toLocaleString('en-IN') %></span>
                        </div>
                        <div id="discountRow" class="<%= discount > 0 ? '' : 'hidden' %> flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Coupon Discount</span>
                            <span class="font-bold text-emera-700" id="discountDisplay">-₹<%= discount > 0 ? discount.toLocaleString('en-IN') : '0' %></span>
                        </div>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Shipping</span>
                            <span class="font-bold text-emera-700">Complimentary</span>
                        </div>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Tax (GST 18%)</span>
                            <span class="font-bold text-gray-900" id="taxDisplay">₹<%= tax.toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                    
                    <div class="flex justify-between mb-8 pb-8 border-b border-stone-200">
                        <span class="text-xl font-serif text-gray-900">Total</span>
                        <span class="text-2xl font-serif text-gray-900" id="totalDisplay">₹<%= total.toLocaleString('en-IN') %></span>
                    </div>

                    <button id="placeOrderBtn"
                      class="block text-center w-full bg-emera-950 text-white py-6 text-[10px] uppercase tracking-[0.4em] font-bold mb-6 hover:bg-emera-700 transition-all duration-300">
                      Continue to Payment
                    </button>
                    
                    <% if (cartItems && cartItems.some(item => item.product.stock < item.quantity || item.product.isBlocked || item.product.category?.isBlocked)) { %>
                        <p class="text-[9px] text-red-600 uppercase tracking-widest text-center mb-4">Please remove unavailable items to continue</p>
                    <% } %>
                    
                    <div class="space-y-4 text-center">
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Secure Checkout • 256-bit SSL</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Free Returns Within 30 Days</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Authenticity Guaranteed</p>
                    </div>
                </div>
            </div>
            
        </div>
        
    </main>

<!-- Aesthetic Modal -->
<div id="aestheticModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center px-6 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white max-w-md w-full transform scale-95 transition-transform duration-300" id="modalContent">
        <div class="p-10 text-center">
            <div class="mb-6">
                <div class="w-16 h-16 mx-auto bg-stone-100 rounded-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-600" id="modalIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24"></svg>
                </div>
            </div>
            <h3 class="text-2xl font-serif text-gray-900 mb-4" id="modalTitle"></h3>
            <p class="text-sm text-gray-600 mb-8" id="modalMessage"></p>
            <button id="modalCloseBtn" class="w-full bg-emera-950 text-white py-4 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all duration-300">Close</button>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center px-6 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white max-w-md w-full transform scale-95 transition-transform duration-300" id="confirmContent">
        <div class="p-10 text-center">
            <div class="mb-6">
                <div class="w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
            </div>
            <h3 class="text-2xl font-serif text-gray-900 mb-4" id="confirmTitle"></h3>
            <p class="text-sm text-gray-600 mb-8" id="confirmMessage"></p>
            <div class="flex gap-4">
                <button id="confirmCancelBtn" class="flex-1 border-2 border-stone-300 text-gray-700 py-4 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-gray-900 transition-all duration-300">Cancel</button>
                <button id="confirmOkBtn" class="flex-1 bg-red-600 text-white py-4 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-red-700 transition-all duration-300">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
  // ── Server-side constants ─────────────────────────────────────────────
  const BASE_SUBTOTAL  = <%- JSON.stringify(subtotal || 0) %>;
  const BASE_TOTAL     = <%- JSON.stringify(total || 0) %>;
  const COD_MAX        = <%- JSON.stringify(COD_MAX_AMOUNT || 0) %>;
  const WALLET_BALANCE = <%- JSON.stringify(walletBalance || 0) %>;

  // ── Buy Now state ─────────────────────────────────────────────────────
  const IS_BUY_NOW        = <%- JSON.stringify(isBuyNow) %>;
  const BUY_NOW_PRODUCT   = <%- JSON.stringify(buyNowProductId) %>;
  const BUY_NOW_COLOR     = <%- JSON.stringify(buyNowColor) %>;
  const BUY_NOW_QTY       = <%- JSON.stringify(buyNowQty) %>;

  // ── Coupon state ──────────────────────────────────────────────────────
  let appliedCouponCode = '';
  let appliedDiscount   = 0;
  let currentTotal      = BASE_TOTAL;

  window.addresses = <%- JSON.stringify(addresses || []) %>;

  // ── Modal ─────────────────────────────────────────────────────────────
  function showModal(title, message, type) {
    type = type || 'info';
    const modal        = document.getElementById('aestheticModal');
    const modalContent = document.getElementById('modalContent');
    const modalIcon    = document.getElementById('modalIcon');
    document.getElementById('modalTitle').textContent   = title;
    document.getElementById('modalMessage').textContent = message;

    if (type === 'error') {
      modalIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>';
      modalIcon.parentElement.className = 'w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center';
      modalIcon.className = 'w-8 h-8 text-red-600';
    } else if (type === 'success') {
      modalIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>';
      modalIcon.parentElement.className = 'w-16 h-16 mx-auto bg-green-100 rounded-full flex items-center justify-center';
      modalIcon.className = 'w-8 h-8 text-green-600';
    } else {
      modalIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>';
      modalIcon.parentElement.className = 'w-16 h-16 mx-auto bg-stone-100 rounded-full flex items-center justify-center';
      modalIcon.className = 'w-8 h-8 text-gray-600';
    }

    modal.classList.remove('hidden');
    setTimeout(function() {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }, 10);
  }

  function hideModal() {
    const modal        = document.getElementById('aestheticModal');
    const modalContent = document.getElementById('modalContent');
    modal.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('scale-95');
    setTimeout(function() { modal.classList.add('hidden'); }, 300);
  }

  // ── Payment method warnings ───────────────────────────────────────────
  function updatePaymentMethodWarnings(total) {
    document.querySelectorAll('.cod-limit-warning').forEach(function(el) {
      el.classList.toggle('hidden', total <= COD_MAX);
    });
    document.querySelectorAll('.wallet-insufficient').forEach(function(el) {
      el.classList.toggle('hidden', WALLET_BALANCE >= total);
    });

    const codRadio = document.querySelector('input[name="payment"][value="cod"]');
    if (codRadio) {
      codRadio.disabled = total > COD_MAX;
      if (codRadio.disabled && codRadio.checked) {
        const onlineRadio = document.querySelector('input[name="payment"][value="razorpay"]');
        if (onlineRadio) { onlineRadio.checked = true; updateButtonLabel('razorpay'); }
      }
    }

    const walletRadio = document.querySelector('input[name="payment"][value="wallet"]');
    if (walletRadio) {
      walletRadio.disabled = WALLET_BALANCE < total;
      if (walletRadio.disabled && walletRadio.checked) {
        const onlineRadio = document.querySelector('input[name="payment"][value="razorpay"]');
        if (onlineRadio) { onlineRadio.checked = true; updateButtonLabel('razorpay'); }
      }
    }
  }

  function updateButtonLabel(value) {
    const btn = document.getElementById('placeOrderBtn');
    if (btn) btn.textContent = value === 'cod' ? 'Place Order' : 'Continue to Payment';
  }

  // ── Coupon functions ──────────────────────────────────────────────────
  async function applyCoupon(code) {
    const errEl = document.getElementById('couponError');
    errEl.classList.add('hidden');

    try {
      const res = await fetch('/checkout/apply-coupon', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({
          couponCode:      code,
          isBuyNow:        IS_BUY_NOW,
          buyNowProductId: BUY_NOW_PRODUCT,
          buyNowQty:       BUY_NOW_QTY,
        }),
      });
      const data = await res.json();

      if (!data.success) {
        errEl.textContent = data.message || 'This coupon cannot be applied.';
        errEl.classList.remove('hidden');
        return;
      }

      appliedCouponCode = code;
      appliedDiscount   = data.discountAmount;
      currentTotal      = data.newTotal;

      const discountedSubtotal = BASE_SUBTOTAL - data.discountAmount;
      const newTax             = Math.round(discountedSubtotal * 0.18);

      document.getElementById('discountRow').classList.remove('hidden');
      document.getElementById('discountDisplay').textContent   = '-\u20B9' + data.discountAmount.toLocaleString('en-IN');
      document.getElementById('taxDisplay').textContent        = '\u20B9' + newTax.toLocaleString('en-IN');
      document.getElementById('totalDisplay').textContent      = '\u20B9' + data.newTotal.toLocaleString('en-IN');
      document.getElementById('appliedCouponCode').textContent = code;
      document.getElementById('appliedCouponTag').classList.remove('hidden');

      document.querySelectorAll('.coupon-chip').forEach(function(btn) {
        btn.classList.toggle('border-emera-950', btn.dataset.code === code);
        btn.classList.toggle('bg-emera-50',      btn.dataset.code === code);
      });

      updatePaymentMethodWarnings(currentTotal);

    } catch (err) {
      errEl.textContent = 'Failed to validate coupon. Please try again.';
      errEl.classList.remove('hidden');
    }
  }

  async function applyManualCoupon() {
    const input = document.getElementById('couponInput');
    const code  = input.value.trim().toUpperCase();
    if (!code) return;
    await applyCoupon(code);
    input.value = '';
  }

  function removeCoupon() {
    appliedCouponCode = '';
    appliedDiscount   = 0;
    currentTotal      = BASE_TOTAL;

    const originalTax = Math.round(BASE_SUBTOTAL * 0.18);

    document.getElementById('discountRow').classList.add('hidden');
    document.getElementById('taxDisplay').textContent   = '\u20B9' + originalTax.toLocaleString('en-IN');
    document.getElementById('totalDisplay').textContent = '\u20B9' + BASE_TOTAL.toLocaleString('en-IN');
    document.getElementById('appliedCouponTag').classList.add('hidden');
    document.getElementById('couponInput').value = '';
    document.getElementById('couponError').classList.add('hidden');
    document.querySelectorAll('.coupon-chip').forEach(function(btn) {
      btn.classList.remove('border-emera-950', 'bg-emera-50');
    });

    updatePaymentMethodWarnings(currentTotal);
  }

  document.addEventListener('DOMContentLoaded', function() {

    // ── Confirm modal ─────────────────────────────────────────────────
    function showConfirm(title, message, onConfirm) {
      const modal        = document.getElementById('confirmModal');
      const modalContent = document.getElementById('confirmContent');
      document.getElementById('confirmTitle').textContent   = title;
      document.getElementById('confirmMessage').textContent = message;
      modal.classList.remove('hidden');
      setTimeout(function() {
        modal.classList.remove('opacity-0');
        modalContent.classList.remove('scale-95');
        modalContent.classList.add('scale-100');
      }, 10);

      function hideConfirm() {
        modal.classList.add('opacity-0');
        modalContent.classList.remove('scale-100');
        modalContent.classList.add('scale-95');
        setTimeout(function() { modal.classList.add('hidden'); }, 300);
      }

      document.getElementById('confirmOkBtn').onclick    = function() { hideConfirm(); onConfirm(); };
      document.getElementById('confirmCancelBtn').onclick = hideConfirm;
    }

    document.getElementById('modalCloseBtn').addEventListener('click', hideModal);

    // ── Payment radio change ──────────────────────────────────────────
    document.querySelectorAll('input[name="payment"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        const hint = document.querySelector('.online-hint');
        if (hint) hint.classList.toggle('hidden', radio.value !== 'razorpay');
        updateButtonLabel(radio.value);
      });
    });

    document.querySelectorAll('.coupon-chip').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var code = btn.dataset.code;
        if (code) applyCoupon(code);
      });
    });

    const defaultPayment = document.querySelector('input[name="payment"]:checked');
    if (defaultPayment) {
      updateButtonLabel(defaultPayment.value);
      const hint = document.querySelector('.online-hint');
      if (hint) hint.classList.toggle('hidden', defaultPayment.value !== 'razorpay');
    }

    updatePaymentMethodWarnings(currentTotal);

    // ── Coupon input — Enter key ──────────────────────────────────────
    const couponInputEl = document.getElementById('couponInput');
    if (couponInputEl) {
      couponInputEl.addEventListener('keydown', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); applyManualCoupon(); }
      });
    }

    // ── Address helpers ───────────────────────────────────────────────
    const addressForm      = document.getElementById('addressForm');
    const addNewAddressBtn = document.getElementById('addNewAddressBtn');
    const cancelAddressBtn = document.getElementById('cancelAddressBtn');
    const saveAddressBtn   = document.getElementById('saveAddressBtn');
    const editingAddressId = document.getElementById('editingAddressId');

    function clearAddressForm() {
      editingAddressId.value = '';
      ['firstName','lastName','address1','address2','city','state','pincode','addressPhone'].forEach(function(id) {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });
      const def = document.getElementById('setAsDefault');
      if (def) def.checked = false;
    }

    if (addNewAddressBtn) {
      addNewAddressBtn.addEventListener('click', function() {
        addressForm.classList.remove('hidden');
        addNewAddressBtn.classList.add('hidden');
        clearAddressForm();
      });
    }

    if (cancelAddressBtn) {
      cancelAddressBtn.addEventListener('click', function() {
        addressForm.classList.add('hidden');
        if (addNewAddressBtn) addNewAddressBtn.classList.remove('hidden');
        clearAddressForm();
      });
    }

    if (saveAddressBtn) {
      saveAddressBtn.addEventListener('click', async function() {
        const firstName = document.getElementById('firstName').value.trim();
        const lastName  = document.getElementById('lastName').value.trim();
        const address1  = document.getElementById('address1').value.trim();
        const city      = document.getElementById('city').value.trim();
        const state     = document.getElementById('state').value;
        const pincode   = document.getElementById('pincode').value.trim();

        if (!firstName || !lastName || !address1 || !city || !state || !pincode) {
          showModal('Required Fields', 'Please fill all required fields to continue.', 'error');
          return;
        }
        if (!/^\d{6}$/.test(pincode)) {
          showModal('Invalid PIN Code', 'PIN code must be exactly 6 digits.', 'error');
          return;
        }

        const payload = {
          firstName,
          lastName,
          address1,
          address2:  document.getElementById('address2').value.trim(),
          city,
          state,
          pincode,
          phone:     document.getElementById('addressPhone').value.trim(),
          isDefault: document.getElementById('setAsDefault').checked,
        };

        const isEdit = Boolean(editingAddressId.value);
        const url    = isEdit
          ? '/profile/addresses/' + editingAddressId.value
          : '/profile/addresses';

        try {
          saveAddressBtn.disabled = true;
          const res  = await fetch(url, {
            method:  isEdit ? 'PUT' : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify(payload),
          });
          const data = await res.json();
          if (data.success) {
            location.reload();
          } else {
            showModal('Save Failed', data.message || 'Unable to save address.', 'error');
          }
        } catch (err) {
          showModal('Connection Error', 'Something went wrong. Please try again.', 'error');
        } finally {
          saveAddressBtn.disabled = false;
        }
      });
    }

    document.querySelectorAll('.edit-address-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const address = window.addresses.find(function(a) { return a._id === btn.dataset.addressId; });
        if (!address) { showModal('Not Found', 'Address not found.', 'error'); return; }
        editingAddressId.value = address._id;
        document.getElementById('firstName').value    = address.firstName;
        document.getElementById('lastName').value     = address.lastName;
        document.getElementById('address1').value     = address.address1;
        document.getElementById('address2').value     = address.address2 || '';
        document.getElementById('city').value         = address.city;
        document.getElementById('state').value        = address.state;
        document.getElementById('pincode').value      = address.pincode;
        document.getElementById('addressPhone').value = address.phone || '';
        document.getElementById('setAsDefault').checked = address.isDefault;
        addressForm.classList.remove('hidden');
        if (addNewAddressBtn) addNewAddressBtn.classList.add('hidden');
        addressForm.scrollIntoView({ behavior: 'smooth' });
      });
    });

    document.querySelectorAll('.delete-address-btn').forEach(function(btn) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        showConfirm('Delete Address', 'Are you sure you want to delete this address?', async function() {
          try {
            const res  = await fetch('/profile/addresses/' + btn.dataset.addressId, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
              location.reload();
            } else {
              showModal('Delete Failed', data.message || 'Unable to delete address.', 'error');
            }
          } catch (err) {
            showModal('Connection Error', 'Something went wrong.', 'error');
          }
        });
      });
    });

    document.querySelectorAll('.set-default-btn').forEach(function(btn) {
      btn.addEventListener('click', async function(e) {
        e.preventDefault();
        e.stopPropagation();
        try {
          const res  = await fetch('/profile/addresses/' + btn.dataset.addressId + '/set-default', { method: 'PUT' });
          const data = await res.json();
          if (data.success) {
            location.reload();
          } else {
            showModal('Update Failed', data.message || 'Failed to set default.', 'error');
          }
        } catch (err) {
          showModal('Connection Error', 'Something went wrong.', 'error');
        }
      });
    });

    // ── Place Order ───────────────────────────────────────────────────
    const placeOrderBtn = document.getElementById('placeOrderBtn');
    if (placeOrderBtn) {
      placeOrderBtn.addEventListener('click', async function(e) {
        e.preventDefault();

        const email           = document.getElementById('email') ? document.getElementById('email').value.trim() : '';
        const phone           = document.getElementById('phone') ? document.getElementById('phone').value.trim() : '';
        const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked');

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showModal('Invalid Email', 'Please enter a valid email address.', 'error');
          return;
        }

        if (!phone || !/^\d{10}$/.test(phone)) {
          showModal('Invalid Phone', 'Please enter a valid 10-digit phone number.', 'error');
          return;
        }

        if (!selectedAddress) {
          showModal('Address Required', 'Please select a shipping address.', 'error');
          return;
        }

        let paymentValue = 'razorpay';
        const selectedPayment = document.querySelector('input[name="payment"]:checked');
        if (selectedPayment && selectedPayment.value) {
          paymentValue = selectedPayment.value;
        }

        placeOrderBtn.disabled    = true;
        placeOrderBtn.textContent = 'Processing...';

        try {
          const response = await fetch('/checkout', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({
              email,
              phone,
              addressId:       selectedAddress.value,
              paymentMethod:   paymentValue,
              couponCode:      appliedCouponCode || '',
              isBuyNow:        IS_BUY_NOW,
              buyNowProductId: BUY_NOW_PRODUCT,
              buyNowColor:     BUY_NOW_COLOR,
              buyNowQty:       BUY_NOW_QTY,
            }),
          });

          const data = await response.json();

          if (data.success && data.redirectUrl) {
            window.location.href = data.redirectUrl;
          } else {
            showModal('Order Failed', data.message || 'Something went wrong', 'error');
          }

        } catch (err) {
          console.error('FETCH ERROR:', err);
          showModal('Error', 'Server not responding. Please try again.', 'error');
        } finally {
          placeOrderBtn.disabled    = false;
          placeOrderBtn.textContent = paymentValue === 'cod' ? 'Place Order' : 'Continue to Payment';
        }
      });
    }

  });
</script>

<%- include('../partials/user/footer') %>
