<%- include('../partials/user/header') %>
    
    <main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20 animate-reveal">
        
        <!-- Breadcrumb & Header -->
        <div class="mb-24 space-y-6">
            <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-400">
                <a href="/" class="hover:text-black transition-colors">Home</a> / 
                <a href="/cart" class="hover:text-black transition-colors">Cart</a> / 
                <span class="text-black">Checkout</span>
            </nav>
            <h1 class="text-6xl md:text-7xl font-serif text-gray-900 leading-none">Secure <span class="italic font-light">Checkout</span></h1>
            <p class="text-[11px] uppercase tracking-[0.3em] text-gray-400 font-bold">Complete Your Order</p>
        </div>
        
        <!-- Main Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-24">
            
            <!-- Checkout Form -->
            <div class="lg:col-span-2 space-y-12">
                
                <!-- Contact Information -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-3xl font-serif text-gray-900">Contact Information</h2>
                        <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">Step 1 of 3</span>
                    </div>
                    
                    <div class="space-y-6">
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Email Address *</label>
                            <input type="email" id="email" required value="<%= user?.email || '' %>" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Phone Number *</label>
                            <input type="tel" id="phone" required value="<%= user?.phone || '' %>" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                    </div>
                </div>
                
                <!-- Shipping Address -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-3xl font-serif text-gray-900">Shipping Address</h2>
                        <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">Step 2 of 3</span>
                    </div>
                    
                    <!-- Saved Addresses -->
                    <% if (addresses && addresses.length > 0) { %>
                        <div class="mb-8">
                            <h3 class="text-sm font-semibold text-gray-900 mb-4 uppercase tracking-widest">Select Saved Address</h3>
                            <div class="space-y-4" id="savedAddresses">
                                <% addresses.forEach((address, index) => { %>
                                    <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white address-card" data-address-id="<%= address._id %>">
                                        <input type="radio" name="selectedAddress" value="<%= address._id %>" class="radio-custom mt-1" <%= address.isDefault ? 'checked' : '' %>>
                                        <div class="flex-1">
                                            <div class="flex items-center justify-between mb-2">
                                                <span class="text-sm font-semibold"><%= address.firstName %> <%= address.lastName %></span>
                                                <% if (address.isDefault) { %>
                                                    <span class="text-[8px] uppercase tracking-widest text-emera-700 font-bold bg-emera-50 px-3 py-1">Default</span>
                                                <% } %>
                                            </div>
                                            <p class="text-xs text-gray-600 mb-1">
                                                <%= address.address1 %><% if (address.address2) { %>, <%= address.address2 %><% } %>
                                            </p>
                                            <p class="text-xs text-gray-600 mb-1">
                                                <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                                            </p>
                                            <p class="text-xs text-gray-600 mb-3">India</p>
                                            <p class="text-xs text-gray-600">Phone: <%= address.phone || user.phone %></p>
                                            <div class="flex gap-4 mt-4">
                                                <button class="text-[9px] uppercase tracking-widest text-emera-700 font-bold hover:text-emera-950 transition-colors edit-address-btn" data-address-id="<%= address._id %>">
                                                    Edit
                                                </button>
                                                <% if (!address.isDefault) { %>
                                                    <button class="text-[9px] uppercase tracking-widest text-gray-500 font-bold hover:text-gray-900 transition-colors set-default-btn" data-address-id="<%= address._id %>">
                                                        Set as Default
                                                    </button>
                                                    <button class="text-[9px] uppercase tracking-widest text-red-500 font-bold hover:text-red-700 transition-colors delete-address-btn" data-address-id="<%= address._id %>">
                                                        Delete
                                                    </button>
                                                <% } %>
                                            </div>
                                        </div>
                                    </label>
                                <% }) %>
                            </div>
                            
                            <button id="addNewAddressBtn" class="mt-6 w-full border-2 border-dashed border-stone-300 text-gray-600 py-6 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-emera-950 hover:text-emera-950 transition-all duration-300">
                                + Add New Address
                            </button>
                        </div>
                    <% } else { %>
                        <p class="text-sm text-gray-500 mb-6 text-center py-4">No saved addresses. Please add a new address below.</p>
                    <% } %>
                    
                    <!-- Add/Edit Address Form -->
                    <div id="addressForm" class="<%= addresses && addresses.length > 0 ? 'hidden' : '' %> space-y-6">
                        <div class="flex items-center justify-between mb-6">
                            <h3 class="text-sm font-semibold text-gray-900 uppercase tracking-widest" id="formTitle">
                                <%= addresses && addresses.length > 0 ? 'Add New Address' : 'Enter Shipping Address' %>
                            </h3>
                            <% if (addresses && addresses.length > 0) { %>
                                <button id="cancelAddressBtn" class="text-[9px] uppercase tracking-widest text-gray-500 font-bold hover:text-gray-900 transition-colors">
                                    Cancel
                                </button>
                            <% } %>
                        </div>
                        
                        <input type="hidden" id="editingAddressId" value="">
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">First Name *</label>
                                <input type="text" id="firstName" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Last Name *</label>
                                <input type="text" id="lastName" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Street Address *</label>
                            <input type="text" id="address1" required placeholder="House number and street name" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white mb-4">
                            <input type="text" id="address2" placeholder="Apartment, suite, unit etc. (optional)" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">City *</label>
                                <input type="text" id="city" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">State / Province *</label>
                                <select id="state" required class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                                    <option value="">Select State</option>
                                    <option value="AN">Andaman and Nicobar Islands</option>
                                    <option value="AP">Andhra Pradesh</option>
                                    <option value="AR">Arunachal Pradesh</option>
                                    <option value="AS">Assam</option>
                                    <option value="BR">Bihar</option>
                                    <option value="CH">Chandigarh</option>
                                    <option value="CT">Chhattisgarh</option>
                                    <option value="DH">Dadra and Nagar Haveli and Daman and Diu</option>
                                    <option value="DL">Delhi</option>
                                    <option value="GA">Goa</option>
                                    <option value="GJ">Gujarat</option>
                                    <option value="HR">Haryana</option>
                                    <option value="HP">Himachal Pradesh</option>
                                    <option value="JK">Jammu and Kashmir</option>
                                    <option value="JH">Jharkhand</option>
                                    <option value="KA">Karnataka</option>
                                    <option value="KL">Kerala</option>
                                    <option value="LA">Ladakh</option>
                                    <option value="LD">Lakshadweep</option>
                                    <option value="MP">Madhya Pradesh</option>
                                    <option value="MH">Maharashtra</option>
                                    <option value="MN">Manipur</option>
                                    <option value="ML">Meghalaya</option>
                                    <option value="MZ">Mizoram</option>
                                    <option value="NL">Nagaland</option>
                                    <option value="OR">Odisha</option>
                                    <option value="PY">Puducherry</option>
                                    <option value="PB">Punjab</option>
                                    <option value="RJ">Rajasthan</option>
                                    <option value="SK">Sikkim</option>
                                    <option value="TN">Tamil Nadu</option>
                                    <option value="TG">Telangana</option>
                                    <option value="TR">Tripura</option>
                                    <option value="UP">Uttar Pradesh</option>
                                    <option value="UT">Uttarakhand</option>
                                    <option value="WB">West Bengal</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">PIN Code *</label>
                                <input type="text" id="pincode" required maxlength="6" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Country *</label>
                                <input type="text" id="country" value="India" readonly class="w-full border border-stone-300 px-6 py-4 text-sm bg-stone-100 text-gray-500">
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Phone (Optional)</label>
                            <input type="tel" id="addressPhone" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            <p class="text-[9px] text-gray-400 mt-2">Leave blank to use contact phone number</p>
                        </div>
                        
                        <div>
                            <label class="flex items-start gap-3 cursor-pointer">
                                <input type="checkbox" id="setAsDefault" class="mt-1">
                                <span class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold">Set as default address</span>
                            </label>
                        </div>
                        
                        <button id="saveAddressBtn" class="w-full bg-emera-950 text-white py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all duration-300">
                            Save Address
                        </button>
                    </div>
                </div>
                
                <!-- Payment Method -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <div class="flex items-center justify-between mb-8">
                        <h2 class="text-3xl font-serif text-gray-900">Payment Method</h2>
                        <span class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold">Step 3 of 3</span>
                    </div>
                    
                    <div class="space-y-4">
                        <!-- Credit/Debit Card -->
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white">
                            <input type="radio" name="payment" value="card" class="radio-custom mt-1">
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-semibold">Credit / Debit Card</span>
                                    <div class="flex gap-2">
                                        <svg class="h-6" viewBox="0 0 48 32" fill="none"><rect width="48" height="32" rx="4" fill="#1434CB"/><circle cx="18" cy="16" r="9" fill="#EB001B"/><circle cx="30" cy="16" r="9" fill="#F79E1B"/><path d="M24 10.5c1.8 1.5 3 3.7 3 6s-1.2 4.5-3 6c-1.8-1.5-3-3.7-3-6s1.2-4.5 3-6z" fill="#FF5F00"/></svg>
                                        <svg class="h-6" viewBox="0 0 48 32" fill="none"><rect width="48" height="32" rx="4" fill="#0066B2"/><rect x="8" y="12" width="32" height="8" rx="1" fill="white"/><rect x="8" y="12" width="6" height="8" fill="#F7B600"/></svg>
                                    </div>
                                </div>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Secure payment via Stripe</p>
                            </div>
                        </label>
                        
                        <!-- UPI -->
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white">
                            <input type="radio" name="payment" value="upi" class="radio-custom mt-1">
                            <div class="flex-1">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-sm font-semibold">UPI Payment</span>
                                    <span class="text-[9px] uppercase tracking-[0.3em] text-emera-700 font-bold">Popular</span>
                                </div>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Google Pay, PhonePe, Paytm & more</p>
                            </div>
                        </label>
                        
                        <!-- Net Banking -->
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white">
                            <input type="radio" name="payment" value="netbanking" class="radio-custom mt-1">
                            <div class="flex-1">
                                <span class="text-sm font-semibold">Net Banking</span>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">All major banks supported</p>
                            </div>
                        </label>
                        
                        <!-- Cash on Delivery -->
                        <label class="flex items-start gap-4 p-6 border border-stone-300 cursor-pointer hover:border-emera-950 transition-colors bg-white">
                            <input type="radio" name="payment" value="cod" class="radio-custom mt-1" checked>
                            <div class="flex-1">
                                <span class="text-sm font-semibold">Cash on Delivery</span>
                                <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400">Pay when you receive</p>
                            </div>
                        </label>
                    </div>
                    
                    <!-- Card Details (shown when card is selected) -->
                    <div id="cardDetails" class="mt-8 pt-8 border-t border-stone-200 space-y-6" style="display: none;">
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Card Number *</label>
                            <input type="text" id="cardNumber" maxlength="19" placeholder="1234 5678 9012 3456" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                        <div>
                            <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Cardholder Name *</label>
                            <input type="text" id="cardName" placeholder="Name on card" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                        </div>
                        <div class="grid grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Expiry Date *</label>
                                <input type="text" id="cardExpiry" maxlength="5" placeholder="MM/YY" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                            <div>
                                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">CVV *</label>
                                <input type="text" id="cardCVV" maxlength="3" placeholder="123" class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors bg-white">
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
            
            <!-- Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-stone-50 p-10 border border-stone-100 sticky top-32">
                    <h2 class="text-3xl font-serif text-gray-900 mb-8">Order Summary</h2>
                    
                    <!-- Order Items -->
                    <div class="space-y-6 mb-8 pb-8 border-b border-stone-200">
                        <% if (cartItems && cartItems.length > 0) { %>
                            <% cartItems.forEach(item => { %>
                                <% const isOutOfStock = item.product.stock < item.quantity; %>
                                <% const isBlocked = item.product.isBlocked || item.product.category?.isBlocked; %>
                                <div class="flex gap-4 <%= (isOutOfStock || isBlocked) ? 'opacity-50' : '' %>">
                                    <div class="w-20 h-20 bg-stone-200 flex-shrink-0 overflow-hidden">
                                        <img src="<%= item.product.productImage?.[0]?.url || '/images/placeholder.png' %>" 
                                             alt="<%= item.product.name %>" 
                                             class="w-full h-full object-cover">
                                    </div>
                                    <div class="flex-1">
                                        <h4 class="text-sm font-semibold text-gray-900 mb-1"><%= item.product.name %></h4>
                                        <p class="text-[9px] uppercase tracking-widest text-gray-400">Qty: <%= item.quantity %></p>
                                        <% if (isOutOfStock) { %>
                                            <p class="text-[8px] uppercase tracking-widest text-red-600 font-bold mt-1">Out of Stock</p>
                                        <% } else if (isBlocked) { %>
                                            <p class="text-[8px] uppercase tracking-widest text-red-600 font-bold mt-1">Unavailable</p>
                                        <% } %>
                                        <p class="text-sm font-bold text-gray-900 mt-2">₹<%= item.price.toLocaleString('en-IN') %></p>
                                    </div>
                                </div>
                            <% }) %>
                        <% } else { %>
                            <div class="text-center py-8">
                                <p class="text-sm text-gray-500">No items in cart</p>
                            </div>
                        <% } %>
                    </div>
                    
                    <!-- Price Breakdown -->
                    <div class="space-y-6 mb-8 pb-8 border-b border-stone-200">
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Subtotal</span>
                            <span class="font-bold text-gray-900">₹<%= subtotal.toLocaleString('en-IN') %></span>
                        </div>
                        <% if (discount > 0) { %>
                            <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                                <span class="text-gray-400 font-bold">Discount</span>
                                <span class="font-bold text-emera-700">-₹<%= discount.toLocaleString('en-IN') %></span>
                            </div>
                        <% } %>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Shipping</span>
                            <span class="font-bold text-emera-700">Complimentary</span>
                        </div>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Tax (GST 18%)</span>
                            <span class="font-bold text-gray-900">₹<%= tax.toLocaleString('en-IN') %></span>
                        </div>
                    </div>
                    
                    <div class="flex justify-between mb-8 pb-8 border-b border-stone-200">
                        <span class="text-xl font-serif text-gray-900">Total</span>
                        <span class="text-2xl font-serif text-gray-900">₹<%= total.toLocaleString('en-IN') %></span>
                    </div>
                    
                    <button id="placeOrderBtn" class="block text-center w-full bg-emera-950 text-white py-6 text-[10px] uppercase tracking-[0.4em] font-bold mb-6 hover:bg-emera-700 transition-all duration-300" <%= (cartItems && cartItems.some(item => item.product.stock < item.quantity || item.product.isBlocked || item.product.category?.isBlocked)) ? 'disabled' : '' %>>
                        Place Order
                    </button>
                    
                    <% if (cartItems && cartItems.some(item => item.product.stock < item.quantity || item.product.isBlocked || item.product.category?.isBlocked)) { %>
                        <p class="text-[9px] text-red-600 uppercase tracking-widest text-center mb-4">Please remove unavailable items to continue</p>
                    <% } %>
                    
                    <div class="space-y-4 text-center">
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Secure Checkout • 256-bit SSL</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Free Returns Within 30 Days</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Authenticity Guaranteed</p>
                    </div>
                </div>
            </div>
            
        </div>
        
    </main>

<!-- Aesthetic Modal -->
<div id="aestheticModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center px-6 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white max-w-md w-full transform scale-95 transition-transform duration-300" id="modalContent">
        <div class="p-10 text-center">
            <div class="mb-6">
                <div class="w-16 h-16 mx-auto bg-stone-100 rounded-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-gray-600" id="modalIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <!-- Icon will be set dynamically -->
                    </svg>
                </div>
            </div>
            <h3 class="text-2xl font-serif text-gray-900 mb-4" id="modalTitle"></h3>
            <p class="text-sm text-gray-600 mb-8" id="modalMessage"></p>
            <button id="modalCloseBtn" class="w-full bg-emera-950 text-white py-4 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all duration-300">
                Close
            </button>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div id="confirmModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center px-6 hidden opacity-0 transition-opacity duration-300">
    <div class="bg-white max-w-md w-full transform scale-95 transition-transform duration-300" id="confirmContent">
        <div class="p-10 text-center">
            <div class="mb-6">
                <div class="w-16 h-16 mx-auto bg-red-100 rounded-full flex items-center justify-center">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                    </svg>
                </div>
            </div>
            <h3 class="text-2xl font-serif text-gray-900 mb-4" id="confirmTitle"></h3>
            <p class="text-sm text-gray-600 mb-8" id="confirmMessage"></p>
            <div class="flex gap-4">
                <button id="confirmCancelBtn" class="flex-1 border-2 border-stone-300 text-gray-700 py-4 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-gray-900 transition-all duration-300">
                    Cancel
                </button>
                <button id="confirmOkBtn" class="flex-1 bg-red-600 text-white py-4 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-red-700 transition-all duration-300">
                    Confirm
                </button>
            </div>
        </div>
    </div>
</div>

<script>
  window.addresses = <%- JSON.stringify(addresses || []) %>;
</script>


<script>
document.addEventListener('DOMContentLoaded', () => {

  /* ================= MODAL FUNCTIONS ================= */

  function showModal(title, message, type = 'info') {
    const modal = document.getElementById('aestheticModal');
    const modalContent = document.getElementById('modalContent');
    const modalTitle = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const modalIcon = document.getElementById('modalIcon');
    
    modalTitle.textContent = title;
    modalMessage.textContent = message;
    
    // Set icon based on type
    if (type === 'error') {
      modalIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>';
      modalIcon.parentElement.classList.remove('bg-stone-100', 'bg-green-100');
      modalIcon.parentElement.classList.add('bg-red-100');
      modalIcon.classList.remove('text-gray-600', 'text-green-600');
      modalIcon.classList.add('text-red-600');
    } else if (type === 'success') {
      modalIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>';
      modalIcon.parentElement.classList.remove('bg-stone-100', 'bg-red-100');
      modalIcon.parentElement.classList.add('bg-green-100');
      modalIcon.classList.remove('text-gray-600', 'text-red-600');
      modalIcon.classList.add('text-green-600');
    } else {
      modalIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>';
      modalIcon.parentElement.classList.remove('bg-red-100', 'bg-green-100');
      modalIcon.parentElement.classList.add('bg-stone-100');
      modalIcon.classList.remove('text-red-600', 'text-green-600');
      modalIcon.classList.add('text-gray-600');
    }
    
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }, 10);
  }

  function hideModal() {
    const modal = document.getElementById('aestheticModal');
    const modalContent = document.getElementById('modalContent');
    
    modal.classList.add('opacity-0');
    modalContent.classList.remove('scale-100');
    modalContent.classList.add('scale-95');
    
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 300);
  }

  function showConfirm(title, message, onConfirm) {
    const modal = document.getElementById('confirmModal');
    const modalContent = document.getElementById('confirmContent');
    const confirmTitle = document.getElementById('confirmTitle');
    const confirmMessage = document.getElementById('confirmMessage');
    const confirmOkBtn = document.getElementById('confirmOkBtn');
    const confirmCancelBtn = document.getElementById('confirmCancelBtn');
    
    confirmTitle.textContent = title;
    confirmMessage.textContent = message;
    
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modalContent.classList.remove('scale-95');
      modalContent.classList.add('scale-100');
    }, 10);
    
    const hideConfirm = () => {
      modal.classList.add('opacity-0');
      modalContent.classList.remove('scale-100');
      modalContent.classList.add('scale-95');
      setTimeout(() => modal.classList.add('hidden'), 300);
    };
    
    confirmOkBtn.onclick = () => {
      hideConfirm();
      onConfirm();
    };
    
    confirmCancelBtn.onclick = hideConfirm;
  }

  document.getElementById('modalCloseBtn').addEventListener('click', hideModal);

  /* ================= DOM ELEMENTS ================= */

  const firstName = document.getElementById('firstName');
  const lastName = document.getElementById('lastName');
  const address1 = document.getElementById('address1');
  const address2 = document.getElementById('address2');
  const city = document.getElementById('city');
  const state = document.getElementById('state');
  const pincode = document.getElementById('pincode');
  const addressPhone = document.getElementById('addressPhone');
  const setAsDefault = document.getElementById('setAsDefault');

  const addressForm = document.getElementById('addressForm');
  const addNewAddressBtn = document.getElementById('addNewAddressBtn');
  const cancelAddressBtn = document.getElementById('cancelAddressBtn');
  const saveAddressBtn = document.getElementById('saveAddressBtn');
  const editingAddressId = document.getElementById('editingAddressId');
  const placeOrderBtn = document.getElementById('placeOrderBtn');

  /* ================= PAYMENT ================= */

  const cardDetails = document.getElementById('cardDetails');
  document.querySelectorAll('input[name="payment"]').forEach(radio => {
    radio.addEventListener('change', () => {
      cardDetails.style.display = radio.value === 'card' ? 'block' : 'none';
    });
  });

  /* ================= HELPERS ================= */

  function clearAddressForm() {
    editingAddressId.value = '';
    [firstName,lastName,address1,address2,city,state,pincode,addressPhone]
      .forEach(el => el && (el.value = ''));
    setAsDefault.checked = false;
  }

  /* ================= ADD ADDRESS ================= */

  addNewAddressBtn?.addEventListener('click', () => {
    addressForm.classList.remove('hidden');
    addNewAddressBtn.classList.add('hidden');
    clearAddressForm();
  });

  cancelAddressBtn?.addEventListener('click', () => {
    addressForm.classList.add('hidden');
    addNewAddressBtn?.classList.remove('hidden');
    clearAddressForm();
  });

  saveAddressBtn?.addEventListener('click', async () => {
    if (
      !firstName.value.trim() ||
      !lastName.value.trim() ||
      !address1.value.trim() ||
      !city.value.trim() ||
      !state.value ||
      !pincode.value.trim()
    ) {
      showModal('Required Fields', 'Please fill all required fields to continue.', 'error');
      return;
    }

    if (pincode.value.length !== 6) {
      showModal('Invalid PIN Code', 'PIN code must be exactly 6 digits.', 'error');
      return;
    }

    const payload = {
      firstName: firstName.value.trim(),
      lastName: lastName.value.trim(),
      address1: address1.value.trim(),
      address2: address2.value.trim(),
      city: city.value.trim(),
      state: state.value,
      pincode: pincode.value.trim(),
      phone: addressPhone.value.trim(),
      isDefault: setAsDefault.checked
    };

    const isEdit = Boolean(editingAddressId.value);
    const url = isEdit
      ? `/profile/addresses/${editingAddressId.value}`
      : `/profile/addresses`;

    try {
      saveAddressBtn.disabled = true;
      const res = await fetch(url, {
        method: isEdit ? 'PUT' : 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (data.success) location.reload();
      else showModal('Save Failed', data.message || 'Unable to save address. Please try again.', 'error');
    } catch {
      showModal('Connection Error', 'Something went wrong. Please check your connection and try again.', 'error');
    } finally {
      saveAddressBtn.disabled = false;
    }
  });

  /* ================= EDIT ADDRESS ================= */

  document.querySelectorAll('.edit-address-btn').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      e.stopPropagation();

      const address = window.addresses.find(a => a._id === btn.dataset.addressId);
      if (!address) {
        showModal('Not Found', 'Address not found. Please refresh the page.', 'error');
        return;
      }

      editingAddressId.value = address._id;
      firstName.value = address.firstName;
      lastName.value = address.lastName;
      address1.value = address.address1;
      address2.value = address.address2 || '';
      city.value = address.city;
      state.value = address.state;
      pincode.value = address.pincode;
      addressPhone.value = address.phone || '';
      setAsDefault.checked = address.isDefault;

      addressForm.classList.remove('hidden');
      addNewAddressBtn?.classList.add('hidden');
      addressForm.scrollIntoView({ behavior: 'smooth' });
    });
  });

  document.querySelectorAll('.delete-address-btn').forEach(btn => {
    btn.addEventListener('click', async e => {
      e.preventDefault();
      e.stopPropagation(); 

      showConfirm(
        'Delete Address',
        'Are you sure you want to delete this address? This action cannot be undone.',
        async () => {
          try {
            const res = await fetch(
              `/profile/addresses/${btn.dataset.addressId}`,
              { method: 'DELETE' }
            );

            const data = await res.json();
            if (data.success) {
              location.reload();
            } else {
              showModal('Delete Failed', data.message || 'Unable to delete address.', 'error');
            }
          } catch (err) {
            console.error(err);
            showModal('Connection Error', 'Something went wrong. Please try again.', 'error');
          }
        }
      );
    });
  });

  document.querySelectorAll('.set-default-btn').forEach(btn => {
    btn.addEventListener('click', async e => {
      e.preventDefault();
      e.stopPropagation();

      try {
        const res = await fetch(
          `/profile/addresses/${btn.dataset.addressId}/set-default`,
          { method: 'PUT' }
        );

        const data = await res.json();
        if (data.success) {
          location.reload();
        } else {
          showModal('Update Failed', data.message || 'Failed to set default address.', 'error');
        }
      } catch (err) {
        console.error(err);
        showModal('Connection Error', 'Something went wrong. Please try again.', 'error');
      }
    });
  });

  /* ================= PLACE ORDER ================= */

  placeOrderBtn?.addEventListener('click', async () => {
    const email = document.getElementById('email').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const selectedAddress = document.querySelector('input[name="selectedAddress"]:checked');

    if (!email || !phone) {
      showModal('Contact Information Required', 'Please provide your email and phone number to continue.', 'error');
      return;
    }
    
    if (!selectedAddress) {
      showModal('Address Required', 'Please select or add a shipping address to continue.', 'error');
      return;
    }

    placeOrderBtn.disabled = true;
    placeOrderBtn.textContent = 'Placing Order...';

    try {
      const res = await fetch('/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          email,
          phone,
          addressId: selectedAddress.value,
          paymentMethod: document.querySelector('input[name="payment"]:checked').value
        })
      });

      const data = await res.json();
      if (data.success) location.href = `/orderConfirmation/${data.orderId}`;
      else showModal('Order Failed', data.message || 'Unable to place your order. Please try again.', 'error');
    } catch {
      showModal('Connection Error', 'Checkout failed. Please check your connection and try again.', 'error');
    } finally {
      placeOrderBtn.disabled = false;
      placeOrderBtn.textContent = 'Place Order';
    }
  });

});
</script>




<%- include('../partials/user/footer') %>
