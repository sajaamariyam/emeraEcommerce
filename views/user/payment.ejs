<%- include('../partials/user/header', { user, cartCount }) %>

<body class="bg-white text-gray-900 selection:bg-emera-950 selection:text-white">

  <!-- Header Spacer -->
  <div class="h-24 bg-emera-950"></div>

  <main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20 animate-reveal">

    <!-- Breadcrumb & Header -->
    <div class="mb-24 space-y-6">
      <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-400">
        <a href="/" class="hover:text-black transition-colors">Home</a> /
        <a href="/cart" class="hover:text-black transition-colors">Cart</a> /
        <a href="/checkout" class="hover:text-black transition-colors">Checkout</a> /
        <span class="text-black">Payment</span>
      </nav>
      <h1 class="text-6xl md:text-7xl font-serif text-gray-900 leading-none">Complete <span class="italic font-light">Payment</span></h1>
      <p class="text-[11px] uppercase tracking-[0.3em] text-gray-400 font-bold">Order #<%= order.orderId %></p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-24">

      <!-- Left: Payment Methods -->
      <div class="lg:col-span-2 space-y-6">

        <!-- Wallet Option -->
        <div id="wallet-section" class="bg-stone-50 border border-stone-100 p-10">
          <div class="flex items-start justify-between mb-8">
            <div>
              <h2 class="text-2xl font-serif text-gray-900 mb-1">Wallet Balance</h2>
              <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold">Instant · No extra charges</p>
            </div>
            <span class="text-2xl font-serif text-gray-900">₹<%= (user.wallet || 0).toLocaleString('en-IN') %></span>
          </div>

          <% if (user.wallet >= order.finalAmount) { %>
            <div class="mb-8 p-6 border border-emera-950 bg-emera-950 bg-opacity-5">
              <p class="text-[10px] uppercase tracking-[0.3em] text-emera-950 font-bold">
                Sufficient balance available &mdash; ₹<%= order.finalAmount.toLocaleString('en-IN') %> will be deducted
              </p>
            </div>
            <button
              id="wallet-pay-btn"
              class="btn-hover w-full bg-emera-950 text-white py-6 text-[10px] uppercase tracking-[0.4em] font-bold transition-all duration-500"
            >
              Pay with Wallet
            </button>
          <% } else { %>
            <div class="mb-8 p-6 border border-stone-200 bg-stone-100">
              <p class="text-[10px] uppercase tracking-[0.3em] text-gray-500 font-bold">
                Insufficient balance &mdash; ₹<%= (order.finalAmount - user.wallet).toLocaleString('en-IN') %> short
              </p>
            </div>
            <button
              disabled
              class="w-full bg-stone-200 text-stone-400 py-6 text-[10px] uppercase tracking-[0.4em] font-bold cursor-not-allowed"
            >
              Insufficient Wallet Balance
            </button>
          <% } %>
        </div>

        <!-- Divider -->
        <div class="flex items-center gap-6">
          <div class="flex-1 h-px bg-stone-200"></div>
          <span class="text-[9px] uppercase tracking-[0.4em] text-gray-400 font-bold">Or</span>
          <div class="flex-1 h-px bg-stone-200"></div>
        </div>

        <!-- Razorpay Option -->
        <div class="bg-stone-50 border border-stone-100 p-10">
          <div class="mb-8">
            <h2 class="text-2xl font-serif text-gray-900 mb-1">Card / UPI / Net Banking</h2>
            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold">Secured by Razorpay · 256-bit SSL</p>
          </div>

          <!-- Accepted Payments Icons Row -->
          <div class="flex items-center gap-6 mb-10">
            <span class="text-[9px] uppercase tracking-widest text-gray-400 font-bold">Accepted:</span>
            <div class="flex gap-3">
              <div class="h-6 px-3 bg-white border border-stone-200 flex items-center justify-center">
                <span class="text-[8px] uppercase tracking-widest font-bold text-gray-500">Visa</span>
              </div>
              <div class="h-6 px-3 bg-white border border-stone-200 flex items-center justify-center">
                <span class="text-[8px] uppercase tracking-widest font-bold text-gray-500">MC</span>
              </div>
              <div class="h-6 px-3 bg-white border border-stone-200 flex items-center justify-center">
                <span class="text-[8px] uppercase tracking-widest font-bold text-gray-500">UPI</span>
              </div>
              <div class="h-6 px-3 bg-white border border-stone-200 flex items-center justify-center">
                <span class="text-[8px] uppercase tracking-widest font-bold text-gray-500">NB</span>
              </div>
            </div>
          </div>

          <button
            id="razorpay-pay-btn"
            class="btn-hover w-full bg-emera-950 text-white py-6 text-[10px] uppercase tracking-[0.4em] font-bold transition-all duration-500"
          >
            Pay ₹<%= order.finalAmount.toLocaleString('en-IN') %> Securely
          </button>
        </div>

        <!-- Back Link -->
        <div class="pt-4">
          <a href="/checkout" class="inline-block border border-emera-950 px-10 py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-950 hover:text-white transition-all duration-500">
            &larr; Back to Checkout
          </a>
        </div>

      </div>

      <!-- Right: Order Summary -->
      <div class="lg:col-span-1">
        <div class="bg-stone-50 p-10 border border-stone-100 sticky top-32">
          <h2 class="text-3xl font-serif text-gray-900 mb-12">Order Summary</h2>

          <!-- Items List -->
          <div class="space-y-6 mb-10 pb-10 border-b border-stone-200">
            <% order.orderedItems.forEach(item => { %>
            <div class="flex gap-5 items-start">
              <div class="w-16 h-16 bg-stone-200 overflow-hidden flex-shrink-0">
                <img
                  src="<%= item.productId?.productImage?.[0]?.url || '/images/placeholder.png' %>"
                  alt="<%= item.productId?.name %>"
                  class="w-full h-full object-cover"
                >
              </div>
              <div class="flex-1 min-w-0">
                <p class="text-sm font-serif text-gray-900 leading-tight truncate"><%= item.productId?.name || 'Product' %></p>
                <p class="text-[9px] uppercase tracking-widest text-gray-400 mt-1">Qty: <%= item.quantity %></p>
              </div>
              <p class="text-sm font-bold text-gray-900 flex-shrink-0">₹<%= (item.price * item.quantity).toLocaleString('en-IN') %></p>
            </div>
            <% }); %>
          </div>

          <!-- Pricing Breakdown -->
          <div class="space-y-5 mb-8 pb-8 border-b border-stone-200">
            <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
              <span class="text-gray-400 font-bold">Subtotal</span>
              <span class="font-bold text-gray-900">₹<%= order.totalPrice.toLocaleString('en-IN') %></span>
            </div>
            <% if (order.discount > 0) { %>
            <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
              <span class="text-gray-400 font-bold">Discount</span>
              <span class="font-bold text-emera-700">− ₹<%= order.discount.toLocaleString('en-IN') %></span>
            </div>
            <% } %>
            <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
              <span class="text-gray-400 font-bold">Shipping</span>
              <span class="font-bold text-emera-700">Complimentary</span>
            </div>
          </div>

          <div class="flex justify-between mb-10">
            <span class="text-xl font-serif text-gray-900">Total</span>
            <span class="text-2xl font-serif text-gray-900">₹<%= order.finalAmount.toLocaleString('en-IN') %></span>
          </div>

          <!-- Delivery Address -->
          <div class="pt-8 border-t border-stone-200">
            <p class="text-[9px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-4">Delivering To</p>
            <% if (order.address) { %>
            <div class="space-y-1">
              <p class="text-sm font-serif text-gray-900"><%= order.address.name || order.address.fullName %></p>
              <p class="text-[10px] text-gray-500 leading-relaxed">
                <%= order.address.addressLine || order.address.street %>,<br>
                <%= order.address.city %>, <%= order.address.state %> &mdash; <%= order.address.pincode || order.address.zip %>
              </p>
            </div>
            <% } %>
          </div>

          <div class="mt-8 space-y-3 text-center">
            <p class="text-[9px] text-gray-400 uppercase tracking-widest">Secure Checkout &bull; 256-bit SSL</p>
            <p class="text-[9px] text-gray-400 uppercase tracking-widest">Free Returns Within 30 Days</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <!-- Modal -->
  <div id="paymentModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">
    <div class="bg-white p-10 max-w-md w-full mx-4">
      <h3 id="modalTitle" class="text-2xl font-serif text-gray-900 mb-4"></h3>
      <p id="modalMessage" class="text-sm text-gray-600 mb-10 leading-relaxed"></p>
      <button id="modalClose" class="w-full bg-emera-950 text-white py-5 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-800 transition-colors">
        Close
      </button>
    </div>
  </div>

  <!-- Loading Overlay -->
  <div id="loadingOverlay" class="hidden fixed inset-0 bg-white bg-opacity-80 z-50 flex flex-col items-center justify-center gap-6">
    <div class="w-10 h-10 border-2 border-emera-950 border-t-transparent rounded-full animate-spin"></div>
    <p class="text-[10px] uppercase tracking-[0.4em] text-gray-400 font-bold">Processing Payment...</p>
  </div>

  <!-- Razorpay SDK -->
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script>
    const orderId = "<%= order.orderId %>";

    const modal        = document.getElementById('paymentModal');
    const modalTitle   = document.getElementById('modalTitle');
    const modalMessage = document.getElementById('modalMessage');
    const modalClose   = document.getElementById('modalClose');
    const loading      = document.getElementById('loadingOverlay');

    function showModal(title, message, onClose) {
      modalTitle.textContent   = title;
      modalMessage.textContent = message;
      modal.classList.remove('hidden');
      modalClose.onclick = () => {
        modal.classList.add('hidden');
        if (typeof onClose === 'function') onClose();
      };
    }

    function showLoading() { loading.classList.remove('hidden'); }
    function hideLoading() { loading.classList.add('hidden'); }

    /* ── Wallet Payment ─────────────────────────────────────────── */
    const walletBtn = document.getElementById('wallet-pay-btn');
    if (walletBtn) {
      walletBtn.addEventListener('click', async () => {
        showLoading();
        try {
          const res  = await fetch(`/payment/wallet/${orderId}`, { method: 'POST' });
          const data = await res.json();
          hideLoading();

          if (data.success) {
            window.location.href = data.redirectUrl;
          } else {
            showModal('Payment Failed', data.message || 'Wallet payment could not be processed.');
          }
        } catch (err) {
          hideLoading();
          showModal('Error', 'Something went wrong. Please try again.');
        }
      });
    }

    /* ── Razorpay Payment ───────────────────────────────────────── */
    document.getElementById('razorpay-pay-btn').addEventListener('click', async () => {
      showLoading();
      try {
        const res  = await fetch(`/payment/create-order/${orderId}`);
        const data = await res.json();
        hideLoading();

        if (!data.success) {
          showModal('Initialization Failed', data.message || 'Could not initialize payment. Please try again.');
          return;
        }

        const options = {
          key:       data.key,
          amount:    data.amount,
          currency:  data.currency,
          order_id:  data.order_id,
          name:      'Emera',
          description: `Order #${orderId}`,
          theme: { color: '#0d0d0d' },

          handler: async function (response) {
            showLoading();
            try {
              const verifyRes  = await fetch('/payment/verify', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  razorpay_order_id:   response.razorpay_order_id,
                  razorpay_payment_id: response.razorpay_payment_id,
                  razorpay_signature:  response.razorpay_signature,
                  orderId,
                }),
              });
              const verifyData = await verifyRes.json();
              hideLoading();

              if (verifyData.success) {
                window.location.href = verifyData.redirectUrl;
              } else {
                window.location.href = verifyData.redirectUrl || `/payment-failed/${orderId}`;
              }
            } catch (err) {
              hideLoading();
              window.location.href = `/payment-failed/${orderId}`;
            }
          },

          modal: {
            ondismiss: function () {
              showModal(
                'Payment Cancelled',
                'You closed the payment window. Your order is saved — you can retry payment anytime.',
                () => {}
              );
            },
          },
        };

        const rzp = new Razorpay(options);

        rzp.on('payment.failed', function () {
          window.location.href = `/payment-failed/${orderId}`;
        });

        rzp.open();

      } catch (err) {
        hideLoading();
        showModal('Error', 'Something went wrong. Please refresh and try again.');
      }
    });
  </script>

<%- include('../partials/user/footer') %>