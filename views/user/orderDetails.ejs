<%- include('../partials/user/header') %>
    
    <main class="max-w-[1440px] mx-auto px-6 lg:px-12 py-20 animate-reveal">
        
        <!-- Breadcrumb & Header -->
        <div class="mb-24 space-y-6">
            <nav class="text-[9px] uppercase tracking-[0.4em] text-gray-400">
                <a href="/" class="hover:text-black transition-colors">Home</a> / 
                <a href="/orders" class="hover:text-black transition-colors">My Orders</a> / 
                <span class="text-black">Order Details</span>
            </nav>
            <div class="flex flex-wrap justify-between items-start gap-6">
                <div>
                    <h1 class="text-6xl md:text-7xl font-serif text-gray-900 leading-none">Order <span class="italic font-light">Details</span></h1>
                    <p class="text-[11px] uppercase tracking-[0.3em] text-gray-400 font-bold mt-4">Order #<%= order.orderId %></p>
                </div>
                <div class="text-right">
                    <div class="inline-block px-8 py-3 rounded-full text-[10px] uppercase tracking-[0.3em] font-bold mb-3
                        <%= order.status === 'Delivered' ? 'bg-green-100 text-green-700' : '' %>
                        <%= order.status === 'Pending' ? 'bg-yellow-100 text-yellow-700' : '' %>
                        <%= order.status === 'Processing' ? 'bg-blue-100 text-blue-700' : '' %>
                        <%= order.status === 'Shipped' ? 'bg-purple-100 text-purple-700' : '' %>
                        <%= order.status === 'Cancelled' ? 'bg-red-100 text-red-700' : '' %>
                        <%= order.status === 'Return Requested' ? 'bg-orange-100 text-orange-700' : '' %>">
                        <%= order.status %>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Main Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-24">
            
            <!-- Left Column -->
            <div class="lg:col-span-2 space-y-12">
                
                <!-- Order Information -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <h2 class="text-3xl font-serif text-gray-900 mb-8">Order Information</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Order Number</p>
                            <p class="text-lg font-semibold text-gray-900">#<%= order.orderId %></p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Order Date</p>
                            <p class="text-lg font-semibold text-gray-900"><%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %></p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Payment Method</p>
                            <p class="text-lg font-semibold text-gray-900 capitalize"><%= order.paymentMethod.replace(/_/g, ' ') %></p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Estimated Delivery</p>
                            <p class="text-lg font-semibold text-gray-900">
                                <% if (order.status === 'Delivered') { %>
                                    <%= new Date(order.updatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                <% } else if (order.status === 'Cancelled') { %>
                                    Cancelled
                                <% } else { %>
                                    <%= new Date(Date.now() + 7 * 24 * 60 * 60 * 1000).toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                                <% } %>
                            </p>
                        </div>
                    </div>
                </div>
                
                <!-- Shipping Address -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <h2 class="text-3xl font-serif text-gray-900 mb-8">Shipping Address</h2>

                    <% if (order.shippingAddress) { %>
                        <div class="space-y-2">
                            <p class="text-lg font-semibold text-gray-900">
                                <%= order.shippingAddress.name %>
                            </p>

                            <p class="text-sm text-gray-600">
                                <%= order.shippingAddress.address %>
                            </p>

                            <p class="text-sm text-gray-600">
                                <%= order.shippingAddress.city %>, 
                                <%= order.shippingAddress.state %> 
                                <%= order.shippingAddress.pincode %>
                            </p>

                            <p class="text-sm text-gray-600">
                                <%= order.shippingAddress.country %>
                            </p>

                            <p class="text-sm text-gray-600 mt-4">
                                <strong>Phone:</strong> <%= order.shippingAddress.phone %>
                            </p>

                            <% if (order.shippingAddress.email) { %>
                                <p class="text-sm text-gray-600">
                                    <strong>Email:</strong> <%= order.shippingAddress.email %>
                                </p>
                            <% } %>
                        </div>
                    <% } else { %>
                        <p class="text-sm text-gray-500">Shipping address not available</p>
                    <% } %>
                </div>

                
                <!-- Order Items -->
               <div class="space-y-6">
                <% order.orderedItems.forEach(item => { %>

                    <%
                    // DEFAULT image
                    let imageUrl = '/images/product-unavailable.png';

                    // ONLY if product still exists and has image
                    if (
                        item.productId &&
                        Array.isArray(item.productId.productImage) &&
                        item.productId.productImage.length > 0
                    ) {
                        if (typeof item.productId.productImage[0] === 'string') {
                        imageUrl = '/' + item.productId.productImage[0];
                        } else if (item.productId.productImage[0].url) {
                        imageUrl = item.productId.productImage[0].url;
                        }
                    }
                    %>

                    <div class="flex gap-6 pb-6 border-b border-stone-200
                                <%= !item.productId ? 'opacity-50' : '' %>">

                    <div class="w-32 h-32 bg-stone-200 overflow-hidden">
                        <img
                        src="<%= imageUrl %>"
                        alt="<%= item.productId ? item.productId.name : 'Product unavailable' %>"
                        class="w-full h-full object-cover">
                    </div>

                    <div class="flex-1">
                        <h4 class="text-lg font-semibold text-gray-900">
                        <%= item.productId ? item.productId.name : 'Product no longer available' %>
                        </h4>

                        <p class="text-xs uppercase tracking-wider text-gray-400">
                        Qty: <%= item.quantity %>
                        </p>

                        <% if (!item.productId) { %>
                        <p class="text-xs text-red-600 mt-2">
                            This product has been removed from the store
                        </p>
                        <% } %>
                    </div>

                    <div class="text-right">
                        <p class="text-lg font-serif text-gray-900">
                        ₹<%= (item.price * item.quantity).toLocaleString('en-IN') %>
                        </p>
                    </div>
                    </div>

                <% }) %>
                </div>

                
                <!-- Order Tracking -->
                <div class="bg-stone-50 p-10 border border-stone-100">
                    <h2 class="text-3xl font-serif text-gray-900 mb-8">Order Tracking</h2>
                    
                    <div class="relative">
                        <!-- Progress Line -->
                        <div class="absolute left-6 top-6 bottom-6 w-0.5 bg-stone-200"></div>
                        <div class="absolute left-6 top-6 w-0.5 bg-emera-700 transition-all duration-1000" style="height: 0%" id="progressLine"></div>
                        
                        <!-- Steps -->
                        <div class="space-y-8 relative">
                            <!-- Order Placed -->
                            <div class="flex gap-6 items-start">
                                <div class="w-12 h-12 rounded-full bg-emera-700 flex items-center justify-center flex-shrink-0 z-10 step-circle" data-step="pending">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                                    </svg>
                                </div>
                                <div class="flex-1 pt-2">
                                    <h4 class="text-sm font-bold text-gray-900 uppercase tracking-[0.2em]">Order Placed</h4>
                                    <p class="text-xs text-gray-500 mt-1"><%= new Date(order.createdAt).toLocaleString('en-IN') %></p>
                                </div>
                            </div>
                            
                            <!-- Order Confirmed -->
                            <!-- <div class="flex gap-6 items-start">
                                <div class="w-12 h-12 rounded-full bg-stone-200 flex items-center justify-center flex-shrink-0 z-10 step-circle" data-step="Processing" id="step2">
                                    <div class="w-3 h-3 rounded-full bg-gray-400"></div>
                                </div>
                                <div class="flex-1 pt-2">
                                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-[0.2em] step-title">Order Confirmed</h4>
                                    <p class="text-xs text-gray-400 mt-1 step-status">Pending</p>
                                </div>
                            </div> -->
                            
                            <!-- Shipped -->
                            <div class="flex gap-6 items-start">
                                <div class="w-12 h-12 rounded-full bg-stone-200 flex items-center justify-center flex-shrink-0 z-10 step-circle" data-step="shipped" id="step3">
                                    <div class="w-3 h-3 rounded-full bg-gray-400"></div>
                                </div>
                                <div class="flex-1 pt-2">
                                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-[0.2em] step-title">Shipped</h4>
                                    <p class="text-xs text-gray-400 mt-1 step-status">Pending</p>
                                </div>
                            </div>
                            
                            <!-- Out for Delivery -->
                            <div class="flex gap-6 items-start">
                                <div class="w-12 h-12 rounded-full bg-stone-200 flex items-center justify-center flex-shrink-0 z-10 step-circle" data-step="out-for-delivery" id="step4">
                                    <div class="w-3 h-3 rounded-full bg-gray-400"></div>
                                </div>
                                <div class="flex-1 pt-2">
                                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-[0.2em] step-title">Out for Delivery</h4>
                                    <p class="text-xs text-gray-400 mt-1 step-status">Pending</p>
                                </div>
                            </div>
                            
                            <!-- Delivered -->
                            <div class="flex gap-6 items-start">
                                <div class="w-12 h-12 rounded-full bg-stone-200 flex items-center justify-center flex-shrink-0 z-10 step-circle" data-step="delivered" id="step5">
                                    <div class="w-3 h-3 rounded-full bg-gray-400"></div>
                                </div>
                                <div class="flex-1 pt-2">
                                    <h4 class="text-sm font-bold text-gray-400 uppercase tracking-[0.2em] step-title">Delivered</h4>
                                    <p class="text-xs text-gray-400 mt-1 step-status">Pending</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
            </div>
            
            <!-- Right Column - Order Summary -->
            <div class="lg:col-span-1">
                <div class="bg-stone-50 p-10 border border-stone-100 sticky top-32">
                    <h2 class="text-3xl font-serif text-gray-900 mb-8">Order Summary</h2>
                    
                    <!-- Price Breakdown -->
                    <div class="space-y-6 mb-8 pb-8 border-b border-stone-200">
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Subtotal</span>
                            <span class="font-bold text-gray-900">₹<%= subtotal.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Shipping</span>
                            <span class="font-bold text-emera-700">Complimentary</span>
                        </div>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Tax (GST 18%)</span>
                            <span class="font-bold text-gray-900">₹<%= tax.toLocaleString('en-IN') %></span>
                        </div>
                        <% if (order.discount > 0) { %>
                        <div class="flex justify-between text-[11px] uppercase tracking-[0.2em]">
                            <span class="text-gray-400 font-bold">Discount</span>
                            <span class="font-bold text-emera-700">-₹<%= order.discount.toLocaleString('en-IN') %></span>
                        </div>
                        <% } %>
                    </div>
                    
                    <div class="flex justify-between mb-8 pb-8 border-b border-stone-200">
                        <span class="text-xl font-serif text-gray-900">Total</span>
                        <span class="text-2xl font-serif text-gray-900">₹<%= total.toLocaleString('en-IN') %></span>
                    </div>
                    
                    <!-- Action Buttons -->
                    <div class="space-y-4 mb-8">
                    <form
                    action="/orders/<%= order.orderId %>/invoice"
                    method="POST"
                    class="block w-full"
                    >
                   <button
                    type="submit"
                    class="block text-center w-full
                            border-2 border-emera-950 text-emera-950
                            py-6 text-[10px] uppercase tracking-[0.4em] font-bold
                            hover:bg-emera-950 hover:text-white
                            transition-all duration-300"
                    >
                    Download Invoice
                    </button>

                    </form>


                        <% if (order.status === 'Pending' || order.status === 'Processing') { %>
                            <button onclick="openCancelModal('<%= order.orderId %>', 'order')"
                                    class="block text-center w-full border-2 border-red-600 text-red-600 py-6 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-red-600 hover:text-white transition-all duration-300">
                                Cancel Entire Order
                            </button>
                        <% } %>
                        
                        <% if (order.status === 'Delivered') { %>
                            <button onclick="openReturnModal('<%= order.orderId %>')"
                                    class="block text-center w-full border-2 border-orange-600 text-orange-600 py-6 text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-orange-600 hover:text-white transition-all duration-300">
                                Return Order
                            </button>
                        <% } %>
                        
                        <a href="/orders"
                           class="block text-center w-full border-2 border-stone-300 text-gray-900 py-6 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 transition-all duration-300">
                            Back to Orders
                        </a>
                    </div>
                    
                    <!-- Support Information -->
                    <div class="space-y-4 text-center pt-8 border-t border-stone-200">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-gray-900 font-bold mb-4">Need Help?</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Email: support@emera.com</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Phone: +91 1800 123 4567</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest mt-6">Free Returns Within 30 Days</p>
                        <p class="text-[9px] text-gray-400 uppercase tracking-widest">Authenticity Guaranteed</p>
                    </div>
                </div>
            </div>
            
        </div>
        
    </main>

    <!-- Cancel Order Modal -->
    <div id="cancelModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
        <div class="bg-white max-w-2xl w-full mx-4 p-10">
            <h2 class="text-3xl font-serif text-gray-900 mb-6">Cancel <span id="cancelTitle">Order</span></h2>
            <p class="text-sm text-gray-600 mb-6">Are you sure you want to cancel? This action cannot be undone.</p>
            
            <div class="mb-8">
                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Reason for Cancellation (Optional)</label>
                <textarea 
                    id="cancelReason" 
                    rows="4"
                    placeholder="Tell us why you're cancelling..."
                    class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors resize-none"
                ></textarea>
            </div>
            
            <div class="flex gap-4">
                <button onclick="confirmCancel()" 
                        class="flex-1 py-4 bg-red-600 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-red-700 transition-all">
                    Confirm Cancellation
                </button>
                <button onclick="closeCancelModal()" 
                        class="flex-1 py-4 border-2 border-stone-300 text-gray-900 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 transition-all">
                    Keep <span id="keepTitle">Order</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Return Order Modal -->
    <div id="returnModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
        <div class="bg-white max-w-2xl w-full mx-4 p-10">
            <h2 class="text-3xl font-serif text-gray-900 mb-6">Return Order</h2>
            <p class="text-sm text-gray-600 mb-6">Please provide a reason for returning this order. Our team will review your request.</p>
            
            <div class="mb-8">
                <label class="block text-[10px] uppercase tracking-[0.3em] text-gray-400 font-bold mb-3">Reason for Return *</label>
                <textarea 
                    id="returnReason" 
                    rows="4"
                    placeholder="Please describe the reason for return..."
                    class="w-full border border-stone-300 px-6 py-4 text-sm focus:border-emera-950 transition-colors resize-none"
                    required
                ></textarea>
            </div>
            
            <div class="flex gap-4">
                <button onclick="confirmReturn()" 
                        class="flex-1 py-4 bg-orange-600 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-orange-700 transition-all">
                    Submit Return Request
                </button>
                <button onclick="closeReturnModal()" 
                        class="flex-1 py-4 border-2 border-stone-300 text-gray-900 text-[10px] uppercase tracking-[0.4em] font-bold hover:border-stone-900 transition-all">
                    Cancel
                </button>
            </div>
        </div>
    </div>

    <!-- Notification Modal -->
    <div id="notificationModal" class="fixed inset-0 bg-black bg-opacity-50 z-50 hidden items-center justify-center">
        <div class="bg-white max-w-md w-full mx-4 p-10 text-center animate-reveal">
            <div id="notificationIcon" class="w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center">
                <!-- Icon will be inserted here -->
            </div>
            <h3 id="notificationTitle" class="text-2xl font-serif text-gray-900 mb-4"></h3>
            <p id="notificationMessage" class="text-sm text-gray-600 mb-8"></p>
            <button onclick="closeNotification()" 
                    class="w-full py-4 bg-emera-950 text-white text-[10px] uppercase tracking-[0.4em] font-bold hover:bg-emera-700 transition-all">
                Close
            </button>
        </div>
    </div>

    <script>
        let currentOrderId = '<%= order.orderId %>';
        let cancelType = 'order';
        let currentProductId = '';

        // Status progression map
        const statusMap = {
            'Pending': { progress: '0%', step: 0 },
            'Processing': { progress: '25%', step: 1 },
            'Shipped': { progress: '50%', step: 2 },
            'Out for Delivery': { progress: '75%', step: 3 },
            'Delivered': { progress: '100%', step: 4 },
            'Cancelled': { progress: '0%', step: 0 },
            'Return Requested': { progress: '0%', step: 0 }
        };

        const currentStatus = '<%= order.status %>';
        
        // Animate progress line on page load
        window.addEventListener('load', () => {
            setTimeout(() => {
                const progressLine = document.getElementById('progressLine');
                const statusInfo = statusMap[currentStatus] || statusMap['Pending'];
                progressLine.style.height = statusInfo.progress;
                
                const stepCircles = document.querySelectorAll('.step-circle');
                const stepTitles = document.querySelectorAll('.step-title');
                const stepStatuses = document.querySelectorAll('.step-status');
                
                stepCircles.forEach((circle, index) => {
                    if (index <= statusInfo.step) {
                        circle.classList.remove('bg-stone-200');
                        circle.classList.add('bg-emera-700');
                        circle.innerHTML = `
                            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                        `;
                        
                        if (stepTitles[index]) {
                            stepTitles[index].classList.remove('text-gray-400');
                            stepTitles[index].classList.add('text-gray-900');
                        }
                        
                        if (stepStatuses[index]) {
                            if (index === statusInfo.step) {
                                stepStatuses[index].textContent = 'In Progress';
                                stepStatuses[index].classList.remove('text-gray-400');
                                stepStatuses[index].classList.add('text-emera-700');
                            } else {
                                stepStatuses[index].textContent = 'Completed';
                                stepStatuses[index].classList.remove('text-gray-400');
                                stepStatuses[index].classList.add('text-gray-500');
                            }
                        }
                    }
                });
            }, 500);
        });

        // Notification Modal
        function showNotification(type, title, message) {
            const modal = document.getElementById('notificationModal');
            const icon = document.getElementById('notificationIcon');
            const titleEl = document.getElementById('notificationTitle');
            const messageEl = document.getElementById('notificationMessage');
            
            // Set content
            titleEl.textContent = title;
            messageEl.textContent = message;
            
            // Set icon based on type
            if (type === 'success') {
                icon.className = 'w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center bg-green-100';
                icon.innerHTML = `
                    <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                `;
            } else if (type === 'error') {
                icon.className = 'w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center bg-red-100';
                icon.innerHTML = `
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                `;
            } else if (type === 'warning') {
                icon.className = 'w-16 h-16 mx-auto mb-6 rounded-full flex items-center justify-center bg-yellow-100';
                icon.innerHTML = `
                    <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                `;
            }
            
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeNotification() {
            const modal = document.getElementById('notificationModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        // Cancel Modal
        function openCancelModal(orderId, type = 'order', productId = '') {
            currentOrderId = orderId;
            cancelType = type;
            currentProductId = productId;
            
            if (type === 'product') {
                document.getElementById('cancelTitle').textContent = 'This Item';
                document.getElementById('keepTitle').textContent = 'Item';
            } else {
                document.getElementById('cancelTitle').textContent = 'Order';
                document.getElementById('keepTitle').textContent = 'Order';
            }
            
            document.getElementById('cancelModal').classList.remove('hidden');
            document.getElementById('cancelModal').classList.add('flex');
        }

        function closeCancelModal() {
            document.getElementById('cancelModal').classList.add('hidden');
            document.getElementById('cancelModal').classList.remove('flex');
            document.getElementById('cancelReason').value = '';
        }

        function confirmCancel() {
            const reason = document.getElementById('cancelReason').value;
            
            const url = cancelType === 'product' 
                ? `/orders/${currentOrderId}/cancel-product`
                : `/orders/${currentOrderId}/cancel`;
            
            const body = cancelType === 'product'
                ? { reason, productId: currentProductId }
                : { reason };
            
            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            })
            .then(r => r.json())
            .then(data => {
                closeCancelModal();
                if (data.success) {
                    showNotification('success', 'Cancellation Successful', data.message || 'Your cancellation request has been processed successfully.');
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showNotification('error', 'Cancellation Failed', data.message || 'Unable to process your cancellation request. Please try again.');
                }
            })
            .catch(err => {
                closeCancelModal();
                console.error('Error:', err);
                showNotification('error', 'Request Failed', 'An error occurred while processing your request. Please try again.');
            });
        }

        // Return Modal
        function openReturnModal(orderId) {
            currentOrderId = orderId;
            document.getElementById('returnModal').classList.remove('hidden');
            document.getElementById('returnModal').classList.add('flex');
        }

        function closeReturnModal() {
            document.getElementById('returnModal').classList.add('hidden');
            document.getElementById('returnModal').classList.remove('flex');
            document.getElementById('returnReason').value = '';
        }

        function confirmReturn() {
            const reason = document.getElementById('returnReason').value.trim();
            
            if (!reason) {
                showNotification('warning', 'Reason Required', 'Please provide a reason for your return request.');
                return;
            }
            
            fetch(`/orders/${currentOrderId}/return`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason })
            })
            .then(r => r.json())
            .then(data => {
                closeReturnModal();
                if (data.success) {
                    showNotification('success', 'Return Request Submitted', data.message || 'Your return request has been submitted successfully. Our team will review it shortly.');
                    setTimeout(() => {
                        window.location.reload();
                    }, 2000);
                } else {
                    showNotification('error', 'Return Request Failed', data.message || 'Unable to submit your return request. Please try again.');
                }
            })
            .catch(err => {
                closeReturnModal();
                console.error('Error:', err);
                showNotification('error', 'Request Failed', 'An error occurred while processing your request. Please try again.');
            });
        }

        // Download Invoice
        function downloadInvoice(orderId) {
            window.location.href = `/orders/${orderId}/invoice`;
        }

        // Close modals on outside click
        document.getElementById('cancelModal').addEventListener('click', function(e) {
            if (e.target === this) closeCancelModal();
        });

        document.getElementById('returnModal').addEventListener('click', function(e) {
            if (e.target === this) closeReturnModal();
        });

        document.getElementById('notificationModal').addEventListener('click', function(e) {
            if (e.target === this) closeNotification();
        });

        // Close modals on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeCancelModal();
                closeReturnModal();
                closeNotification();
            }
        });


