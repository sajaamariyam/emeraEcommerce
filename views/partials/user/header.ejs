<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>EMERA</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            serif: ['Playfair Display', 'serif'],
          },
          colors: {
            emera: {
              950: '#062c26'
            },
            gold: {
              400: '#d4af37',
              500: '#c5a028'
            }
          }
        }
      }
    }
  </script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Crimson+Text:ital,wght@0,400;0,600;1,400&display=swap');
        
        .font-serif {
            font-family: 'Crimson Text', serif;
        }
        
        @keyframes reveal {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .animate-reveal {
            animation: reveal 0.6s ease-out;
        }
        
        .btn-hover {
            position: relative;
            overflow: hidden;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .btn-hover:hover {
            background-color: #0a1a0f;
        }
        
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: #0f2419;
        }
        
        .radio-custom {
            appearance: none;
            width: 20px;
            height: 20px;
            border: 2px solid #d6d3d1;
            border-radius: 50%;
            position: relative;
            cursor: pointer;
        }
        
        .radio-custom:checked {
            border-color: #0f2419;
        }
        
        .radio-custom:checked::after {
            content: '';
            width: 10px;
            height: 10px;
            background: #0f2419;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
    </style>

</head>

<body class="font-sans">

<!-- ================= ANNOUNCEMENT ================= -->
<% if (showAnnouncement) { %>
  <div class="bg-emera-950 text-white text-xs uppercase tracking-widest text-center py-2 font-medium">
    Complimentary Shipping on Orders Over ₹500
  </div>
<% } %>

<!-- ================= NAVBAR ================= -->
<nav class="sticky top-0 z-50 bg-emera-950 border-b border-white/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <!-- Logo -->
      <a href="/" class="font-serif text-3xl text-white tracking-tight">
        EMERA.
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/products" class="text-sm uppercase tracking-wide text-white/80 hover:text-white">
          New Arrivals
        </a>
        <a href="/products" class="text-sm uppercase tracking-wide text-white/80 hover:text-white">
          Handbags
        </a>
        <a href="/about" class="text-sm uppercase tracking-wide text-white/80 hover:text-white">
          World of Emera
        </a>
      </div>

      <!-- Right Section -->
      <div class="flex items-center space-x-6">

        <!-- Search -->
        <form action="/search" method="GET" class="flex items-center gap-2">
          
          <input
            type="text"
            name="q"
            placeholder="Search products"
            class="bg-transparent border-b border-white/40 text-white text-sm px-2 py-1 focus:outline-none"
            required
          />

          <button type="submit" class="text-white/80 hover:text-white">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>

        </form>


        <!-- Cart -->
        <a href="/cart" class="relative text-white/80 hover:text-white">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>

          <% if (cartCount && cartCount > 0) { %>
            <span class="absolute -top-2 -right-2 bg-white text-emera-950 text-[10px] w-5 h-5 rounded-full flex items-center justify-center font-bold">
              <%= cartCount %>
            </span>
          <% } %>
        </a>

        <!-- Auth -->
        <% if (!user) { %>
          <a href="/login" class="text-sm text-white/80 hover:text-white">
            Login
          </a>
          <a href="/signup"
             class="hidden sm:block px-4 py-2 bg-gold-400 text-emera-950 text-sm font-medium rounded hover:bg-gold-500">
            Sign Up
          </a>
        <% } else { %>
        
          <div class="relative">
          <button id="profileBtn" class="text-sm text-white/80 hover:text-white">
            <%= user?.name || user?.email || "Account" %>
          </button>

          <div id="profileMenu"
              class="absolute right-0 mt-2 w-40 bg-white rounded shadow-lg hidden">
            <a href="/profile" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">
              Profile
            </a>
            <a href="/logout" class="block px-4 py-2 text-red-600 hover:bg-gray-100">
              Logout
            </a>
          </div>
        </div>


        <% } %>

      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById("profileBtn");
  const menu = document.getElementById("profileMenu");

  btn.addEventListener("click", () => {
    menu.classList.toggle("hidden");
  });

  document.addEventListener("click", (e) => {
    if (!btn.contains(e.target) && !menu.contains(e.target)) {
      menu.classList.add("hidden");
    }
  });
</script>
